+// Release coordinates only. This module owns no accounts, grants or saved work.
+const uuid=/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;
+const studioPattern=/^[a-z0-9-]{1,64}$/;
+const fields=['share_kind','share_studio','share_program','share_version'];
+const esc=value=>String(value??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
+export function shareReference({kind,studio,key,version}={}){
+  if(!['routine','plan'].includes(kind)||typeof studio!=='string'||!studioPattern.test(studio)||typeof key!=='string'||!uuid.test(key)||!Number.isSafeInteger(version)||version<1||version>100)throw Error('This program link is invalid.');
+  return {kind,studio,key,version};
+}
+export function sharedProgramPath(reference){
+  const r=shareReference(reference);return `/programs/${r.studio}/${r.kind}/${r.key}/${r.version}`;
+}
+export function parseSharedProgramPath(path){
+  const match=typeof path==='string'&&path.match(/^\/programs\/([a-z0-9-]+)\/(routine|plan)\/([a-f0-9-]+)\/([1-9][0-9]*)$/);
+  if(!match)throw Error('This program link is invalid.');
+  return shareReference({studio:match[1],kind:match[2],key:match[3],version:Number(match[4])});
+}
+export function sharedAdoptionPath(reference){
+  const r=shareReference(reference),query=new URLSearchParams();
+  [r.kind,r.studio,r.key,String(r.version)].forEach((value,index)=>query.set(fields[index],value));
+  return '/?'+query.toString()+'#programs';
+}
+export function parseSharedAdoption(search){
+  const query=new URLSearchParams(search);
+  if(!fields.some(key=>query.has(key)))return null;
+  if(fields.some(key=>query.getAll(key).length!==1)||! /^[1-9][0-9]*$/.test(query.get('share_version')??''))throw Error('This program link is invalid.');
+  return shareReference({kind:query.get(fields[0]),studio:query.get(fields[1]),key:query.get(fields[2]),version:Number(query.get(fields[3]))});
+}
+export function clearSharedAdoption(url){
+  const next=new URL(url);for(const field of fields)next.searchParams.delete(field);return next.pathname+next.search+next.hash;
+}
+export function sourceSharePath(source,kind='routine'){
+  try{return sharedProgramPath({kind,studio:source?.creator,key:source?.program,version:Number(source?.version)});}catch{return '';}
+}
+export function shareLink(source,kind='routine'){
+  const path=sourceSharePath(source,kind);
+  return path?`<a class="text-button" data-program-share href="${esc(path)}" target="_blank" rel="noopener">Open ${kind==='plan'?'plan':'program'} link</a>`:'';
+}
+// Only the current public catalogue can offer a new adoption. Existing member
+// copies remain independently usable after an update or withdrawal.
+export function resolveSharedProgram(reference,catalogue){
+  const r=shareReference(reference);
+  if(!catalogue?.available||catalogue.fresh!==true)return {state:'unavailable',reference:r};
+  const rows=r.kind==='plan'?catalogue.plans:catalogue.programs;
+  if(!Array.isArray(rows))throw Error('The published program catalogue is invalid.');
+  const row=rows.find(item=>item.key===r.key);
+  if(!row)return {state:'missing',reference:r};
+  const value=r.kind==='plan'?row.plan:row.routine,source=value?.source;
+  const expected=`studio:${r.studio}:${r.kind==='plan'?'plan:':''}${r.key}:v${row.version}`;
+  if(!Number.isSafeInteger(row.version)||row.version<1||row.version>100||source?.creator!==r.studio||source.program!==r.key||source.version!==String(row.version)||value.id!==expected)throw Error('The published program identity changed.');
+  if(row.version!==r.version)return {state:'replaced',reference:r,current:shareReference({...r,version:row.version})};
+  return {state:'ready',reference:r,release:row,value};
+}
+export function sharedProgramNotice(result){
+  if(!result)return '';
+  const r=result.reference;
+  if(result.state==='ready')return `<section class="panel" data-shared-program><p class="eyebrow">Shared ${r.kind==='plan'?'plan':'program'} · Version ${r.version}</p><h2>${esc(result.value.name)}</h2><p>Review this published version before adding it. Your existing training stays in place.</p></section>`;
+  const message=result.state==='replaced'?'This link names a different published version.':result.state==='missing'?'This program is no longer offered at this address.':'Reconnect to check this published program. Your saved training is still available.';
+  return `<section class="panel" data-shared-program role="status"><h2>Program unavailable</h2><p>${message}</p>${result.current?`<a class="button" href="${esc(sharedProgramPath(result.current))}">Review the current version</a>`:''}</section>`;
+}
diff --git a/components/BonfyreServiceSite/training-share-page.mjs b/components/BonfyreServiceSite/training-share-page.mjs
new file mode 100644
