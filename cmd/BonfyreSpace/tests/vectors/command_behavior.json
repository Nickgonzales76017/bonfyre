 {"argv":["open","job1"],"env":{"HOME":"${tmp}","BONFYRE_SPACE_DB":"${tmp}/s.db"},"exit":0},
 {"argv":["put","job1","k1","hello"],"env":{"HOME":"${tmp}","BONFYRE_SPACE_DB":"${tmp}/s.db"},"exit":0,"contains":["written: job1/k1 (5 bytes)"]},
 {"argv":["get","job1","k1"],"env":{"HOME":"${tmp}","BONFYRE_SPACE_DB":"${tmp}/s.db"},"exit":0,"stdout":"hello\n"},
 {"argv":["get","job1","nope"],"env":{"HOME":"${tmp}","BONFYRE_SPACE_DB":"${tmp}/s.db"},"exit":1,"stdout":""},
 {"argv":["stats","job1"],"env":{"HOME":"${tmp}","BONFYRE_SPACE_DB":"${tmp}/s.db"},"exit":0,"contains":["keys      : 1","size      : 5 bytes"]}]}]}
