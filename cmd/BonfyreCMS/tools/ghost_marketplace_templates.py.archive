#!/usr/bin/env python3
"""Compile the Ghost marketplace census into Bonfÿre presentation-reference JSONL.

This is a presentation conversion, not a theme-code importer. The compiler keeps
Ghost marketplace identity/provenance and records a bounded *reference-candidate*
vector. It does not claim that marketplace metadata or a name-derived vector is a
complete observed page profile.
It never imports Handlebars, Ghost data models, paid assets, CSS or JavaScript.

The checked-in TSV is the current 2026-09-06 marketplace snapshot. A later
snapshot can be substituted without changing the native surface engine.
"""

from __future__ import annotations

import argparse
import csv
import hashlib
import json
import re
import unicodedata
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urljoin, urlparse
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CENSUS = ROOT / "data" / "ghost-marketplace-2026-09-06.tsv"

ACCEPTANCE = (
    "responsive at chip/card/section/page/workspace extents; keyboard reachable; "
    "valid semantic HTML; alt/fallback policy for media; readable empty/refused/failed "
    "states; navigation remains linked; typography, hierarchy, balance, contrast and "
    "negative space remain coherent; template changes presentation only; Authority "
    "still gates every effect at its owner"
)

CANNOT_INFER = (
    "a Ghost marketplace reference -> Ghost code, paid assets, Handlebars, Ghost "
    "ontology or a Ghost backend is installed; visual resemblance -> identical source "
    "implementation; a presentation template -> a semantic owner, a subject, a pack, "
    "an institution, authority, publication state or permission to act"
)

FINGERPRINT_CANNOT_INFER = (
    "a DesignFingerprint -> copied Ghost theme code, CSS, JavaScript, paid asset, "
    "Ghost ontology or an installed Ghost backend; a visual vector -> a semantic "
    "claim, subject identity, source admission, audience entitlement, authority or "
    "permission to act"
)

OBSERVATION_CANNOT_INFER = (
    "a public-page anatomy observation -> copied markup, CSS, JavaScript, image, "
    "Ghost runtime, a selected profile, semantic truth, source admission, audience "
    "entitlement, authority or permission to act"
)

