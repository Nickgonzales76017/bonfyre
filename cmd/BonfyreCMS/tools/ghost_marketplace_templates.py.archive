CATEGORY_FONTSETS = {
    "Blog": ["newsreader", "instrument", "space"],
    "Magazine": ["newsreader", "plex", "space"],
    "News": ["newsreader", "plex"],
    "Newsletter": ["instrument", "newsreader", "plex"],
