    "Docs": ["plex", "space"],
}

VISUAL_BASES = {
    "editorial": dict(ground="#f7f4ec", ink="#171714", display="#0c0c0a", muted="#6f6a61", panel="#fffdf8", hue=18, sat=72, light=46),
    "magazine": dict(ground="#f1eee6", ink="#151515", display="#080808", muted="#69655d", panel="#faf8f2", hue=352, sat=72, light=48),
