{
  "name": "site_fragment_migration",
  "displayName": "Site Fragment Migration",
  "description": "Durable migration ledger for compiled site literals becoming authored site_fragment atoms. It records source identity, exact target coordinate, derivation and projection witnesses, publication and fallback retirement; it does not itself authorize any transition or publication.",
  "attributes": {
    "candidate_key": {"type": "uid", "required": true, "uniqueWithinNamespace": true},
    "source_ref": {"type": "string", "required": true},
    "source_line": {"type": "integer", "required": false},
    "source_column": {"type": "integer", "required": false},
    "source_ordinal": {"type": "integer", "required": false},
    "source_digest": {"type": "string", "required": true},
    "source_artifact_uri": {"type": "string", "required": false},
    "source_class": {"type": "string", "required": true},
    "lexical_class": {"type": "string", "required": false},
    "raw_literal": {"type": "text", "required": false},
    "extracted_text": {"type": "text", "required": true},
    "coordinate": {"type": "string", "required": false},
    "page": {"type": "string", "required": false},
    "slot": {"type": "string", "required": false},
    "audience": {"type": "string", "required": false},
    "kind": {"type": "string", "required": false},
    "stage": {"type": "string", "required": true},
    "compiled_fallback": {"type": "boolean", "required": true},
    "cms_entry_id": {"type": "integer", "required": false},
    "cms_receipt": {"type": "string", "required": false},
    "tensor_cells": {"type": "integer", "required": false},
    "ann_indexed": {"type": "boolean", "required": false},
    "projection_witness": {"type": "string", "required": false},
    "fallback_witness": {"type": "string", "required": false},
    "publication_receipt": {"type": "string", "required": false},
    "public_readback_digest": {"type": "string", "required": false},
    "fallback_retired": {"type": "boolean", "required": false},
    "stale_source": {"type": "boolean", "required": false},
    "last_verified_at": {"type": "datetime", "required": false},
    "notes": {"type": "text", "required": false}
  }
}
