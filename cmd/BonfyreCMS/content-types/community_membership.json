{
  "name": "community_membership",
  "displayName": "Community Membership",
  "description": "The explicit relation between a human subject and a community body. Membership state can shape presentation, but does not itself grant effect authority outside the community owner's rules.",
  "attributes": {
    "membership": {"type": "string", "required": true, "uniqueWithinNamespace": true},
    "community": {"type": "string", "required": true},
    "member_subject": {"type": "string", "required": true},
    "role": {"type": "string", "required": true},
    "state": {"type": "string", "required": true},
    "joined_at": {"type": "string", "required": false},
    "expires_at": {"type": "string", "required": false},
    "authority_ref": {"type": "string", "required": false},
    "provenance": {"type": "text", "required": false},
    "cannot_infer": {"type": "text", "required": true},
    "status": {"type": "string", "required": true}
  }
}
