    "predicate_id": {"type": "string", "required": true},
    "owner": {"type": "string", "required": true},
    "predicate": {"type": "string", "required": true},
    "expected_state": {"type": "string", "required": true},
    "evidence_requirement": {"type": "string", "required": false},
    "authority_requirement": {"type": "string", "required": false},
    "valid_start": {"type": "string", "required": false},
    "valid_end": {"type": "string", "required": false},
    "status": {"type": "string", "required": true}
  }
}
