    "wanted": { "type": "string", "required": true },
    "filled": { "type": "string", "required": true },
    "derived_from": { "type": "string", "required": true },
    "cannot_infer": { "type": "text", "required": true },
    "status": { "type": "string", "required": true }
  }
}
