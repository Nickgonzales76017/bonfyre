      "required": true
    },
    "to_participation_revision": {
      "type": "integer",
      "required": true
    },
    "choice": {
      "type": "string",
      "required": true
    },
    "channel": {
      "type": "string",
      "required": true
    },
    "recorded_at": {
      "type": "string",
      "required": true
    },
