#!/usr/bin/env python3
"""Exercise observed DesignFingerprint extraction without retaining donor bytes."""
from __future__ import annotations

import hashlib
import importlib.util
import json
import sys
from pathlib import Path

TOOL = Path(__file__).resolve().parents[1] / "tools" / "ghost_marketplace_templates.py"
spec = importlib.util.spec_from_file_location("ghost_marketplace_templates", TOOL)
assert spec and spec.loader
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

HTML = b"""<!doctype html><html><head><link rel='stylesheet' href='/style.css'></head>
<body><header><nav><a href='/'>Home</a></nav></header><main><h1>Measured</h1>
<img width='1600' height='900' src='/hero.jpg'><section><article><h2>One</h2></article>
<article><h2>Two</h2></article></section><form><button>Submit</button></form></main></body></html>"""

class FakeResponse:
    def __init__(self, body: bytes, url: str, content_type: str) -> None:
        self.body, self.url = body, url
        self.headers = type("Headers", (), {"get_content_type": lambda self: content_type})()
    def read(self, _limit: int) -> bytes: return self.body
    def geturl(self) -> str: return self.url
    def __enter__(self): return self
    def __exit__(self, *_args): return False

def fake_open(request, timeout: int):
    url = request.full_url
    return FakeResponse(HTML if url.endswith("/") else b"@media (max-width: 40rem){}", url,
                        "text/html" if url.endswith("/") else "text/css")

module.urlopen = fake_open
row = module.observe_public_page("ghost-proof", "https://example.test/")
vector = row["visual_vector"]
assert row["status"] == "observed_reference"
assert vector["html_sha256"] == hashlib.sha256(HTML).hexdigest()
assert vector["masthead"] == {"headers": 1, "navs": 1, "links_in_header": 1}
assert vector["hero"]["h1_before_first_article"] is True
assert vector["media_geometry"]["declared_aspect_ratios"] == {"1.78": 1}
assert vector["typed_slots"] == {"h1": 1, "h2": 2, "h3": 0, "article": 2, "section": 1}
assert "<article" not in json.dumps(row)
assert "authority" in row["cannot_infer"]
print("ghost observation: PASS")
