# Historical witness; public_carrier_collector.test.mjs supersedes it.
import importlib.util
from pathlib import Path
ROOT=Path(__file__).resolve().parents[3];s=importlib.util.spec_from_file_location("g",ROOT/"cmd/BonfyreExternalEstate/tools/collect_github_repository.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
e=m.normalize({"id":42,"full_name":"org/repo","html_url":"https://github.com/org/repo","description":"A project","created_at":"2026-01-01T00:00:00Z"},"source:github","receipt:github","2026-09-28T00:00:00Z")
assert e["kind"]=="github_repository" and e["payload"]["title"]=="org/repo"
try:m.normalize({},"s","r","t")
except m.Refusal:pass
else:raise AssertionError("malformed response admitted")
print("github repository collector: PASS")
