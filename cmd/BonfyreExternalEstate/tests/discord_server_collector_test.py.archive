#!/usr/bin/env python3
# Historical witness; public_carrier_collector.test.mjs supersedes it.
import importlib.util
from pathlib import Path
ROOT=Path(__file__).resolve().parents[3];s=importlib.util.spec_from_file_location("d",ROOT/"cmd/BonfyreExternalEstate/tools/collect_discord_server.py");m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
e=m.normalize({"id":"42","name":"Operators","instant_invite":"https://discord.gg/abc"},"s","r","t");assert e["kind"]=="discord_server"
try:m.normalize({"id":"42","name":"Private"},"s","r","t")
except m.Refusal:pass
else:raise AssertionError("private server admitted")
print("discord server collector: PASS")
