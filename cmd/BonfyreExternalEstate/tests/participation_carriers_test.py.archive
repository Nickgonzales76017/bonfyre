 r=m.compile({"provider":"test","carrier_kind":kind,"source_ref":"source:test","receipt_ref":"receipt:test","observed_at":"2026-09-28T00:00:00Z","payload":{"id":kind,"title":"Test","url":"https://example.test/x"}})
