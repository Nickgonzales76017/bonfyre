#!/usr/bin/env python3
"""Historical Python adapter; collect_public_carrier.mjs owns this path."""
import argparse,hashlib,html,json,os,re,subprocess
from pathlib import Path
class Refusal(ValueError):pass
SCRIPT=re.compile(r'<script[^>]+type=["\']application/ld\+json["\'][^>]*>(.*?)</script>',re.I|re.S)
def event_from_html(body,url):
 for raw in SCRIPT.findall(body):
  try: docs=json.loads(html.unescape(raw.strip()))
  except ValueError:continue
  pool=docs if isinstance(docs,list) else (docs.get("@graph",[]) if isinstance(docs,dict) else [])
  if isinstance(docs,dict):pool=[docs]+pool
  for item in pool:
   types=item.get("@type",[]) if isinstance(item,dict) else []
   if isinstance(types,str):types=[types]
   if isinstance(item,dict) and "Event" in types and item.get("name"):
    return {"id":str(item.get("@id") or item.get("url") or url),"title":item["name"],"url":item.get("url") or url,"description":item.get("description") or "","starts_at":item.get("startDate") or ""}
 raise Refusal("retained page declares no Event JSON-LD")
def main():
 p=argparse.ArgumentParser();p.add_argument("--provider",choices=("meetup","eventbrite"),required=True);p.add_argument("--url",required=True);p.add_argument("--source-ref",required=True);p.add_argument("--project",required=True);p.add_argument("--foreign-root",type=Path,required=True);p.add_argument("--observed-at",required=True);p.add_argument("--out",type=Path,required=True);a=p.parse_args()
 if not a.url.startswith("https://"):print("event collector: public HTTPS event URL required");return 2
 ident=a.provider+"-event-"+hashlib.sha256(a.url.encode()).hexdigest()[:24];(a.foreign_root/"bodies").mkdir(parents=True,exist_ok=True);(a.foreign_root/"receipts").mkdir(parents=True,exist_ok=True);body=str(a.foreign_root/"bodies"/(ident+".body"));receipt=str(a.foreign_root/"receipts"/(ident+".json"))
 run=subprocess.run([a.project,"foreign","observe",ident,a.url,"--observe-right","public","--body",body,"--receipt",receipt],capture_output=True,text=True)
 if run.returncode or not os.path.exists(body):print("event collector: observer did not retain public page");return 2
 try:payload=event_from_html(Path(body).read_text(errors="replace"),a.url)
 except (OSError,ValueError) as e:print("event collector: %s"%e);return 2
 row={"provider":a.provider,"kind":a.provider+"_event","source_ref":a.source_ref,"receipt_ref":"foreign:"+ident,"observed_at":a.observed_at,"payload":payload};a.out.write_text(json.dumps(row,sort_keys=True)+"\n");print(json.dumps({"kind":row["kind"],"receipt_ref":row["receipt_ref"]}));return 0
if __name__=="__main__":raise SystemExit(main())
