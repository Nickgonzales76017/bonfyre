#!/usr/bin/env python3
"""Project a SourceAttention plan into the existing BonfyreAttention store."""
import argparse,json,os,subprocess,sys
import compile_source_frontier as frontier
def atom(v): return isinstance(v,str) and v and all(32<ord(c)<127 and c not in '"\\' for c in v)
def main():
 p=argparse.ArgumentParser();p.add_argument('--plan',required=True);p.add_argument('--attention-bin',required=True);p.add_argument('--db',required=True);p.add_argument('--dry-run',action='store_true');p.add_argument('--limit',type=int,default=0);a=p.parse_args()
 if not os.path.exists(a.attention_bin):p.error('attention binary does not exist')
 rows=[r for r in frontier.load_rows(a.plan) if isinstance(r,dict) and r.get('schema')=='bonfyre.source-attention-plan.v1'];rows=rows[:a.limit] if a.limit else rows;applied=failed=0;commands=[]
 for r in rows:
  watch=str(r.get('watch_id') or '');subject=str(r.get('subject') or '');temp=str(r.get('temperature') or '');signal=str(r.get('reheat_on') or '');e=r.get('evidence') or {};detail='SourceFabric:%s:p%s:i%s:g%s'%(r.get('basis') or '',e.get('candidate_occurrences',0),e.get('affected_closures',0),e.get('open_gaps',0))
  if not atom(watch) or not atom(subject) or temp not in {'hot','warm','cool','cold'} or not atom(detail):failed+=1;continue
  argv=[a.attention_bin,'schedule','--db',a.db,'--watch',watch,'--subject',subject,'--temperature',temp,'--detail',detail]
  if signal:
   if not atom(signal):failed+=1;continue
   argv+=['--reheat-on',signal]
  commands.append({'watch_id':watch,'temperature':temp,'reheat_on':signal})
  if a.dry_run:continue
  done=subprocess.run(argv,capture_output=True,text=True);applied+=done.returncode==0;failed+=done.returncode!=0
 print(json.dumps({'schema':'bonfyre.source-attention-sync.v1','planned':len(rows),'applied':applied,'failed':failed,'dry_run':a.dry_run,'commands':commands if a.dry_run else [],'truth':'internal_attention_projection_only_not_fetch_admission_authority_or_effect','cannot_infer':['attention watch -> permission to observe','hot -> semantic importance or source quality','scheduled watch -> acquisition, payment, contact or external effect']},sort_keys=True));return 0 if failed==0 else 1
if __name__=='__main__':sys.exit(main())
