#!/usr/bin/env python3
"""Lower public-estate passports into AddressPlane candidate advertisements.

A passport (schemas/control/source-passport.cue) says what a public estate can
do for the machine.  This compiler writes one `external_source` advertisement
per passport, so a task asks the forwarding plane for a capability instead of
a source's name:

  bonfyre-external-estate forward --db INDEX --kind external_source \
      --need affordance:identify-recording --forbid admission:refused

Terms carry the passport's roles, access, topology, refresh, reach, evidence,
reuse posture, credential requirement and admission state.  An advertisement
is a candidate for exact verification only: admission of a read is a census
row with a robots preflight and a receipt, and terms are always the source's.

The awesome-public-datasets registry is compiled into candidate passports the
same way (compile_dataset_registry.py); those are never ADMITTED here.

  compile_source_passports.py --out passports.jsonl [--json passports.json]
"""
import argparse, hashlib, json, os, re, subprocess, sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
TOKEN = re.compile(r"[^a-z0-9-]+")


def token(value):
    return TOKEN.sub("-", str(value).lower()).strip("-")[:150]


def passports(path=None):
    if path:
        return json.load(open(path))
    out = subprocess.run(["cue", "export", ".", "-e", "nativeSourcePassports", "--out", "json"],
                         cwd=os.path.join(ROOT, "schemas", "control"), capture_output=True, text=True, check=True)
    return json.loads(out.stdout)


def advertisement(passport, verifier=None, lowerer=None):
    terms = ["source:" + token(passport["passport"]), "admission:" + token(passport["state"])]
    terms += ["affordance:" + token(c) for c in passport["capabilities"]]
    terms += ["source_kind:" + token(r) for r in passport["roles"]]
    terms += ["carrier:" + token(a) for a in passport["access"]]
    terms += ["material:" + token(t) for t in passport["topology"]]
    terms += ["subject_kind:" + token(k) for k in passport.get("subject_kinds", [])]
    terms += ["field:" + token(i) for i in passport.get("identifiers", [])]
    terms += ["refresh:" + token(passport["refresh"]), "temporal:" + token(passport["temporal"]),
              "spatial:" + token(passport["spatial"]), "evidence:" + token(passport["evidence"]),
              "regime:mirror-" + token(passport["mirror"])]
    reuse = passport["reuse"]
    terms += ["reuse:allows-" + token(a) for a in reuse.get("allows", [])]
    terms += ["reuse:unknown-" + token(a) for a in reuse.get("unknown", [])]
    terms += ["requirement:" + token(r) for r in reuse.get("requires", [])]
    if reuse.get("varies_per_item"):
        terms.append("reuse:varies-per-item")
    if passport.get("credential"):
        terms.append("requirement:credential-" + token(passport["credential"]))
        terms.append("authority:credential-" + token(passport["credential"]))
    robots = passport.get("carrier", {}).get("robots", "unobserved")
    terms.append("regime:robots-" + token(robots))
    digest = hashlib.sha256(json.dumps(passport, sort_keys=True).encode()).hexdigest()
    admitted = passport["state"] == "ADMITTED"
    deps = ["SourcePassport:" + passport["passport"]] + ["InternetSource:" + c for c in passport.get("census", [])]
    return {
        "identity": "external_source:passport:" + passport["passport"],
        "candidate_kind": "external_source",
        "owner_ref": "SourcePassport:" + passport["passport"],
        "exact_verifier": verifier or ("ForeignTwin:receipt" if admitted else "SourcePassport:declared"),
        "lowerer_ref": lowerer or ("InternetSource:census" if admitted and passport.get("census") else "SourcePassport:unlowered"),
        "validity_frontier": "sha256:" + digest,
        "terms": sorted(set(t for t in terms if t.split(":", 1)[1])),
        "dependencies": deps,
        "name": passport["name"],
        "cannot_infer": passport["cannot_infer"],
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--json")
    ap.add_argument("--out", required=True)
    args = ap.parse_args()
    rows = [advertisement(p) for p in passports(args.json)]
    with open(args.out, "w") as out:
        for row in rows:
            out.write(json.dumps(row, separators=(",", ":")) + "\n")
    print(json.dumps({"advertisements": len(rows), "admitted": sum(1 for r in rows if "admission:admitted" in r["terms"])}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
