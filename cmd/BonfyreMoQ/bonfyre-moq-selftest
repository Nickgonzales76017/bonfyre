#!/bin/sh
# Starts the native moqt-21 listener, completes a TLS/QUIC handshake with the
# native client, exchanges SETUP on the paired control streams and submits a
# SUBSCRIBE, which the server must refuse because the client holds no
# transport lease. Every field reported below is read from what the two
# processes printed.
# What this does not prove: no media is published or relayed here; this is a
# session and an authorisation refusal, not delivery.
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin="$root_dir/bonfyre-moq"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/bonfyre-moq-selftest.XXXXXX")
pid=''
cleanup() { [ -z "$pid" ] || kill "$pid" 2>/dev/null || true; [ -z "$pid" ] || wait "$pid" 2>/dev/null || true; rm -rf "$tmp"; }
trap cleanup EXIT INT TERM

openssl req -x509 -newkey rsa:2048 -keyout "$tmp/key.pem" -out "$tmp/cert.pem" \
  -days 1 -nodes -subj /CN=127.0.0.1 >/dev/null 2>&1

port=$((20000 + $$ % 20000))
"$bin" moqt-native-server --bind 127.0.0.1 --port "$port" --cert "$tmp/cert.pem" --key "$tmp/key.pem" \
  >"$tmp/server.out" 2>"$tmp/server.err" &
pid=$!
attempt=0
until grep -q 'listening_paired_control_stream_server' "$tmp/server.out" 2>/dev/null; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 100 ] || ! kill -0 "$pid" 2>/dev/null; then
    echo 'native listener did not become ready' >&2; cat "$tmp/server.err" >&2; exit 1
  fi
  sleep 0.05
done
grep -q '"alpn":"moqt-21"' "$tmp/server.out"

if "$bin" moqt-native-subscribe --host 127.0.0.1 --port "$port" --authority "127.0.0.1:$port" --path /live \
  --namespace bonfyre,world --track semantic-delta >"$tmp/client.out" 2>"$tmp/client.err"; then
  echo 'a subscribe without a transport lease was accepted' >&2; exit 1
fi
grep -q '"transport":"native_quic"' "$tmp/client.out"
grep -q '"control_stream":"paired_setup_completed"' "$tmp/client.out"
grep -q '"request_stream":"subscribe_submitted"' "$tmp/client.out"
grep -q 'received paired server SETUP' "$tmp/client.err"
grep -q 'rejected subscribe .*UNAUTHORIZED' "$tmp/server.err"
grep -q 'received REQUEST_ERROR' "$tmp/client.err"

printf '{"ready":true,"port":%s,"alpn":"moqt-21","unauthorized_subscribe_refused":true,"client":%s}\n' \
  "$port" "$(head -1 "$tmp/client.out")"
