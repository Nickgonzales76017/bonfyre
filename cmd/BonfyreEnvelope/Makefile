# Typed operation messages from proto/aurekai/operation.proto, generated by the
# packaged protoc and linked against the packaged protobuf.
CXX ?= c++
PROTO = ../../proto
TARGET = bonfyre-envelope
all: $(TARGET)
build/aurekai/operation.pb.cc: $(PROTO)/aurekai/operation.proto
	@mkdir -p build
	protoc -I$(PROTO) --cpp_out=build $(PROTO)/aurekai/operation.proto
$(TARGET): src/main.cc build/aurekai/operation.pb.cc
	$(CXX) -std=c++17 -O2 -Wall -Wextra -Ibuild $(patsubst -I%,-isystem %,$(shell pkg-config --cflags protobuf simdjson)) src/main.cc build/aurekai/operation.pb.cc $(shell pkg-config --libs protobuf simdjson) -o $@
test: $(TARGET)
	sh tests/envelope_test.sh ./$(TARGET)
clean:
	rm -rf build $(TARGET)
.PHONY: all test clean
