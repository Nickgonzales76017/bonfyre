{"schema":"bonfyre.command-vectors.v1","binary":"bonfyre-gate","binary_env":"BONFYRE_GATE_BIN","cases":[
{"name": "a free key allows its entitlements and denies the rest", "steps": [{"program": "sh", "argv": ["-c", "mkdir -m 700 k && \"$1\" keygen --key-dir k >/dev/null", "sh", "${root}/cmd/BonfyreSign/bonfyre-sign"], "exit": 0}, {"argv": ["issue", "--tier", "free", "--org", "Acme", "--out", "k.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 0, "present": ["${tmp}/k.json"]}, {"program": "cat", "argv": ["k.json"], "at": {"tier": "free", "org": "Acme", "status": "active", "entitlements.allowed_ops": "Ingest,Brief,Proof"}}, {"argv": ["check", "k.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 0, "contains": ["Status:  ACTIVE"]}, {"argv": ["guard", "k.json", "--op", "Brief"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 0}, {"argv": ["guard", "k.json", "--op", "transcribe"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 1}]},
{"name": "an edited key, a key checked with no trusted public key, and a key checked against another institution's key are all refused", "steps": [{"program": "sh", "argv": ["-c", "mkdir -m 700 k && \"$1\" keygen --key-dir k >/dev/null", "sh", "${root}/cmd/BonfyreSign/bonfyre-sign"], "exit": 0}, {"argv": ["issue", "--tier", "free", "--org", "Acme", "--out", "k.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 0}, {"program": "sh", "argv": ["-c", "sed 's/\"allowed_ops\": \"Ingest,Brief,Proof\"/\"allowed_ops\": \"Ingest,Brief,Proof,Transcribe\"/' k.json > t.json && grep -c Transcribe t.json"], "exit": 0, "stdout": "1\n"}, {"argv": ["guard", "t.json", "--op", "Transcribe"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 1, "stderr": "DENIED: signature does not verify under the trusted key\n"}, {"argv": ["check", "t.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 2, "contains": ["Status:  INVALID"]}, {"argv": ["guard", "k.json", "--op", "Ingest"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 1, "stderr": "DENIED: no trusted gate public key (set BONFYRE_GATE_TRUST)\n"}, {"program": "sh", "argv": ["-c", "mkdir -m 700 other && \"$1\" keygen --key-dir other >/dev/null", "sh", "${root}/cmd/BonfyreSign/bonfyre-sign"], "exit": 0}, {"argv": ["guard", "k.json", "--op", "Ingest"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/other/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 1}, {"argv": ["issue", "--tier", "free", "--org", "Acme", "--out", "x.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 2, "absent": ["${tmp}/x.json"]}]},
{"name": "a correctly signed key past its expiry is reported expired and denied", "files": {"body.json": "{\"entitlements\":{\"allowed_ops\":\"Ingest\",\"max_artifacts\":10,\"max_bytes\":1,\"rate_limit_hr\":5},\"expires_at\":\"2020-01-01T00:00:00Z\",\"issued_at\":\"2019-12-01T00:00:00Z\",\"key_id\":\"bfk_old\",\"org\":\"Acme\",\"status\":\"active\",\"tier\":\"free\",\"version\":\"1.0.0\"}"}, "steps": [{"program": "sh", "argv": ["-c", "mkdir -m 700 k && \"$1\" keygen --key-dir k >/dev/null", "sh", "${root}/cmd/BonfyreSign/bonfyre-sign"], "exit": 0}, {"program": "sh", "argv": ["-c", "sig=$(\"$1\" sign --key-dir k --file body.json | sed -n 's/.*\"signature\":\"\\([0-9a-f]*\\)\".*/\\1/p') && printf '%s' \"$(sed 's/}$//' body.json),\\\"signature\\\":\\\"$sig\\\"}\" > k.json", "sh", "${root}/cmd/BonfyreSign/bonfyre-sign"], "exit": 0}, {"argv": ["check", "k.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 2, "contains": ["Status:  EXPIRED"]}, {"argv": ["guard", "k.json", "--op", "Ingest"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign"}, "exit": 1, "stderr": "DENIED: key expired\n"}]}]}
