#!/usr/bin/env python3
"""Every publisher an encyclopedia already knows has a website.

The estate's breadth is bounded by how many publishers it has heard of.  It
lists a few thousand, and the arithmetic is unforgiving: a source yields about
thirty-four items, so a hundred thousand items needs roughly three thousand
sources, and a listed address only becomes a source about one time in five even
when a publisher declares it.  Guessing more conventional addresses at the same
publishers cannot close that gap; more publishers can.

Wikidata already records, for newspapers, magazines, radio and television
stations, museums, libraries, universities, observatories and city governments,
the official website each one states.  This asks for those, and lists each as a
publisher this estate has heard of.  What any of them actually publishes is
decided later, by asking them.

Nothing here is admitted, read as content, or treated as a source: a root is a
host this estate knows exists.  The query is Wikidata's own public endpoint,
asked politely, one class at a time, and every row is attributed to the Wikidata
item it came from.

  expand_publishers_wikidata.py --out roots.jsonl [--per-class 2000] [--classes newspaper,museum]
"""
import argparse, json, re, sys, time, urllib.parse, urllib.request

ENDPOINT = "https://query.wikidata.org/sparql"
AGENT = "BonfyreSourceFrontier/1.0 (estate source census; contact via aurekai.life)"

# What kind of thing tends to publish, and the Wikidata class that names it.
CLASSES = {
    "newspaper": "Q11032",
    "magazine": "Q41298",
    "news-agency": "Q192283",
    "radio-station": "Q14350",
    "television-station": "Q1616075",
    "museum": "Q33506",
    "library": "Q7075",
    "university": "Q3918",
    "botanical-garden": "Q167346",
    "observatory": "Q62832",
    "theatre": "Q24354",
    "orchestra": "Q42998",
    "publisher": "Q2085381",
    "research-institute": "Q31855",
    "national-park": "Q46169",
    "zoo": "Q43501",
    "archive": "Q166118",
    "concert-hall": "Q1060829",
    "art-gallery": "Q1007870",
    "film-festival": "Q220505",
}

QUERY = """
SELECT ?item ?itemLabel ?site WHERE {
  ?item wdt:P31/wdt:P279* wd:%s .
  ?item wdt:P856 ?site .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
LIMIT %d
"""


def ask(sparql, timeout=180):
    url = ENDPOINT + "?" + urllib.parse.urlencode({"query": sparql, "format": "json"})
    request = urllib.request.Request(url, headers={"User-Agent": AGENT, "Accept": "application/sparql-results+json"})
    with urllib.request.urlopen(request, timeout=timeout) as answer:
        return json.loads(answer.read().decode("utf-8"))


def host_of(address):
    try:
        host = urllib.parse.urlparse(address).hostname or ""
    except ValueError:
        return ""
    host = host.lower().strip(".")
    # A host is a host: no ports, no credentials, nothing that is not a name.
    if not host or " " in host or not re.match(r"^[a-z0-9.-]+\.[a-z]{2,}$", host):
        return ""
    return host[4:] if host.startswith("www.") else host


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", required=True)
    ap.add_argument("--per-class", type=int, default=1500)
    ap.add_argument("--classes", default="")
    ap.add_argument("--pause", type=float, default=2.0)
    args = ap.parse_args()

    wanted = [c.strip() for c in args.classes.split(",") if c.strip()] or list(CLASSES)
    seen, rows, refused = set(), [], {}
    for kind in wanted:
        identifier = CLASSES.get(kind)
        if not identifier:
            refused[kind] = "not a class this tool knows"
            continue
        try:
            answer = ask(QUERY % (identifier, args.per_class))
        except Exception as problem:            # the endpoint is someone else's
            refused[kind] = str(problem)[:80]
            time.sleep(args.pause)
            continue
        found = 0
        for row in answer.get("results", {}).get("bindings", []):
            site = (row.get("site") or {}).get("value", "")
            host = host_of(site)
            if not host or host in seen:
                continue
            seen.add(host)
            item = (row.get("item") or {}).get("value", "")
            name = (row.get("itemLabel") or {}).get("value", "") or host
            rows.append({
                "root": host,
                "name": name[:160],
                "identity": item.rsplit("/", 1)[-1] if item else "",
                "discovered_from": "Wikidata records %s as the official website of this %s" % (site, kind),
            })
            found += 1
        sys.stderr.write("%-20s %d publishers\n" % (kind, found))
        time.sleep(args.pause)

    with open(args.out, "w") as out:
        for row in rows:
            out.write(json.dumps(row) + "\n")
    print(json.dumps({
        "publishers": len(rows), "classes_asked": len(wanted), "classes_refused": refused,
        "cannot_infer": "a publisher listed here is a host an encyclopedia records as someone's official "
                        "website; it is not a channel, not a source this estate reads, and nothing here "
                        "says the host answers or publishes a feed",
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
