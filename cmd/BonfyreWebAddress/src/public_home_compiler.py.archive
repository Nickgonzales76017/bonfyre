# Public-home projection over the existing external-estate runtime.
# The canonical territory compiler still owns the page. This pass discovers
# source-derived candidates and hands one selected public URL to /_surface/intake.
# It never probes, admits evidence, chooses a provider, spends, or effects.
from pathlib import Path
import runpy

ROOT = Path(__file__).resolve().parents[3]
CANONICAL_COMPILER = ROOT / "site/matrix/surfaces/build/mk_home.py"
HOME = ROOT / "site/matrix/surfaces/home.html"

CSS = r'''.try{padding:76px 0 18px}.try-head{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:end;margin-bottom:22px}.try h2{font-size:clamp(2.4rem,6vw,5.7rem);line-height:.84;letter-spacing:-.075em;margin:10px 0 0}.try-intro{color:var(--muted);line-height:1.5;max-width:48ch;margin:0}.estate-form{display:flex;border:1px solid var(--line);background:var(--panel);padding:6px}.estate-form input{min-width:0;flex:1;border:0;background:transparent;color:var(--ink);font:500 .95rem var(--mono);padding:.8rem}.estate-form input:focus{outline:2px solid var(--accent);outline-offset:-2px}.estate-form button,.candidate button{border:0;background:var(--ink);color:var(--paper);font:500 .68rem var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:.7rem 1rem;cursor:pointer}.estate-form button:hover,.candidate button:hover{background:var(--signal)}.try-presets{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 0}.try-preset{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:999px;padding:.48rem .72rem;font:500 .66rem var(--mono);cursor:pointer;text-decoration:none;display:inline-block}.try-preset:hover{border-color:var(--ink);color:var(--ink)}.estate-status{min-height:1.4em;color:var(--muted);font:400 .7rem var(--mono);margin:14px 0}.candidate-grid:not(:empty){display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.candidate-grid .surface-title,.candidate-grid .surface-caption{grid-column:1/-1;background:var(--panel);margin:0;padding:14px 20px 0}.candidate-grid .surface-caption{padding:6px 20px 14px;color:var(--muted);font-size:.78rem}.candidate-grid .surface-record{background:var(--panel);padding:20px;margin:0;display:flex;flex-direction:column;gap:2px}.candidate-grid .surface-record dt{font:500 .58rem var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--signal);margin-top:8px}.candidate-grid .surface-record dt:first-of-type{margin-top:0}.candidate-grid .surface-record dd{margin:0;font-size:.82rem;line-height:1.4;overflow-wrap:anywhere}.candidate-grid .surface-denied,.candidate-grid .surface-withheld{grid-column:1/-1;background:var(--panel);padding:16px 20px;margin:0;color:var(--muted);font:.78rem var(--mono)}.candidate{background:var(--panel);padding:20px;min-height:225px;display:flex;flex-direction:column}.candidate .kind{font:500 .62rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--signal)}.candidate h3{font-size:1.28rem;letter-spacing:-.04em;line-height:1.05;margin:22px 0 10px}.candidate .meta{font:.66rem/1.5 var(--mono);color:var(--muted)}.candidate .actions{display:flex;gap:12px;align-items:center;margin-top:auto;padding-top:22px}.candidate .actions a{font:500 .67rem var(--mono);border-bottom:1px solid var(--line);padding-bottom:2px}.estate-route{margin-top:14px}.estate-route:not(:empty){border:1px solid var(--line);background:var(--panel);padding:14px}.estate-route p{margin:0 0 9px;color:var(--muted);font-size:.8rem}.estate-route form{margin:0}.estate-route button{border:0;background:var(--accent);color:var(--ink);padding:.6rem .8rem;font:500 .68rem var(--mono);cursor:pointer}.estate-session,.estate-law{font:.68rem/1.45 var(--mono);color:var(--muted)}.estate-session{margin:10px 0 0}.estate-law{border-top:1px solid var(--line);padding-top:12px;margin-top:18px}@media(max-width:760px){.try-head{grid-template-columns:1fr}.candidate-grid{grid-template-columns:1fr}.estate-form{display:block}.estate-form button{width:100%;margin-top:6px}}'''
MARKUP = r'''<section class="wrap try" id="estate-try"><div class="try-head"><div><p class="eyebrow"><i></i>02 / ask the outside</p><h2 id="estate-title">Find a route. Then inspect it.</h2></div><div><p class="try-intro" id="estate-intro">Describe a domain or thing you need. Aurekai searches its compiled public candidate estate and gives you real outside routes without pretending that a listing is evidence, authority, or a provider.</p><p class="estate-session" id="estate-session">Public search. No account required.</p></div></div><form class="estate-form" action="/_surface/external-estate" method="get" hx-get="/_surface/external-estate" hx-target="#estate-results" hx-swap="innerHTML" hx-indicator="#estate-status"><input type="hidden" name="limit" value="9"><input name="q" type="search" autocomplete="off" placeholder="A domain, source, capability, place, or need" aria-label="Search public candidate routes" required><button type="submit">Find real routes &rarr;</button></form><div class="try-presets" aria-label="Ways into the candidate estate"><a class="try-preset" href="/_surface/external-estate?functions=~Registries&amp;limit=9" hx-get="/_surface/external-estate?functions=~Registries&amp;limit=9" hx-target="#estate-results" hx-swap="innerHTML">registries &amp; discovery</a><a class="try-preset" href="/_surface/external-estate?functions=~x402&amp;limit=9" hx-get="/_surface/external-estate?functions=~x402&amp;limit=9" hx-target="#estate-results" hx-swap="innerHTML">machine commerce</a><a class="try-preset" href="/_surface/external-estate?functions=~Government&amp;limit=9" hx-get="/_surface/external-estate?functions=~Government&amp;limit=9" hx-target="#estate-results" hx-swap="innerHTML">government &amp; public records</a><a class="try-preset" href="/_surface/external-estate?functions=~Agents&amp;limit=9" hx-get="/_surface/external-estate?functions=~Agents&amp;limit=9" hx-target="#estate-results" hx-swap="innerHTML">agents &amp; tools</a><a class="try-preset" href="/_surface/external-estate?functions=~Science&amp;limit=9" hx-get="/_surface/external-estate?functions=~Science&amp;limit=9" hx-target="#estate-results" hx-swap="innerHTML">science &amp; research</a></div><p class="estate-status" id="estate-status" aria-live="polite">Choose a way in, or search in your own terms. The same address answers a machine with JSON.</p><div class="candidate-grid" id="estate-results"></div><p class="estate-law">Candidate source &ne; evidence &middot; listing &ne; provider readiness &middot; payment affordance &ne; spend authority &middot; preparing a route &ne; performing an effect.</p></section>'''
JS = r'''(()=>{const root=document.getElementById('estate-try');if(!root)return;const h=location.hostname.toLowerCase(),k=h.includes('.life')?'life':h.includes('.live')?'live':h.includes('.shop')?'shop':'work';const copy={life:['Find what can help your life.','Search real public routes before deciding what deserves a place in your private world.'],live:['Find the signals behind the moment.','Search real public routes for what is moving now, then decide what deserves to become durable.'],shop:['Find a real route before you buy.','Search offers, markets, services, and machine-capable sources without confusing availability with a completed exchange.'],work:['Find a source or capability for the job.','Search the outside world for a route into the work, then let evidence and authority decide what can actually proceed.']}[k];document.getElementById('estate-title').textContent=copy[0];document.getElementById('estate-intro').textContent=copy[1];fetch('/account',{headers:{Accept:'application/json'},credentials:'same-origin'}).then(r=>r.ok?r.json():null).then(d=>{if(d&&d.valid){const who=d.name||d.email||'this account';document.getElementById('estate-session').textContent='Signed in as '+who+'. Search stays public; a prepared route can continue only into working context this session is actually admitted to.'}}).catch(()=>{})})();'''

# This is deliberately a browser lowerer, not an external-estate owner. It
# asks the candidate-slice endpoint, renders only its declared candidate shape,
# and hands a chosen supplied URL back to the native intake owner. It neither
# accepts nor invents actor/audience/role/authority coordinates.
ESTATE_RUNTIME_JS = r'''(async()=>{
const root=document.getElementById('estate-try');if(!root)return;
const form=root.querySelector('.estate-form'),out=document.getElementById('estate-results'),status=document.getElementById('estate-status');
const endpoint='/external-estate/v1/surfaces/discover',recordPath='/external-estate/v1/occurrences/',worldPath='/external-estate/v1/worlds/';
const worlds=['household-daily-life','touring-musician','independent-retailer','research-laboratory'];
let cells=[],presentationClass='anonymous';try{const [catalogue,closure]=await Promise.all([fetch('/external-estate/v1/presentation-cells',{headers:{Accept:'application/json'},credentials:'same-origin'}),fetch('/_surface/presentation-class?grammar=discover',{headers:{Accept:'application/json'},credentials:'same-origin'})]);if(catalogue.ok){const data=await catalogue.json();cells=data.cells||[]}if(closure.ok){const resolved=await closure.json();if(resolved&&['anonymous','personal','member_worker','operator'].includes(resolved.presentation_class))presentationClass=resolved.presentation_class}}catch(_){}
const say=t=>status.textContent=t;
const text=(node,value)=>node.textContent=String(value||'');
const tag=(label)=>{const s=document.createElement('span');s.className='kind';text(s,label);return s};
function render(slice){out.replaceChildren();const cell=cells.find(c=>c.grammar==='discover'&&c.presentation_class===presentationClass)||slice.presentation_cell;const title=document.createElement('p');title.className='surface-title';text(title,(cell&&cell.question?cell.question+' ':'')+(slice.candidate_count||0)+' matching public candidate sources');out.append(title);
const note=document.createElement('p');note.className='surface-caption';text(note,'Candidate source ≠ evidence. '+(cell&&cell.experience_character?cell.experience_character+'. ':'')+'This is material for an owner to inspect, not a provider claim, permission, payment, settlement, or action.');out.append(note);
for(const record of (slice.candidates||[])){const article=document.createElement('article');article.className='candidate';article.append(tag('candidate / '+(record.source_kind||'unknown')));const h=document.createElement('h3');text(h,record.observed_name||record.source_ref);article.append(h);const meta=document.createElement('p');meta.className='meta';text(meta,[record.source_ref,record.section].filter(Boolean).join(' · '));article.append(meta);const actions=document.createElement('div');actions.className='actions';
const inspect=document.createElement('a');inspect.href=recordPath+encodeURIComponent(record.id);text(inspect,'Machine record');actions.append(inspect);
const supplied=document.createElement('a');supplied.href='/_surface/intake?url='+encodeURIComponent(record.primary_url||'');text(supplied,'Prepare owner route');actions.append(supplied);
const world=(record.projection&&record.projection.candidate_worlds||[])[0];if(world){const lens=document.createElement('a');lens.href=worldPath+encodeURIComponent(world);text(lens,'World lens');actions.append(lens)}article.append(actions);out.append(article)}
if(!(slice.candidates||[]).length){const empty=document.createElement('p');empty.className='surface-withheld';text(empty,'No candidate source occurrence matches this requested shape.');out.append(empty)}
}
async function search(query){const p=new URLSearchParams(query);p.set('limit','9');say('Reading declared public candidate material…');try{const r=await fetch(endpoint+'?'+p,{headers:{Accept:'application/json'},credentials:'same-origin'});if(!r.ok)throw new Error(String(r.status));const slice=await r.json();render(slice);say((slice.candidate_count||0)+' candidate sources returned. No source body was fetched.')}catch(error){try{const f=await fetch('/_surface/external-estate?'+p,{headers:{Accept:'text/html'},credentials:'same-origin'});if(!f.ok)throw error;const markup=await f.text();out.innerHTML=markup;const shown=(markup.match(/surface-record/g)||[]).length;say(shown?shown+' candidate sources, answered by the surface. No source body was fetched.':'No candidate source matches that. Nothing was invented.')}catch(_){out.replaceChildren();say('Candidate route unavailable ('+(error.message||'no response')+'). No result was invented.')}}}
form.removeAttribute('hx-get');form.addEventListener('submit',event=>{event.preventDefault();const q=String(new FormData(form).get('q')||'').trim();if(q)search({q})});
const rail=document.createElement('div');rail.className='try-presets';rail.setAttribute('aria-label','Cross-domain World lenses');for(const world of worlds){const a=document.createElement('a');a.className='try-preset';a.href='?world='+encodeURIComponent(world);text(a,world.replaceAll('-',' '));a.addEventListener('click',e=>{e.preventDefault();search({world})});rail.append(a)}root.querySelector('.try-presets').after(rail);
root.querySelectorAll('.try-preset').forEach(a=>{a.removeAttribute('hx-get');a.addEventListener('click',e=>{if(a.parentElement===rail)return;e.preventDefault();const u=new URL(a.href,location.href),q=(u.searchParams.get('functions')||'').replace(/^~/,'');if(q)search({q})})});
})();'''

def compile_home() -> None:
    runpy.run_path(str(CANONICAL_COMPILER), run_name="__main__")
    html = HOME.read_text(encoding="utf-8")
    # The former projection appended a second client application here: bespoke
    # CSS, browser state, source search and card markup.  It is intentionally
    # retired while SurfaceIR is lowered natively from declared contracts.
    # Keep this forwarding wrapper only until that native compiler replaces the
    # canonical generator; it must never reintroduce a browser-owned estate.
    if "/external-estate/" in html or 'id="estate-try"' in html:
        raise SystemExit("public-home compiler refused a client-owned external-estate projection")
    print(f"retained canonical public home at {HOME} ({len(html)} bytes)")

if __name__ == "__main__":
    compile_home()
