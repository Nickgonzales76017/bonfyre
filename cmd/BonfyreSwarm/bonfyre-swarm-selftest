#!/bin/sh
# Seeds a real file (this organ's own binary), then has two native peers each
# fetch its first block over the wire and compares what arrived with the file.
# A separate status call then reads the seeder's index for both peers and the
# bytes it uploaded.
# What this does not prove: both peers and the seeder are on this machine's
# loopback, so nothing here crosses a network or finds a peer it was not told.
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin="$root_dir/bonfyre-swarm"
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/bonfyre-swarm-selftest.XXXXXX")
seed_dir="$run_dir/seed"
mkdir -p "$seed_dir"
cp "$bin" "$seed_dir/payload.bin"
db="$run_dir/swarm.db"
log="$run_dir/server.log"
length=4096

port=$((20000 + $$ % 20000))
while nc -z 127.0.0.1 "$port" 2>/dev/null; do port=$((port + 1)); done

"$bin" seed "$seed_dir" --port "$port" --index "$db" </dev/null >"$log" 2>&1 &
server_pid=$!
cleanup() { kill "$server_pid" 2>/dev/null || true; wait "$server_pid" 2>/dev/null || true; rm -rf "$run_dir"; }
trap cleanup EXIT INT TERM

n=0
until nc -z 127.0.0.1 "$port" 2>/dev/null; do
    n=$((n + 1))
    if [ "$n" -ge 100 ] || ! kill -0 "$server_pid" 2>/dev/null; then
        echo "seeder did not become ready" >&2; cat "$log" >&2; exit 1
    fi
    sleep 0.05
done

head -c "$length" "$seed_dir/payload.bin" > "$run_dir/expected.bin"
matched() {
    "$bin" fetch --port "$port" --length "$length" --out "$run_dir/$1.bin" --peer "$1" >/dev/null &&
        cmp -s "$run_dir/expected.bin" "$run_dir/$1.bin" && echo true || echo false
}
one=$(matched worker000001)
two=$(matched worker000002)
sleep 0.3
status=$("$bin" status --index "$db")

printf '{"ready":true,"worker1_piece_matched":%s,"worker2_piece_matched":%s,"status":%s}\n' "$one" "$two" "$status"
[ "$one" = true ] && [ "$two" = true ]
