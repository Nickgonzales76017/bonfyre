{"schema":"bonfyre.command-vectors.v1","binary":"bonfyre-pipeline","binary_env":"BONFYRE_PIPELINE_BIN","cases":[
{"name": "a table runs gate, ingest, meter, stitch, ledger and compress into one output directory", "files": {"t.csv": "name,qty\nwidget,3\n"}, "steps": [{"argv": ["run", "t.csv", "--out", "po"], "env": {"HOME": "${tmp}"}, "exit": 0, "present": ["${tmp}/po/normalized.txt", "${tmp}/po/stitch-manifest.json", "${tmp}/po/ledger.jsonl", "${tmp}/po/compressed.zst", "${tmp}/po/meter.db"]}]},
{"name": "a missing input is refused", "steps": [{"argv": ["run", "missing.csv", "--out", "po"], "env": {"HOME": "${tmp}"}, "exit_nonzero": true}]},
{"name": "a signed licence key passes the gate, an edited one stops the run before ingest, and usage is recorded without an invented price", "files": {"t.csv": "name,qty\nwidget,3\n"}, "steps": [{"program": "sh", "argv": ["-c", "mkdir -m 700 k && \"$1\" keygen --key-dir k >/dev/null && \"$2\" issue --tier free --org Acme --out key.json >/dev/null 2>&1 && sed 's/\"allowed_ops\": \"Ingest,Brief,Proof\"/\"allowed_ops\": \"*\"/' key.json > edited.json", "sh", "${root}/cmd/BonfyreSign/bonfyre-sign", "${root}/cmd/BonfyreGate/bonfyre-gate"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_BIN": "${root}/cmd/BonfyreGate/bonfyre-gate", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public"}, "exit": 0}, {"argv": ["run", "t.csv", "--out", "ok", "--key-file", "key.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_BIN": "${root}/cmd/BonfyreGate/bonfyre-gate", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public"}, "exit": 0, "present": ["${tmp}/ok/meter.db"]}, {"program": "sqlite3", "argv": ["ok/meter.db", "select op||'|'||quote(cost) from events"], "exit": 0, "stdout": "Ingest|NULL\n"}, {"argv": ["run", "t.csv", "--out", "bad", "--key-file", "edited.json"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_BIN": "${root}/cmd/BonfyreGate/bonfyre-gate", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public"}, "exit_nonzero": true, "absent": ["${tmp}/bad/normalized.txt"]}, {"argv": ["run", "t.csv", "--out", "nokey"], "env": {"HOME": "${tmp}", "BONFYRE_GATE_BIN": "${root}/cmd/BonfyreGate/bonfyre-gate", "BONFYRE_SIGN_BIN": "${root}/cmd/BonfyreSign/bonfyre-sign", "BONFYRE_GATE_KEY_DIR": "${tmp}/k", "BONFYRE_GATE_TRUST": "${tmp}/k/institution.ed25519.public"}, "exit": 0, "present": ["${tmp}/nokey/normalized.txt"]}]}]}
