{
 "schema": "bonfyre.command-vectors.v1",
 "binary": "bonfyre-experience-map",
 "binary_env": "BONFYRE_EXPERIENCE_TEST_BINARY",
 "replaces": [
  "tests/policy_compilation.test.mjs"
 ],
 "cases": [
  {
   "name": "activation-law runtime policy is exactly compiled from CUE",
   "steps": [
    {
     "program": "cue",
     "argv": [
      "export",
      "${organ}/tools/activation-law.cue",
      "-e",
      "activationLaw",
      "--out",
      "json"
     ],
     "exit": 0,
     "stdout_file": "${organ}/tools/activation-law.generated.json"
    }
   ]
  },
