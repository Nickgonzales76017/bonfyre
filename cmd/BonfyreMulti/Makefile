bonfyre-multi-3: $(OBJS_3)
	$(CC) $(CFLAGS) -Wl,-dead_strip -o bonfyre-multi-3 $(OBJS_3) $(LDFLAGS) $(MEGA_LDFLAGS_3)

# Install: one real file per bucket, hard links for every organ name it
# hosts so installed_bonfyre_bytes (which de-dupes by inode) counts each
# bucket once.
install-bin: $(TARGETS)
	@mkdir -p $(HOME)/.bonfyre/bin
	@strip -x -S bonfyre-multi-1 -o build/bonfyre-multi-1.stripped
	@codesign --force --sign - build/bonfyre-multi-1.stripped >/dev/null 2>&1 || true
	@cp build/bonfyre-multi-1.stripped $(HOME)/.bonfyre/bin/bonfyre-multi-1
	@for n in $(ORGAN_NAMES_1); do \
		rm -f $(HOME)/.bonfyre/bin/$$n; \
		ln $(HOME)/.bonfyre/bin/bonfyre-multi-1 $(HOME)/.bonfyre/bin/$$n; \
	done
	@strip -x -S bonfyre-multi-2 -o build/bonfyre-multi-2.stripped
	@codesign --force --sign - build/bonfyre-multi-2.stripped >/dev/null 2>&1 || true
	@cp build/bonfyre-multi-2.stripped $(HOME)/.bonfyre/bin/bonfyre-multi-2
	@for n in $(ORGAN_NAMES_2); do \
		rm -f $(HOME)/.bonfyre/bin/$$n; \
		ln $(HOME)/.bonfyre/bin/bonfyre-multi-2 $(HOME)/.bonfyre/bin/$$n; \
	done
	@strip -x -S bonfyre-multi-3 -o build/bonfyre-multi-3.stripped
	@codesign --force --sign - build/bonfyre-multi-3.stripped >/dev/null 2>&1 || true
	@cp build/bonfyre-multi-3.stripped $(HOME)/.bonfyre/bin/bonfyre-multi-3
	@for n in $(ORGAN_NAMES_3); do \
		rm -f $(HOME)/.bonfyre/bin/$$n; \
		ln $(HOME)/.bonfyre/bin/bonfyre-multi-3 $(HOME)/.bonfyre/bin/$$n; \
	done

clean:
	rm -rf build $(TARGETS)

.PHONY: all clean install-bin
