CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -std=c11 -ffunction-sections -fdata-sections
LDFLAGS = ../../lib/libbonfyre/libbonfyre.a -lsqlite3 -lm
LIB = ../../lib/libbonfyre/libbonfyre.a
INC = -I../../lib/libbonfyre/include
LEXINC = -I../../cmd/BonfyreLex/src

# Bucketed busybox binaries: organs are bin-packed across K=3 targets
# (bonfyre-multi-1..3) so no single installed file grows unbounded, while
# organs within the same bucket still share one physical file via hard
# links (installed_bonfyre_bytes counts each real file once).
# Generated by /tmp/generate_mega_multi_buckets.py; provenance in
# /tmp/multi_fold_results.json. BonfyreWebAddress is NOT included here:
# it stays its own standalone binary (cmd/BonfyreWebAddress/Makefile).

TARGETS = bonfyre-multi-1 bonfyre-multi-2 bonfyre-multi-3

all: $(TARGETS)

build/stitch_organ.o: ../BonfyreStitch/src/main.c $(LIB)
	@mkdir -p build
	$(CC) $(CFLAGS) $(INC) $(LEXINC) -Dmain=bf_stitch_entry -c ../BonfyreStitch/src/main.c -o $@

