#!/usr/bin/env python3
# Archived after Bun credential-descriptor discovery cutover.
"""Find out what the estate's sources ask for, before anyone has to.

Candidate hosts come from the same public estate Bonfÿre already owns:
published CMS sources plus SourceFrontier roots (which already absorb public
commons passports and the other source inventories).  The places services
publish a machine-readable description of their API are asked for through the
ForeignTwin observer, so robots rules and receipts govern every request:

  /.well-known/api-catalog   (RFC 9727: a linkset whose service-desc links name API descriptions)
  /.well-known/openapi.json, /openapi.json, /swagger.json, /api/openapi.json, /v3/api-docs

A JSON OpenAPI or Swagger document is retained as descriptor evidence.  Genuine
authentication schemes are imported into the credential boundary; x402
payment-carrier schemes remain economic requirements in the retained descriptor
and are not stored as credentials.  A host that answers nothing is simply not
listed.  Evidence of every request is written.

Selection modes:
  legacy clock slice:
      discover_credential_needs.py ... [--hosts-per-run 40]

  exact leased work:
      discover_credential_needs.py ... --host-file FILE

  read-only candidate projection for WorkGraph:
      discover_credential_needs.py --cms CMS.db [--frontier-db FRONTIER.db] --list-hosts

The exact-host mode performs no host scheduling of its own.  WorkGraph chooses
the hosts; this operator only observes and imports what those hosts declare.
"""
import argparse, hashlib, json, os, re, sqlite3, subprocess, sys, time, urllib.parse

PATHS = ["/.well-known/api-catalog", "/.well-known/openapi.json", "/openapi.json", "/swagger.json", "/api/openapi.json", "/v3/api-docs"]
DESCRIPTOR_PROTOCOLS = {"openapi", "swagger", "api_catalog", "rfc9727"}
RELATED_MACHINE_PROTOCOLS = {"mcp", "a2a", "x402", "graphql", "jsonrpc", "webhook", "ogc", "beckn", "oauth"}


def normalize_host(value):
    value = (value or "").strip()
    if not value:
        return ""
    if "://" in value:
        value = urllib.parse.urlparse(value).netloc
    else:
        value = value.split("/", 1)[0]
    return value.strip().lower()


def candidate_hosts(cms, frontier_db=None):
    """Return {host: priority} without observing the network.

    This score is deliberately *operator-specific*.  connection-describe probes
    RFC 9727/OpenAPI/Swagger descriptions, so an API-shaped source candidate is
    not automatically descriptor evidence.  In particular, WordPress-derived
    ``json_api`` candidates remain useful SourceFrontier facts but do not get an
    OpenAPI discovery bonus merely because their protocol name contains ``api``.

    Evidence tiers:
      5100  host is already published by the CMS
       100  every SourceFrontier root
     +12000 observed descriptor-native protocol (OpenAPI/Swagger/RFC9727)
      +6000 protocol-derived descriptor-native candidate with no refusal
      +7000 observed adjacent machine protocol (MCP/A2A/x402/etc.)
       +750 derived adjacent machine protocol with no refusal
      +8000 observed credential involvement with no refusal
      +1500 derived credential involvement with no refusal

    Robots/policy refusals never contribute a machine/credential bonus.  Other
    refused candidates remain in SourceFrontier but do not outrank evidence the
    connection-describe operator can actually consume.
    """
    priorities = {}
    if cms and os.path.exists(cms):
        con = sqlite3.connect("file:%s?mode=ro" % cms, uri=True)
        try:
            rows = con.execute("SELECT url FROM internet_source WHERE status='published' AND url LIKE 'http%'")
            for (url,) in rows:
                host = normalize_host(url)
                if host:
                    priorities[host] = max(priorities.get(host, 0), 5100)
        finally:
            con.close()

    if frontier_db and os.path.exists(frontier_db):
        con = sqlite3.connect("file:%s?mode=ro" % frontier_db, uri=True)
        con.row_factory = sqlite3.Row
        try:
            roots = con.execute("SELECT root_id, host FROM root WHERE COALESCE(host,'') <> ''")
            root_hosts = {}
            for row in roots:
                host = normalize_host(row["host"])
                if not host:
                    continue
                root_hosts[row["root_id"]] = host
                priorities[host] = max(priorities.get(host, 0), 100)

            bonuses = {}
            rows = con.execute("""
                SELECT root_id, LOWER(COALESCE(protocol,'')) AS protocol,
                       LOWER(COALESCE(truth_level,'')) AS truth_level,
                       LOWER(COALESCE(state,'')) AS state,
                       LOWER(COALESCE(refusal,'')) AS refusal,
                       COALESCE(credential,'') AS credential
                  FROM channel
                 WHERE root_id IS NOT NULL
            """)
            for row in rows:
                host = root_hosts.get(row["root_id"])
                if not host:
                    continue
                protocol = (row["protocol"] or "").strip()
                truth = (row["truth_level"] or "").strip()
                refusal = (row["refusal"] or "").strip()
                credential = (row["credential"] or "").strip()

                observed = truth.startswith("observed") or truth.startswith("admitted")
                derived = "derived" in truth or truth.endswith("candidate")
                policy_blocked = "robots" in refusal or "policy" in refusal
                usable = not refusal

                machine_bonus = 0
                if not policy_blocked:
                    if protocol in DESCRIPTOR_PROTOCOLS:
                        if observed and usable:
                            machine_bonus = 12000
                        elif derived and usable:
                            machine_bonus = 6000
                    elif protocol in RELATED_MACHINE_PROTOCOLS:
                        if observed and usable:
                            machine_bonus = 7000
                        elif derived and usable:
                            machine_bonus = 750

                credential_bonus = 0
                if credential and not policy_blocked and usable:
                    credential_bonus = 8000 if observed else 1500

                current_machine, current_credential = bonuses.get(host, (0, 0))
                bonuses[host] = (max(current_machine, machine_bonus),
                                 max(current_credential, credential_bonus))

            for host, (machine_bonus, credential_bonus) in bonuses.items():
                priorities[host] = priorities.get(host, 100) + machine_bonus + credential_bonus
        except sqlite3.OperationalError:
            # Older/frontier-minimal installs still retain the CMS candidate set.
            pass
        finally:
            con.close()
    return priorities


def observe(project, foreign, twin, url):
    receipts, bodies = os.path.join(foreign, "receipts"), os.path.join(foreign, "bodies")
    os.makedirs(receipts, exist_ok=True); os.makedirs(bodies, exist_ok=True)
    receipt, body = os.path.join(receipts, twin + ".json"), os.path.join(bodies, twin + ".body")
    subprocess.run([project, "foreign", "observe", twin, url, "--receipt", receipt, "--body", body, "--observe-right", "public"], capture_output=True, timeout=90)
    last = {}
    if os.path.exists(receipt):
        lines = [l for l in open(receipt).read().splitlines() if l.startswith("{")]
        last = json.loads(lines[-1]) if lines else {}
    text = open(body, "rb").read(4_000_000).decode("utf-8", "replace") if os.path.exists(body) and 200 <= int(last.get("http_status") or 0) < 300 else ""
    return last, text


def described(text):
    try:
        doc = json.loads(text)
    except ValueError:
        return None
    if not isinstance(doc, dict) or not (doc.get("openapi") or doc.get("swagger")):
        return None
    schemes = (doc.get("components") or {}).get("securitySchemes") or doc.get("securityDefinitions")
    return doc if schemes else None


PAYMENT_HEADERS = {"payment-signature", "x-payment", "x-payment-response", "payment-required", "x402-payment"}


def payment_scheme(name, scheme):
    key = (name or "").lower()
    header = str((scheme or {}).get("name") or "").lower()
    # x402 payment presentation is economic. L402 Authorization is deliberately
    # retained as credential material because the Authorization value is what
    # the credential boundary applies on subsequent requests.
    return "x402" in key or header in PAYMENT_HEADERS


def security_summary(doc):
    schemes = (doc.get("components") or {}).get("securitySchemes") or doc.get("securityDefinitions") or {}
    credential, economic = [], []
    for name, scheme in schemes.items():
        if not isinstance(scheme, dict):
            continue
        (economic if payment_scheme(name, scheme) else credential).append(name)
    return {"credential_schemes": sorted(credential), "economic_schemes": sorted(economic)}


def payment_protocols(doc):
    """Carrier evidence only; never authority, settlement, or spend approval.

    Some payment protocols surface through OpenAPI securitySchemes. x402
    payment presentation is excluded from Credentials by payment_scheme().
    MPP/L402 Authorization may still be credential application material, but
    their scheme names are also protocol evidence and therefore remain visible
    to DemandBook. One fact may legitimately participate in both boundaries.
    """
    schemes = (doc.get("components") or {}).get("securitySchemes") or doc.get("securityDefinitions") or {}
    carriers = set()
    for name, scheme in schemes.items():
        if not isinstance(scheme, dict):
            continue
        key = str(name or "").lower()
        header = str(scheme.get("name") or "").lower()
        if "x402" in key or header in PAYMENT_HEADERS:
            carriers.add("x402")
        if "mpp" in key:
            carriers.add("mpp")
        if "l402" in key:
            carriers.add("l402")
    return sorted(carriers)


def read_exact_hosts(path):
    out, seen = [], set()
    for raw in open(path, encoding="utf-8"):
        host = normalize_host(raw.split("\t", 1)[0])
        if host and host not in seen:
            seen.add(host); out.append(host)
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project")
    ap.add_argument("--credentials")
    ap.add_argument("--db")
    ap.add_argument("--cms", required=True)
    ap.add_argument("--frontier-db")
    ap.add_argument("--foreign")
    ap.add_argument("--evidence")
    ap.add_argument("--hosts-per-run", type=int, default=40)
    ap.add_argument("--host-file", help="exact hosts leased by WorkGraph; disables local time slicing")
    ap.add_argument("--list-hosts", action="store_true", help="print host<TAB>priority and make no network requests")
    args = ap.parse_args()

    priorities = candidate_hosts(args.cms, args.frontier_db)
    if args.list_hosts:
        for host, priority in sorted(priorities.items(), key=lambda row: (-row[1], row[0])):
            print("%s\t%d" % (host, priority))
        return 0

    for required, value in (("--project", args.project), ("--credentials", args.credentials), ("--db", args.db),
                            ("--foreign", args.foreign), ("--evidence", args.evidence)):
        if not value:
            ap.error("%s is required unless --list-hosts is used" % required)

    hosts = sorted(priorities)
    if args.host_file:
        todays = read_exact_hosts(args.host_file)
        selection = "workgraph"
    else:
        # Legacy compatibility only. StandingAutomation uses exact leased hosts
        # when a WorkGraph database is configured.
        start = (int(time.time() // 86400) * args.hosts_per_run) % max(1, len(hosts))
        todays = (hosts[start:] + hosts[:start])[: args.hosts_per_run]
        selection = "legacy-day-slice"

    imported = 0
    described_hosts = 0
    economic_hosts = 0
    economic_schemes = 0
    payment_protocol_hosts = 0
    payment_protocol_counts = {}
    with open(args.evidence, "a") as evidence:
        for host in todays:
            twin = "descriptor-" + hashlib.sha256(host.encode()).hexdigest()[:16]
            found = None
            for path in PATHS:
                receipt, text = observe(args.project, args.foreign, twin, "https://%s%s" % (host, path))
                record = {"host": host, "path": path, "http_status": receipt.get("http_status"), "policy": receipt.get("policy_decision")}
                if receipt.get("policy_decision") not in (None, "allow"):
                    evidence.write(json.dumps(record) + "\n")
                    break
                if text and path == "/.well-known/api-catalog":
                    try:
                        catalog = json.loads(text)
                        links = [l.get("href") for entry in catalog.get("linkset", []) for l in entry.get("service-desc", []) if isinstance(l, dict)]
                    except (ValueError, AttributeError):
                        links = []
                    for href in links[:3]:
                        if href and href.startswith("https://"):
                            sub_receipt, sub_text = observe(args.project, args.foreign, twin + "-desc", href)
                            if described(sub_text):
                                found, record["service_desc"] = sub_text, href
                                break
                elif text and described(text):
                    found = text
                evidence.write(json.dumps(record) + "\n")
                if found:
                    break
                time.sleep(0.2)
            if found:
                spec = os.path.join(args.foreign, "bodies", twin + ".spec.json")
                spec_bytes = found.encode("utf-8")
                with open(spec, "wb") as out:
                    out.write(spec_bytes)
                spec_sha256 = hashlib.sha256(spec_bytes).hexdigest()
                provider = re.sub(r"[^a-z0-9-]+", "-", host.lower()).strip("-")[:60]
                doc = json.loads(found)
                summary = security_summary(doc)
                carriers = payment_protocols(doc)
                described_hosts += 1
                if summary["economic_schemes"]:
                    economic_hosts += 1
                    economic_schemes += len(summary["economic_schemes"])
                if carriers:
                    payment_protocol_hosts += 1
                    for carrier in carriers:
                        payment_protocol_counts[carrier] = payment_protocol_counts.get(carrier, 0) + 1
                done = None
                if summary["credential_schemes"]:
                    done = subprocess.run([args.credentials, "openapi", "--db", args.db, "--provider", provider, "--spec", spec, "--name", host, "--actor", "discovery"], capture_output=True, text=True)
                    imported += done.returncode == 0
                descriptor_url = record.get("service_desc") or ("https://%s%s" % (host, record.get("path") or ""))
                evidence.write(json.dumps({
                    "schema": "bonfyre-demand-descriptor.v1",
                    "occurrence_id": "external:" + provider,
                    "host": host,
                    "descriptor_url": descriptor_url,
                    "descriptor_path": spec,
                    "descriptor_sha256": spec_sha256,
                    "described": provider,
                    "credential_imported": provider if done is not None and done.returncode == 0 else None,
                    "credential_schemes": summary["credential_schemes"],
                    "economic_schemes": summary["economic_schemes"],
                    "payment_protocols": carriers,
                    "produced_by": "discover_credential_needs.py",
                    "cannot_infer": [
                        "a published descriptor -> this estate is authorized to call it",
                        "a payment carrier declaration -> spend approval, payment verification or settlement",
                        "credential material -> payment authority"
                    ],
                    "detail": done.stderr.strip()[:200] if done is not None else "descriptor retained outside credential boundary"
                }, sort_keys=True) + "\n")
    print(json.dumps({
        "hosts_known": len(hosts),
        "asked": len(todays),
        "described": described_hosts,
        "declared": imported,
        "credential_declared": imported,
        "economic_hosts": economic_hosts,
        "economic_schemes": economic_schemes,
        "payment_protocol_hosts": payment_protocol_hosts,
        "payment_protocols": dict(sorted(payment_protocol_counts.items())),
        "selection": selection
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
