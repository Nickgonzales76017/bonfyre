    {
        "provider": "podcast-index",
        "name": "Podcast Index",
        "purpose": "Discovers podcasts and new episodes by show identity for Podcasts and Listen.",
        "get_it": "https://api.podcastindex.org/signup",
        "terms": "https://podcastindex.org/",
        "fields": [
            {
                "field": "api_key",
                "label": "API key",
                "kind": "api_key",
                "sensitive": true,
                "required": true,
                "generator": "",
                "help": "Shown on the Podcast Index developer page after sign-up."
            },
            {
                "field": "api_secret",
                "label": "API secret",
                "kind": "secret",
                "sensitive": true,
                "required": true,
                "generator": "",
                "help": "Shown once with the key; it signs every request."
            }
        ],
        "apply": {
            "headers": [
                {
                    "name": "X-Auth-Key",
                    "value": "{api_key}"
                },
                {
                    "name": "X-Auth-Date",
                    "value": "{epoch}"
                },
                {
                    "name": "Authorization",
                    "value": "{sha1:api_key+api_secret+epoch}"
                }
            ],
            "query": []
        },
        "verify": {
            "url": "https://api.podcastindex.org/api/1.0/recent/episodes?max=1",
            "expect": 200
        },
        "tell_them": [],
        "passports": [
            "podcast-index"
        ],
        "cannot_infer": "a working key is access to the index, not an endorsement of any show"
    },
