#!/bin/sh
# Starts a real bonfyre-api HTTP server on an ephemeral loopback port, waits
# for it to actually accept connections, then proves the real API-key
# authentication middleware by making one request with a genuine key
# (inserted directly into the server's own sqlite database, the only way
# keys are provisioned -- there is no self-service creation endpoint) and
# one request with a bogus key, and reports both real HTTP status codes.
# This is not a mock: it is the real server binary, the real router, and
# the real validate_api_key() DB lookup.
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/bonfyre-api-selftest.XXXXXX")
db="$run_dir/api.db"
log="$run_dir/server.log"

port=$(python3 -c "import socket; s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()")

"$root_dir/bonfyre-api" serve --port "$port" --db "$db" </dev/null >"$log" 2>&1 &
server_pid=$!

cleanup() {
    kill "$server_pid" 2>/dev/null || true
    wait_attempt=0
    while kill -0 "$server_pid" 2>/dev/null; do
        wait_attempt=$((wait_attempt + 1))
        if [ "$wait_attempt" -ge 40 ]; then
            kill -9 "$server_pid" 2>/dev/null || true
            break
        fi
        sleep 0.05
    done
    wait "$server_pid" 2>/dev/null || true
    rm -rf "$run_dir"
}
trap cleanup EXIT

attempt=0
until curl -s -o /dev/null "http://127.0.0.1:$port/api/health"; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 100 ] || ! kill -0 "$server_pid" 2>/dev/null; then
        echo "server did not become ready" >&2
        cat "$log" >&2
        exit 1
    fi
    sleep 0.05
done

key="selftest-$$-$(date +%s)"
sqlite3 "$db" "INSERT INTO api_keys (key, label, active, created_at) VALUES ('$key', 'selftest', 1, datetime('now'));"

authenticated_status=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $key" "http://127.0.0.1:$port/api/status")
rejected_status=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer invalid-key-does-not-exist" "http://127.0.0.1:$port/api/status")
logged=$(sqlite3 "$db" "SELECT COUNT(*) FROM request_log WHERE api_key='$key';")

printf '{"ready":true,"port":%s,"authenticated_status":%s,"rejected_status":%s,"authenticated_requests_logged":%s}\n' \
    "$port" "$authenticated_status" "$rejected_status" "$logged"
