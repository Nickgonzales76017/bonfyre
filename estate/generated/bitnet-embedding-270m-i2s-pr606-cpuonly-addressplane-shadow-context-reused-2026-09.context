<div class="bb-cap" data-bb-cap="1">
    <h3 class="bb-cap-title">Get tomorrow's free pick by email</h3>
    <div class="bb-cap-row">
        <input type="email" class="bb-cap-email" placeholder="you@email.com" maxlength="100"
               inputmode="email" autocapitalize="off" autocorrect="off" spellcheck="false"
               aria-label="Your email address" />
        <button type="button" class="bb-cap-btn">Send me the pick</button>
    </div>
    
    <div class="bb-cap-hpwrap" aria-hidden="true" style="position:absolute; left:-5000px; top:auto; height:1px; width:1px; overflow:hidden;">
        <input type="text" class="bb-cap-hp" name="bb_hp" tabindex="-1" autocomplete="off" value="" />
    </div>
    <div class="bb-cap-msg" role="status" aria-live="polite"></div>
    <p class="bb-cap-micro">Free. One email a day, tops. Unsubscribe in one tap.</p>
    <p class="bb-cap-rg">18+ only. Please gamble responsibly.</p>
</div>
<script>
(function () {
    if (window.__bbCapInit) return;            /* one binding per page, however many units render */
    window.__bbCapInit = true;

    var CAP_URL = '/newsletter-signup.ashx';
    var EMAIL_RX = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function showMsg(box, text) {
        var m = box.querySelector('.bb-cap-msg');
        if (m) { m.textContent = text; m.style.display = 'block'; }
    }

    function showDone(box, text) {
        /* swap the whole unit for the success state, in place */
        box.innerHTML =
            '<h3 class="bb-cap-title">' + text + '</h3>' +
            '<p class="bb-cap-micro">Free. One email a day, tops. Unsubscribe in one tap.</p>' +
            '<p class="bb-cap-rg">18+ only. Please gamble responsibly.</p>';
    }

    function submitCap(box) {
        var input = box.querySelector('.bb-cap-email');
        var btn = box.querySelector('.bb-cap-btn');
        var hp = box.querySelector('.bb-cap-hp');
        if (!input || !btn || box.getAttribute('data-bb-busy') === '1') return;

        var email = (input.value || '').trim();
        if (!EMAIL_RX.test(email) || email.length > 100) {
            showMsg(box, "That email doesn't look right. Give it one more try.");
            input.focus();
            return;
        }

        box.setAttribute('data-bb-busy', '1');
        btn.disabled = true;
        btn.textContent = 'Sending…';

        var body = 'email=' + encodeURIComponent(email) +
                   '&hp=' + encodeURIComponent(hp ? hp.value : '') +
                   '&src=' + encodeURIComponent(window.location.pathname || '');

        fetch(CAP_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body,
            credentials: 'same-origin'
        }).then(function (r) { return r.json(); }).then(function (d) {
            if (d && d.ok) {
                if (d.dup) {
                    showDone(box, "You're already on the list. Your pick lands tomorrow morning.");
                } else {
                    showDone(box, 'Done. Check your inbox tomorrow morning.');
                    /* Free-pick email capture = the site's only non-purchase conversion.
                       Routed through bbTrack so Meta's Lead and GA4's generate_lead share ONE
                       browser-minted event id instead of Meta getting a bare, unattributable
                       event and GA4 getting nothing at all. Falls back to the old raw fbq call
                       if bbTrack is somehow absent, so behaviour can only improve. */
                    try {
                        if (window.bbTrack) {
                            window.bbTrack('Lead', {
                                content_name: 'Free pick email',
                                content_category: 'Newsletter',
                                content_ids: ['free_pick_email']
                            }, null, { method: 'Email capture' });
                        } else if (typeof fbq === 'function') { fbq('track', 'Lead'); }
                    } catch (e) { }
                }
            } else {
                box.removeAttribute('data-bb-busy');
                btn.disabled = false;
                btn.textContent = 'Send me the pick';
                showMsg(box, (d && d.err) ? d.err : 'Something went wrong. Please try again.');
            }
        }).catch(function () {
            box.removeAttribute('data-bb-busy');
            btn.disabled = false;
            btn.textContent = 'Send me the pick';
            showMsg(box, 'Something went wrong. Please try again.');
        });
    }

    /* delegation: works for every unit on the page, incl. any added later */
    document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('.bb-cap-btn') : null;
        if (!btn) return;
        var box = btn.closest('.bb-cap');
        if (box) submitCap(box);
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        var t = e.target;
        if (t && t.classList && t.classList.contains('bb-cap-email')) {
            e.preventDefault();                 /* never trigger the WebForms postback */
            var box = t.closest('.bb-cap');
            if (box) submitCap(box);
        }
    });
})();
</script>
<script>
(function () {
    if (window.__bbCapCss) return;
    window.__bbCapCss = true;
    var css =
        '.bb-cap{max-width:560px;margin:40px auto;padding:26px 22px;text-align:center;' +
            'background:var(--panel,rgba(255,255,255,.03));border:1px solid var(--line,rgba(128,140,160,.25));border-radius:16px;}' +
        '.bb-cap-title{font-family:var(--display,inherit);font-size:1.2rem;font-weight:700;color:var(--ink,inherit);margin:0 0 14px;line-height:1.3;}' +
        '.bb-cap-row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}' +
        '.bb-cap-email{flex:1 1 220px;min-width:0;padding:12px 16px;border-radius:12px;font-size:1rem;' +
            'background:var(--panel-2,rgba(255,255,255,.06));border:1px solid var(--line-strong,rgba(128,140,160,.4));color:var(--ink,inherit);}' +
        '.bb-cap-btn{flex:0 0 auto;padding:12px 20px;min-height:46px;border:none;border-radius:12px;cursor:pointer;' +
            'font-family:var(--ui,inherit);font-weight:700;font-size:.95rem;color:#fff;' +
            'background:var(--accent-grad,#3b82f6);box-shadow:inset 0 1px 0 rgba(255,255,255,.35);}' +
        '.bb-cap-btn:disabled{opacity:.7;cursor:default;}' +
        '.bb-cap-hpwrap{position:absolute;left:-5000px;top:auto;height:1px;width:1px;overflow:hidden;}' +
        '.bb-cap-msg{display:none;margin-top:10px;font-size:.88rem;font-weight:600;color:var(--book,#e0655f);}' +
        '.bb-cap-micro{margin:12px 0 0;font-size:.82rem;color:var(--ink-dim,#8b97a6);}' +
        '.bb-cap-rg{margin:6px 0 0;font-size:.72rem;color:var(--ink-faint,#6b7684);}';
    var s = document.createElement('style');
    s.textContent = css;
    document.head.appendChild(s);
})();
</script>


