    <div class="bb-ovl" id="bbSearchOverlay" role="dialog" aria-modal="true" aria-label="Search teams and players">
        <div class="bb-ovl-top">
            <span class="bb-si" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></span>
            <input type="text" id="bbSearchInputM" autocomplete="off" spellcheck="false"
                placeholder="Search teams &amp; players"
                aria-label="Search teams and players" aria-autocomplete="list"
                role="combobox" aria-expanded="false" aria-controls="bbSearchResultsM" />
