<style>
  [data-machine-translation-notice]{
    position:fixed;right:12px;bottom:12px;z-index:9998;
    max-width:calc(100vw - 24px);padding:5px 9px;border:1px solid #d1d5db;
    border-radius:999px;background:rgba(255,255,255,.96);color:#6b7280;
    font-size:11px;line-height:1.2;box-shadow:0 4px 16px rgba(15,23,42,.12);
    backdrop-filter:blur(8px)
  }
  .top5-site-header{position:sticky;top:0;z-index:50;width:100%;height:52px}
  .top5-site-header,.top5-site-header *{box-sizing:border-box}
  .top5-site-header ul{margin:0;padding:0;list-style:none}
  .top5-site-header a{text-decoration:none}
  .top5-site-nav{
    width:100%;height:52px;border-bottom:1px solid rgba(148,163,184,.16);
    box-shadow:0 1px 0 rgba(2,6,23,.4);
    -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
    font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
    font-size:16px;line-height:1.5
  }
  .top5-nav-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:nowrap;width:100%;height:52px;max-width:1280px;margin:0 auto;padding:0 16px}
  .top5-nav-brand{display:flex;align-items:center;gap:10px;min-width:max-content}
  .top5-brand-mark{display:block;flex:none;color:#16a34a}
  /* Keep the brand identical on every static page and Worker-rendered page;
     page-local heading utilities must not make one route look heavier. */
  .top5-brand-name{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif !important;font-size:20px;font-style:normal;font-synthesis:none;font-weight:600 !important;line-height:28px;letter-spacing:-.025em;white-space:nowrap}
  .top5-nav-actions{display:flex;align-items:center;gap:8px;order:2}
  .top5-nav-actions label,.top5-nav-toggle{position:relative;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:8px;padding:8px;background:transparent}
  .top5-nav-actions label{padding:0}
  .top5-nav-actions select{position:absolute;inset:0;width:100%;height:100%;cursor:pointer;opacity:0;outline:0}
  .top5-nav-cta{display:none;align-items:center;justify-content:center;white-space:nowrap;border-radius:8px;padding:10px 16px;font-size:14px;font-weight:600;line-height:20px}
  .top5-mobile-cta{display:block;margin-top:8px;border-radius:8px;background:#1d4ed8;padding:10px 12px;color:#fff!important;font-size:14px;font-weight:600;line-height:20px;text-align:center}
  .top5-nav-toggle{cursor:pointer;color:#94a3b8}
  .top5-nav-toggle svg,.top5-nav-actions label svg,.research-chevron{display:block;flex:none}
  .research-chevron{margin-left:6px}
  .top5-nav-collapse{display:none}
  .top5-nav-list{display:flex;flex-direction:column;gap:4px;font-weight:500}
  .top5-nav-link,.top5-research-button{display:flex;width:100%;align-items:center;border:0;border-radius:8px;background:transparent;padding:8px 12px;color:#cbd5e1;font-size:14px;font-weight:500;line-height:20px;text-align:left}
  .top5-research-button{justify-content:space-between;cursor:pointer}
  .research-menu{position:relative}
  .top5-research-dropdown{z-index:60;width:100%;margin-top:4px;border:1px solid rgba(148,163,184,.22);border-radius:12px;background:#0f172a;padding:8px}
  .top5-research-dropdown.hidden,.top5-research-dropdown[aria-hidden="true"]{display:none}
  .top5-research-dropdown .top5-nav-link{padding:10px 16px}
  .top5-site-header .sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .top5-site-header svg.hidden{display:none}
  /* Dark header theme. These unlayered rules outrank the light Tailwind
     utility classes in the markup (Tailwind v4 utilities live in cascade
     layers), so both Netlify pages and Worker articles render the navy
     header even when an older compiled stylesheet is still live. */
  .top5-site-nav{background:rgba(15,23,42,.96);border-bottom-color:rgba(148,163,184,.16)}
  .top5-site-nav .top5-brand-name{color:#fff}
  .top5-site-nav .top5-brand-mark{box-shadow:none;color:#4ade80}
  .top5-site-nav a:not([aria-label]),.top5-site-nav #researchDropdownButton{color:#cbd5e1}
  .top5-site-nav a:not([aria-label]):hover,.top5-site-nav #researchDropdownButton:hover{background:rgba(148,163,184,.14);color:#fff}
  .top5-site-nav a[href^="/join"]{background:#1d4ed8;color:#fff}
  .top5-site-nav a[href^="/join"]:hover{background:#1e40af;color:#fff}
  .top5-site-nav #navbarToggler,.top5-site-nav label[for="site-language"]{color:#94a3b8}
  .top5-site-nav #navbarToggler:hover,.top5-site-nav label[for="site-language"]:hover{background:rgba(148,163,184,.14);color:#fff}
  /* Mouse clicks should not create the browser/utility-class halo around
     entire controls. Keyboard focus remains visible as a compact inset cue
     that does not change the navbar's apparent size. */
  .top5-site-nav .top5-nav-cta:focus,.top5-site-nav label[for="site-language"]:focus-within{outline:0;box-shadow:none}
  .top5-site-nav .top5-nav-cta:focus-visible{outline:0;box-shadow:inset 0 0 0 2px rgba(255,255,255,.72)}
  .top5-site-nav label[for="site-language"]:has(select:focus-visible){background:rgba(148,163,184,.14);color:#fff;box-shadow:inset 0 0 0 2px rgba(148,163,184,.72)}
  #researchDropdown{border-color:rgba(148,163,184,.22);background:#0f172a}
  .top5-site-nav button,.top5-site-nav select{font-family:inherit;letter-spacing:normal}
  @keyframes researchDropdownIn{
    from{opacity:0;transform:translateY(-12px) scale(.96)}
    to{opacity:1;transform:translateY(0) scale(1)}
  }
  #researchDropdown{box-shadow:0 18px 40px rgba(2,6,23,.45)}
  #researchDropdown:not(.hidden){
    animation:researchDropdownIn .3s cubic-bezier(.16,1,.3,1) both;
    transform-origin:top
  }
  .research-chevron{transition:transform .18s ease}
  #researchDropdownButton[aria-expanded="true"] .research-chevron{transform:rotate(180deg)}
  @media(prefers-reduced-motion:reduce){
    #researchDropdown:not(.hidden){animation:none}
    .research-chevron{transition:none}
  }
  @media(max-width:1023px){
    #navbarCollapse:not(.hidden){
      position:absolute;left:1rem;right:1rem;top:calc(100% + 1px);display:block;
      max-height:calc(100vh - 76px);overflow:auto;border:1px solid rgba(148,163,184,.22);
      border-radius:0 0 .75rem .75rem;background:#0f172a;padding:.75rem 1rem 1rem;
      box-shadow:0 18px 35px rgba(2,6,23,.5)
    }
  }
  @media(min-width:640px){.top5-nav-cta{display:inline-flex}.top5-site-header li.sm\:hidden{display:none}}
  @media(min-width:1024px){
    .top5-nav-inner{padding:0 24px}
    .top5-nav-toggle{display:none}
    .top5-nav-collapse{display:flex!important;order:1;width:auto;align-items:center;justify-content:space-between}
    .top5-nav-list{margin-top:0;flex-direction:row;align-items:center;gap:4px}
    .top5-nav-link,.top5-research-button{width:auto;padding:8px 10px}
    .top5-research-dropdown{position:absolute;left:0;top:100%;width:224px;margin-top:8px}
  }
  @media(min-width:1280px){.top5-nav-list{gap:8px}}
  /* Site-wide surface tint: sections get a faint blue-gray so white cards read
     as raised surfaces instead of white-on-white. Cards keep pure #fff.
     Scoped to light pages — dark-themed pages (html.dark: today, results)
     set their own dark body background that this must not override. */
  html:not(.dark) body{background:#f5f8fc}
  html:not(.dark) section.bg-white{background:#f8fafd}
  html:not(.dark) section.bg-gray-50{background:#eef2f8}
  /* Micro-interaction utility: gentle lift on hoverable cards. Opt-in via
     class so tables and text blocks never move. Disabled for reduced motion. */
  @media(prefers-reduced-motion:no-preference){
    .t5-lift{transition:transform .18s ease,box-shadow .18s ease}
    .t5-lift:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(2,6,23,.10)}
    /* Featured pricing cards keep their blue emphasis on hover. The API
       page's blue ring lives in box-shadow, so the generic hover rule above
       would otherwise replace (and visually wash out) it. Must live in this
       template — build.py regenerates _nav.html and every page's injected
       style block from here, wiping page-local additions. */
    .price-card.featured.t5-lift:hover{box-shadow:0 0 0 1px #1d4ed8,0 12px 28px rgba(29,78,216,.16)}
    .plan-card-featured.t5-lift:hover{box-shadow:0 12px 28px rgba(29,78,216,.16)}
  }
  @media(min-width:1024px) and (max-width:1279px){
    html:not([lang="en"]) #navbarToggler{display:inline-flex!important}
    html:not([lang="en"]) #navbarCollapse.hidden{display:none!important}
    html:not([lang="en"]) #navbarCollapse:not(.hidden){
      position:absolute;left:auto;right:1rem;top:calc(100% + 1px);display:block!important;
      width:260px;max-width:260px;border:1px solid rgba(148,163,184,.22);border-radius:0 0 .75rem .75rem;
      background:#0f172a;padding:.75rem 1rem 1rem;box-shadow:0 18px 35px rgba(2,6,23,.5)
    }
    html:not([lang="en"]) #navbarCollapse>ul{display:block!important}
  }
  @media(min-width:1280px){
    html:not([lang="en"]) #navbarCollapse a{white-space:nowrap;font-size:clamp(.8rem,.9vw,.875rem)}
  }
</style>
<header class="top5-site-header sticky top-0 z-50">
