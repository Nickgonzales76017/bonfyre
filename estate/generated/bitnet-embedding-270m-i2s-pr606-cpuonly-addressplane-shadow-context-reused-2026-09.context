<section class="py-5 bg-dark text-white">
  <div class="container">
    <div class="row text-center justify-content-center mb-5">
      <div class="col-lg-8">
        <h2 class="display-4 font-weight-bold">Simple API, Powerful Results</h2>
        <p class="lead opacity-75">One API call to extract data from any website</p>
      </div>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <ul class="nav nav-pills justify-content-center mb-4" role="tablist">
          <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#python-tab">Python</a></li>
          <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#javascript-tab">JavaScript</a></li>
          <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#php-tab">PHP</a></li>
