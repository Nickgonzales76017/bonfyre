<bonfyre-material cid="sha256:a7f62631fe0e66da0533db69f113be175d4367e515a95dae68e8332e07e39055" receipt="sha256:daf23f7a99de2a7534d93e76280f849a650b4b40caa291717b1078a7257b3498" evidence="/Users/nickgonzales/.bonfyre/estate/evidence.jsonl">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Crypto Price API - Free Developer API | Pip's TinyMind</title>
    <meta name="description" content="Free live crypto price API with CORS support. Real-time Bitcoin, Ethereum, BNB, LTC, USDT prices. Embeddable widget included. No API key required.">
    <meta name="keywords" content="crypto API, free crypto API, live crypto prices, bitcoin API, ethereum API, CORS API, developer API">
    <link rel="canonical" href="https://tinymind.eu/api">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
        .container { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
        h1 { color: #38bdf8; font-size: 2rem; margin-bottom: 0.5rem; }
        .subtitle { color: #94a3b8; margin-bottom: 2rem; }
        .api-endpoint { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1rem; margin: 1rem 0; font-family: 'Courier New', monospace; }
        .api-endpoint a { color: #38bdf8; text-decoration: none; }
        .api-endpoint a:hover { text-decoration: underline; }
        .code-block { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 1rem; margin: 1rem 0; overflow-x: auto; }
        .code-block pre { color: #a5f3fc; font-family: 'Courier New', monospace; font-size: 0.9rem; }
        .code-block .comment { color: #64748b; }
        .code-block .string { color: #86efac; }
        .code-block .key { color: #93c5fd; }
        .code-block .number { color: #fbbf24; }
        h2 { color: #38bdf8; margin-top: 2rem; margin-bottom: 0.5rem; }
        h3 { color: #7dd3fc; margin-top: 1.5rem; margin-bottom: 0.5rem; }
        p { color: #cbd5e1; line-height: 1.6; margin: 0.5rem 0; }
        .badge { display: inline-block; background: #065f46; color: #6ee7b7; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; margin-left: 0.5rem; }
        .feature-list { list-style: none; padding: 0; }
        .feature-list li { padding: 0.5rem 0; color: #cbd5e1; }
        .feature-list li::before { content: "✓ "; color: #38bdf8; font-weight: bold; }
        .cta { display: inline-block; background: #38bdf8; color: #0f172a; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: bold; margin-top: 1rem; }
        .cta:hover { background: #7dd3fc; }
        .nav { margin-bottom: 2rem; }
        .nav a { color: #94a3b8; text-decoration: none; margin-right: 1rem; }
        .nav a:hover { color: #38bdf8; }
    </style>
