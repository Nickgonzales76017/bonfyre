    posthog.init('phc_t4hQYdwGjXoBkkpQ1eCfSgysqW0X6tsYaiDOdRFsUlF', {
      api_host: window.location.origin + '/relay',
      ui_host: 'https://us.posthog.com',
      person_profiles: 'identified_only',
      // These URLs hold forbidden data: /dashboard share links serialize the
      // whole request form, /auth carries live Devise tokens (a reset token
      // is an account takeover), /oauth carries state/PKCE/redirect_uri,
      // /admin filters carry customer API keys and target URLs (no PostHog
      // loads there, but same-origin navigation leaks them via $referrer),
      // and /unsubscribe/:token carries a replayable user-linked token in
      // the PATH (it reaches $referrer via the result page's return link).
      // The path prefix is all the analytics need.
      sanitize_properties: function (props) {
        ['$current_url', '$referrer'].forEach(function (key) {
          var value = props[key];
          if (typeof value !== 'string') return;
          var unsub = value.indexOf('/unsubscribe/');
          if (unsub !== -1) value = value.slice(0, unsub + '/unsubscribe'.length);
          if (value.indexOf('?') !== -1 &&
              (value.indexOf('/dashboard') !== -1 || value.indexOf('/auth') !== -1 ||
               value.indexOf('/oauth') !== -1 || value.indexOf('/admin') !== -1)) {
            value = value.split('?')[0];
          }
          props[key] = value;
        });
        return props;
      }
    })
