<script>
		$(function() {
		
			$('[data-bs-toggle="tooltip"]').tooltip();
		
			$('.btn-copy').on('mouseover', function() {
				var tooltip = bootstrap.Tooltip.getInstance(this);
				tooltip.dispose();
				this.setAttribute('title', 'Copy to clipboard');
				tooltip = bootstrap.Tooltip.getOrCreateInstance(this);
				tooltip.show();
			}).tooltip();
		
			$(".dropdown-menu-code .dropdown-item").click(function(){
				$(this).parents(".code-menu").find('.btn-dropdown').html($(this).text()+ '&nbsp;');
			});
		
			//Copy Sample Codes
			//$('.btn-codes').tooltip({trigger: 'click', placement: 'top'});
			$('.btn-codes').click(function(){
				if (window.getSelection && document.createRange) {
					// IE 9 and non-IE
					var activeTabId = document.querySelector('#tab-codes .active pre');
					var range = document.createRange();
					range.selectNodeContents(activeTabId);
					var sel = window.getSelection();
					sel.removeAllRanges();
					sel.addRange(range);
					document.execCommand("copy");
					if (document.execCommand('copy')){
						var tooltip = bootstrap.Tooltip.getInstance(this);
						tooltip.dispose();
						this.setAttribute('title', 'Copied!');
						tooltip = bootstrap.Tooltip.getOrCreateInstance(this);
						tooltip.show();
		
					}
				} else if (document.body.createTextRange) {
					// IE < 9
					var textRange = document.body.createTextRange();
					textRange.moveToElementText();
					textRange.select();
					document.execCommand("copy");
					if (document.execCommand('copy')){
						var tooltip = bootstrap.Tooltip.getInstance(this);
						tooltip.dispose();
						this.setAttribute('title', 'Copied!');
						tooltip = bootstrap.Tooltip.getOrCreateInstance(this);
						tooltip.show();
					}
				}
			});
		
			//Scroll to div when click on side menu
			$('#navbar-dev .nav-sub').click(function() {
				var target = $(this).attr("data-target");
				var id = '#'+ target;
				if (target){
					$('html, body').animate({
							scrollTop: $(id).offset().top - 90
						});
					}
				});
		
		});
		</script>

