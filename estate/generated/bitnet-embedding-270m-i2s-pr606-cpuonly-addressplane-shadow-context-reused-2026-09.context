        /* [2026-08-29] DEFAULT-HIDDEN STATES are CRITICAL: every rule below is duplicated verbatim from
   bb-core-rest (async) because an overlay hidden only by async CSS paints VISIBLE on page load
   (live incident: the subscription modal appeared on every load). Duplicates are cascade-neutral. */
.gstrip-scroll::-webkit-scrollbar{display:none;}
@media (max-width:640px){.gstrip-all{display:none;}}
.nav-links{display:none;gap:20px;}
.hamburger-toggle{display:none;font-size:1.4rem;color:var(--on-chrome);cursor:pointer;}
.theme-toggle .i-moon{display:none;}
:root[data-theme="light"] .theme-toggle .i-sun{display:none;}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]):not([data-theme="light"]) .theme-toggle .i-sun{display:none;}}
@media (max-width:919px){.brand-badge{display:none;}}
@media (max-width:919px){.nav-actions .btn-glass:not(.keep-mobile){display:none;}}
@media (max-width:430px){.brand-text{display:none;}}
/* ---------- mobile drawer ---------- */
        .menu-overlay{position:fixed;inset:0;background:var(--overlay-bg);backdrop-filter:blur(6px);z-index:9998;opacity:0;pointer-events:none;transition:.3s;}
.menu-fold>.mf-body{display:none;padding-left:8px;}
/* [2026-09-07] sidebar redesign (artifact 368d5756): free pick leads, proof on the rows, one
   money CTA, sports collapsed to the in-season row until "All sports". The two hidden-state
   rules (collapsed tiles, subscriber money-hide) are here per the 2026-08-29 default-hidden
   law; the cosmetic rules ride with them so the drawer is whole before any network CSS. */
.dw-pick{background:linear-gradient(180deg,rgba(70,140,255,.10),rgba(70,140,255,.03));border:1px solid var(--card-edge);border-radius:14px;padding:13px 14px;margin-bottom:12px;}
.dw-pick-cap{display:flex;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink);margin-bottom:8px;}
.dw-free{background:var(--model-dim);color:var(--model);border-radius:20px;padding:2px 8px;font-weight:700;}
.dw-pick-game{font-weight:700;font-size:14px;color:var(--ink);}
.dw-pick-meta{font-size:11px;color:var(--ink-faint);margin-top:1px;}
.dw-pick-sel{margin:9px 0 3px;font-size:16.5px;font-weight:800;letter-spacing:-.01em;color:var(--ink);}
.dw-pick-conf{display:flex;gap:8px;align-items:center;font-size:11.5px;color:var(--ink-faint);}
.dw-conf{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--model);background:var(--model-dim);border-radius:5px;padding:2px 7px;}
.dw-pick-go{display:block;margin-top:11px;background:var(--accent-grad);color:#fff;text-align:center;border-radius:10px;padding:10px;font-weight:700;font-size:14px;text-decoration:none;}
.dw-row{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:11px 13px;text-decoration:none;color:var(--ink);margin-bottom:9px;}
.dw-row:hover{border-color:var(--line-strong);}
.dw-rl{display:flex;flex-direction:column;gap:2px;min-width:0;}
.dw-rt{font-weight:700;font-size:14.5px;}
.dw-rs{font-size:11.5px;color:var(--ink-faint);}
.dw-chev{color:var(--ink-faint);flex:none;}
.dw-cnt{font-family:var(--mono);font-size:10.5px;font-weight:700;color:var(--accent-ink);background:rgba(70,140,255,.1);border:1px solid var(--card-edge);border-radius:20px;padding:2px 8px;flex:none;white-space:nowrap;}
.dw-ticks{display:inline-flex;gap:3px;align-items:center;margin-right:6px;vertical-align:middle;}
.dw-tk{width:8px;height:8px;border-radius:2.5px;background:var(--model);display:inline-block;}
.dw-tk.l{background:var(--book);}
#sportsGridD:not(.all) a.sport-tile:nth-child(n+8){display:none;}
#sportsGridD.all .sport-more{display:none;}
.sport-more{cursor:pointer;color:var(--accent-ink);background:var(--panel);border:1px solid var(--card-edge);font-family:inherit;font-size:11px;font-weight:700;border-radius:11px;}
.dw-money{display:block;background:var(--accent-grad);border-radius:12px;padding:11px;text-align:center;color:#fff;text-decoration:none;font-weight:800;font-size:15px;margin-bottom:12px;}
.dw-money small{display:block;font-weight:500;font-size:11px;opacity:.85;margin-top:2px;}
body.subscribed .dw-money{display:none;}
.dw-rg{font-size:10.5px;color:var(--ink-faint);text-align:center;margin:10px 0 0;}
/* ---------- subscribe modal (structure preserved; restyled) ---------- */
        .modal-wrap{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:.3s ease-out;background:var(--modal-bg);backdrop-filter:blur(12px);}
.modal-box.focused-mode .modal-right{display:none;}
.modal-box.checkout-mode .modal-right{display:none;}
@media (max-width: 850px){.modal-left > img{display:none;}}
/* Mobile: single compact column, feature panel hidden so step-1 fits the viewport without scrolling. */
        .s1-mob-benefits{display:none;}
@media (max-width:850px){.modal-right{display:none;}}
/* ---------- site-wide mobile bottom-nav (P8 → app-design port 2026-08-14) ----------
           Mirrors the Flutter AppBottomNav: a 64px flush translucent panel bar with a strong top
           hairline; quiet 22px line icons + 10px labels that brighten ink-faint → ink when active
           (no color flood — the raised center button carries the focus); center = raised 56px
           brand-gradient squircle (radius 19, 2.5px void ring, soft brand shadow) poking 18px
           above the bar, with a small action-blue label beneath. */
        .bb-botnav{display:none;position:fixed;left:0;right:0;bottom:0;z-index:8500;align-items:stretch;justify-content:space-around;background:var(--botnav-bg);background:color-mix(in srgb,var(--panel) 94%,transparent);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-top:1px solid var(--line-strong);padding-bottom:env(safe-area-inset-bottom);}
body.subscribed .bb-botnav .bb-cta-wrap{display:none;}
body:has(.bot-nav) .bb-botnav{display:none;}
/* ---------- shared content utilities (used by pages) ---------- */
        .reveal{opacity:0;transform:translateY(16px);transition:.7s cubic-bezier(.2,.7,.2,1);}
@media (max-width:768px) */
@media (max-width: 768px){.apk-vs-text, .npk-vs, .vs-text{display: none;}}
.tip-row.player-prop-row .bet-units{visibility: hidden; height: 0;}
@media (max-width: 768px){.promo-icon{display: none;}}
/* uniform legs: hide per-leg stat labels (NBA/EPL omit them; policy = hide everywhere) */
.parlay-tip-row .stat-label{display: none;}
@media (max-width: 850px){/* redundant once the picks are the next block on screen */
    body .apk-decision .apk-jump{display: none;}}
/* [2026-08-18] ICP JARGON — the pick card's third stat. Card labels across the 20 league
   picks templates now read "Chance to win" and "Best price" (markup pass, same wave), but
   "Edge 33.7%" is jargon that cannot be relabelled into plain English — it is the exact
   term the validated buyer asked about ("what is an edge?"). It stays in the DOM and stays
   visible to MEMBERS (who paid for the depth); guests simply do not see it in the reading
   path. Guest/member split uses the body.subscribed class Site.Master already stamps from
   BbGate.IsPaidLevel (line ~2215). Applies at all widths — jargon is jargon on desktop too.
   NOTE: prop-bets pages carry a separate "Edge:" span (<span class="edge">) on ~62 markup
   sites incl. FAQ/odds; deliberately NOT swept here without a live check — next wave. */
body:not(.subscribed) .apk-detail-item.is-edge{display: none;}
/* ==== END mobile content-first ==== */
    

/* ==== block boundary (source order preserved) ==== */


        /* Desktop inline search (shown at >=1200px alongside nav-links) */
        .bb-search{position:relative;display:none;align-items:center;}
@media (min-width:1420px){.bb-search-btn{display:none;}}
@media (min-width:1420px){.nav-actions:has(.keep-mobile) .bb-search{display:none;}}
/* Shared results dropdown (desktop popover) */
        .bb-sr{position:absolute;top:calc(100% + 8px);right:0;width:340px;max-width:82vw;max-height:min(60vh,440px);overflow-y:auto;background:var(--panel);border:1px solid var(--line-strong);border-radius:12px;box-shadow:var(--shadow-card);z-index:9600;padding:6px;display:none;-webkit-overflow-scrolling:touch;}
/* Mobile full-width overlay (thumb-reach input at top) */
        .bb-ovl{position:fixed;inset:0;z-index:10001;background:var(--void);display:none;flex-direction:column;}
/* ==== block boundary (source order preserved) ==== */


    .bb-more-hidden{display: none !important;}
        /* [2026-08-29b] STATE-PAIR COMPLETENESS: hidden-state rules moved inline made overlays hidden
   pre-css, but their SHOW/OPEN counterparts were still async - a fast click opened an invisible
   modal. Every state-class rule from bb-core-rest is duplicated here so overlay open AND close
   both work before any network css arrives. Duplicates are cascade-neutral. */
.nav-links a:hover,.nav-links a.active{color:var(--on-chrome);}
.menu-fold.open>.mf-h .fa-chevron-down{transform:rotate(180deg);}
.menu-fold.open>.mf-body{display:block;}
.modal-wrap.show{opacity:1;pointer-events:auto;}
.modal-wrap.show .modal-box{transform:scale(1) translateY(0);}
.toggle-item.active{background:var(--panel-2);color:var(--ink);border:1px solid var(--line-strong);}
.bb-tab.active{color:var(--ink);}
.bb-tab.active .lb{font-weight:600;}
.reveal.in{opacity:1;transform:none;}
.apk-picks-collapsible.expanded, .npk-picks-content.expanded, .picks-collapsible-content.expanded{max-height: 100%; overflow: visible;}
.reason-text.expanded, .npp-reason-text.expanded{max-height: 4000px; padding: 0.75em;}
.bb-sr.open{display:block;}
.bb-sr-item:hover,.bb-sr-item.active{background:var(--panel-2);}
.bb-ovl.open{display:flex;}
        /* [2026-09-01] iOS ZOOM FIX: Safari auto-zooms any focused field whose font-size < 16px,
   and the page stays zoomed after - the 'zooms in so much its not great' report. 16px on
   every input on phones kills the zoom at the source (the correct fix; maximum-scale=1
   is an accessibility anti-pattern). Critical because fields exist above the fold. */
@media (max-width:850px){
  input[type=text],input[type=email],input[type=password],input[type=tel],input[type=number],input[type=search],select,textarea{font-size:16px !important;}
}
        /* [2026-08-29] .reveal must be CRITICAL: if it arrives async, gated elements flash visible, vanish, then fade back in. */
        .reveal{opacity:0;transform:translateY(16px);transition:.7s cubic-bezier(.2,.7,.2,1);}
        .reveal.in{opacity:1;transform:none;}
</style>
