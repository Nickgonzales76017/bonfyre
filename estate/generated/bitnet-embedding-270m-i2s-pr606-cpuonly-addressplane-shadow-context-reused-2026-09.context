    <script>
    function switchTab(e, tabId) {
      var button = e.currentTarget;
      var btns = button.closest('.api-card').querySelectorAll('.tab-btn');
      var panels = button.closest('.api-card').querySelectorAll('.tab-panel');
      btns.forEach(function(b) { b.classList.remove('active'); });
      panels.forEach(function(p) { p.classList.remove('active'); });
      button.classList.add('active');
      document.getElementById(tabId).classList.add('active');
    }
    function toggleCollapse(btn) {
      var body = btn.nextElementSibling;
      btn.classList.toggle('open');
      body.classList.toggle('open');
      btn.setAttribute('aria-expanded', btn.classList.contains('open') ? 'true' : 'false');
    }
    </script>
    <script src="/assets/js/api.js?v=4609daa99d82"></script>
    <script>
    // The static site intentionally exposes only the status envelope. Paid
    // rows stay behind the authenticated Worker gateway and must never be
    // pulled into this public page through a legacy compatibility fallback.
    fetch('/api/v1/research/stocks/today.json', { cache: 'no-store' })
      .then(function(d) {
        if (!d.ok) throw new Error('public_contract_' + d.status);
        return d.json();
      })
      .then(function(d) {
        var show = d;
        document.getElementById('live-preview').textContent = JSON.stringify(show, null, 2);
      })
      .catch(function() {
        document.getElementById('live-preview').textContent = '// Live preview is temporarily unavailable.\n// Authenticated endpoint:\n// https://top5stocks-api.top5stocks.workers.dev/api/v1/research/stocks/today.json';
      });
    </script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/refund.js" defer></script>
  </body>
</html>

</bonfyre-material>
