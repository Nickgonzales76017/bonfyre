/* Inter 800 (latin-ext + latin) — added so per-page pages that requested Inter wght@800 can drop their
   render-blocking fonts.googleapis.com stylesheet and use these inlined faces instead. Same variable woff2 as 400-700. */
/* latin-ext */
@font-face {
  font-family: 'Inter';
