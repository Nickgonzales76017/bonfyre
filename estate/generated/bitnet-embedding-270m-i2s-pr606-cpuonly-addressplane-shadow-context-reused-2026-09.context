<script>
(function () {
  if (window.__top5NavBound) return;
  window.__top5NavBound = true;
  var toggler = document.querySelector("#navbarToggler");
  var collapse = document.querySelector("#navbarCollapse");
  var rBtn = document.querySelector("#researchDropdownButton");
  var rMenu = document.querySelector("#researchDropdown");
  var rWrap = rBtn && rBtn.closest(".research-menu");
  var desktop = window.matchMedia("(min-width: 1024px)");
  var hover = window.matchMedia("(min-width: 1024px) and (hover: hover) and (pointer: fine)");
  var pinned = false, closeTimer = 0;
  function setResearch(open) {
    if (!rBtn || !rMenu) return;
    rBtn.setAttribute("aria-expanded", String(open));
    rMenu.setAttribute("aria-hidden", String(!open));
    rMenu.classList.toggle("hidden", !open);
  }
  function setNav(open) {
    if (!toggler || !collapse) return;
    toggler.classList.toggle("navbarTogglerActive", open);
    toggler.setAttribute("aria-expanded", String(open));
    toggler.setAttribute("aria-label", open ? "Close main menu" : "Open main menu");
    collapse.classList.toggle("hidden", !open);
    collapse.setAttribute("aria-hidden", desktop.matches ? "false" : String(!open));
    var openIcon = toggler.querySelector("[data-menu-open-icon]");
    var closeIcon = toggler.querySelector("[data-menu-close-icon]");
    if (openIcon) openIcon.classList.toggle("hidden", open);
    if (closeIcon) closeIcon.classList.toggle("hidden", !open);
    if (!open) { pinned = false; setResearch(false); }
  }
  if (toggler && collapse) {
    toggler.addEventListener("click", function () {
      setNav(collapse.classList.contains("hidden"));
    });
  }
  if (rBtn && rMenu) {
    rBtn.addEventListener("click", function () {
      if (desktop.matches) { pinned = !pinned; setResearch(pinned); }
      else setResearch(rMenu.classList.contains("hidden"));
    });
    rBtn.addEventListener("keydown", function (e) {
      if (e.key !== "ArrowDown") return;
      e.preventDefault();
      pinned = desktop.matches;
      setResearch(true);
      var first = rMenu.querySelector("a");
      if (first) first.focus();
    });
  }
  if (rWrap) {
    rWrap.addEventListener("pointerenter", function () {
      if (!hover.matches) return;
      window.clearTimeout(closeTimer);
      setResearch(true);
    });
    rWrap.addEventListener("pointerleave", function () {
      if (!hover.matches || pinned) return;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(function () { setResearch(false); }, 180);
    });
    rWrap.addEventListener("focusout", function (e) {
      var next = e.relatedTarget;
      if (next instanceof Node && rWrap.contains(next)) return;
      pinned = false;
      setResearch(false);
    });
  }
  if (collapse) {
    collapse.querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", function () { setNav(false); });
    });
  }
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    if (rMenu && !rMenu.classList.contains("hidden")) {
      pinned = false;
      setResearch(false);
      if (rBtn) rBtn.focus();
      return;
    }
    if (collapse && !collapse.classList.contains("hidden") && !desktop.matches) {
      setNav(false);
      if (toggler) toggler.focus();
    }
  });
  document.addEventListener("click", function (e) {
    var t = e.target;
    if (!(t instanceof Node)) return;
    if (rMenu && !rMenu.classList.contains("hidden") &&
        !rMenu.contains(t) && !(rBtn && rBtn.contains(t))) {
      pinned = false;
      setResearch(false);
    }
    var header = document.querySelector(".top5-site-header");
    if (!desktop.matches && collapse && !collapse.classList.contains("hidden") &&
        !(header && header.contains(t))) {
      setNav(false);
    }
  });
  function reset() {
    pinned = false;
    setNav(false);
    if (collapse && desktop.matches) collapse.setAttribute("aria-hidden", "false");
  }
  if (desktop.addEventListener) desktop.addEventListener("change", reset);
  else desktop.addListener(reset);
  reset();
})();
</script>
