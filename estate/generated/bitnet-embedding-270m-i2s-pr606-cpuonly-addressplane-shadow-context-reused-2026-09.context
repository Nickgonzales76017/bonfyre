								<pre class="p-4 m-0 rounded-bottom"><code id="curl-code" class="language-bash">curl https://api.fraudlabspro.com/v2/order/screen \
--header 'Content-Type: application/json' \
--data '{
	"key": "Enter_License_Key",
	"format": "json",
	"ip": "IP_Address",
	"last_name": "Henderson",
	"first_name": "Hector",
	"bill_addr": "1766 PowderHouse Road",
	"bill_city": "Cleveland",
	"bill_state": "OH",
	"bill_zip_code": "44115",
	"bill_country": "US",
	"ship_last_name": "Henderson",
	"ship_first_name": "Hector",
	"ship_addr": "4987 Bingamon Road",
	"ship_city": "Cleveland",
	"ship_state": "OH",
	"ship_zip_code": "44115",
	"ship_country": "US",
	"email_domain": "gmail.com",
	"user_phone": "440-5551961",
	"email_hash": "Email_Hash",
	"bin_no": "558265",
	"card_hash": "Card_Hash",
	"avs_result": "Y",
