        </div>
        <div class="bb-ovl-results bb-sr" id="bbSearchResultsM" role="listbox" aria-label="Search results" style="display:block;position:static;box-shadow:none;border:none;background:transparent;max-height:none;width:auto;max-width:none;"></div>
    </div>

    <!-- NET-NEW: nav search controller (vanilla JS, no libs/CDNs; binds listeners only, fetches on input) -->
    <script>
    (function(){
        var EP = '/search.ashx';
        function debounce(fn,ms){var t;return function(){var a=arguments,c=this;clearTimeout(t);t=setTimeout(function(){fn.apply(c,a);},ms);};}
        function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(m){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m];});}

        function attach(input, results, opts){
            opts = opts||{};
            var data=[], active=-1, curQ='';
            function close(){ results.classList.remove('open'); results.innerHTML=''; data=[]; active=-1; input.setAttribute('aria-expanded','false'); input.removeAttribute('aria-activedescendant'); }
            function open(){ results.classList.add('open'); input.setAttribute('aria-expanded','true'); }
            function setActive(){ if(active>=0 && active<data.length){ input.setAttribute('aria-activedescendant', opts.ns+'-opt-'+active); } else { input.removeAttribute('aria-activedescendant'); } }
            function render(){
                if(!data.length){
                    if(curQ.length>=2){ results.innerHTML='<div class="bb-sr-empty">No teams or players found</div>'; open(); } else { close(); }
                    return;
                }
                var h='';
                for(var i=0;i<data.length;i++){ var it=data[i]; var chip = it.subleague ? it.subleague : it.league;
                    h+='<a class="bb-sr-item'+(i===active?' active':'')+'" role="option" id="'+opts.ns+'-opt-'+i+'" aria-selected="'+(i===active?'true':'false')+'" href="'+esc(it.url)+'" data-i="'+i+'">'
                        +'<span class="bb-sr-type" aria-hidden="true">'+(it.type==='team'?'T':'P')+'</span>'
                        +'<span class="bb-sr-name">'+esc(it.name)+'</span>'
                        +'<span class="bb-sr-chip">'+esc(chip||'')+'</span></a>';
                }
                results.innerHTML=h; open(); setActive();
            }
            function highlight(){
                var nodes=results.querySelectorAll('.bb-sr-item');
                for(var i=0;i<nodes.length;i++){ var on=(i===active); nodes[i].classList.toggle('active',on); nodes[i].setAttribute('aria-selected', on?'true':'false'); }
                setActive();
                if(active>=0 && nodes[active] && nodes[active].scrollIntoView) nodes[active].scrollIntoView({block:'nearest'});
            }
            var run = debounce(function(q){
                fetch(EP+'?q='+encodeURIComponent(q), {headers:{'Accept':'application/json'}, credentials:'same-origin'})
                    .then(function(r){ return r.ok ? r.json() : []; })
                    .then(function(j){ if(input.value.trim()!==q) return; data=Array.isArray(j)?j:[]; active=data.length?0:-1; render(); })
                    .catch(function(){ data=[]; render(); });
            }, 180);
            // [2026-07-31] The global nav search fired NOTHING to Meta or GA4 on any page of the site,
            // while the correct block was already written, tested and allowlisted at HitRates.aspx.
            // A visitor typing a team or player name is stating intent in their own words — for this
            // ICP that is one of the strongest signals the site can observe, and Search is a Meta
            // standard event already permitted by the beacon's allowlist (MetaEvent.ashx.cs).
            // Debounced far longer than the autocomplete fetch (900ms vs 180ms) so one event
            // represents one settled query rather than one per keystroke, and guarded on the last
            // tracked value so re-focusing or arrow-keying never re-sends it.
            var bbLastQ = '';
            var trackSearch = debounce(function (q) {
                try {
                    if (!q || q.length < 2 || q === bbLastQ || !window.bbTrack) return;
                    bbLastQ = q;
                    var p = { search_string: q, content_type: 'product' };
                    var id = window.bbTrack('Search', p, null, { search_term: q });
                    if (window.bbCapi) window.bbCapi('Search', id, p);
                } catch (e) { }
            }, 900);
            input.addEventListener('input', function(){ curQ=input.value.trim(); if(curQ.length<2){ close(); return; } run(curQ); trackSearch(curQ); });
            input.addEventListener('keydown', function(e){
                var isOpen = results.classList.contains('open');
                if(e.key==='ArrowDown'){ if(!isOpen||!data.length) return; e.preventDefault(); active=(active+1)%data.length; highlight(); }
                else if(e.key==='ArrowUp'){ if(!isOpen||!data.length) return; e.preventDefault(); active=(active-1+data.length)%data.length; highlight(); }
                else if(e.key==='Enter'){ if(active>=0 && data[active]){ e.preventDefault(); window.location.href=data[active].url; } }
                else if(e.key==='Escape'){ if(opts.onEscape){ opts.onEscape(); } else { close(); input.blur(); } }
            });
            input.addEventListener('blur', function(){ setTimeout(close, 150); });
            return { close: close, focus: function(){ input.focus(); } };
        }

        var dInput=document.getElementById('bbSearchInput'), dRes=document.getElementById('bbSearchResults');
        if(dInput && dRes) attach(dInput, dRes, {ns:'bbd'});

        var mInput=document.getElementById('bbSearchInputM'), mRes=document.getElementById('bbSearchResultsM'),
            ovl=document.getElementById('bbSearchOverlay'), openBtn=document.getElementById('bbSearchOpen'), closeBtn=document.getElementById('bbSearchClose');
        if(mInput && mRes && ovl){
            var mCtl = attach(mInput, mRes, {ns:'bbm', onEscape:function(){ hideOvl(); }});
            function showOvl(){ ovl.classList.add('open'); document.body.style.overflow='hidden'; setTimeout(function(){ mInput.focus(); }, 50); }
            function hideOvl(){ ovl.classList.remove('open'); document.body.style.overflow=''; mInput.value=''; mCtl.close(); }
            if(openBtn) openBtn.addEventListener('click', showOvl);
            if(closeBtn) closeBtn.addEventListener('click', hideOvl);
        }
    })();
    </script>
