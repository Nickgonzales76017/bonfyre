    <style>
      :root {
        --color-dark: #0b0f19;
        --color-dark-2: #131a2b;
        --color-dark-3: #1c2740;
        --color-dark-6: #7d8590;
        --color-primary: #2f81f7;
        --color-body-color: #7d8590;
        --color-gray-7: #c9d1d9;
        --color-gray-1: #0f1629;
      }
      /* Light theme matching the rest of the site (members.html/methodology.html).
         The markup still carries dark-theme inline styles and text-white
         classes; the scoped overrides below remap them, same approach as
         methodology.html, so the 700 lines of content don't need rewriting. */
      body { margin: 0; padding: 0; background: #fff; color: #374151; }
      html { margin: 0; padding: 0; background: #fff; }
      html, body { overflow-x: clip; max-width: 100%; }
      .section-label {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.12em; color: #1d4ed8; margin-bottom: 12px;
      }
      .api-hero { padding-top: 44px; padding-bottom: 34px; background: linear-gradient(180deg, #eff6ff 0%, #fff 100%); border-bottom: 1px solid #e5e7eb; }
      .api-hero-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr); align-items: center; gap: 44px; max-width: 1080px; }
      .api-hero-inner { max-width: 760px; text-align: left; }
      .api-hero-copy { margin-top: 14px; line-height: 1.6; }
      .api-hero-actions { margin-top: 24px; }
      .api-hero-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; border: 1px solid #bfdbfe; border-radius: 999px; background: rgba(255,255,255,.75); color: #1d4ed8; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .api-hero-kicker-dot { width: 7px; height: 7px; border-radius: 999px; background: #16a34a; box-shadow: 0 0 0 4px #dcfce7; }
      .api-hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
      .api-hero-tag { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border-radius: 8px; background: rgba(255,255,255,.8); border: 1px solid #dbeafe; color: #374151; font-size: 12px; font-weight: 600; }
      .api-hero-tag svg { width: 15px; height: 15px; color: #2563eb; flex-shrink: 0; }
      .api-hero-preview { border: 1px solid #bfdbfe; border-radius: 18px; background: rgba(255,255,255,.92); box-shadow: 0 18px 45px rgba(30,64,175,.12); overflow: hidden; transform: rotate(1deg); }
      .api-hero-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
      .api-hero-preview-status { display: inline-flex; align-items: center; gap: 5px; color: #15803d; letter-spacing: normal; text-transform: none; }
      .api-hero-preview-status::before { content: ''; width: 6px; height: 6px; border-radius: 999px; background: #22c55e; }
      .api-hero-preview-route { margin: 0; padding: 16px 16px 12px; color: #1d4ed8; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
      .api-hero-preview-list { display: grid; gap: 8px; padding: 0 16px 16px; }
      .api-hero-preview-row { display: flex; align-items: center; gap: 10px; padding: 10px 11px; border: 1px solid #eef2f7; border-radius: 10px; background: #f8fafd; color: #374151; font-size: 12px; font-weight: 600; }
      .api-hero-preview-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: #dbeafe; color: #1d4ed8; flex-shrink: 0; }
      .api-hero-preview-icon svg { width: 15px; height: 15px; }
      .api-hero-preview-row small { display: block; margin-top: 2px; color: #6b7280; font-size: 10px; font-weight: 500; }
      .api-hero-preview-footer { padding: 11px 16px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 11px; line-height: 1.45; }
      .api-first-section { padding-top: 32px; }
      main section { background: #f8fafd; }
      main h1.text-white, main h2.text-white, main h3.text-white, main h4.text-white,
      main p.text-white, main span.text-white, main strong.text-white { color: #111827 !important; }
      main [style*="color:#c9d1d9"] { color: #374151 !important; }
      main [style*="color:#d1d5db"] { color: #374151 !important; }
      main [style*="color:#9ca3af"] { color: #6b7280 !important; }
      main [style*="color:#7d8590"] { color: #6b7280 !important; }
      main [style*="color:#4ade80"] { color: #16a34a !important; }
      main a[style*="border:1px solid #1c2740"] { border-color: #d1d5db !important; color: #111827 !important; }
      main [style*="color:#58a6ff"] { color: #1d4ed8 !important; }
      main [style*="color:#2f81f7"] { color: #1d4ed8 !important; }
      main [style*="color:#f85149"] { color: #b91c1c !important; }
      main [style*="color:#3fb950"] { color: #15803d !important; }
      main [style*="color:#fff"] { color: #111827 !important; }
      main [style*="border-bottom:1px solid #1c2740"] { border-color: #e5e7eb !important; }
      main pre [style*="color:#58a6ff"] { color: #58a6ff !important; }
      main pre [style*="color:#c9d1d9"] { color: #c9d1d9 !important; }
      main pre [style*="color:#7d8590"] { color: #8b949e !important; }
      main pre [style*="color:#9ca3af"] { color: #9ca3af !important; }
      main pre [style*="color:#4ade80"] { color: #4ade80 !important; }
      main pre [style*="color:#3fb950"] { color: #3fb950 !important; }
      .api-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
      .endpoint-row {
        display: flex; align-items: center; gap: 10px; padding: 12px 0;
        border-bottom: 1px solid #f3f4f6; flex-wrap: wrap;
      }
      .endpoint-row:last-child { border-bottom: none; }
      .method-badge { background: #16a34a; color: #fff; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px; letter-spacing: 0.05em; flex-shrink: 0; }
      .tier-badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 4px; flex-shrink: 0; min-width: 48px; text-align: center; }
      .tier-free { background: #dbeafe; color: #1d4ed8; }
      .tier-starter { background: #dcfce7; color: #15803d; }
      .tier-pro { background: #f3e8ff; color: #7e22ce; }
      .tier-ultra { background: #fee2e2; color: #b91c1c; }
      pre { background: #0d1117; color: #c9d1d9; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; overflow-x: auto; font-size: 13px; line-height: 1.5; }
      code { font-family: 'SF Mono', 'Fira Code', monospace; }
      .price-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
      @media (min-width: 640px) { .price-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1100px) { .price-grid { grid-template-columns: repeat(4, 1fr); } }
      .price-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px 22px; text-align: center; display: flex; flex-direction: column; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
      .price-card .price-card-features { flex: 1; text-align: left; }
      .price-card .price-card-features p { text-align: left; }
      /* Keep inherited-plan labels readable and consistent with the
         membership cards. The API page uses a separate card layout, so its
         labels need their own size/weight/color treatment. */
      .price-card .plus-label {
        margin: 0 0 4px;
        color: #6b7280;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: normal;
        text-transform: none;
      }
      .price-card.featured .plus-label { color: #1d4ed8; }
      .price-card .price-card-cta { margin-top: auto; }
      .price-card.featured { border-color: #1d4ed8; box-shadow: 0 0 0 1px #1d4ed8, 0 8px 24px rgba(29,78,216,.10); }
      .live-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #16a34a; margin-right: 6px; animation: pulse-dot 2s infinite; }
      @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
      .tab-bar { display: flex; gap: 0; border-bottom: 1px solid #e5e7eb; margin-bottom: 0; }
      .tab-btn { padding: 8px 16px; font-size: 12px; font-weight: 600; color: #6b7280; background: none; border: none; cursor: pointer; border-bottom: 2px solid transparent; }
      .tab-btn.active { color: #1d4ed8; border-bottom-color: #1d4ed8; }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }
      .collapse-btn { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 12px 0; background: none; border: none; color: #111827; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; }
      .collapse-btn::after { content: '+'; color: #6b7280; font-size: 18px; flex-shrink: 0; }
      .collapse-btn.open::after { content: '\2212'; }
      .collapse-body { display: none; padding-bottom: 8px; }
      .collapse-body.open { display: block; }
      @media (max-width: 767px) {
        .api-hero { padding-top: 32px; padding-bottom: 26px; }
        .api-hero-grid { grid-template-columns: 1fr; gap: 28px; }
        .api-hero-inner { text-align: center; }
        .api-hero-tags { justify-content: center; }
        .api-hero-preview { transform: none; }
        .api-hero-actions { margin-top: 20px; }
        .api-first-section { padding-top: 24px; }
        .endpoint-row { font-size: 13px; }
        .endpoint-row code { font-size: 12px; }
        .ep-desc { display: block; margin-left: 0 !important; margin-top: 3px; color: #9ca3af !important; font-size: 11px !important; line-height: 1.35; }
      }
    </style>
