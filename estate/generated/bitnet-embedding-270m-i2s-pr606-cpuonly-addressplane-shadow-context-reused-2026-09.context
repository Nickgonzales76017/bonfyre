	'billing'	=&gt; [
		'firstName'	=&gt; 'Hector',
		'lastName'	=&gt; 'Henderson',
		'email'		=&gt; 'hh5566@gmail.com',
		'phone'		=&gt; '561-628-8674',

		'address'	=&gt; '1766 Powder House Road',
		'city'		=&gt; 'West Palm Beach',
		'state'		=&gt; 'FL',
		'postcode'	=&gt; '33401',
		'country'	=&gt; 'US',
	],

	'shipping'	=&gt; [
