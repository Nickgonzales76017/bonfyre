"h-8 w-8 animate-spin rounded-full border-[3px] border-slate-200 border-t-blue-600"></span><span class="text-[12.5px] font-semibold uppercase tracking-[0.08em] text-slate-400">Loading</span></div><!--/$--><footer class="mt-16 bg-navy-900 text-slate-400"><div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4"><div><div class="flex items-center gap-2.5"><img src="/fc_logo4.png" alt="" class="h-7 w-7"/><span class="font-bold tracking-tight text-white">Football Charts</span></div><p class="mt-3 max-w-xs text-[13px] leading-relaxed">Transparent football statistics and model predictions. Every number explained, every result published — wins and losses alike.</p></div><div><div class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Product</div><ul class="mt-3 space-y-2 text-[13.5px]"><li><a class="hover:text-white transition-colors" href="/">Today</a></li><li><a class="hover:text-white transition-colors" href="/predictions">Match Predictions</a></li><li><a class="hover:text-white transition-colors" href="/rankings">Team Rankings</a></li><li><a class="hover:text-white transition-colors" href="/charts/england/premier-league">League Charts</a></li></ul></div><div><div class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Popular leagues</div><ul class="mt-3 space-y-2 text-[13.5px]"><li><a class="hover:text-white transition-colors" href="/leagues/england/premier-league">Premier League</a></li><li><a class="hover:text-white transition-colors" href="/leagues/spain/laliga">LaLiga</a></li><li><a class="hover:text-white transition-colors" href="/leagues/germany/bundesliga">Bundesliga</a></li><li><a class="hover:text-white transition-colors" href="/leagues/italy/serie-a">Serie A</a></li></ul></div><div><div class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Company</div><ul class="mt-3 space-y-2 text-[13.5px]"><li><a class="hover:text-white transition-colors" href="/track-record">Track Record</a><