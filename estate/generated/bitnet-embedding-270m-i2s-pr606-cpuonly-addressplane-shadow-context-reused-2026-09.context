    <script>
    /* [2026-08-25] GAMES-STRIP COUNTDOWN. The strip is server-rendered + cached, so time
       labels ("TODAY") go stale exactly when a game matters most. This client pass upgrades
       each chip's label from its data-gts UTC stamp: started within the last 3h → "LIVE"
       (gold); starting within 90 min → "IN 42 MIN" (green); otherwise the server text stays.
       Cache-safe (HTML identical for everyone), no-JS/crawler fallback = server text. */
    (function () {
        function tick() {
            try {
                var els = document.querySelectorAll('.gm-when[data-gts]');
                if (!els.length) return;
                var now = Date.now();
                els.forEach(function (el) {
                    var ts = Date.parse(el.getAttribute('data-gts'));
                    if (!ts) return;
                    var mins = Math.round((ts - now) / 60000);
                    if (mins <= 0 && mins > -180) {
                        if (el.textContent !== 'LIVE') el.textContent = 'LIVE';
                        el.classList.add('gm-live'); el.classList.remove('gm-soon');
                    } else if (mins > 0 && mins <= 90) {
                        var t = 'IN ' + mins + ' MIN';
                        if (el.textContent !== t) el.textContent = t;
                        el.classList.add('gm-soon'); el.classList.remove('gm-live');
                    }
                    else if (mins > 90) {
                        /* [2026-08-29] VISITOR-LOCAL DAY LABEL: the server's "TODAY/TOMORROW"
                           is US-Eastern-based — wrong for AU/EU visitors much of the day
                           (a Sydney 9am reader sees "TONIGHT" games that are their tomorrow).
                           Recompute from the UTC stamp in the visitor's own clock. Month
                           rollovers fall through to the weekday name — still truthful. */
                        var d = new Date(ts), n2 = new Date(now);
                        var dd = (d.getFullYear() * 10000 + d.getMonth() * 100 + d.getDate())
                               - (n2.getFullYear() * 10000 + n2.getMonth() * 100 + n2.getDate());
                        var lbl = dd === 0 ? 'TODAY' : dd === 1 ? 'TOMORROW'
                                : ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'][d.getDay()];
                        if (el.textContent !== lbl) el.textContent = lbl;
                        el.classList.remove('gm-soon'); el.classList.remove('gm-live');
                    }
                    /* long-finished games: leave the server label untouched */
                });
            } catch (e) { }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick); else tick();
        setInterval(tick, 30000);
    })();

    /* [2026-08-29] GEO SPORT-ORDERING (max-conversion program #9). Region-relevant leagues
       first: an Australian sees AFL/NRL/Cricket lead the nav and the tonight cards, a Brit
       sees Soccer first, a Canadian NHL. Geo-personalization analogues measure 8-35% lifts.
       DISPLAY-ONLY: CSS `order` on flex/grid children — DOM order untouched, so crawlers see
       exactly what they saw before (the [class$="-wrapper"] safe-pattern precedent) and the
       shared page cache is untouched (identical HTML, client repaint). NEGATIVE orders so
       unlisted items and the nav's ::after underline filler (order 0, last in DOM) keep
       their places. US + unmapped regions: no-op, default order stands. */
    (function () {
        try {
            /* [2026-08-29 fix] bbRegion is set by the currency block LATER in the page —
               reading it at parse time always saw undefined and the module no-opped
               (caught in live verification). Resolve region lazily inside apply(). */
            var PRI = {
                AU: ['AFL', 'NRL', 'CRICKET', 'SOCCER', 'TENNIS', 'UFC'],
                NZ: ['NRL', 'CRICKET', 'AFL', 'SOCCER'],
                GB: ['SOCCER', 'TENNIS', 'UFC', 'NFL', 'NBA'],
                IE: ['SOCCER', 'TENNIS', 'UFC'],
                IN: ['CRICKET', 'SOCCER', 'TENNIS'], PK: ['CRICKET'], BD: ['CRICKET'], LK: ['CRICKET'],
                ZA: ['CRICKET', 'SOCCER', 'UFC'],
                CA: ['NHL', 'NBA', 'NFL', 'MLB'],
                DE: ['SOCCER', 'TENNIS'], FR: ['SOCCER', 'TENNIS'], ES: ['SOCCER', 'TENNIS'],
                IT: ['SOCCER', 'TENNIS'], NL: ['SOCCER', 'TENNIS'], PT: ['SOCCER'],
                BR: ['SOCCER', 'UFC'], MX: ['SOCCER', 'NFL'],
                SE: ['SOCCER', 'NHL', 'TENNIS'], NO: ['SOCCER', 'NHL'], DK: ['SOCCER', 'NHL']
            };
            var NAVMAP = { bbnAFL: 'AFL', bbnNRL: 'NRL', bbnCricket: 'CRICKET', bbnMLB: 'MLB', bbnNBA: 'NBA', bbnNFL: 'NFL', bbnNHL: 'NHL', bbnWNBA: 'WNBA', bbnNCAAF: 'NCAAF', bbnNCAAB: 'NCAAB', bbnSoccer: 'SOCCER', bbnTennis: 'TENNIS', bbnUFC: 'UFC' };
            var pri = null;
            function orderFor(key) { var i = pri.indexOf(key); return i < 0 ? null : String(i - 100); }
            function apply() {
                try {
                    pri = PRI[window.bbRegion || ''];
                    if (!pri) return;
                    document.querySelectorAll('.bbn-wrap > .bbn-tab').forEach(function (t) {
                        var k = NAVMAP[t.id]; if (!k) return;
                        var o = orderFor(k); if (o !== null) t.style.order = o;
                    });
                    document.querySelectorAll('.lgstrip > .lgx').forEach(function (card) {
                        var m = (card.getAttribute('data-bb-cta') || '').match(/home_league_([a-z]+)/);
                        if (!m) return;
                        var o = orderFor(m[1].toUpperCase()); if (o !== null) card.style.order = o;
                    });
                } catch (e) { }
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply); else apply();
        } catch (e) { }
    })();
    </script>
    <script>
    /* World-class games ticker: native touch momentum + mouse drag-to-scroll + edge-fade cues.
       Additive & guarded — never throws if the strip isn't on the page. */
    (function(){
        var el = document.getElementById('gstripScroll');
        if(!el) return;
        function fade(){
            var sl = el.scrollLeft, max = el.scrollWidth - el.clientWidth;
            el.classList.toggle('ovl', sl > 2);
            el.classList.toggle('ovr', sl < max - 2 && max > 2);
        }
        fade();
        el.addEventListener('scroll', fade, {passive:true});
        window.addEventListener('resize', fade);
        if (window.ResizeObserver){ try{ new ResizeObserver(fade).observe(el); }catch(_){} }
        // Mouse/pen drag-to-scroll (touch keeps native momentum, which is best on mobile).
        // IMPORTANT: only capture the pointer once a real drag begins. Capturing on pointerdown
        // redirects the follow-up click to this container, so a plain click never reaches the
        // <a class="gm"> link and navigation silently fails.
        var down=false, moved=false, sx=0, sl=0, pid=null;
        el.addEventListener('pointerdown', function(e){
            if(e.pointerType==='touch' || e.button!==0) return;
            down=true; moved=false; sx=e.clientX; sl=el.scrollLeft; pid=e.pointerId;
        });
        el.addEventListener('pointermove', function(e){
            if(!down) return;
            var dx=e.clientX-sx;
            if(!moved && Math.abs(dx)>4){ moved=true; el.classList.add('gdrag'); try{ el.setPointerCapture(pid); }catch(_){} }
            if(moved){ el.scrollLeft = sl - dx; }
        });
        function end(){ if(!down) return; down=false; el.classList.remove('gdrag'); if(pid!=null){ try{ el.releasePointerCapture(pid); }catch(_){} pid=null; } }
        el.addEventListener('pointerup', end);
        el.addEventListener('pointercancel', end);
        // Swallow the click that fires after a real drag so a swipe never triggers navigation.
        el.addEventListener('click', function(e){ if(moved){ e.preventDefault(); e.stopPropagation(); moved=false; } }, true);
    })();
    </script>

