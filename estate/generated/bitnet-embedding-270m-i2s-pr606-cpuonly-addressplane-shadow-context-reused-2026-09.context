    <script>
    /* [2026-08-20 owner] NAV-CTA COPY TEST — five arms, S1-architecture (owner: "the way the
       subscription modal does it"). Self-leaning split from bb-nav-weights.ashx (Laplace-
       smoothed, 8% floor, 10-min cache, fails open to even) — leans toward winners, never
       greedy, never starves an arm. Sticky per browser (localStorage bb_nav1).
       ARMS — each a distinct persuasion axis. ⛔ MESSAGE-MATCH LAW (owner, 2026-08-20): this
       button opens the SUBSCRIPTION MODAL, so every copy must honestly signal a membership
       door — never promise free content ("See today's picks" would bait-and-switch into a
       paywall and poison the data). All grade-6, header-width-safe, no winning-promises:
         geta   "Get access"    — incumbent control
         getmy  "Get my picks"  — first-person possessive, minimal pair with control (same
                                  verb, only the object changes; +90% CTR Unbounce/ContentVerve,
                                  10-40% in replications)
         unlock "Unlock picks"  — paid-gate signal + concrete noun (matches the site's own
                                  lock language on every gated row)
         gopro  "Go Pro"        — membership/status framing, the category's own convention
         stopg  "Stop guessing" — removed-downside/pain axis from the ICP research (the modal
                                  IS the answer to it — congruent, not bait)
       Judged on header unlock_click users (bb_src nav_<arm>) / exposed users (bb_nav_view,
       bb_variant); leaders read when sample supports it (~6+ weeks — five arms rank slower
       than two; the leaner spends the wait shifting traffic to whatever is ahead).
       Guardrail = revenue per opener. No peeking, no arm edits mid-flight.
       Cache-safe: the swap is client-side; shared cached HTML always holds control copy.
       Concurrent with the S1 step-1 test: S1 randomizes at modal OPEN, so a shift in who
       opens hits all five S1 arms evenly — both stay internally valid. */
    (function () {
        var COPY = { getmy: 'Get my picks', unlock: 'Unlock picks', gopro: 'Go Pro', stopg: 'Stop guessing' };
        var apply = function (arm) {
            if (COPY[arm]) {
                document.querySelectorAll('.bb-nav-cta').forEach(function (b) {
                    b.textContent = COPY[arm];
                    b.setAttribute('data-bb-cta', 'nav_' + arm);
                });
            }
            /* exposure ping only when the button is actually on screen for this visitor —
               subscribers have no nav CTA and must not enter the denominator. Sent to BOTH
               ledgers: GA4 (bb_nav_view + bb_variant) and /bb-event.ashx (NavView, arm in
               category) — the second feeds bb-nav-weights.ashx's live split. */
            var ping = function () {
                try {
                    if (!document.querySelector('.bb-nav-cta')) return;
                    if (window.gtag) gtag('event', 'bb_nav_view', { bb_variant: 'nav_' + arm, bb_page: location.pathname });
                    var q = '/bb-event.ashx?e=nav_view&c=' + arm + '&d=' + encodeURIComponent(location.pathname);
                    if (navigator.sendBeacon) navigator.sendBeacon(q); else (new Image()).src = q + '&i=1';
                } catch (e) { }
            };
            if (document.readyState === 'complete') ping();
            else window.addEventListener('load', ping);
        };
        var ARMS = ['geta', 'getmy', 'unlock', 'gopro', 'stopg'];
        var assign = function (w) {
            /* weighted-random over the live split, exactly like the S1 modal test */
            var r = Math.random(), acc = 0, arm = ARMS[0];
            for (var i = 0; i < ARMS.length; i++) {
                var p = (w && typeof w[ARMS[i]] === 'number') ? w[ARMS[i]] : 1 / ARMS.length;
                acc += p;
                if (r < acc) { arm = ARMS[i]; break; }
            }
            try { localStorage.setItem('bb_nav1', arm); } catch (e) { }
            apply(arm);
        };
        try {
            var arm; try { arm = localStorage.getItem('bb_nav1'); } catch (e) { }
            if (ARMS.indexOf(arm) >= 0) { apply(arm); return; }
            /* First visit: one fetch of the live weights, then sticky forever. The very first
               pageview can flash control copy for a beat; every later pageview swaps
               synchronously from the sticky assignment. Fetch failure = even split. */
            fetch('/bb-nav-weights.ashx').then(function (r) { return r.json(); })
                .then(assign)
                .catch(function () { assign(null); });
        } catch (e) { }
    })();
    </script>

