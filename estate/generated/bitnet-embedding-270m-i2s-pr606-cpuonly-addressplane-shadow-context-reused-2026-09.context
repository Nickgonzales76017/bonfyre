<!-- FAQ Section -->
<section class="pt-5">
  <div class="container">
    <div class="row section-title justify-content-center text-center">
      <div class="col-md-9 col-lg-8 col-xl-7">
        <h3 class="display-4 font-weight-bold">Frequently Asked Questions</h3>
        <div class="lead text-muted">Have more questions? Contact us at <a href="mailto:hello@WebScraping.AI">hello@WebScraping.AI</a></div>
      </div>
    </div>
    <div class="row justify-content-center">
      <div class="col-md-9 col-lg-8 col-xl-7">
        <div id="faq-accordion">
            <div class="card mb-2 mb-md-3">
              <a href="#accordion-1" data-toggle="collapse" role="button" aria-expanded="false" class="p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0 mr-2">Can I try it for free?</h6>
                  <img src="https://webscraping.ai/assets/icons/interface/icon-caret-right-89bf271ef719d487713476d392e00d0f7a6730b81b21c6902544e71dd39a0260.svg" alt="Caret Right" class="icon icon-sm">
                </div>
              </a>
              <div class="collapse" id="accordion-1" data-parent="#faq-accordion">
                <div class="px-3 px-md-4 pb-3 pb-md-4">
                  Yes! <a href="/auth/sign_up">Sign up for a free account</a> to get 2,000 API credits per month for free (with a maximum of 2 concurrent connections). No credit card required.
                </div>
              </div>
            </div>
            <div class="card mb-2 mb-md-3">
              <a href="#accordion-2" data-toggle="collapse" role="button" aria-expanded="false" class="p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0 mr-2">Do you offer pay-as-you-go pricing?</h6>
                  <img src="https://webscraping.ai/assets/icons/interface/icon-caret-right-89bf271ef719d487713476d392e00d0f7a6730b81b21c6902544e71dd39a0260.svg" alt="Caret Right" class="icon icon-sm">
                </div>
              </a>
              <div class="collapse" id="accordion-2" data-parent="#faq-accordion">
                <div class="px-3 px-md-4 pb-3 pb-md-4">
                  Yes. You can buy credits without any subscription: $1 buys 5,000 credits ($0.0002 per credit), with a $20 minimum top-up. Pay-as-you-go credits stay valid for 12 months, and every new top-up extends your entire balance for another 12 months. If you also have a subscription, pay-as-you-go credits are only consumed after your monthly plan quota runs out. Top up from your <a href="/dashboard/billing">billing dashboard</a>.
                </div>
              </div>
            </div>
            <div class="card mb-2 mb-md-3">
              <a href="#accordion-3" data-toggle="collapse" role="button" aria-expanded="false" class="p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0 mr-2">What happens when I change my plan?</h6>
                  <img src="https://webscraping.ai/assets/icons/interface/icon-caret-right-89bf271ef719d487713476d392e00d0f7a6730b81b21c6902544e71dd39a0260.svg" alt="Caret Right" class="icon icon-sm">
                </div>
              </a>
              <div class="collapse" id="accordion-3" data-parent="#faq-accordion">
                <div class="px-3 px-md-4 pb-3 pb-md-4">
                  If you downgrade, you'll stay on your current plan until the end of the billing period. If you upgrade, you'll be upgraded immediately, and unused credits from your old plan will be added to your new quota.
                </div>
              </div>
            </div>
            <div class="card mb-2 mb-md-3">
              <a href="#accordion-4" data-toggle="collapse" role="button" aria-expanded="false" class="p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0 mr-2">Do you offer refunds?</h6>
                  <img src="https://webscraping.ai/assets/icons/interface/icon-caret-right-89bf271ef719d487713476d392e00d0f7a6730b81b21c6902544e71dd39a0260.svg" alt="Caret Right" class="icon icon-sm">
                </div>
              </a>
              <div class="collapse" id="accordion-4" data-parent="#faq-accordion">
                <div class="px-3 px-md-4 pb-3 pb-md-4">
