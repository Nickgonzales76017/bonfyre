  <script>
    (function() {
      try {
        var themeData = localStorage.getItem('color-theme-data');
        var isDark = false;
        if (themeData) {
          var parsed = JSON.parse(themeData);
          if (Date.now() < parsed.expiry) {
            isDark = parsed.theme === 'dark';
          } else {
            localStorage.removeItem('color-theme-data');
            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        if (isDark) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var darkIcon = document.getElementById('theme-toggle-dark-icon');
      var lightIcon = document.getElementById('theme-toggle-light-icon');

      function setStored(theme) {
        localStorage.setItem('color-theme-data', JSON.stringify({
          theme: theme,
          expiry: Date.now() + (12 * 60 * 60 * 1000)
        }));
      }
      function syncIcons() {
        var isDark = document.documentElement.classList.contains('dark');
        if (darkIcon) darkIcon.toggleAttribute('hidden', isDark);
        if (lightIcon) lightIcon.toggleAttribute('hidden', !isDark);
      }
      syncIcons();

      btn.addEventListener('click', function() {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          setStored('light');
        } else {
          document.documentElement.classList.add('dark');
          setStored('dark');
        }
        syncIcons();
        document.dispatchEvent(new Event('dark-mode'));
      });
    });
  </script>

