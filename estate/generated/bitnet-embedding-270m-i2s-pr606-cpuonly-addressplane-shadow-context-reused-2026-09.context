<!-- How It Works Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row text-center justify-content-center mb-5">
      <div class="col-lg-8">
        <h2 class="display-4 font-weight-bold">How It Works</h2>
        <p class="lead text-muted">Three simple steps to extract data from any website</p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4 mb-4 mb-md-0">
        <div class="text-center">
          <div class="step-number mx-auto mb-4">1</div>
          <div class="step-icon mx-auto mb-3">
            <i class="fas fa-link fa-2x text-primary"></i>
          </div>
          <h4 class="font-weight-bold">Send a URL</h4>
          <p class="text-muted">Pass any URL to our API endpoint. We accept any website, including JavaScript-heavy SPAs.</p>
        </div>
      </div>
      <div class="col-md-4 mb-4 mb-md-0">
        <div class="text-center">
          <div class="step-number mx-auto mb-4">2</div>
          <div class="step-icon mx-auto mb-3">
            <i class="fas fa-cogs fa-2x text-primary"></i>
          </div>
          <h4 class="font-weight-bold">We Handle the Rest</h4>
          <p class="text-muted">Our infrastructure handles proxies, browser rendering, CAPTCHAs, and retries automatically.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="text-center">
          <div class="step-number mx-auto mb-4">3</div>
          <div class="step-icon mx-auto mb-3">
            <i class="fas fa-database fa-2x text-primary"></i>
          </div>
          <h4 class="font-weight-bold">Get Clean Data</h4>
          <p class="text-muted">Receive HTML, plain text, or AI-extracted structured JSON data ready for your application.</p>
        </div>
      </div>
    </div>
  </div>
</section>

