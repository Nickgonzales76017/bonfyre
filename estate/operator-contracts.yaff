  # certified by start alone, which records a prompt and runs nothing. The
  # endpoint is the managed local model; a contract for another names its own.
  invocation_kind native-process
  argv ${binary} ask --prompt ${input.path} --endpoint http://127.0.0.1:7000 --model Qwen1.5-MoE-A2.7B-Chat-Q2_K.gguf --max-tokens 128 --session ${mission.id}
