# Checked-in invocation contracts.  Templates are argv tokens, never shell.
contract artifact_file_v1
  invocation_kind native-process
  argv ${binary} file ${input.path}
  input_binding artifact
  output_discovery stdout
  environment PATH=/usr/bin:/bin
  working_directory mission.dir
  timeout_seconds 30
  output_limit_bytes 1048576
  retry_policy bounded:0
  workload_probe output-artifact
  quality_probe sha256-output

