contract meter_record_v1
  # Records the execution that produced the input, from the fabric's own event
  # for it: its receipt, when it started, how long it ran, and the measured
  # size of what it produced.
  invocation_kind native-process
  argv ${binary} record --key ${mission.id} --op operator-execution --bytes-of ${input.path} --receipt ${input.receipt} --attempt-ref ${input.receipt} --realization-ref ${input.uri} --at ${input.receipt_at} --duration ${input.receipt_duration_ms} --db ${output.dir}/meter.sqlite
  input_binding artifact
  output_discovery stderr
  environment PATH=/usr/bin:/bin
  working_directory mission.dir
  timeout_seconds 60
  output_limit_bytes 1048576
  retry_policy bounded:0
  workload_probe output-artifact
  quality_probe artifact-integrity

