contract tel_selftest_v1
  # The bound program starts a FreeSWITCH that has only its event socket on
  # loopback and calls that stay inside it, places a call through the organ,
  # asks the switch whether the call exists, hangs it up and asks again.
  # Nothing reaches a trunk or the telephone network.
  invocation_kind native-process
  argv ${binary}
  input_binding artifact
  output_discovery stdout-json
  environment PATH=/opt/homebrew/bin:/usr/bin:/bin,TMPDIR=/tmp
  working_directory mission.dir
  timeout_seconds 120
  output_limit_bytes 1048576
  retry_policy bounded:0
  workload_probe output-artifact
  quality_probe json-schema
