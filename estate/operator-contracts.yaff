  invocation_kind native-process
  argv ${binary} train --activations ${input.path} --dim 896 --features 16 --layer 12 --family qwen2.5-coder-0.5b-instruct --out ${output.dir}/dictionary.bfsae
  input_binding artifact
  output_discovery stdout
  environment PATH=/usr/bin:/bin
