# Copy to /etc/bonfyre/address-plane.env and set paths for the independently
# owned stores. None of these values confer authority to the AddressPlane.
BONFYRE_ADDRESS_INDEX=/var/lib/bonfyre/state/address-plane.db
# ExternalEstate remains the exact owner for occurrence topics.  The lowerer
# receives this read-only owner path only to recheck a typed handoff before it
# can create a ForeignTwin observation demand.
BONFYRE_EXTERNAL_ESTATE_DB=/var/lib/bonfyre/state/external-estate.db
BONFYRE_CMS_DB=/var/lib/bonfyre/state/cms.db
# The advertised TargetObligation and its recompiler must name the same owner
# database. That database also contains the exact owner stores PredicateRef
# evaluation needs; AddressPlane receives only its non-owning advertisements.
BONFYRE_TARGET_DB=/var/lib/bonfyre/state/institutional-owners.db
BONFYRE_INVERSE_DB=/var/lib/bonfyre/state/institutional-owners.db
BONFYRE_PROVIDER_DB=/var/lib/bonfyre/state/provider-state.db
BONFYRE_MODEL_DB=/var/lib/bonfyre/state/model-catalog.db
BONFYRE_PROTOCOLS_JSONL=/opt/bonfyre/cmd/BonfyreExperienceMap/generated/protocols.jsonl
BONFYRE_MCP_URL=http://127.0.0.1:8790/mcp
BONFYRE_MCP_TOKEN_FILE=/etc/bonfyre/mcp.token
BONFYRE_FACT_DELTAS=/var/lib/bonfyre/fact-deltas
BONFYRE_LOWERER_INBOX=/var/lib/bonfyre/lowerer-inbox
BONFYRE_PHYSICAL_REGISTRY_DB=/var/lib/bonfyre/state/physical-registry.db
BONFYRE_PHYSICAL_COMPILER=/usr/local/bin/bonfyre-compress
# ResourceAdmission controls only the transient compiled-passport build
# aperture. It does not make an advertised representation authoritative.
BONFYRE_ADMISSION_DB=/var/lib/bonfyre/state/resource-admission.db
BONFYRE_PHYSICAL_ADMISSION_VOLUME=/var/lib/bonfyre
BONFYRE_PHYSICAL_ADMISSION_PLANE=physical-compiler
BONFYRE_ADDRESS_DELTA_LIMIT=256
BONFYRE_LOWERING_WORKER_DB=/var/lib/bonfyre/lowering-workers.db
# The same verified system image gates both derived forwarding publication and
# its typed lowerer consumers. It is a consistency reference, never authority.
BONFYRE_OWNER_CONTRACT_IMAGE=/var/lib/bonfyre/state/owner-contract-image.json
# Authenticated closure acquisition remains MCP's responsibility. This is a
# short-lived, token-free snapshot consumed by the derived projection worker.
BONFYRE_MCP_CLOSURE_SNAPSHOT=/var/lib/bonfyre/mcp/closure.json
BONFYRE_FOREIGN_OBSERVATION_DEMANDS=/var/lib/bonfyre/foreign/observation-demands
# MaterialCompiler consumes exact receipt references after a ForeignTwin delta;
# it never reconstructs material from a topic string or asks the carrier again.
BONFYRE_FOREIGN_RECEIPTS=/var/lib/bonfyre/foreign/receipts
# ResourceWeather is a whole-census physical standing snapshot. Its refresh
# worker publishes only --dry-run Project output, diffs it durably, then wakes
# matching held MaterialLeases. WebSub/ForeignTwin separately own all reads.
BONFYRE_RESOURCE_WEATHER_SNAPSHOT=/var/lib/bonfyre/foreign/weather.json
BONFYRE_RESOURCE_WEATHER_TRANSITION_DB=/var/lib/bonfyre/state/resource-weather-transition.db
BONFYRE_RESOURCE_WEATHER_REHEAT_DB=/var/lib/bonfyre/state/material-weather-reheat.db
BONFYRE_MATERIAL_WEATHER_GATE_DB=/var/lib/bonfyre/state/material-weather-gate.db
BONFYRE_MATERIAL_LEASE_DB=/var/lib/bonfyre/state/material-lease.db
BONFYRE_MATERIAL_ACQUIRE_DIR=/var/lib/bonfyre/material/acquire
BONFYRE_MATERIAL_CANCEL_DIR=/var/lib/bonfyre/material/cancel
BONFYRE_MATERIAL_ADMITTED_DIR=/var/lib/bonfyre/lowerer-inbox
BONFYRE_RESOURCE_WEATHER_DELTA_DIR=/var/lib/bonfyre/resource-weather-deltas
