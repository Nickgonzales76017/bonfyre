# Read-only source-candidate estate service; Nginx exposes /external-estate/.
AUREKAI_REPO_ROOT=/opt/bonfyre
AUREKAI_EXTERNAL_ESTATE_PORT=8792
AUREKAI_EXTERNAL_ESTATE_BASE_PATH=/external-estate
# The public World product asks the native AddressPlane to witness the same
# World mask cut. Set REQUIRE=1 only once this index is deployed alongside the
# public corpus; it then fails closed rather than silently falling back.
BONFYRE_ADDRESS_INDEX=/var/lib/bonfyre/state/address-plane.db
BONFYRE_ADDRESSPLANE_BINARY=/usr/local/bin/bonfyre-external-estate
BONFYRE_WORLD_REQUIRE_NATIVE_FORWARDING=1
