BONFYRE_MATRIX_DB=/var/lib/bonfyre/matrix.db
BONFYRE_WEB_ADDRESS_PORT=8787
BONFYRE_SITE_ROOT=/opt/bonfyre/site/matrix
# Optional existing inquiry form. Omit to publish no contact route; this never
# prices capabilities or enables paid execution.
# BONFYRE_CAPABILITY_INQUIRY_URL=https://your-service.example/inquiry
BONFYRE_AUTH_DB=/var/lib/bonfyre/auth.db
# The address edge invokes the native CMS binary for authenticated HTMX writes.
# These must name the same durable owner used by the deployed Content Studio;
# keeping this database separate from a developer's ~/.bonfyre store prevents
# an accidental local/prod split from looking like a published empty CMS.
BONFYRE_BIN_DIR=/usr/local/bin
BONFYRE_FOREIGN_DISCOVER_BIN=/opt/bonfyre/native-src/scripts/foreign-discover.mjs
BONFYRE_CMS_BINARY=/usr/local/bin/bonfyre-cms
BONFYRE_CMS_DB=/var/lib/bonfyre/cms/bonfyre_cms.db
BONFYRE_CMS_SCHEMAS=/var/lib/bonfyre/cms/content-types
# Observed economic records remain a separate ledger. ForeignTwin reads its
# source-alignment status, never a made-up offer or settlement.
BONFYRE_PRICES_DB=/var/lib/bonfyre/economics/prices.db
# Shared durable input for the AddressPlane worker. A delta is only a declared
# write set; the worker calculates the dependent cut and queues lowerers.
BONFYRE_FACT_DELTAS=/var/lib/bonfyre/fact-deltas
# Disposable anonymous HTML closures. This contains compiled public responses,
# never CMS truth, actor closure, authority, evidence, or effect state.
BONFYRE_PUBLIC_PROJECTION_DB=/var/lib/bonfyre/state/public-projection-cache.db
