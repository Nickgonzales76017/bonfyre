/* Shared PageComposition controls */
.page-item-continuations{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;margin:10px 0 4px;font:600 12px/1.45 system-ui}.page-item-continuations a{min-height:36px;display:inline-flex;align-items:center;color:var(--w-accent,#d0fc4f);text-underline-offset:3px}.page-item-continuations a:focus-visible{outline:2px solid currentColor;outline-offset:3px}@media(max-width:390px){.page-item-continuations{gap:4px 12px}.page-item-continuations a{min-height:44px}}
.agenda-tools{display:grid;grid-template-columns:auto minmax(190px,1fr) auto;align-items:end;gap:12px 18px;padding:21px 24px;margin:18px 0 18px;border:1px solid var(--w-rule,#444935);border-radius:17px;background:var(--w-panel,#171d19);color:var(--w-ink,#dee4dd);font:14px/1.45 system-ui}.agenda-tools .agenda-choices{display:flex;flex-wrap:wrap;gap:7px}.agenda-tools button{min-height:44px;padding:9px 16px;border:1px solid var(--w-rule,#444935);border-radius:999px;color:inherit;background:transparent;font:600 13px/1.2 system-ui;cursor:pointer}.agenda-tools button[aria-pressed=true]{background:var(--w-accent,#d0fc4f);color:var(--w-ground,#0f1511);border-color:var(--w-accent,#d0fc4f)}.agenda-tools label{display:grid;gap:6px;font:600 12px/1.2 system-ui;min-width:0}.agenda-tools input{width:100%;min-width:0;min-height:44px;padding:9px 12px;border:1px solid var(--w-rule,#444935);background:var(--w-ground,#0f1511);color:var(--w-ink,#dee4dd);border-radius:8px}.agenda-tools output{font:12px/1.4 system-ui}.agenda-tools small{grid-column:1/-1;color:var(--w-muted,#c5c9af)}ol.agenda li[hidden]{display:none!important}.agenda-tools :is(button,input):focus-visible{outline:2px solid var(--w-accent,#d0fc4f);outline-offset:3px}@media(max-width:760px){.agenda-tools{grid-template-columns:1fr 1fr;padding:17px}.agenda-tools .agenda-choices{grid-column:1/-1}.agenda-tools label{grid-column:1/-1}}@media(max-width:530px){.agenda-tools{grid-template-columns:1fr}.agenda-tools output{grid-column:1/-1}}@media(prefers-reduced-motion:reduce){.agenda-tools *{transition:none!important}}
.media-catalogue-controls{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,300px);gap:12px 20px;align-items:center;margin:0 0 24px;padding:17px 0;border-bottom:1px solid var(--w-rule,#444935)}.media-catalogue-controls .media-modes{display:flex;flex-wrap:wrap;gap:8px}.media-catalogue-controls button{min-height:44px;padding:8px 13px;border:1px solid var(--w-rule,#444935);color:inherit;background:transparent;border-radius:999px;cursor:pointer}.media-catalogue-controls button[aria-pressed=true]{border-color:var(--w-accent,#d0fc4f);color:var(--w-ground,#0f1511);background:var(--w-accent,#d0fc4f)}.media-catalogue-controls label{display:grid;gap:5px;font:600 12px/1.4 system-ui}.media-catalogue-controls input{min-height:44px;width:100%;min-width:0;padding:10px;border:1px solid var(--w-rule,#444935);color:inherit;background:transparent;border-radius:8px}.media-catalogue-controls output{grid-column:1/-1;font:12px/1.4 system-ui}.media-catalogue .page-media-card[hidden]{display:none!important}.media-catalogue[data-media-view=list] .video-grid{display:grid;grid-template-columns:minmax(0,1fr)!important}.media-catalogue[data-media-view=list] .page-media-card{display:grid;grid-template-columns:minmax(96px,170px) minmax(0,1fr);column-gap:22px;padding:16px 0;border-bottom:1px solid var(--w-rule,#444935);align-items:start}.media-catalogue[data-media-view=list] .page-media-card>a.video{grid-column:1}.media-catalogue[data-media-view=list] .page-media-card>.page-item-continuations{grid-column:2}.media-catalogue .media-catalogue-proof{display:flex;flex-wrap:wrap;gap:5px 12px;font:11px/1.5 system-ui;color:var(--w-muted,#c5c9af);overflow-wrap:anywhere}.media-catalogue .media-catalogue-proof .terms{max-width:100%}@media(max-width:740px){.media-catalogue-controls{grid-template-columns:1fr}.media-catalogue[data-media-view=list] .page-media-card{grid-template-columns:1fr}.media-catalogue[data-media-view=list] .page-media-card>*{grid-column:1!important}}
.feed-tools{display:grid;grid-template-columns:minmax(0,1fr) minmax(160px,260px);gap:12px;padding:18px 0;margin:0 0 20px;border-bottom:1px solid var(--w-rule,#444935);align-items:center}.feed-modes{display:flex;gap:8px;flex-wrap:wrap}.feed-modes button{min-height:44px;border:1px solid var(--w-rule,#444935);border-radius:999px;padding:10px 13px;background:transparent;color:inherit;cursor:pointer}.feed-modes button[aria-pressed=true]{background:var(--w-accent,#d0fc4f);color:var(--w-ground,#0f1511)}.feed-tools label{display:grid;gap:5px;font:600 12px/1.4 system-ui}.feed-tools input{min-width:0;width:100%;min-height:44px;padding:9px;border:1px solid var(--w-rule,#444935);border-radius:8px;background:var(--w-ground,#0f1511);color:inherit}.feed-tools output{grid-column:1/-1;font:12px/1.5 system-ui;color:var(--w-muted,#c5c9af)}.feed article[hidden]{display:none!important}@media(max-width:720px){.feed-tools{grid-template-columns:1fr}}
.map-inspector{margin:20px 0 0;padding:22px;border:1px solid #60765e;border-radius:16px;background:var(--w-panel,#171d19);color:inherit}.map-inspector[hidden]{display:none!important}.map-inspector h3{font:600 24px/1.2 system-ui;margin:0 0 12px}.map-inspector [data-map-inspector-body]{display:grid;gap:8px;overflow-wrap:anywhere}.map-inspector [data-map-inspector-body] a{display:inline-flex;align-items:center;min-height:44px;color:var(--w-accent,#d0fc4f);text-decoration:underline;text-underline-offset:3px}.map-inspector p{font:12px/1.5 system-ui}.map-inspector button{min-height:44px;border:1px solid #60765e;border-radius:9px;padding:10px 14px;background:transparent;color:inherit;cursor:pointer}@media(max-width:620px){.map-inspector{padding:16px}}.map-tools{display:flex;gap:12px;align-items:end;flex-wrap:wrap;padding:12px 0 18px}.map-tools label{display:grid;gap:5px;flex:1 1 190px;max-width:460px;font:600 12px/1.5 system-ui}.map-tools input{width:100%;min-height:44px;padding:10px;border:1px solid #6e806c;border-radius:8px;background:transparent;color:inherit}.map-tools output{font:12px/1.5 system-ui}.places-list [data-locate-point]{min-height:42px;margin-right:10px;border:1px solid #6e806c;border-radius:8px;background:transparent;color:inherit;cursor:pointer}.places-list [data-locate-point][aria-pressed=true]{background:#d0fc4f;color:#0f1511}.places-list li[hidden]{display:none!important}.map .point[data-selected=true] :is(circle){stroke:#d0fc4f;stroke-width:3;fill:#f0af46}.map circle.point[data-selected=true]{stroke:#d0fc4f;stroke-width:2;fill:#f0af46}@media(max-width:620px){.map-tools{display:grid}}
.media-space-catalogue{margin:24px 0 42px;padding:24px;border:1px solid var(--w-rule,#444935);border-radius:18px;background:var(--w-panel,#171d19)}.media-space-heading{display:flex;gap:12px;align-items:center;margin:0 0 12px}.media-space-heading .ak-icon{width:26px;height:26px}.media-space-controls{display:grid;grid-template-columns:minmax(200px,1fr) auto;gap:12px 18px;align-items:end;margin:16px 0}.media-space-controls label{display:grid;gap:7px;font:600 12px/1.4 system-ui;min-width:0}.media-space-controls input{min-height:44px;width:100%;min-width:0;padding:10px;border-radius:9px;background:var(--w-ground,#0f1511);color:inherit;border:1px solid var(--w-rule,#444935)}.media-space-controls output{grid-column:1/-1;font:12px/1.4 system-ui}.media-space-modes{display:flex;gap:7px;flex-wrap:wrap}.media-space-modes button{min-height:44px;border:1px solid var(--w-rule,#444935);border-radius:99px;background:transparent;color:inherit;padding:8px 14px;cursor:pointer}.media-space-modes [aria-pressed=true]{background:var(--w-accent,#d0fc4f);color:var(--w-ground,#0f1511)}.media-space-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,265px),1fr));gap:12px;list-style:none;margin:0;padding:0}.media-space-cards li{padding:18px;border:1px solid var(--w-rule,#444935);border-radius:13px;min-width:0}.media-space-cards li[hidden]{display:none!important}.media-space-cards h3{font:600 clamp(18px,2vw,23px)/1.2 system-ui;margin:9px 0}.media-space-cards p{line-height:1.5;margin:8px 0}.media-space-cards small{color:var(--w-muted,#c5c9af)}.media-space-catalogue a{color:inherit;text-underline-offset:3px}.media-space-catalogue a:focus-visible,.media-space-catalogue :is(input,button):focus-visible{outline:2px solid var(--w-accent,#d0fc4f);outline-offset:3px}@media(max-width:650px){.media-space-catalogue{padding:14px}.media-space-controls{grid-template-columns:1fr}.media-space-cards{grid-template-columns:1fr}}
