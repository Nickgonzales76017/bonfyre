/* account-connections presentation */
.external{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.external-item{display:flex!important;flex-direction:column;gap:12px!important;min-height:205px;padding:20px!important;animation:ak-connection-rise .48s both}.external-item:nth-child(2n){animation-delay:.08s}.connection-mark{display:grid;place-items:center;width:54px;height:54px;border-radius:16px;background:linear-gradient(135deg,#1a4834,#80af74);color:white;font:700 23px 'DM Sans',system-ui}.connection-body{display:grid;gap:6px;min-width:0}.connection-provider{color:var(--live);font:500 10px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.13em}.connection-body>a{font-size:19px!important;text-decoration:none}.connection-body>small{overflow-wrap:anywhere;color:var(--dim)}.connection-proof{align-self:start;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--rule);border-radius:999px;padding:7px 11px;font:500 10px 'DM Mono',monospace}.connection-proof:before{content:'';height:7px;width:7px;background:var(--warm);border-radius:50%}.external-item[data-connection-proof=verified] .connection-proof:before{background:var(--live)}.connection-explainer{margin-top:auto!important;font-size:11px!important}.external-item .remove{position:absolute;top:14px;right:14px;background:var(--paper);border:1px solid var(--rule);border-radius:99px;padding:7px 10px}.external-item[hidden]{display:none!important}.connection-filters{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}.connection-filters input{min-width:120px;flex:1;border-radius:12px;background:var(--paper)}.connection-filters select{padding:10px;background:var(--paper);color:var(--ink);border:1px solid var(--rule);border-radius:12px}.connection-count{color:var(--dim);font:500 11px 'DM Mono',monospace}@keyframes ak-connection-rise{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}@media(max-width:1100px){.external{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.external-item{animation:none}}
