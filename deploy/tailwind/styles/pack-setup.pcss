/* Pack setup layout */
.pack-workspace{max-width:1120px;margin:auto;padding:42px 24px 80px}.pack-workspace h1{font-size:clamp(2rem,5vw,3.7rem);line-height:1.08}.pack-workspace h2{font-size:1.25rem}.pack-grid{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:32px;margin-top:30px}.pack-panel{padding:24px;border:1px solid currentColor;border-radius:12px;min-width:0}.pack-panel p{line-height:1.6}.pack-workspace select,.pack-workspace button{min-height:44px;font:inherit;padding:10px 14px;border-radius:8px}.pack-workspace select{max-width:100%}.pack-workspace button{cursor:pointer}.pack-workspace form{margin:14px 0}.pack-workspace code{overflow-wrap:anywhere;font-size:.8rem}.pack-workspace table{width:100%;border-collapse:collapse;font-size:.94rem}.pack-workspace th,.pack-workspace td{padding:14px 6px;text-align:left;border-bottom:1px solid currentColor;overflow-wrap:anywhere}.pack-workspace td:first-child{max-width:250px}.pack-actions{display:flex;gap:12px;flex-wrap:wrap}.pack-link{display:block;overflow-wrap:anywhere;line-height:1.6}.pack-status{font-weight:700}.pack-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}.pack-warning{padding:18px;border:2px solid currentColor;border-radius:10px}@media(max-width:760px){.pack-grid{grid-template-columns:1fr}.pack-workspace{padding:28px 16px}.pack-panel{padding:18px}.pack-workspace table{font-size:.85rem}}
