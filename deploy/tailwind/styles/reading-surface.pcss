/* Discover, Watch and Board reading surfaces */
body[data-character]:is(.route-discover,.route-watch,.route-board) .wrap>.hero{margin:clamp(18px,3vw,34px) 0 0;padding:clamp(26px,4vw,52px);border:1px solid var(--w-rule);border-radius:24px;background:color-mix(in srgb,var(--w-accent) 10%,var(--w-ground))}body[data-character]:is(.route-discover,.route-watch,.route-board) .wrap>.hero h1{display:flex;align-items:center;gap:clamp(12px,2vw,24px);font-size:clamp(3rem,7vw,6.5rem);animation:none}body[data-character]:is(.route-discover,.route-watch,.route-board) .reading-mark{display:grid;place-items:center;flex:none;width:clamp(48px,5vw,70px);height:clamp(48px,5vw,70px);border-radius:18px;background:var(--w-accent);color:var(--w-ground)}body[data-character]:is(.route-discover,.route-watch,.route-board) .reading-mark .ak-icon{width:48%;height:48%}body[data-character]:is(.route-discover,.route-watch,.route-board) .wrap>.hero .lede{margin-top:18px;max-width:54ch;font-size:clamp(1.05rem,1.5vw,1.35rem);line-height:1.45}body[data-character]:is(.route-discover,.route-watch,.route-board) .wrap>.region{padding-block:clamp(32px,5vw,64px)}body[data-character]:is(.route-discover,.route-watch,.route-board) .video-grid{gap:16px}body[data-character]:is(.route-discover,.route-watch,.route-board) .video{padding:12px;border:1px solid var(--w-rule);border-radius:18px;background:var(--w-panel);text-decoration:none}body[data-character]:is(.route-discover,.route-watch,.route-board) .video .frame{background:linear-gradient(135deg,var(--w-panel),color-mix(in srgb,var(--w-accent) 28%,var(--w-ground)))}body[data-character]:is(.route-discover,.route-watch,.route-board) .video .play{width:44px;height:44px;background:var(--w-accent);color:var(--w-ground)}body[data-character]:is(.route-discover,.route-watch,.route-board) .video .play .ak-icon{width:20px;height:20px}body[data-character]:is(.route-discover,.route-watch,.route-board) .video .by{margin:8px 0 4px}body[data-character]:is(.route-discover,.route-watch,.route-board) .tile{border:1px solid var(--w-rule);border-radius:16px;overflow:hidden;background:var(--w-panel)}body[data-character]:is(.route-discover,.route-watch,.route-board) .tile>a{padding:14px;text-decoration:none}body[data-character]:is(.route-discover,.route-watch,.route-board) .tile .frame{margin:-14px -14px 14px}body[data-character]:is(.route-discover,.route-watch,.route-board) .pin{border:1px solid var(--w-rule);background:var(--w-panel)}body[data-character]:is(.route-discover,.route-watch,.route-board) .pin .cap{position:static;opacity:1;background:none;color:var(--w-ink);padding:12px}body[data-character]:is(.route-discover,.route-watch,.route-board) :is(.video,.pin,.tile a):focus-visible{outline:3px solid var(--w-accent);outline-offset:3px}@media(max-width:700px){body[data-character]:is(.route-discover,.route-watch,.route-board) .wrap>.hero{border-radius:18px;padding:24px 20px}body[data-character]:is(.route-discover,.route-watch,.route-board) .wrap>.hero h1{font-size:clamp(2.6rem,11vw,4rem)}body[data-character]:is(.route-discover,.route-watch,.route-board) .reading-mark{width:44px;height:44px;border-radius:13px}}
