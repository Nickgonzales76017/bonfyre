/*! Generated from deploy/tailwind/styles/matrix-aperture.pcss; do not edit this output. */
/* Matrix aperture: server-fragment interaction styling, kept with the surface. */
.aperture{padding:96px 0 112px;border-top:1px solid var(--ink)}.aperture-copy{display:grid;grid-template-columns:1.1fr .9fr;gap:58px;align-items:end}.aperture-copy h2{grid-column:1;margin:0;font-size:clamp(44px,5.3vw,76px);font-weight:500;letter-spacing:-.072em;line-height:.92}.aperture-copy h2 em{font-family:'Instrument Serif',Georgia,serif;font-weight:400}.aperture-copy>p:not(.eyebrow){grid-column:2;margin:0;color:#526159;font-size:16px;line-height:1.55}.aperture-copy .eyebrow{grid-column:1/-1;margin-bottom:-30px}.aperture-grid{display:grid;grid-template-columns:1.14fr 1fr 1fr;margin-top:57px;border-top:1px solid var(--ink);border-left:1px solid var(--ink)}.aperture-card{display:flex;min-height:320px;flex-direction:column;align-items:flex-start;padding:21px 19px;border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);background:#e9e9df;transition:.2s ease}.aperture-card:hover{position:relative;z-index:1;transform:translateY(-6px);box-shadow:10px 11px 0 var(--ink);background:#e0ebcf}.aperture-card.intake{color:#e7efe0;background:#16251f}.aperture-card.intake:hover{background:#223e2f}.aperture-card span{color:#64746b;font:500 9px 'DM Mono',monospace;letter-spacing:.05em}.aperture-card.intake span{color:#a9b9ad}.aperture-card h3{max-width:255px;margin:57px 0 9px;font-size:27px;line-height:.93;letter-spacing:-.06em}.aperture-card p{max-width:300px;margin:0;color:#56665d;font-size:13px;line-height:1.48}.aperture-card.intake p{color:#b5c4b9}.aperture-card b{margin-top:auto;padding-top:22px;font-size:12px;font-weight:600}.aperture-card b em{margin-left:8px;color:#779e24;font-size:16px;font-style:normal}.aperture-card label{margin:24px 0 7px;color:#a9b9ad;font:500 9px 'DM Mono',monospace;letter-spacing:.05em;text-transform:uppercase}.aperture-card input{width:100%;border:0;border-bottom:1px solid rgba(232,243,226,.38);border-radius:0;padding:9px 0;color:#edf6e6;background:transparent;font:500 14px 'DM Mono',monospace;outline:none}.aperture-card input::placeholder{color:#7f9285}.aperture-card input:focus{border-color:var(--lime)}.aperture-card .button{width:100%;margin-top:17px;border-color:#dcebd2;color:#1c3023;background:#dcebd2}.aperture-card .button span{color:#648e26;font-size:17px}.intake-result{width:100%;margin-top:12px}.intake-result p{margin:0;color:#dcebd2}.intake-result .button{display:block;text-decoration:none;text-align:center}@media(max-width:850px){.aperture-copy{grid-template-columns:1fr;gap:40px}.aperture-copy .eyebrow,.aperture-copy h2,.aperture-copy>p:not(.eyebrow){grid-column:auto}.aperture-copy .eyebrow{margin-bottom:-22px}.aperture-grid{grid-template-columns:1fr}}@media(max-width:560px){.aperture{padding:70px 0}.aperture-card{min-height:250px}.aperture-card h3{margin-top:35px}}

/* Pages opened with BF_PAGE_OPEN (x402_capability_and_aperture_forms.h) sit in
   the one shell: the Stitch ground, the estate bar and footer. The doors grammar
   they share was an inline <style> in that macro; it lives here now. */
html:has(body.ak-page),body.ak-page{--ink:var(--ak-on-surface);--paper:var(--ak-surface);--line:var(--ak-outline-variant);--lime:var(--ak-primary);--accent:var(--ak-primary)}
body.ak-page .wrap{width:min(1360px,calc(100% - 2*clamp(16px,3vw,32px)));margin-inline:auto}
body.ak-page .hero{padding:clamp(28px,5vw,64px) 0 clamp(12px,2vw,24px)}
body.ak-page .hero h1{font:600 clamp(2.3rem,5.2vw,4.4rem)/1.03 var(--ak-sans);letter-spacing:-.035em;color:var(--ak-on-surface)}
body.ak-page .hero h1 em{font-family:var(--ak-serif);font-weight:400;font-style:italic;color:var(--ak-primary)}
body.ak-page .lede{max-width:62ch;font:400 clamp(1.05rem,1.5vw,1.3rem)/1.5 var(--ak-serif);color:var(--ak-on-variant)}
body.ak-page .lede a{color:var(--ak-primary)}
body.ak-page .eyebrow{color:var(--ak-primary);font:500 11px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.14em}
body.ak-page .eyebrow i{background:var(--ak-primary);box-shadow:0 0 0 4px color-mix(in srgb,var(--ak-primary) 18%,transparent)}
body.ak-page .doors{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px;margin:28px 0 56px}
body.ak-page :is(.surface-title,.surface-caption){grid-column:1/-1;margin:0;padding:8px 0 0}
body.ak-page .surface-title{font:500 11px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
body.ak-page .surface-caption{max-inline-size:none;color:var(--ak-on-variant);font-size:14px;line-height:1.5;padding-bottom:8px}
body.ak-page .lens-panel{content-visibility:auto;contain-intrinsic-size:auto 600px}
body.ak-page .surface-record{margin:0;padding:18px 20px;display:grid;grid-template-columns:auto 1fr;gap:2px 14px;align-content:start;font-size:14px;border:1px solid var(--ak-outline-variant);border-radius:18px;background:var(--ak-surface-low)}
body.ak-page .surface-record dt{font:500 10.5px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant);align-self:center}
body.ak-page .surface-record dd{margin:0;color:var(--ak-on-surface);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
body.ak-page .surface-record dd:empty::after{content:"\2014";color:var(--ak-outline)}
body.ak-page .door{display:flex;flex-direction:column;min-height:220px;padding:22px 20px;border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-low);transition:border-color .2s ease,background .2s ease}
body.ak-page .door:hover{border-color:var(--ak-primary);background:var(--ak-surface-mid)}
body.ak-page .door h3{margin:12px 0 8px;font:600 1.45rem/1.15 var(--ak-sans);letter-spacing:-.025em;color:var(--ak-on-surface);overflow-wrap:anywhere}
body.ak-page .door p{margin:0 0 16px;color:var(--ak-on-variant);font-size:14px;line-height:1.5}
body.ak-page .door .ways{margin-top:auto;display:flex;flex-wrap:wrap;gap:6px}
body.ak-page .way{display:inline-flex;align-items:center;padding:5px 11px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:500 11px/1.2 'DM Mono',monospace;color:var(--ak-on-variant);text-decoration:none}
body.ak-page .way:hover{border-color:var(--ak-primary);color:var(--ak-primary)}
body.ak-page .price{margin:0 0 4px;font:500 22px 'DM Mono',monospace;letter-spacing:-.03em;color:var(--ak-primary)}
body.ak-page .price small{font-size:11px;color:var(--ak-on-variant);letter-spacing:.04em}
body.ak-page .unpriced{color:var(--ak-on-variant)}
body.ak-page pre{overflow-x:auto;padding:14px 16px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-lowest);color:var(--ak-on-variant);font:400 13px/1.6 'DM Mono',monospace}
