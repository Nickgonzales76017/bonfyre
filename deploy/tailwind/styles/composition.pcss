/*! Generated from deploy/tailwind/styles/composition.pcss; do not edit this output. */
/* Composition patterns chosen per route by route_presentation rows in the CMS
   (cmd/BonfyreCMS/content-types/route_presentation.json). Presentation only. */
body[data-aurekai-pattern]{--ak-comp-accent:var(--w-accent,#d0fc4f);--ak-comp-line:var(--w-rule,rgba(140,160,130,.24));--ak-comp-panel:var(--w-panel,rgba(125,145,115,.09));--ak-comp-gap:clamp(20px,3vw,44px)}
body[data-aurekai-pattern] :is(.wrap,.bf-native-layout){width:min(calc(100% - clamp(24px,5vw,80px)),1440px);max-width:1440px;margin-inline:auto}
body[data-aurekai-pattern] :is(.wrap>.hero,.bf-native-masthead){padding-block:clamp(28px,5vw,76px);border-bottom:1px solid var(--ak-comp-line)}
body[data-aurekai-pattern] :is(.wrap>.hero h1,.bf-native-masthead h1){font-size:clamp(2.3rem,5vw,5.4rem);letter-spacing:-.055em;line-height:1.02;text-wrap:balance}
body[data-aurekai-pattern] :is(.wrap>.region,.bf-native-slot){padding-block:var(--ak-comp-gap);border-bottom:1px solid var(--ak-comp-line)}
body[data-aurekai-pattern] :is(a,button,input,select,textarea):focus-visible{outline:2px solid var(--ak-comp-accent);outline-offset:3px}
body[data-aurekai-pattern=reader] :is(p,li){line-height:1.75}
body[data-aurekai-pattern=reader] .wrap{max-width:1100px}
body[data-aurekai-pattern=workbench] .bf-native-layout{max-width:1640px}
body[data-aurekai-pattern=connections] :is(.source-desk,.bf-native-layout){max-width:1480px}
body[data-aurekai-pattern=market] :is(.tile,.offer,.bf-native-slot){border-color:var(--ak-comp-line)}
/* Market: the trade index screen. Hero with its ledger of counts on the right,
   source chips, then numbered lots with price, date and an open button. */
body[data-aurekai-pattern=market] .wrap>.hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,1fr);column-gap:clamp(20px,4vw,56px);align-items:start}
body[data-aurekai-pattern=market] .wrap>.hero>:not(.market-ledger){grid-column:1}
body[data-aurekai-pattern=market] .wrap>.hero h1{font:700 clamp(2.1rem,4.2vw,3.8rem)/1.02 var(--ak-sans);letter-spacing:-.04em}
body[data-aurekai-pattern=market] .wrap>.hero .lede{font:400 clamp(1rem,1.3vw,1.15rem)/1.55 var(--ak-sans);color:var(--ak-on-variant);max-width:58ch}
body[data-aurekai-pattern=market] .market-ledger{grid-column:2;grid-row:1 / span 3;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin:0;background:var(--ak-outline-variant);border:1px solid var(--ak-outline-variant);border-radius:4px;overflow:hidden}
body[data-aurekai-pattern=market] .market-ledger>div{padding:14px 16px;background:var(--ak-surface-low)}
body[data-aurekai-pattern=market] .market-ledger dt{font:500 10.5px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant)}
body[data-aurekai-pattern=market] .market-ledger dd{margin:6px 0 0;font:700 clamp(1.3rem,2vw,1.7rem)/1.1 var(--ak-sans);color:var(--ak-primary)}
body[data-aurekai-pattern=market] .market-from{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
body[data-aurekai-pattern=market] .market-from a{display:inline-flex;align-items:center;min-height:36px;padding:6px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:600 11.5px/1.2 var(--ak-sans);letter-spacing:.04em;text-transform:uppercase;color:var(--ak-on-surface);text-decoration:none}
body[data-aurekai-pattern=market] .market-from a[aria-current]{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)}
body[data-aurekai-pattern=market] .ak-experience-controls :is(.ak-exp-view-buttons,.ak-exp-lanes),body[data-aurekai-pattern=market] [data-exp-focus]{display:none!important}
body[data-aurekai-pattern=market] .region-table{background:transparent!important;padding:0!important;border:0}
body[data-aurekai-pattern=market] .trade-index{width:100%;border-collapse:collapse;font:400 14px/1.45 var(--ak-sans);color:var(--ak-on-surface)}
body[data-aurekai-pattern=market] .trade-index th{padding:10px 12px;border-bottom:1px solid var(--ak-outline-variant);font:500 10.5px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant);text-align:left}
body[data-aurekai-pattern=market] .trade-index td{padding:16px 12px;border-bottom:1px solid color-mix(in srgb,var(--ak-outline-variant) 70%,transparent);vertical-align:middle}
body[data-aurekai-pattern=market] .trade-index .lot{font:700 13px/1 'DM Mono',ui-monospace,monospace;color:var(--ak-primary);white-space:nowrap}
body[data-aurekai-pattern=market] .region .trade-index td.name>a{font:600 15px/1.35 var(--ak-sans)!important;letter-spacing:0!important;color:var(--ak-on-surface);text-decoration:none}
body[data-aurekai-pattern=market] .trade-index .name>a:hover{color:var(--ak-primary)}
body[data-aurekai-pattern=market] .region .trade-index td .dek{display:block;margin-top:4px;font:400 12px/1.4 var(--ak-sans)!important;color:var(--ak-on-variant)}
body[data-aurekai-pattern=market] .region .trade-index td .dek a{color:inherit;font:inherit!important}
body[data-aurekai-pattern=market] .trade-index .price{font:700 15px/1.2 var(--ak-sans);color:var(--ak-primary);white-space:nowrap}
body[data-aurekai-pattern=market] .trade-index .price .none{font-weight:400;font-size:12px;color:var(--ak-on-variant)}
body[data-aurekai-pattern=market] .trade-index .when{font-size:12px;color:var(--ak-on-variant);white-space:nowrap}
body[data-aurekai-pattern=market] .trade-index .go{width:44px;text-align:right}
body[data-aurekai-pattern=market] .trade-index .lot-open{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--ak-primary);color:var(--ak-on-primary)}
body[data-aurekai-pattern=market] .trade-index .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
body[data-aurekai-pattern=market] .trade-index.no-price td.when{min-width:6rem}
body[data-aurekai-pattern=market] .wrap>.region{margin-inline:0}
body[data-aurekai-pattern=market] .market-note{max-width:70ch;margin:18px 0 0;font:400 13px/1.5 var(--ak-sans);color:var(--ak-on-variant)}
/* Living neighbourhoods (/property): search on the roll, the merchants kept
   here as rows with their latest offer quoted, then the closing band. */
body.route-property .place-find{margin-top:24px;max-width:640px}
body.route-property .place-find label{display:block;margin-bottom:8px;font:500 10.5px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant)}
body.route-property .place-find div{display:flex;gap:8px;padding:4px 4px 4px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-low)}
body.route-property .place-find input{flex:1;min-width:0;border:0;background:none;color:var(--ak-on-surface);font:400 15px/1.4 var(--ak-sans)}
body.route-property .place-find button{min-height:40px;padding:0 18px;border:0;border-radius:999px;background:var(--ak-primary);color:var(--ak-on-primary);font:600 13px/1 var(--ak-sans);cursor:pointer}
body.route-property .place-merchants{padding-block:clamp(32px,5vw,64px)}
body.route-property .place-kicker{margin:0 0 10px;font:500 10.5px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--ak-primary)}
body[data-character].route-property .wrap>.place-merchants>h2{margin:0;font:700 clamp(1.8rem,3.4vw,2.8rem)/1.05 var(--ak-sans);letter-spacing:-.035em;color:var(--ak-on-surface)}
body.route-property .place-dek{max-width:56ch;margin:12px 0 24px;font:400 15px/1.55 var(--ak-sans);color:var(--ak-on-variant)}
body.route-property .place-merchants ol{list-style:none;margin:0;padding:0;display:grid;gap:12px}
body.route-property .place-merchants li{display:grid;grid-template-columns:minmax(180px,1fr) minmax(0,2fr) auto;gap:20px;align-items:center;padding:22px 24px;border:1px solid var(--ak-outline-variant);border-radius:16px;background:var(--ak-surface-low)}
body.route-property .place-who span{font:500 10.5px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-primary)}
body.route-property .place-who h3{margin:6px 0 0;font:700 clamp(1.2rem,2vw,1.5rem)/1.15 var(--ak-sans);color:var(--ak-on-surface)}
body.route-property .place-merchants blockquote{margin:0;font:italic 400 clamp(1rem,1.4vw,1.2rem)/1.45 var(--ak-serif);color:var(--ak-on-surface)}
body.route-property .place-merchants blockquote p{margin:0}
body.route-property .place-merchants blockquote small{display:block;margin-top:6px;font:600 12px/1.3 var(--ak-sans);font-style:normal;color:var(--ak-primary)}
body.route-property .place-go,body.route-property .place-band nav a{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:600 12.5px/1 var(--ak-sans);color:var(--ak-on-surface);text-decoration:none;white-space:nowrap}
body.route-property .place-band{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;margin:clamp(24px,4vw,48px) 0;padding:clamp(24px,4vw,44px);border-radius:24px;background:var(--ak-primary);color:var(--ak-on-primary)}
body[data-character].route-property .place-band h2{margin:0;font:700 clamp(1.6rem,3vw,2.4rem)/1.05 var(--ak-sans);letter-spacing:-.03em;text-transform:none;color:var(--ak-on-primary)}
body.route-property .place-band p{max-width:52ch;margin:10px 0 0;font:400 15px/1.5 var(--ak-sans)}
body.route-property .place-band nav{display:flex;flex-wrap:wrap;gap:10px}
body.route-property .place-band nav a{border-color:var(--ak-on-primary);color:var(--ak-on-primary)}
body.route-property .place-band nav a.is-primary{background:var(--ak-on-primary);color:var(--ak-primary)}
body.route-property .region-properties .results{list-style:none;margin:0;padding:0}
@media(max-width:760px){body.route-property .place-merchants li{grid-template-columns:minmax(0,1fr)}}
@media(max-width:760px){body[data-aurekai-pattern=market] .wrap>.hero{grid-template-columns:minmax(0,1fr)}body[data-aurekai-pattern=market] .market-ledger{grid-column:1;grid-row:auto;margin-top:20px}body[data-aurekai-pattern=market] .trade-index thead{display:none}body[data-aurekai-pattern=market] .trade-index tbody tr{display:grid;grid-template-columns:2.2rem minmax(0,1fr) 44px;grid-template-areas:'lot name go' '. price go' '. when go';column-gap:8px;padding:12px 0;border-bottom:1px solid color-mix(in srgb,var(--ak-outline-variant) 70%,transparent)}body[data-character][data-aurekai-pattern=market] .trade-index td{display:block!important;padding:0;border:0}body[data-aurekai-pattern=market] .trade-index td.lot{grid-area:lot;padding-top:4px}body[data-aurekai-pattern=market] .trade-index td.name{grid-area:name}body[data-aurekai-pattern=market] .trade-index td.price{grid-area:price;margin-top:6px}body[data-aurekai-pattern=market] .trade-index td.when{grid-area:when}body[data-aurekai-pattern=market] .trade-index td.go{grid-area:go;align-self:center}}
body[data-aurekai-pattern=spatial] :is(svg,canvas){max-width:100%}
@media(max-width:650px){body[data-aurekai-pattern] :is(.wrap,.bf-native-layout){width:calc(100% - 20px)}
body[data-aurekai-pattern] :is(.wrap>.hero h1,.bf-native-masthead h1){font-size:clamp(2rem,11vw,3.2rem)}
}
@media(prefers-reduced-motion:reduce){body[data-aurekai-pattern] *{transition:none!important}
}
/* Workbench and spatial pages built in C on the one shell (app_shell.h):
   body.ak-app main.ak-wb. Regions follow the Stitch workbench/spatial screens:
   status strip, hero with its instrument panel, chip row, panel grids, the
   console, the closing band. Tokens are aurekai-bar.css --ak-*. */
.ak-wb{box-sizing:border-box;width:100%;max-width:1360px;margin:0 auto;padding:0 clamp(16px,3vw,32px) 24px;font:400 15px/1.55 var(--ak-sans)}
.ak-wb *{box-sizing:border-box}.ak-wb a{color:inherit}
.ak-wb :is(h1,h2,h3,h4,p){margin:0}
.ak-wb-strip{display:flex;flex-wrap:wrap;align-items:center;gap:8px 22px;margin:0 calc(-1*clamp(16px,3vw,32px));padding:10px clamp(16px,3vw,32px);border-bottom:1px solid var(--ak-outline-variant);background:var(--ak-surface-lowest);font:500 11px/1.4 'DM Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-on-variant)}
.ak-wb-strip b{font-weight:500;color:var(--ak-on-surface)}.ak-wb-strip .ak-live{margin-left:auto}
.ak-live::before,.ak-dot::before{content:"";display:inline-block;width:7px;height:7px;margin-right:7px;border-radius:50%;background:var(--ak-primary);vertical-align:1px}
.ak-dot.is-off::before{background:var(--ak-outline)}
.ak-kicker{font:500 11px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
.ak-wb-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,380px);gap:clamp(24px,4vw,56px);align-items:start;padding:clamp(28px,5vw,64px) 0 clamp(20px,3vw,36px)}
.ak-wb-hero.is-solo{grid-template-columns:minmax(0,1fr)}
.ak-wb-hero h1{margin:12px 0 18px;font:600 clamp(2.3rem,5.2vw,4.4rem)/1.03 var(--ak-sans);letter-spacing:-.035em;color:var(--ak-on-surface);text-wrap:balance}
.ak-lede{max-width:60ch;font:400 clamp(1.05rem,1.6vw,1.4rem)/1.5 var(--ak-serif);color:var(--ak-on-variant)}
.ak-wb-hero .ak-actions{margin-top:24px}
.ak-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.ak-btn,.ak-wb .ak-action button{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:9px 18px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:500 14px/1.2 var(--ak-sans);text-decoration:none;cursor:pointer}
.ak-btn:hover,.ak-wb .ak-action button:hover{border-color:var(--ak-primary);color:var(--ak-primary);background:var(--ak-surface-high)}
.ak-btn.is-primary,.ak-wb .ak-action.is-primary button,.ak-wb .ak-ask .ak-action button{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary);font-weight:600}
.ak-btn.is-primary:hover{filter:brightness(1.06);color:var(--ak-on-primary)}
.ak-btn.is-quiet{background:none}
.ak-chips{display:flex;flex-wrap:wrap;gap:8px;padding:6px 0 26px;border-bottom:1px solid var(--ak-outline-variant)}
.ak-chip{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:500 13px/1.2 var(--ak-sans);color:var(--ak-on-variant);text-decoration:none;white-space:nowrap}
.ak-chip b{font:500 11px 'DM Mono',monospace;color:var(--ak-primary)}
.ak-chip:hover,.ak-chip[aria-current]{border-color:var(--ak-primary);color:var(--ak-on-surface)}
.ak-chip[aria-current]{background:var(--ak-primary);color:var(--ak-on-primary)}.ak-chip[aria-current] b{color:inherit}
.ak-panel{min-width:0;padding:clamp(18px,2vw,26px);border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-low)}
.ak-panel.is-raised{background:var(--ak-surface-mid)}
.ak-panel>h2,.ak-panel>header h2{font:600 1.35rem/1.2 var(--ak-sans);letter-spacing:-.02em;color:var(--ak-on-surface)}
.ak-panel>header{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px}
.ak-panel h3{font:600 1.05rem/1.3 var(--ak-sans);color:var(--ak-on-surface)}
.ak-panel p{color:var(--ak-on-variant)}
.ak-tag{display:inline-block;padding:3px 9px;border-radius:999px;background:var(--ak-surface-high);font:500 10.5px/1.3 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant);white-space:nowrap}
.ak-tag.is-on{background:color-mix(in srgb,var(--ak-primary) 18%,transparent);color:var(--ak-primary)}
.ak-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin:0;border-radius:18px;overflow:hidden;border:1px solid var(--ak-outline-variant);background:var(--ak-outline-variant)}
.ak-stats.is-row{grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));margin:8px 0 34px}
.ak-stats>div{padding:16px 18px;background:var(--ak-surface-low)}
.ak-stats dt{font:500 10.5px/1.3 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant)}
.ak-stats dd{margin:6px 0 0;font:600 clamp(1.4rem,2.4vw,2rem)/1.1 var(--ak-sans);letter-spacing:-.02em;color:var(--ak-on-surface);font-variant-numeric:tabular-nums}
.ak-stats dd.is-on{color:var(--ak-primary)}.ak-stats small{display:block;margin-top:4px;font-size:12px;color:var(--ak-on-variant)}
.ak-sec{padding:clamp(28px,4vw,48px) 0 0}
.ak-sec>header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:10px 24px;margin-bottom:20px}
.ak-sec>header h2{font:600 clamp(1.5rem,2.6vw,2.2rem)/1.15 var(--ak-sans);letter-spacing:-.03em;color:var(--ak-on-surface)}
.ak-sec>header p{max-width:60ch;color:var(--ak-on-variant)}
.ak-sec>header .ak-kicker{display:block;margin-bottom:8px}
.ak-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))}
.ak-grid.is-2{grid-template-columns:repeat(2,minmax(0,1fr))}.ak-grid.is-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.ak-grid.is-main{grid-template-columns:minmax(220px,.9fr) minmax(0,2.2fr) minmax(220px,1fr);align-items:start}
.ak-rows{display:grid;margin:0;padding:0;list-style:none}
.ak-rows>li,.ak-rows>a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 14px;align-items:center;padding:12px 0;border-top:1px solid var(--ak-outline-variant);text-decoration:none}
.ak-rows>:first-child{border-top:0}
.ak-rows strong{font:500 15px/1.35 var(--ak-sans);color:var(--ak-on-surface);overflow-wrap:anywhere}
.ak-rows small{grid-column:1;font:400 12.5px/1.4 'DM Mono',monospace;color:var(--ak-on-variant);overflow-wrap:anywhere}
.ak-rows .ak-go{grid-row:1/span 2;grid-column:2;font:500 13px var(--ak-sans);color:var(--ak-primary);white-space:nowrap}
.ak-rows>a:hover strong{color:var(--ak-primary)}
.ak-empty{padding:14px 0;font:italic 400 15px/1.5 var(--ak-serif);color:var(--ak-on-variant)}
.ak-table{width:100%;border-collapse:collapse;font-size:14px}
.ak-table th{padding:10px 12px;text-align:left;font:500 10.5px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant);border-bottom:1px solid var(--ak-outline-variant)}
.ak-table td{padding:12px;border-bottom:1px solid var(--ak-outline-variant);vertical-align:top;overflow-wrap:anywhere}
.ak-table td code{font:400 12.5px 'DM Mono',monospace;color:var(--ak-on-variant)}
.ak-table a{color:var(--ak-primary);text-decoration:none}
.ak-scroll{overflow-x:auto}
.ak-console{padding:18px 20px;border-radius:18px;background:var(--ak-surface-lowest);border:1px solid var(--ak-outline-variant);font:400 13px/1.7 'DM Mono',monospace;color:var(--ak-on-variant);overflow-wrap:anywhere}
.ak-console b{color:var(--ak-primary);font-weight:500}
.ak-ask{padding:clamp(18px,2.4vw,28px);border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-mid)}
.ak-ask .ak-action{display:flex;flex-wrap:wrap;gap:12px;align-items:end}
.ak-wb .ak-field{flex:1 1 320px;margin:0;color:var(--ak-on-variant);font:500 12px/1.3 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase}
.ak-wb .ak-field :is(input,textarea,select){max-width:none;margin-top:6px;padding:12px 16px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:400 15px/1.4 var(--ak-sans);letter-spacing:0;text-transform:none}
.ak-wb .ak-field :is(input,textarea):focus{outline:2px solid var(--ak-primary);outline-offset:1px}
.ak-band{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;margin-top:clamp(40px,6vw,72px);padding:clamp(24px,4vw,44px);border-radius:26px;background:var(--ak-primary);color:var(--ak-on-primary)}
.ak-band h2{font:600 clamp(1.6rem,3.4vw,2.8rem)/1.08 var(--ak-sans);letter-spacing:-.035em}
.ak-band p{margin-top:8px;font:400 1.02rem/1.5 var(--ak-serif)}
.ak-band .ak-kicker{color:inherit;opacity:.75}
.ak-band .ak-btn{background:var(--ak-on-primary);border-color:var(--ak-on-primary);color:var(--ak-primary)}
.ak-band .ak-btn.is-quiet{background:none;color:var(--ak-on-primary)}
.ak-spec{display:grid;grid-template-columns:auto minmax(0,1fr);gap:9px 16px;margin:0;font-size:14px}
.ak-spec dt{color:var(--ak-on-variant)}.ak-spec dd{margin:0;text-align:right;color:var(--ak-on-surface);overflow-wrap:anywhere}
.ak-spec dd.is-on{color:var(--ak-primary);font-family:'DM Mono',monospace}
.ak-meter{height:6px;margin-top:10px;border-radius:9px;background:var(--ak-surface-highest);overflow:hidden}.ak-meter i{display:block;height:100%;background:var(--ak-primary)}
@media(max-width:980px){.ak-wb-hero,.ak-grid.is-main{grid-template-columns:minmax(0,1fr)}.ak-grid.is-3{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.ak-grid.is-2,.ak-grid.is-3{grid-template-columns:minmax(0,1fr)}.ak-band{grid-template-columns:minmax(0,1fr)}.ak-wb-strip .ak-live{margin-left:0}.ak-table{font-size:13px}}
/* Communities and guilds (community_journey.h) on the one shell: the guild
   registry directory, a community's rooms, its conversation and forms. */
.cj-shell{min-width:0}.cj-shell a{color:var(--ak-on-surface);text-decoration:none}.cj-shell a:hover{color:var(--ak-primary)}
.cj-breadcrumbs{display:flex;gap:14px;flex-wrap:wrap;padding-top:20px;font:500 12px/1.3 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant)}
.cj-search{display:flex;gap:6px;align-items:center;min-width:min(100%,360px);padding:6px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-low)}
.cj-search input{flex:1;min-width:0;border:0;background:none;color:var(--ak-on-surface);font:500 14px var(--ak-sans);padding:8px 10px}
.cj-search button,.cj-shell button{display:inline-flex;align-items:center;min-height:38px;padding:8px 18px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:600 13px var(--ak-sans);cursor:pointer}
.cj-search button,.cj-shell button[type=submit]{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)}
.cj-chamber{margin:30px 0 14px;font:500 11px/1.3 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
.cj-listing{display:flex;flex-direction:column;gap:12px}.cj-listing h3 a{color:var(--ak-on-surface)}.cj-listing>p{flex:1;font-size:14px;line-height:1.55;overflow-wrap:anywhere}
.cj-actions{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.cj-button{display:inline-flex;align-items:center;min-height:40px;padding:9px 18px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:600 13px var(--ak-sans)}
.cj-actions>a:first-child{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)}
.cj-tabs{display:flex;gap:8px;flex-wrap:wrap;padding:6px 0 22px;margin-bottom:24px;border-bottom:1px solid var(--ak-outline-variant)}
.cj-tabs a{padding:7px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:500 13px var(--ak-sans);color:var(--ak-on-variant)}
.cj-tabs [aria-current=page]{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)!important}
.cj-content{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:32px}.cj-content>aside{padding:20px;border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-low);align-self:start;font-size:13px;color:var(--ak-on-variant)}
.cj-thread{padding:22px 0;border-bottom:1px solid var(--ak-outline-variant);min-width:0;overflow-wrap:anywhere}
.cj-thread h2,.cj-thread h3{margin:8px 0 12px;font:600 1.35rem/1.25 var(--ak-sans);letter-spacing:-.02em;color:var(--ak-on-surface)}
.cj-thread p{white-space:pre-wrap;font:400 1rem/1.7 var(--ak-serif);color:var(--ak-on-variant)}
.cj-meta,.cj-thread time{font:500 11.5px 'DM Mono',monospace;color:var(--ak-on-variant)}
.cj-thread nav{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px;font-size:13px}.cj-thread nav a{color:var(--ak-primary)}
.cj-thread details,.cj-member details{margin-top:14px}.cj-thread summary{cursor:pointer;font-size:13px;color:var(--ak-on-variant)}
.cj-replies{margin:22px 0;padding-left:22px;border-left:2px solid var(--ak-outline-variant)}
.cj-removed{padding:14px;border-radius:14px;background:var(--ak-surface-low);font-style:italic;color:var(--ak-on-variant)}
.cj-notice{margin:20px 0;padding:16px 20px;border:1px solid var(--ak-outline-variant);border-radius:16px;background:var(--ak-surface-low);color:var(--ak-on-variant)}
.cj-review{margin:20px 0;padding:20px;border-left:3px solid var(--ak-primary);background:var(--ak-surface-low);white-space:pre-wrap;overflow-wrap:anywhere}
.cj-form{max-width:820px;padding:24px;border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-low)}
.cj-form label{display:grid;gap:8px;margin-bottom:20px;font:500 12px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant)}
.cj-shell :is(input:not([type=hidden]),textarea){width:100%;min-width:0;padding:12px 14px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:15px/1.6 var(--ak-sans);text-transform:none;letter-spacing:0}
.cj-search input{width:auto;border:0;background:none;padding:8px 10px}
.cj-shell textarea{min-height:180px;resize:vertical}
.cj-member{padding:18px 0;border-bottom:1px solid var(--ak-outline-variant)}.cj-member form{display:inline-block;margin:10px 8px 0 0}
.cj-next{display:inline-block;margin:24px 0;padding:10px 18px;border:1px solid var(--ak-outline-variant);border-radius:999px}
@media(max-width:900px){.cj-content{grid-template-columns:minmax(0,1fr)}}
@media(max-width:600px){.cj-search{width:100%}.cj-replies{padding-left:12px}.cj-form{padding:16px}}
/* Media screens (page_media_spaces.h): Listen, Music, Watch/Film/Stage/Sports, Art. */
.ms{--ms-bg:var(--ak-surface,#0f1511);--ms-low:var(--ak-surface-low,#171d19);--ms-mid:var(--ak-surface-mid,#1b211d);--ms-high:var(--ak-surface-high,#252b27);--ms-ink:var(--ak-on-surface,#dee4dd);--ms-muted:var(--ak-on-variant,#c5c9af);--ms-acc:var(--ak-primary,#d0fc4f);--ms-on-acc:var(--ak-on-primary,#0f1511);--ms-line:var(--ak-outline-variant,#444935);--ms-sans:var(--ak-sans,'DM Sans',system-ui,sans-serif);--ms-serif:var(--ak-serif,'Literata',Georgia,serif);--ms-mono:'DM Mono',ui-monospace,monospace;color:var(--ms-ink);font-family:var(--ms-sans);padding-bottom:96px}
body:has(.ms){background:var(--ak-surface,#0f1511)}
.ms a{color:inherit;text-decoration:none}.ms a:hover{color:var(--ms-acc)}
.ms h1,.ms h2,.ms h3{font-family:var(--ms-sans);color:var(--ms-ink);letter-spacing:-.02em;margin:0;text-transform:none}
.ms .ak-icon{width:1em;height:1em;flex:none}
.ms-kicker{margin:0 0 6px;font:600 11px/1.4 var(--ms-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ms-acc)}
.ms-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ms-acc);margin-right:7px;vertical-align:1px}
.ms-head{padding:clamp(24px,4vw,48px) 0 24px}
.ms-head h1{font-size:clamp(2.6rem,6vw,4.6rem);line-height:1;font-weight:600}
.ms-lede{max-width:62ch;margin:14px 0 0;font:400 clamp(1rem,1.3vw,1.2rem)/1.6 var(--ms-serif);color:var(--ms-ink)}
.ms-stats{display:flex;flex-wrap:wrap;gap:6px 22px;list-style:none;margin:18px 0 0;padding:12px 0;border-block:1px solid var(--ms-line);font:12px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-stats b{color:var(--ms-acc);font-weight:600}
.ms-chips{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0}
.ms-chips a{display:inline-flex;align-items:center;min-height:32px;padding:4px 14px;border-radius:99px;background:var(--ms-high);font:500 12px/1.2 var(--ms-sans);color:var(--ms-muted)}
.ms-chips a[aria-current]{background:var(--ms-acc);color:var(--ms-on-acc)}
.ms-narrowed{margin:12px 0 0;font-size:13px;color:var(--ms-muted)}.ms-narrowed a{color:var(--ms-acc)}
.ms-empty{margin:24px 0;padding:32px;border:1px dashed var(--ms-line);border-radius:20px;color:var(--ms-muted);font-family:var(--ms-serif)}
.ms-sh{display:flex;justify-content:space-between;align-items:end;gap:16px;margin:0 0 16px}
.ms-sh h2{font-size:clamp(1.3rem,2vw,1.6rem);font-weight:500}
.ms-aside{margin:0;font:12px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin:0 0 10px;font:11px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-tag{display:inline-flex;align-items:center;padding:3px 9px;border-radius:99px;background:var(--ms-acc);color:var(--ms-on-acc);font:600 10px/1.3 var(--ms-mono);letter-spacing:.06em;text-transform:uppercase}
.ms-tag-quiet{background:var(--ms-high);color:var(--ms-muted)}
.ms-dur{font:12px/1.4 var(--ms-mono);color:var(--ms-muted);font-variant-numeric:tabular-nums}
.ms-by{margin:6px 0 0;font:500 14px/1.4 var(--ms-sans);color:var(--ms-muted)}
.ms-excerpt{margin:12px 0 0;font:400 16px/1.65 var(--ms-serif);color:var(--ms-ink);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.ms-controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:18px}
.ms-controls-col{flex-direction:column;align-items:stretch}
.ms-primary,.ms-ghost,.ms-pill,.ms-link{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:8px 18px;border-radius:99px;border:0;font:600 13px/1.2 var(--ms-sans);cursor:pointer}
.ms .ms-primary,.ms .ms-pill{background:var(--ms-acc);color:var(--ms-on-acc)}.ms .ms-primary:hover{color:var(--ms-on-acc);filter:brightness(1.05)}
.ms-ghost{background:var(--ms-high);color:var(--ms-ink)}
.ms-pill{min-height:30px;padding:4px 14px;background:var(--ms-acc);color:var(--ms-on-acc);font-size:11px}
.ms-link{min-height:28px;padding:2px 0;background:none;color:var(--ms-acc);font-size:12px}
.ms-play{display:grid;place-items:center;flex:none;width:36px;height:36px;border-radius:50%;border:1px solid var(--ms-line);background:var(--ms-mid);color:var(--ms-ink);cursor:pointer}
.ms-play:hover{background:var(--ms-acc);color:var(--ms-on-acc);border-color:var(--ms-acc)}
.ms-controls .ms-play{width:52px;height:52px;background:var(--ms-acc);color:var(--ms-on-acc);border:0}
.ms-icon{display:grid;place-items:center;width:32px;height:32px;color:var(--ms-muted)}
.ms-wave{display:flex;align-items:center;gap:2px;height:40px;margin-top:16px}
.ms-wave i{flex:1;min-width:2px;max-width:5px;height:var(--h);border-radius:2px;background:var(--ms-acc);opacity:.85}
.ms-wave i:nth-child(n+24){opacity:.3}
.ms-cover{display:block;width:100%;height:100%;object-fit:cover}
.ms-noart{display:grid;place-items:center;background:linear-gradient(135deg,var(--ms-mid),var(--ms-high));color:var(--ms-acc)}.ms-noart .ak-icon{width:32px;height:32px}
.ms-narration[hidden]{display:none!important}
/* Listen */
.ms-now{display:grid;grid-template-columns:minmax(220px,1fr) 2fr;gap:clamp(18px,3vw,36px);padding:clamp(16px,2vw,24px);border-radius:28px;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-now-art{position:relative;min-height:300px;border-radius:18px;overflow:hidden;background:var(--ms-mid)}
.ms-now-art .ms-cover{position:absolute;inset:0;filter:grayscale(.35)}
.ms-badge{position:absolute;top:12px;left:12px;margin:0;padding:4px 10px;border-radius:99px;background:#0f1511cc;font:600 10px/1.3 var(--ms-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ms-acc)}
.ms-now-src{position:absolute;left:12px;right:12px;bottom:12px;margin:0;padding:10px 12px;border-radius:10px;background:#0f1511d9;display:grid;gap:2px;font-size:13px}
.ms-now-src small{font:10px/1.3 var(--ms-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--ms-muted)}
.ms-now-body h2{font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.12;font-weight:600}
.ms-queue,.ms-long,.ms-sec,.ms-stations,.ms-recent,.ms-tracks{margin-top:clamp(36px,5vw,56px)}
.ms-rows{list-style:none;margin:0;padding:0;border:1px solid var(--ms-line);border-radius:20px;overflow:hidden}
.ms-rows>li{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto;align-items:start;gap:6px 14px;padding:14px 18px;border-top:1px solid var(--ms-line);background:var(--ms-low)}
.ms-rows>li:first-child{border-top:0}.ms-rows>li:hover{background:var(--ms-mid)}
.ms-row-src{margin:0;font:11px/1.4 var(--ms-mono);color:var(--ms-muted)}.ms-row-src b{color:var(--ms-acc);font-weight:600}
.ms-rows h3{margin:3px 0 2px;font-size:16px;font-weight:600;line-height:1.3}
.ms-row-text{margin:0;font-size:13px;line-height:1.45;color:var(--ms-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ms-row-meta{display:grid;gap:2px;justify-items:end;margin:0;font:11px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-long-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:16px}
.ms-long-grid article{display:flex;flex-direction:column;padding:24px;border-radius:22px;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-long-grid h3{font-size:22px;line-height:1.2;font-weight:500}
.ms-long-text{margin:12px 0 0;font:400 16px/1.7 var(--ms-serif);display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.ms-long-grid footer{display:flex;align-items:center;gap:14px;margin-top:auto;padding-top:16px}
.ms-long-grid .ms-wave{flex:1;height:24px;margin:0}
/* Music */
.ms-head-slim{padding-bottom:12px}
.ms-music-grid{display:grid;grid-template-columns:240px minmax(0,1fr);gap:24px;align-items:start}
.ms-library{position:sticky;top:16px;display:grid;gap:14px}
.ms-library section{padding:16px;border-radius:20px;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-library ul{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.ms-library a{display:flex;justify-content:space-between;gap:8px;padding:7px 8px;border-radius:8px;font-size:13px}
.ms-library a[aria-current]{background:var(--ms-high);color:var(--ms-acc);font-weight:600}
.ms-library span{font:11px var(--ms-mono);color:var(--ms-muted)}
.ms-record{display:grid;grid-template-columns:minmax(180px,280px) 1fr;gap:clamp(18px,3vw,40px);align-items:center;padding:clamp(18px,3vw,36px);border-radius:32px;background:radial-gradient(circle at 20% 20%,color-mix(in srgb,var(--ms-acc) 10%,var(--ms-low)),var(--ms-low));border:1px solid var(--ms-line)}
.ms-record-art{aspect-ratio:1;border-radius:18px;overflow:hidden;box-shadow:0 24px 48px #0008}
.ms-record h2{font-size:clamp(2rem,4vw,3.4rem);line-height:1.04;font-weight:600}
.ms-rights{margin:10px 0 0;font:11px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-tracks table{width:100%;border-collapse:separate;border-spacing:0 4px;font-size:14px}
.ms-tracks th{padding:6px 10px;text-align:left;font:600 10px/1.3 var(--ms-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ms-muted);border-bottom:1px solid var(--ms-line)}
.ms-tracks td{padding:10px;vertical-align:middle;background:transparent}
.ms-tracks tr:hover td,.ms-tracks tr.is-on td{background:var(--ms-mid)}.ms-tracks tr.is-on b{color:var(--ms-acc)}
.ms-tracks td:first-child{border-radius:12px 0 0 12px;width:44px}.ms-tracks td:last-child{border-radius:0 12px 12px 0;font:12px var(--ms-mono);color:var(--ms-muted)}
.ms-tracks td b{display:block;font-weight:600}.ms-tracks td small{color:var(--ms-muted);font-size:12px}
.ms-no{display:grid;place-items:center;width:32px;height:32px;border:0;border-radius:50%;background:none;color:var(--ms-muted);font:12px var(--ms-mono);cursor:pointer}
.ms-no .ak-icon{display:none}.ms-no:hover span{display:none}.ms-no:hover .ak-icon{display:block;color:var(--ms-acc)}
.ms-col-src,.ms-col-when{font:12px var(--ms-mono);color:var(--ms-muted)}
/* Cards (shared) */
.ms-cards{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.ms-cards-3{grid-template-columns:repeat(3,minmax(0,1fr))}.ms-cards-4{grid-template-columns:repeat(4,minmax(0,1fr))}
.ms-cards>li{display:flex;flex-direction:column;min-width:0;padding:10px 10px 14px;border-radius:20px;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-cards>li>:not(.ms-card-art){margin-inline:6px}
.ms-card-art{position:relative;aspect-ratio:16/10;border-radius:14px;overflow:hidden;background:var(--ms-mid);margin-bottom:12px}
.ms-card-art .ms-art-link{display:block;height:100%}
.ms-cards h3{font-size:16px;line-height:1.3;font-weight:600}
.ms-card-text{margin:6px 0 0;font-size:13px;line-height:1.5;color:var(--ms-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ms-card-by{margin:4px 0 0;font:11px var(--ms-mono);color:var(--ms-muted)}
.ms-cards footer{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto;padding-top:12px;font:11px/1.3 var(--ms-mono);color:var(--ms-muted)}
.ms-cards footer>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ms-over{position:absolute;right:8px;bottom:8px;padding:2px 8px;border-radius:6px;background:#0f1511d9;font:600 11px var(--ms-mono);color:var(--ms-acc)}
.ms-over-l{left:8px;right:auto;top:8px;bottom:auto;max-width:70%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ms-ink)}
.ms-on-art{position:absolute;right:10px;bottom:10px;background:var(--ms-acc);color:var(--ms-on-acc);border:0}
.ms-cards-compact .ms-card-art{aspect-ratio:16/8}
.ms-audio-cards>li{padding:22px}
.ms-audio-cards h3{font-size:19px}
.ms-more{margin:14px 0 0;font-size:13px}.ms-more a{color:var(--ms-acc)}
/* Cinema */
.ms-marquee{position:relative;margin-top:clamp(16px,3vw,32px);min-height:clamp(420px,52vw,600px);display:flex;align-items:flex-end;border-radius:32px;overflow:hidden;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-marquee-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}
.ms-marquee::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0f1511f2 0,#0f1511b3 45%,#0f151133 100%),linear-gradient(0deg,#0f1511 0,transparent 40%)}
.ms-marquee-body{position:relative;z-index:1;max-width:760px;padding:clamp(22px,4vw,56px)}
.ms-marquee h1{font-size:clamp(2.2rem,5vw,4.2rem);line-height:1.04;font-weight:600}
.ms-facts{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;margin:14px 0 0;font:12px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-chip{padding:2px 8px;border:1px solid var(--ms-line);border-radius:6px}
.ms-filter{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-top:28px}
.ms-filter .ms-chips{margin:0}
/* Art */
.ms-mono-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px 40px;align-items:end}
.ms-facts-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:8px 0 0;border-block:1px solid var(--ms-line)}
.ms-facts-grid>div{padding:12px 14px;border-left:1px solid var(--ms-line)}.ms-facts-grid>div:first-child{border-left:0;padding-left:0}
.ms-facts-grid dt{font:10px/1.3 var(--ms-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ms-muted)}
.ms-facts-grid dd{margin:4px 0 0;font:600 14px/1.3 var(--ms-sans);color:var(--ms-acc)}
.ms-facts-grid .ms-chips{margin:0;gap:4px}.ms-facts-grid .ms-chips a{min-height:24px;padding:2px 10px;font-size:11px}
.ms-plate{margin-top:clamp(28px,4vw,48px)}
.ms-plate figure{margin:0;padding:clamp(12px,2vw,24px);border-radius:24px;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-plate-img{display:block;width:100%;max-height:640px;object-fit:contain;border-radius:12px}
.ms-plate figcaption{margin-top:10px;font:11px/1.4 var(--ms-mono);color:var(--ms-muted)}
.ms-columns{columns:2 320px;column-gap:40px;margin-top:20px;font:16px/1.7 var(--ms-serif)}
.ms-columns p{margin:0}
.ms-plates{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.ms-plates figure{margin:0;padding:10px;border-radius:18px;background:var(--ms-low);border:1px solid var(--ms-line)}
.ms-plates .ms-art-link{display:block;aspect-ratio:4/3;border-radius:10px;overflow:hidden}
.ms-plates figcaption{display:grid;gap:4px;padding:10px 4px 2px}.ms-plates figcaption b{font-weight:600;font-size:15px;line-height:1.3}
.ms-lexicon{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.ms-lexicon>li{padding:14px;border:1px solid var(--ms-line);border-radius:12px;background:var(--ms-low)}
.ms-lexicon .ms-kicker{display:flex;justify-content:space-between;gap:8px;color:var(--ms-muted)}.ms-lexicon .ms-kicker span{color:var(--ms-acc)}
.ms-lexicon h3{font-size:15px;line-height:1.3;font-weight:600}
.ms .media-space-catalogue{margin-top:clamp(36px,5vw,56px)}
@media(max-width:1000px){.ms-cards-4{grid-template-columns:repeat(2,minmax(0,1fr))}.ms-lexicon{grid-template-columns:repeat(2,minmax(0,1fr))}.ms-music-grid{grid-template-columns:1fr}.ms-library{position:static;grid-template-columns:1fr 1fr}}
@media(max-width:700px){.ms-now,.ms-record,.ms-mono-head{grid-template-columns:1fr}.ms-now-art{min-height:220px}.ms-record-art{max-width:240px}
.ms-cards-3,.ms-cards-4,.ms-plates{grid-template-columns:1fr}.ms-lexicon{grid-template-columns:1fr}.ms-library{grid-template-columns:1fr}
.ms-rows>li{grid-template-columns:auto minmax(0,1fr);padding:12px}.ms-row-meta{grid-column:2;justify-items:start;display:flex;gap:10px}.ms-rows .ms-icon{display:none}
.ms-col-src,.ms-col-when{display:none}.ms-facts-grid{grid-template-columns:1fr 1fr}.ms-facts-grid>div:nth-child(3){border-left:0;padding-left:0}
.ms-marquee{min-height:440px;border-radius:22px}.ms-sh{flex-direction:column;align-items:start}}
/* Territory fronts (front_editorial.h): edition strip, headline and beats,
   lead, then the dispatch grid (work) or watch/listen/read/what's on (others). */
.fd{--fd-low:var(--ak-surface-low,#171d19);--fd-mid:var(--ak-surface-mid,#1b211d);--fd-high:var(--ak-surface-high,#252b27);--fd-line:var(--ak-outline-variant,#444935);--fd-ink:var(--ak-on-surface,#dee4dd);--fd-soft:var(--ak-on-variant,#c5c9af);--fd-lime:var(--ak-primary,#d0fc4f);--fd-serif:'Literata','Newsreader',Georgia,serif;color:var(--fd-ink);font-family:var(--ak-sans,'DM Sans',system-ui,sans-serif);padding-bottom:1rem}
.fd *{box-sizing:border-box}
.fd a{color:inherit;text-decoration:none}
body.ak-app .fd :is(h1,h2,h3),body.ak-app .ak-zen :is(h1,h2,h3){font-family:var(--ak-sans,'DM Sans',system-ui,sans-serif);letter-spacing:-.02em;margin:0;text-wrap:balance;text-transform:none;color:var(--ak-on-surface,#dee4dd);animation:none}
.fd-strip{display:flex;justify-content:space-between;gap:.5rem 1.5rem;flex-wrap:wrap;padding:.9rem 0;border-bottom:1px solid var(--fd-line);font:600 .68rem/1.4 var(--ak-sans);letter-spacing:.08em;text-transform:uppercase;color:var(--fd-soft)}
.fd-strip p{margin:0;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
.fd-strip-facts{gap:1.25rem!important}.fd-strip-count{color:var(--fd-lime)}
.fd-dot{display:inline-block;width:.45rem;height:.45rem;border-radius:50%;background:var(--fd-lime);flex:none}
.fd-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,320px);gap:1rem 2rem;align-items:end;padding:clamp(1.5rem,4vw,2.75rem) 0 1.25rem}
.fd-head :is(h1,h2){font-size:clamp(2.6rem,6vw,4.6rem);font-weight:600;line-height:1;letter-spacing:-.045em}
.fd-lede{margin:.9rem 0 0;max-width:46ch;font:400 clamp(1.05rem,1.6vw,1.3rem)/1.5 var(--fd-serif);color:var(--fd-soft)}
.fd-find label{display:flex;align-items:center;gap:.5rem;min-height:44px;padding:0 .9rem;border-radius:999px;background:var(--fd-low);border:1px solid var(--fd-line);color:var(--fd-soft)}
.fd-find .ak-icon{width:1rem;height:1rem;flex:none}
.fd-find input{flex:1;min-width:0;border:0;background:transparent;color:var(--fd-ink);font:400 .9rem var(--ak-sans);outline:0}
.fd-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.fd-chips{grid-column:1/-1;display:flex;gap:.5rem;flex-wrap:wrap}
.fd-chips a{display:inline-flex;align-items:center;min-height:36px;padding:0 1rem;border-radius:999px;border:1px solid var(--fd-line);background:var(--fd-low);font:500 .82rem var(--ak-sans);color:var(--fd-soft)}
.fd-chips a:hover{color:var(--fd-ink);border-color:var(--fd-soft)}
.fd-chips a[aria-current]{background:var(--fd-lime);border-color:var(--fd-lime);color:var(--ak-on-primary,#0f1511);font-weight:600}
.fd-lead{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);margin:1.25rem 0 0;border-radius:1.5rem;overflow:hidden;background:var(--fd-low);border:1px solid var(--fd-line)}
.fd-lead-plain{grid-template-columns:1fr}
.fd-lead-picture{display:flex;background:var(--fd-high)}
.fd-lead-img{display:block;flex:1;width:100%;height:auto;min-height:320px;object-fit:cover}
.fd-lead-words{display:flex;flex-direction:column;gap:1rem;padding:clamp(1.5rem,3vw,2.5rem)}
.fd-kicker{display:flex;justify-content:space-between;gap:1rem;margin:0;font:600 .68rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--fd-soft)}
.fd-kicker span:first-child{color:var(--fd-lime)}
.fd-lead h2{font-size:clamp(1.8rem,3.2vw,2.75rem);font-weight:600;line-height:1.08}
.fd-lead h2 a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
.fd-dek{margin:.6rem 0 0;font:400 1rem/1.6 var(--fd-serif);color:var(--fd-soft);display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.fd-lead .fd-dek{-webkit-line-clamp:6;font-size:1.05rem}
.fd-by{margin:0;font:500 .78rem/1.4 var(--ak-sans);color:var(--fd-soft)}
.fd-lead-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1rem;margin-top:auto;padding-top:.5rem}
.fd-primary{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;padding:0 1.4rem;border-radius:999px;background:var(--fd-lime);color:var(--ak-on-primary,#0f1511)!important;font:600 .9rem var(--ak-sans)}
.fd :is(.fd-ghost,.fd-act){display:inline-flex;align-items:center;gap:.4rem;min-height:40px;padding:0 1rem;border-radius:999px;border:1px solid var(--fd-line);background:transparent;color:var(--fd-ink);font:600 .8rem var(--ak-sans);cursor:pointer}
.fd .fd-act{min-height:36px;padding:0 .8rem;font-size:.75rem}
.fd :is(.fd-ghost,.fd-act):hover{border-color:var(--fd-lime);color:var(--fd-lime)}
.fd :is(.fd-ghost,.fd-act) .ak-icon{width:1rem;height:1rem}
.fd-open{display:inline-flex;align-items:center;gap:.3rem;min-height:36px;font:600 .8rem var(--ak-sans);color:var(--fd-ink)}
.fd-open:hover{color:var(--fd-lime)}
.fd-section-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin:0 0 1.25rem}
.fd-section-head h2{display:flex;align-items:center;gap:.6rem;font-size:clamp(1.4rem,2.4vw,1.9rem);font-weight:600}
.fd-section-head :is(p,a){margin:0;font:600 .68rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--fd-soft)}
.fd-section-head a:hover{color:var(--fd-lime)}
.fd :is(.fd-dispatches,.fd-watch,.fd-hear,.fd-reading,.fd-going,.fd-pictured){padding-top:clamp(2.5rem,5vw,4rem)}
.fd-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.fd-card{display:flex;flex-direction:column;gap:.5rem;min-width:0;padding:1.4rem;border-radius:1.5rem;background:var(--fd-low);border:1px solid var(--fd-line)}
.fd-card-top{display:flex;justify-content:space-between;gap:.75rem;margin:0;font:600 .66rem/1.4 var(--ak-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--fd-soft)}
.fd-card-top span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fd-beat{color:var(--fd-lime)}
.fd-card-by{margin:0;font:500 .7rem/1.4 var(--ak-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--fd-soft)}
.fd-card h3,.fd-read h3{font-size:1.15rem;font-weight:600;line-height:1.25}
.fd-card h3 a:hover,.fd-read h3 a:hover,.fd-tracks h3 a:hover,.fd-agenda h3 a:hover{color:var(--fd-lime)}
.fd-card .fd-dek{font-size:.92rem}
.fd-card footer,.fd-read footer{display:flex;align-items:center;justify-content:space-between;gap:.5rem;flex-wrap:wrap;margin-top:auto;padding-top:1rem}
.fd-when{font:500 .72rem var(--ak-sans);color:var(--fd-soft)}
.fd-card footer .fd-when{margin-left:auto}
.fd-shelf{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
.fd-film,.fd-cover-item{display:flex;flex-direction:column;gap:.35rem;min-width:0}
.fd-frame{position:relative;display:block;aspect-ratio:16/10;border-radius:1rem;overflow:hidden;background:var(--fd-high);margin-bottom:.4rem}
.fd-film-img{width:100%;height:100%;object-fit:cover;display:block}
.fd-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:50%;background:rgba(15,21,17,.7);color:#fff}
.fd-play .ak-icon{width:1.1rem;height:1.1rem}
.fd-dur{position:absolute;right:.5rem;bottom:.5rem;padding:.1rem .45rem;border-radius:.4rem;background:rgba(15,21,17,.8);font:600 .7rem var(--ak-sans)}
.fd-film-title{font:600 .95rem/1.3 var(--ak-sans)}
.fd-film-by{font:500 .75rem var(--ak-sans);color:var(--fd-soft)}
.fd-film:hover .fd-film-title,.fd-cover-item:hover .fd-film-title{color:var(--fd-lime)}
.fd-tracks,.fd-agenda{list-style:none;margin:0;padding:0;border-top:1px solid var(--fd-line)}
.fd-tracks li{display:grid;grid-template-columns:3rem minmax(0,1fr) auto auto;align-items:center;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--fd-line)}
.fd-cover{width:3rem;height:3rem;border-radius:.6rem;object-fit:cover;background:var(--fd-high);display:block}
.fd-tracks h3{font-size:1rem;font-weight:600;line-height:1.3}
.fd-show{margin:.15rem 0 0;font:500 .78rem var(--ak-sans);color:var(--fd-soft)}
.fd-columns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem 2rem}
.fd-read{display:flex;flex-direction:column;gap:.5rem;min-width:0;padding-bottom:1.25rem;border-bottom:1px solid var(--fd-line)}
.fd-read-picture{display:block;border-radius:1rem;overflow:hidden;aspect-ratio:3/2;background:var(--fd-high);margin-bottom:.5rem}
.fd-read-img{width:100%;height:100%;object-fit:cover;display:block}
.fd-agenda li{display:grid;grid-template-columns:8rem minmax(0,1fr) auto;gap:1.5rem;align-items:center;padding:1.1rem 0;border-bottom:1px solid var(--fd-line)}
.fd-date{margin:0;display:flex;flex-direction:column}.fd-date b{font:600 1.35rem/1.1 var(--ak-sans);letter-spacing:-.02em}
.fd-date span{font:600 .66rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--fd-soft)}
.fd-agenda h3{font-size:1.05rem;font-weight:600}.fd-agenda div p{margin:.2rem 0 0;font-size:.82rem;color:var(--fd-soft)}
.fd-ahead{margin:0;font:600 .72rem var(--ak-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--fd-lime);text-align:right}
.fd-covers{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:1rem}
.fd-cover-img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:.75rem;background:var(--fd-high);display:block;margin-bottom:.35rem}
.fd-standard{margin-top:clamp(3rem,6vw,4.5rem);padding:clamp(1.5rem,4vw,2.75rem);border-radius:1.5rem;background:var(--fd-mid);border:1px solid var(--fd-line);display:grid;gap:.75rem;max-width:none}
.fd-standard h2{font-size:clamp(1.4rem,2.6vw,2rem);font-weight:600}
.fd-standard p{margin:0;max-width:62ch;font:400 1rem/1.65 var(--fd-serif);color:var(--fd-soft)}
.fd-standard .fd-kicker{font-family:var(--ak-sans)}
.fd-standard-ways{display:flex;gap:1.5rem;flex-wrap:wrap;font-family:var(--ak-sans)!important}
.fd-standard-ways a{font:600 .85rem var(--ak-sans);color:var(--fd-lime)}
.fd-standard-ways a:hover{text-decoration:underline;text-underline-offset:4px}
.fd-empty{margin:2.5rem 0 0;padding:1.5rem;border-radius:1rem;background:var(--fd-low);color:var(--fd-soft)}
.fd-empty a{color:var(--fd-lime)!important}
.fd :focus-visible{outline:2px solid var(--fd-lime);outline-offset:3px}
@media(max-width:960px){.fd-grid,.fd-columns{grid-template-columns:repeat(2,minmax(0,1fr))}.fd-shelf{grid-template-columns:repeat(2,minmax(0,1fr))}.fd-lead{grid-template-columns:1fr}.fd-lead-img{min-height:220px;max-height:420px;aspect-ratio:16/9}}
@media(max-width:640px){.fd-head{grid-template-columns:1fr}.fd-grid,.fd-columns{grid-template-columns:1fr}.fd-strip-facts{gap:.75rem!important}.fd-chips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-inline:-2px;padding-bottom:2px}.fd-chips a{flex:none}
.fd-tracks li{grid-template-columns:3rem minmax(0,1fr) auto}.fd-tracks .fd-when{display:none}.fd-agenda li{grid-template-columns:5rem minmax(0,1fr);gap:1rem}.fd-ahead{grid-column:2;text-align:left}.fd-lead{border-radius:1.1rem}.fd-card{border-radius:1.1rem}}
/* The composer (/cms/compose): the artboard-imposition workbench. Head with
   the page address, a tool row, then sections | sheet | inspector. */
.route-compose .cmc-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,420px);gap:24px clamp(24px,4vw,56px);align-items:end;padding:clamp(26px,4vw,52px) 0 22px}
.route-compose .cmc-head h1{margin:12px 0 14px;font:600 clamp(2.1rem,4.6vw,3.8rem)/1.04 var(--ak-sans);letter-spacing:-.035em;color:var(--ak-on-surface)}
.route-compose .ak-kicker a{text-decoration:none}
.route-compose .cmc-open{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin:0}
.route-compose .cmc-open .ak-field{flex:1 1 200px}
.route-compose .cmc-tools{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:center;padding:14px 0;border-top:1px solid var(--ak-outline-variant);border-bottom:1px solid var(--ak-outline-variant)}
.route-compose .cms-layout-modes{display:flex;flex-wrap:wrap;gap:6px}
.route-compose .cms-layout-modes button{padding:7px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:none;color:var(--ak-on-variant);font:500 13px var(--ak-sans);cursor:pointer}
.route-compose .cms-layout-modes button[aria-pressed=true]{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)}
.route-compose button:disabled{opacity:.42;cursor:default}
.route-compose .cmc-notice{min-height:44px;padding:12px 0;font:400 14px/1.5 'DM Mono',monospace;color:var(--ak-on-variant);white-space:pre-wrap}
.route-compose .cmc-desk{display:grid;grid-template-columns:minmax(220px,.85fr) minmax(0,2.2fr) minmax(250px,1fr);gap:18px;align-items:start}
.route-compose .cmc-desk[hidden]{display:none}
.route-compose #outline{display:grid;gap:6px}
.route-compose #outline button{padding:11px 13px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-mid);color:var(--ak-on-surface);font:500 14px/1.35 var(--ak-sans);text-align:left;overflow-wrap:anywhere;cursor:pointer}
.route-compose #outline button[aria-pressed=true]{border-color:var(--ak-primary);box-shadow:inset 3px 0 0 var(--ak-primary)}
.route-compose .actions{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0}
.route-compose .actions .ak-btn{min-height:34px;padding:6px 12px;font-size:13px}
.route-compose .quiet{font-size:12.5px;color:var(--ak-on-variant)}
.route-compose .eyebrow{font:500 11px 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--ak-primary)}
.route-compose .cmc-sheet #canvas{min-height:480px;padding:clamp(20px,3.5vw,48px);border-radius:16px;background:var(--ak-surface-lowest);border:1px dashed var(--ak-outline-variant);overflow-wrap:anywhere}
.route-compose #canvas h2{margin:6px 0 12px;font:600 clamp(1.8rem,3.4vw,2.8rem)/1.1 var(--ak-sans);letter-spacing:-.03em;color:var(--ak-on-surface)}
.route-compose #canvas h3{margin:4px 0 8px;font:600 1.4rem/1.2 var(--ak-sans);color:var(--ak-on-surface)}
.route-compose #canvas p{max-width:66ch;margin:0 0 8px;white-space:pre-wrap;font:400 1.05rem/1.65 var(--ak-serif);color:var(--ak-on-variant)}
.route-compose #canvas section{padding:18px 0;border-top:1px solid var(--ak-outline-variant)}
.route-compose #canvas section.selected{outline:2px solid var(--ak-primary);outline-offset:6px;border-radius:4px}
.route-compose #canvas a{color:var(--ak-primary)}
.route-compose #canvas[data-cms-layout=cards]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-content:start}
.route-compose #canvas[data-cms-layout=cards]>:not(section){grid-column:1/-1}
.route-compose #canvas[data-cms-layout=cards] section{padding:20px;border:1px solid var(--ak-outline-variant);border-radius:16px;background:var(--ak-surface-low)}
.route-compose #canvas[data-cms-layout=split] section{display:grid;grid-template-columns:minmax(120px,.32fr) minmax(0,1fr);gap:10px 22px}
.route-compose #canvas[data-cms-layout=split] section :is(.eyebrow,h3){grid-column:1}
.route-compose #canvas[data-cms-layout=split] section>p:not(.eyebrow):not(.cms-projection-proof),.route-compose #canvas[data-cms-layout=split] section>a{grid-column:2}
.route-compose .cms-projection-proof{font:400 11px/1.6 'DM Mono',monospace!important;color:var(--ak-on-variant)!important}
.route-compose .cms-preview-width-phone #canvas{width:min(390px,100%);margin-inline:auto}
.route-compose .cms-preview-width-phone #canvas[data-cms-layout] {display:block}
.route-compose .cms-edit-section{float:right;margin:0 0 8px 12px;padding:6px 12px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:500 12px var(--ak-sans);cursor:pointer}
.route-compose #inspector{margin:0}
.route-compose #fields h2{font:600 1.2rem/1.25 var(--ak-sans);color:var(--ak-on-surface);margin-bottom:6px}
.route-compose #fields label{display:grid;gap:6px;margin:12px 0;font:500 11px/1.3 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant)}
.route-compose #fields small{display:block;font:400 12px/1.4 var(--ak-sans);letter-spacing:0;text-transform:none}
.route-compose #fields :is(input,textarea,select){width:100%;padding:10px 12px;border:1px solid var(--ak-outline-variant);border-radius:12px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:400 14px/1.45 var(--ak-sans);letter-spacing:0;text-transform:none}
.route-compose #fields textarea{min-height:120px;resize:vertical}
.route-compose details{margin-top:18px;padding-top:12px;border-top:1px solid var(--ak-outline-variant)}
.route-compose summary{cursor:pointer;color:var(--ak-on-surface);font-weight:500}
.route-compose .cms-review{width:min(92vw,900px);max-height:min(88vh,960px);padding:0;overflow:auto;border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-mid);color:var(--ak-on-surface)}
.route-compose .cms-review::backdrop{background:rgba(5,9,6,.78)}
.route-compose .cms-review-head{padding:24px;border-bottom:1px solid var(--ak-outline-variant)}
.route-compose .cms-review-head h2{margin:6px 0;font:600 1.7rem/1.2 var(--ak-sans)}
.route-compose .cms-review-head p{color:var(--ak-on-variant)}
.route-compose .cms-review-items{display:grid;gap:10px;padding:16px 24px}
.route-compose .cms-review-item{display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;padding:14px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-low);overflow-wrap:anywhere}
.route-compose .cms-review-item h3{grid-column:1/-1;margin:0;font:600 14px var(--ak-sans)}
.route-compose .cms-review-item dt{font:500 10.5px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-on-variant)}
.route-compose .cms-review-item dd{margin:4px 0 0;white-space:pre-wrap}
.route-compose .cms-review [role=status]{padding:0 24px;font-size:13px;color:var(--ak-on-variant)}
.route-compose .cms-review-actions{position:sticky;bottom:0;display:flex;justify-content:flex-end;flex-wrap:wrap;gap:10px;padding:16px 24px;background:var(--ak-surface-mid);border-top:1px solid var(--ak-outline-variant)}
.route-compose .cmc-check{display:flex;gap:10px;align-items:center;font-size:15px}
.route-compose .cmc-visual{min-height:60vh;margin-top:18px;padding:12px;border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-low)}
@media(max-width:1080px){.route-compose .cmc-desk{grid-template-columns:minmax(200px,.8fr) minmax(0,2fr)}.route-compose #inspector{grid-column:1/-1}}
@media(max-width:720px){.route-compose .cmc-head,.route-compose .cmc-desk{grid-template-columns:minmax(0,1fr)}.route-compose #canvas[data-cms-layout=cards],.route-compose #canvas[data-cms-layout=split] section{grid-template-columns:minmax(0,1fr)}.route-compose #canvas[data-cms-layout=split] section>*{grid-column:1!important}.route-compose .cms-review-item{grid-template-columns:1fr}.route-compose .cmc-sheet #canvas{min-height:280px}}
/* Tool directory and setup workbench (/packs/setup; Stitch: tool packs
   workspace setup, casting-setup workbench). pack_setup.h emits the markup. */
.ak-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.ak-packs-hero .ak-kicker span{margin:0 6px;color:var(--ak-on-variant)}
.ak-packs-count{align-self:end;justify-self:end;display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:9px 16px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-low);font:500 12px/1.3 'DM Mono',monospace;color:var(--ak-on-surface)}
.ak-packs-count small{color:var(--ak-on-variant);font:inherit}
.ak-packs-rail,.ak-packs-where{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 28px;align-items:center;padding:18px 22px;border:1px solid var(--ak-outline-variant);border-radius:20px;background:var(--ak-surface-low)}
.ak-packs-where form{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:0}
.ak-packs-where label{font:500 12px 'DM Mono',monospace;letter-spacing:.06em;color:var(--ak-on-variant)}
.ak-packs-where br{display:none}
.ak-packs-where p{margin:0;font-size:13px}.ak-packs-where a{color:var(--ak-primary);text-decoration:none}
.ak-wb :is(.ak-packs-where,.ak-packs-filter) select,.ak-packs-filter input[type=search]{min-height:40px;padding:8px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:400 14px var(--ak-sans)}
.ak-packs-where button{min-height:40px;padding:8px 16px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-primary);font:500 13px var(--ak-sans);cursor:pointer}
.ak-packs-links{display:flex;gap:18px;font:500 13px var(--ak-sans)}.ak-packs-links a{color:var(--ak-on-variant)}
.ak-packs-filter{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:26px 0 6px;padding:10px 0;border-bottom:1px solid var(--ak-outline-variant)}
.ak-packs-find{flex:1 1 280px}.ak-packs-find input{width:100%}
.ak-packs-filter label:not(.ak-packs-find){display:inline-flex;align-items:center;gap:8px;font:500 12px 'DM Mono',monospace;color:var(--ak-on-variant)}
.ak-packs-views{display:inline-flex;padding:3px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-low)}
.ak-packs-views a{padding:6px 14px;border-radius:999px;font:500 13px var(--ak-sans);text-decoration:none;color:var(--ak-on-variant)}
.ak-packs-views a[aria-current]{background:var(--ak-primary);color:var(--ak-on-primary)}
.ak-packs-sec>header>div{display:flex;align-items:baseline;gap:12px}
.ak-packs-grid{grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr))}
.ak-pack{display:flex;flex-direction:column;gap:12px}
.ak-pack>header{display:flex!important;justify-content:space-between;align-items:center;margin:0!important}
.ak-pack-glyph{color:var(--ak-on-variant)}.ak-pack-glyph svg{width:20px;height:20px}
.ak-pack h3{font:600 1.2rem/1.25 var(--ak-sans)!important;letter-spacing:-.015em}
.ak-pack>p{font-size:14px;line-height:1.55}
.ak-pack-chain{padding:8px 12px;border-radius:12px;background:var(--ak-surface-lowest);font:500 12px/1.6 'DM Mono',monospace;color:var(--ak-primary)!important}
.ak-pack-chain span{color:var(--ak-on-variant);margin-right:6px}.ak-pack-chain i{font-style:normal;color:var(--ak-on-variant)}
.ak-pack-open a{color:var(--ak-primary);font-size:14px}.ak-pack-open p{margin:0}
.ak-pack>footer{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto;padding-top:8px}
.ak-pack>footer small{font:500 11px 'DM Mono',monospace;letter-spacing:.06em;color:var(--ak-on-variant)}
.ak-pack>footer .ak-btn{min-height:36px;padding:7px 15px;font-size:13px}
.ak-packs[data-pack-view=list] .ak-packs-grid{grid-template-columns:minmax(0,1fr)}
.ak-packs[data-pack-view=list] .ak-pack{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,2fr) auto;align-items:center;gap:6px 20px}
.ak-packs[data-pack-view=list] .ak-pack>header{grid-column:1;grid-row:1}.ak-packs[data-pack-view=list] .ak-pack h3{grid-column:1;grid-row:2}
.ak-packs[data-pack-view=list] .ak-pack>:is(p,.ak-pack-open){grid-column:2;grid-row:1/span 2;margin:0}
.ak-packs[data-pack-view=list] .ak-pack>footer{grid-column:3;grid-row:1/span 2;flex-direction:column;align-items:end;margin:0}
.ak-packs-foot{margin-top:40px;padding-top:18px;border-top:1px solid var(--ak-outline-variant);font:500 11.5px/1.5 'DM Mono',monospace;color:var(--ak-on-variant)}
.ak-pack-ops{margin:12px 0}.ak-pack-ops form{margin:0}
.ak-pack-proof h2 code{font:500 clamp(.8rem,1.4vw,1rem)/1.4 'DM Mono',monospace;overflow-wrap:anywhere;letter-spacing:0}
.ak-wb .pack-warning{padding:14px 16px;border:1px solid var(--ak-primary);border-radius:14px;color:var(--ak-on-surface)}
.ak-wb [data-pack-preview]{margin-top:16px}.ak-wb [data-pack-preview] a{color:var(--ak-primary)}
@media(max-width:640px){.ak-packs-count{justify-self:start}.ak-packs[data-pack-view=list] .ak-pack{grid-template-columns:minmax(0,1fr)}.ak-packs[data-pack-view=list] .ak-pack>*{grid-column:1!important;grid-row:auto!important}.ak-packs[data-pack-view=list] .ak-pack>footer{align-items:start}}
/* People (people_projection.c): residents with their own address, then the
   credited makers the estate reads, one row per exact source credit. */
.route-people .wrap>.hero{border-bottom:0;padding-bottom:12px}
.route-people .wrap>.hero h1{font:600 clamp(2.4rem,5vw,3.6rem)/1.05 var(--ak-sans);letter-spacing:-.035em}
.route-people .wrap>.hero .lede{font:400 clamp(1.05rem,1.6vw,1.3rem)/1.55 var(--ak-serif);color:var(--ak-on-variant);max-width:60ch}
.route-people .ak-stats.is-row{margin:0 0 18px}.route-people .ak-chips{border-bottom:0;padding-bottom:6px}
.people-sec{padding:clamp(24px,4vw,44px) 0 0}
.people-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:10px 24px;margin-bottom:16px}
.people-head h2{margin:0;text-transform:none;font:600 clamp(1.4rem,2.4vw,1.9rem)/1.2 var(--ak-sans);letter-spacing:-.025em;color:var(--ak-on-surface)}
.people-head h2 small{margin-left:8px;font:500 10.5px 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--ak-on-variant)}
.people-head p{margin:6px 0 0;max-width:62ch;font:400 15px/1.6 var(--ak-serif);color:var(--ak-on-variant)}
.people-members{display:grid;gap:12px;margin:0;padding:0;list-style:none}
.people-members>li{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;padding:clamp(16px,2.4vw,26px);border:1px solid var(--ak-outline-variant);border-radius:24px;background:var(--ak-surface-low)}
.people-members .ak-btn{margin-left:auto}
.people-avatar{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--ak-surface-high);color:var(--ak-primary);font:600 13px/1 var(--ak-sans)}
.people-members .people-avatar{width:56px;height:56px;background:var(--ak-primary);color:var(--ak-on-primary)}.people-avatar svg{width:22px;height:22px}
.people-member{flex:1 1 320px;min-width:0}.people-member strong{font:600 1.35rem/1.2 var(--ak-sans);letter-spacing:-.02em}.people-member strong a{color:var(--ak-on-surface);text-decoration:none}
[data-person-profile-buckets]{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 0}
.person-content-bucket{padding:5px 11px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:500 11.5px var(--ak-sans);color:var(--ak-on-surface);text-decoration:none}.person-content-bucket:hover{border-color:var(--ak-primary);color:var(--ak-primary)}
.people-hosts{display:flex;flex-wrap:wrap;gap:4px 16px;margin:10px 0 0}.people-hosts a{font:500 12px 'DM Mono',monospace;color:var(--ak-on-variant);text-decoration:none}.people-hosts a::before{content:"\25CF";margin-right:6px;font-size:7px;vertical-align:2px;color:var(--ak-outline)}.people-hosts a:hover{color:var(--ak-primary)}
.people-sort{display:flex;align-items:center;gap:8px}.people-sort label{font:500 10.5px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant)}
.people-sort select{min-height:36px;padding:6px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:500 12px var(--ak-sans)}
.people-search{display:flex;align-items:center;gap:10px;margin:0 0 18px;padding:6px 8px 6px 16px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-low)}
.people-search label{flex:1;display:flex;align-items:center;gap:10px;margin:0;min-width:0;color:var(--ak-on-variant)}.people-search svg{width:18px;height:18px;flex:none}
.people-search input{flex:1;min-width:0;padding:9px 0;border:0;background:none;color:var(--ak-on-surface);font:500 14px var(--ak-sans)}.people-search input:focus{outline:0}
.people-total{padding:6px 14px;border-radius:999px;background:var(--ak-surface-high);font:500 11px 'DM Mono',monospace;color:var(--ak-on-variant);white-space:nowrap}.people-total b{color:var(--ak-on-surface)}
.people-list{margin:0;padding:0;list-style:none;border:1px solid var(--ak-outline-variant);border-radius:18px;overflow:hidden}
.people-list>li{display:grid;grid-template-columns:34px 44px minmax(0,1fr) minmax(120px,auto) auto;gap:6px 18px;align-items:center;padding:18px clamp(14px,2vw,26px);border-top:1px solid var(--ak-outline-variant);background:var(--ak-surface-lowest)}
.people-list>li:first-child{border-top:0}.people-list>li:hover{background:var(--ak-surface-low)}
.people-n{font:600 11px 'DM Mono',monospace;color:var(--ak-primary)}
.people-who{min-width:0}.people-who h3{margin:0;font:600 1.05rem/1.3 var(--ak-sans);color:var(--ak-on-surface)}.people-who h3 a{color:inherit;text-decoration:none}.people-who h3 a:hover{color:var(--ak-primary)}
.people-who h3 small{margin-left:6px;font:500 11px var(--ak-sans);color:var(--ak-on-variant)}
.people-latest{margin:4px 0 0;font:400 12.5px/1.5 var(--ak-sans);color:var(--ak-on-variant);overflow-wrap:anywhere}.people-latest a{color:var(--ak-on-surface);text-decoration:none}.people-latest a:hover{color:var(--ak-primary)}
.people-count{margin:0;text-align:right}.people-count b{display:block;font:600 14px var(--ak-sans);color:var(--ak-on-surface)}.people-count small{font:500 11px 'DM Mono',monospace;color:var(--ak-on-variant);overflow-wrap:anywhere}
.people-keep{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid var(--ak-outline-variant);border-radius:8px;font:600 11px var(--ak-sans);color:var(--ak-on-surface);text-decoration:none;white-space:nowrap}.people-keep svg{width:14px;height:14px}.people-keep:hover{border-color:var(--ak-primary);color:var(--ak-primary)}
.people-pager{display:flex;justify-content:center;gap:10px;margin:24px 0}
.people-boundary{max-width:72ch;margin:22px auto 0;text-align:center;font:400 13px/1.7 var(--ak-sans);color:var(--ak-on-variant)}
.people-dossier-head h2{margin:0;font:600 clamp(2rem,4vw,3rem)/1.05 var(--ak-sans);letter-spacing:-.03em}.people-dossier-head p{margin:8px 0 0;color:var(--ak-on-variant)}
.people-source-list,.people-work-list{margin:0;padding:0;list-style:none}.people-source-list li,.people-work-list li{padding:14px 0;border-bottom:1px solid var(--ak-outline-variant)}
.people-source-list h3{margin:0;font:600 1.05rem var(--ak-sans)}.people-source-list h3 a{color:var(--ak-on-surface);text-decoration:none}
.people-work-list a{color:var(--ak-on-surface);font-weight:600;text-decoration:none}.people-work-list a:hover{color:var(--ak-primary)}.people-work-list p,.people-source-list p{margin:4px 0 0;font-size:13.5px;color:var(--ak-on-variant)}
@media(max-width:760px){.people-list>li{grid-template-columns:26px 38px minmax(0,1fr)}.people-count{grid-column:3;text-align:left}.people-count b{display:inline;margin-right:6px}.people-keep{grid-column:3;justify-self:start}.people-avatar{width:38px;height:38px}.people-members .ak-btn{margin-left:0}.people-head{align-items:start}}

/* Source catalogue and reading surfaces share the estate's composition tokens. */
.sx-page .sx{box-sizing:border-box;width:min(100% - 2rem,1400px);margin:auto;padding:clamp(2rem,5vw,4rem) 0}
.sx-page .sx *{box-sizing:border-box}
.sx-page .sx :is(h1,h2,h3,p,blockquote,dl){margin-top:0}
.sx-page .sx :is(p,li){line-height:1.6}
.sx-page .sx a{text-decoration:none}
.sx-page .sx :is(a,button,input,select,textarea,summary):focus-visible,.sx-dialog :is(button,input):focus-visible{outline:2px solid var(--ak-primary);outline-offset:3px}
.sx-page .sx svg{width:1em;height:1em;flex:none}
.sx-crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;margin-bottom:1.3rem;color:var(--ak-on-variant);font:500 .72rem/1.5 var(--ak-sans)}
.sx-crumbs a:hover{color:var(--ak-primary)}.sx-crumbs em{font-family:Literata,Georgia,serif}
.sx-hero{
  @apply flex justify-between items-end;
  gap:2rem;margin-bottom:2rem;
  & > div{max-width:53rem}
  & h1{font:700 clamp(2.2rem,4.4vw,4.4rem)/1.04 var(--ak-sans);letter-spacing:-.045em;margin-bottom:1rem;
    & em{font:400 italic 1em/1.04 Literata,Georgia,serif;color:var(--ak-on-variant)}
  }
  & p{font:400 clamp(1rem,1.3vw,1.2rem)/1.55 Literata,Georgia,serif;color:var(--ak-on-variant);max-width:60ch;margin-bottom:0}
}
.sx-actions,.sx-reading-actions,.sx-notice nav,.sx-pager,.sx-inline{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center}
.sx-btn,.sx-chip,.sx-sort select{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:40px;padding:.6rem 1rem;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:600 .78rem/1.2 var(--ak-sans);cursor:pointer}
.sx-btn:hover,.sx-chip:hover{border-color:var(--ak-primary);color:var(--ak-primary)}
.sx-btn.sx-primary,.sx-chip[aria-current=true]{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)}
.sx-panel,.sx-card,.sx-reading,.sx-rail>section{min-width:0;padding:clamp(1rem,2vw,1.6rem);border:1px solid var(--ak-outline-variant);border-radius:1.25rem;background:var(--ak-surface-low)}
.sx-panel{margin:0 0 1.4rem}.sx-finder{background:var(--ak-surface-low);padding:1rem}
.sx-modes{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem}.sx-modes>span,.sx-modes>button{display:inline-flex;align-items:center;gap:.4rem;min-height:38px;padding:.5rem .85rem;border:0;border-radius:999px;background:transparent;color:var(--ak-on-surface);font:600 .78rem var(--ak-sans)}
.sx-modes>span[aria-current=true]{background:var(--ak-primary);color:var(--ak-on-primary)}.sx-modes>button{cursor:pointer}.sx-modes>button:hover{background:var(--ak-surface-high)}
.sx-live{margin:0 0 0 auto;color:var(--ak-on-variant);font-size:.72rem}
.sx-search{display:flex;gap:.5rem;align-items:center;margin:.8rem 0;padding:.35rem .35rem .35rem 1rem;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-lowest)}
.sx-search:focus-within{border-color:var(--ak-primary)}.sx-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--ak-on-surface);font:400 .9rem var(--ak-sans)}
.sx-chips{display:flex;flex-wrap:wrap;gap:.4rem}.sx-chip{min-height:32px;padding:.4rem .75rem;font-size:.7rem}.sx-chip span{opacity:.7}
.sx-policy{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.7fr);gap:1.5rem;background:var(--ak-surface-lowest)}
.sx-kicker{color:var(--ak-primary);font:600 .67rem/1.4 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
.sx-policy h2,.sx-section-head h2,.sx-register h2,.sx-rail h2{font:600 clamp(1.1rem,1.8vw,1.5rem)/1.2 var(--ak-sans);letter-spacing:-.025em;margin-bottom:.4rem}
.sx-policy p,.sx-section-head p,.sx-card p,.sx-rail p{color:var(--ak-on-variant);font-size:.82rem}
.sx-tiles,.sx-stats,.sx-provenance{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0 0}.sx-tiles>div,.sx-stats>div,.sx-provenance>div{min-width:7rem;padding:.75rem;border-radius:.8rem;background:var(--ak-surface-mid)}
.sx-tiles dt,.sx-stats dt,.sx-provenance dt{font-size:.7rem;color:var(--ak-on-variant)}.sx-tiles dd,.sx-stats dd,.sx-provenance dd{margin:.3rem 0 0;font-weight:700}
.sx-rules,.sx-register ol,.sx-also{margin:0;padding:0;list-style:none}.sx-rules{display:grid;gap:.5rem}.sx-rules a{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-radius:999px;background:var(--ak-surface-low);font-size:.8rem}.sx-rules code{color:var(--ak-primary)}
.sx-section-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin:2rem 0 1rem}.sx-section-head p{margin-bottom:0}.sx-sort{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;color:var(--ak-on-variant);font-size:.75rem}
.sx-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.sx-card header,.sx-card footer{display:flex;align-items:center;justify-content:space-between;gap:.6rem}.sx-card h3{font:600 1rem/1.25 var(--ak-sans);margin:0}.sx-card h3 a:hover,.sx-latest:hover,.sx-dispatch:hover b{color:var(--ak-primary)}
.sx-card footer{border-top:1px solid var(--ak-outline-variant);padding-top:.85rem;margin-top:.85rem;font-size:.75rem}.sx-card footer a{display:inline-flex;align-items:center;gap:.4rem}
.sx-host,.sx-badge,.sx-meta,.sx-byline{color:var(--ak-on-variant);font-size:.72rem}.sx-latest{display:grid;gap:.25rem;padding:.8rem;border-radius:.75rem;background:var(--ak-surface-lowest);font:400 .8rem/1.5 Literata,Georgia,serif}.sx-latest small,.sx-latest time{font:500 .68rem var(--ak-sans);color:var(--ak-on-variant)}
.sx-notice{margin-top:2rem;background:var(--ak-surface-lowest)}.sx-notice blockquote{max-width:75ch;margin:.4rem 0 1.2rem;font:italic 1rem/1.55 Literata,Georgia,serif}.sx-empty{color:var(--ak-on-variant)}
.sx-split{display:grid;grid-template-columns:minmax(15rem,.8fr) minmax(0,1.5fr);gap:1rem;align-items:start}.sx-three{grid-template-columns:minmax(14rem,.8fr) minmax(0,1.4fr) minmax(13rem,.65fr)}
.sx-register ol{display:grid;gap:.4rem}.sx-dispatch{display:grid;gap:.4rem;padding:1rem;border-radius:.8rem;background:var(--ak-surface-lowest)}.sx-dispatch[aria-current=true]{outline:1px solid var(--ak-primary)}.sx-dispatch small,.sx-dispatch span,.sx-dispatch em{color:var(--ak-on-variant);font:400 .75rem/1.4 var(--ak-sans)}.sx-dispatch time{float:right}.sx-dispatch b{font-size:.9rem}
.sx-reading h2{font:600 clamp(1.5rem,2.4vw,2.4rem)/1.15 var(--ak-sans);letter-spacing:-.035em;margin:1.5rem 0 .5rem}.sx-reading figure{margin:1.3rem 0}.sx-reading img{max-width:100%;height:auto;border-radius:.8rem}.sx-body{font:400 1.05rem/1.8 Literata,Georgia,serif;color:var(--ak-on-variant);overflow-wrap:anywhere}.sx-reading-actions{margin-top:1.5rem}.sx-rail>section{margin-bottom:1rem}.sx-also li{padding:.7rem 0;border-bottom:1px solid var(--ak-outline-variant)}.sx-also time{display:block;font-size:.7rem;color:var(--ak-on-variant)}
.sx-dialog{width:min(36rem,calc(100vw - 2rem));padding:clamp(1rem,3vw,2rem);border:1px solid var(--ak-outline-variant);border-radius:1.25rem;background:var(--ak-surface-low);color:var(--ak-on-surface);font-family:var(--ak-sans)}.sx-dialog::backdrop{background:#000b}.sx-dialog header,.sx-dialog footer{display:flex;justify-content:space-between;align-items:start;gap:1rem}.sx-dialog footer{justify-content:flex-end}.sx-dialog h2{margin:.3rem 0}.sx-dialog p,.sx-steps{color:var(--ak-on-variant);line-height:1.6;font-size:.85rem}.sx-field{display:grid;gap:.5rem;margin:1rem 0;font-size:.8rem}.sx-field input{width:100%;padding:.8rem 1rem;border:1px solid var(--ak-outline-variant);border-radius:.75rem;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:inherit}.sx-x{border:0;background:transparent;color:var(--ak-on-surface);font-size:1.5rem;cursor:pointer}
.sx-visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:1000px){.sx-three{grid-template-columns:minmax(13rem,.8fr) minmax(0,1.2fr)}.sx-three .sx-rail{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}}
@media(max-width:680px){.sx-page .sx{width:calc(100% - 2rem)}.sx-hero,.sx-section-head{align-items:start;flex-direction:column}.sx-hero{gap:1rem}.sx-policy,.sx-grid,.sx-split,.sx-three,.sx-three .sx-rail{grid-template-columns:1fr}.sx-three .sx-rail{grid-column:auto}.sx-live{margin-left:0}.sx-rules a{border-radius:.8rem;flex-wrap:wrap}.sx-card header,.sx-card footer{flex-wrap:wrap}.sx-sort{align-self:start}}
.sx-hero .sx-kicker{margin:0 0 .6rem;font:600 .67rem/1.4 'DM Mono',monospace;color:var(--ak-primary);letter-spacing:.08em;text-transform:uppercase}.sx-chips+.sx-split,.sx-room-filter+.sx-split{margin-top:1.6rem}
.subj-page>main.wrap{width:min(100% - 2rem,1100px);margin:auto;padding:clamp(1.5rem,4vw,3rem) 0}.subj-page .subj-name{font:600 clamp(2rem,4.6vw,3.8rem)/1.05 var(--ak-sans);letter-spacing:-.045em}.subj-page .button{display:inline-flex;align-items:center;min-height:40px;padding:.6rem 1.1rem;border:1px solid var(--ak-primary);border-radius:999px;background:var(--ak-primary);color:var(--ak-on-primary);font:600 .8rem var(--ak-sans);cursor:pointer}.subj-page .review-address{font:500 .9rem 'DM Mono',monospace;color:var(--ak-primary)}
.cx-radius{flex:0 1 20rem;margin:0}.cx-radius .cx-big{margin:0;font:600 2.6rem/1 var(--ak-sans);letter-spacing:-.04em;color:var(--ak-on-surface)}.cx-big small{margin-left:.5rem;font:500 .75rem var(--ak-sans);letter-spacing:0;color:var(--ak-on-variant)}
.cx-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.cx-lot h3{font-size:1.1rem}.cx-lot>p{flex:1;color:var(--ak-on-surface);font:400 .9rem/1.55 Literata,Georgia,serif}.cx-lot{display:flex;flex-direction:column}.cx-lot footer a{color:var(--ak-primary)}
.cx-modes{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:2rem;margin:3.5rem 0}.cx-modes h2,.cx-trust h2,.cx-cta h2{font:600 clamp(1.6rem,3vw,2.5rem)/1.1 var(--ak-sans);letter-spacing:-.035em}.cx-modes-copy>p{color:var(--ak-on-variant);font:400 1rem/1.6 Literata,Georgia,serif}.cx-zero{color:var(--ak-on-surface)!important;font:400 .9rem/1.5 var(--ak-sans)!important}.cx-zero b{color:var(--ak-primary)}
.cx-mode-list{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.cx-mode-list a{display:grid;gap:.3rem;height:100%;padding:1rem;border:1px solid var(--ak-outline-variant);border-radius:1rem;background:var(--ak-surface-low)}.cx-mode-list a:hover{border-color:var(--ak-primary)}.cx-n{color:var(--ak-primary);font:600 .9rem 'DM Mono',monospace}.cx-mode-list small{float:right;color:var(--ak-on-variant);font:500 .62rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.06em}.cx-mode-list b{font-size:.95rem}.cx-mode-list span:not(.cx-n){color:var(--ak-on-variant);font-size:.8rem;line-height:1.5}.cx-mode-list em{font:500 .68rem 'DM Mono',monospace;font-style:normal;color:var(--ak-on-variant)}
.cx-trust{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2rem;align-items:center;margin:3.5rem 0}.cx-trust .cx-checks{grid-template-columns:1fr}.cx-checks li{font-size:.9rem;line-height:1.5}.cx-trust .cx-stats{grid-template-columns:repeat(2,minmax(0,1fr));margin:0}.cx-modes-copy>p.sx-kicker{font:600 .67rem/1.4 "DM Mono",monospace;color:var(--ak-primary)}
.cx-cta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem;margin-top:3rem;padding:clamp(1.5rem,4vw,3rem);border-radius:1.5rem;background:var(--ak-primary);color:var(--ak-on-primary)}.cx-cta p{margin:0;max-width:48ch;font:400 1rem/1.55 Literata,Georgia,serif}.cx-cta .sx-btn{background:transparent;border-color:currentColor;color:inherit}.cx-cta .sx-btn.cx-dark{background:var(--ak-on-primary);color:var(--ak-primary);border-color:var(--ak-on-primary)}
.ai-out .sx-dispatch{cursor:default}
@media(max-width:900px){.cx-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cx-modes,.cx-trust{grid-template-columns:1fr}}
@media(max-width:600px){.cx-grid,.cx-mode-list{grid-template-columns:1fr}}
.sx-register h2 span{display:block;margin-top:.2rem;color:var(--ak-on-variant);font:500 .7rem 'DM Mono',monospace;letter-spacing:.04em}
.sx-dispatch[aria-current=true]{outline:0;background:var(--ak-surface-mid);box-shadow:inset 3px 0 0 var(--ak-primary)}.sx-dispatch small{display:flex;justify-content:space-between;gap:.5rem;color:var(--ak-primary);font:600 .66rem/1.4 'DM Mono',monospace;letter-spacing:.05em;text-transform:uppercase}.sx-dispatch small time{float:none;color:var(--ak-on-variant);text-transform:none;white-space:nowrap}
.sx-reading{position:sticky;top:1rem}.sx-reading-actions{padding:.8rem;border-radius:1rem;background:var(--ak-surface-mid)}.sx-provenance{margin:0}.sx-provenance dd{font:500 .72rem 'DM Mono',monospace;color:var(--ak-primary)}.sx-provenance dd a{color:inherit}
.sx-quiet{color:var(--ak-on-variant);font:italic 1rem/1.55 Literata,Georgia,serif}.sx-back,.sx-operator{margin-top:2rem;font-size:.75rem;color:var(--ak-on-variant)}.sx-back a,.sx-operator a{color:var(--ak-primary)}
.sx-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0 0 2rem}.sx-stats dd{font:600 clamp(1.2rem,2vw,1.7rem)/1.2 var(--ak-sans);letter-spacing:-.02em;overflow-wrap:anywhere}.sx-stats dd small{display:block;margin-top:.25rem;font:500 .7rem/1.4 var(--ak-sans);color:var(--ak-on-variant)}.sx-stats dd a,.sx-stats code{color:var(--ak-primary)}
.sx-session .sx-stats{grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));margin:0}.sx-session .sx-stats dd{font-size:1.05rem}.sx-invariant{flex:0 1 22rem;margin:0}
.sx-relay header{justify-content:flex-start;flex-wrap:wrap}.sx-relay .sx-badge{margin-left:auto;padding:.2rem .6rem;border:1px solid var(--ak-outline-variant);border-radius:999px}.sx-badge.is-on{border-color:var(--ak-primary);color:var(--ak-primary)}.sx-relay>p{color:var(--ak-on-surface);font:400 .95rem/1.55 Literata,Georgia,serif}
.sx-mark{display:grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:.7rem;background:var(--ak-surface-high);color:var(--ak-primary)}
.sx-log{margin-top:2.5rem}.sx-table-wrap{overflow-x:auto;border:1px solid var(--ak-outline-variant);border-radius:1.25rem;background:var(--ak-surface-low)}.sx-table{width:100%;border-collapse:collapse;font-size:.85rem}.sx-table th{padding:.85rem 1rem;text-align:left;color:var(--ak-on-variant);font:600 .66rem 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid var(--ak-outline-variant)}.sx-table td{padding:.8rem 1rem;border-bottom:1px solid color-mix(in srgb,var(--ak-outline-variant) 50%,transparent);vertical-align:top}.sx-table td a{font-weight:600}.sx-table td a:hover{color:var(--ak-primary)}.sx-table td small{display:block;color:var(--ak-on-variant);font-size:.75rem}.sx-table td:last-child{white-space:nowrap;color:var(--ak-on-variant);font:500 .7rem 'DM Mono',monospace}
.sx-settings{grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:1.4rem}.sx-options{margin:1rem 0;padding:0;list-style:none;display:grid;gap:.5rem}.sx-options li{display:grid;gap:.25rem;padding:.9rem 1rem;border-radius:.9rem;background:var(--ak-surface-mid)}.sx-options span{color:var(--ak-on-variant);font-size:.85rem}.sx-options code,.sx-code{font:500 .75rem 'DM Mono',monospace;color:var(--ak-primary)}.sx-code{display:block;margin:1rem 0;padding:.9rem;border-radius:.8rem;background:var(--ak-surface-lowest);white-space:pre-wrap;overflow-wrap:anywhere}
.sx-checks{margin:.8rem 0 1.2rem;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:.5rem}.sx-checks li{padding:.6rem .8rem;border-radius:.7rem;background:var(--ak-surface-mid);font-size:.8rem}.sx-checks li::before{content:"\2713";margin-right:.5rem;color:var(--ak-primary)}
.sx-form{display:grid;gap:.25rem;max-width:36rem}.sx-field select{padding:.7rem 1rem;border:1px solid var(--ak-outline-variant);border-radius:.75rem;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:inherit}.sx-steps{display:grid;gap:.4rem;padding-left:1.2rem}.sx-steps b{color:var(--ak-on-surface)}.sx-btn.sx-quiet-btn{min-height:30px;padding:.3rem .8rem;background:transparent}
@media(max-width:680px){.sx-stats,.sx-settings{grid-template-columns:1fr 1fr}.sx-settings{grid-template-columns:1fr}.sx-reading{position:static}.sx-room .sx-reading,.sx-reader .sx-reading{order:-1}.sx-checks{grid-template-columns:1fr}}
.ak-packs-rail .ak-packs-where{padding:0;border:0;background:none}
.ak-pack>footer .ak-btn{white-space:nowrap}
.ak-wb .ak-pattern.ak-action,.ak-wb .ak-pattern.ak-field{background:none;border:0;box-shadow:none;padding:0;margin:0;max-width:none}.ak-wb .ak-action{display:flex;flex-wrap:wrap;gap:12px;align-items:end}
/* Spatial (shop/work /parcels): the cartography instrument. The places region
   is the instrument -- plate beside its placed-record router -- and every
   region sits on the night surface as a panel, photos as spreads. */
body.ak-app[data-aurekai-pattern=spatial] .wrap>.hero{padding-block:clamp(28px,5vw,64px) clamp(16px,3vw,28px)}
body.ak-app[data-aurekai-pattern=spatial] .wrap>.hero h1{font:600 clamp(2.4rem,5.2vw,4.4rem)/1.03 var(--ak-sans);letter-spacing:-.035em;color:var(--ak-on-surface)}
body.ak-app[data-aurekai-pattern=spatial] .wrap>.hero .lede{max-width:60ch;font:400 clamp(1.05rem,1.6vw,1.4rem)/1.5 var(--ak-serif);color:var(--ak-on-variant)}
body.ak-app[data-aurekai-pattern=spatial] .ak-experience>[data-ak-region]{margin:18px 0;padding:clamp(18px,2.4vw,30px)!important;border:1px solid var(--ak-outline-variant)!important;border-radius:24px;background:var(--ak-surface-low)!important;color:var(--ak-on-surface)!important;max-width:none!important}
body.ak-app[data-aurekai-pattern=spatial] [data-ak-region] :is(h2,.region-label){font:600 clamp(1.4rem,2.4vw,2rem)/1.15 var(--ak-sans)!important;letter-spacing:-.025em;color:var(--ak-on-surface)!important}
body.ak-app[data-aurekai-pattern=spatial] .region-places .region-label::before{content:"Live cartography \00B7  ";display:block;margin-bottom:6px;font:500 11px 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
body.ak-app[data-aurekai-pattern=spatial] figure.map.with-list{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr);grid-template-areas:"tools tools" "plate list" "insp list";gap:14px 22px;margin:0}
body.ak-app[data-aurekai-pattern=spatial] figure.map .map-tools{grid-area:tools}
body.ak-app[data-aurekai-pattern=spatial] figure.map .plate{grid-area:plate;padding:14px;border-radius:18px;background:var(--ak-surface-lowest);border:1px solid var(--ak-outline-variant)}
body.ak-app[data-aurekai-pattern=spatial] figure.map .plate svg{display:block;width:100%;height:auto}
body.ak-app[data-aurekai-pattern=spatial] figure.map .places-list{grid-area:list;max-height:560px;overflow:auto;margin:0;padding:0 6px 0 0;list-style:none}
body.ak-app[data-aurekai-pattern=spatial] figure.map .places-list li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:2px 10px;align-items:center;padding:12px 0;border-top:1px solid var(--ak-outline-variant)}
body.ak-app[data-aurekai-pattern=spatial] figure.map .places-list li a{color:var(--ak-on-surface);font:500 14px/1.35 var(--ak-sans);text-decoration:none}
body.ak-app[data-aurekai-pattern=spatial] figure.map .places-list .by{grid-column:2;font:400 11.5px/1.4 'DM Mono',monospace;color:var(--ak-on-variant)}
body.ak-app[data-aurekai-pattern=spatial] figure.map .places-list [data-locate-point]{grid-row:1/span 2;min-height:34px;margin:0;padding:6px 12px;border-color:var(--ak-outline-variant);border-radius:999px;font:500 12px var(--ak-sans)}
body.ak-app[data-aurekai-pattern=spatial] figure.map .map-inspector{grid-area:insp;margin:0}
body.ak-app[data-aurekai-pattern=spatial] figure.map .map-tools input{border-color:var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-lowest)}
body.ak-app[data-aurekai-pattern=spatial] .region-photos .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
body.ak-app[data-aurekai-pattern=spatial] .region-photos figure.photo{margin:0;padding:10px;border:1px solid var(--ak-outline-variant);border-radius:16px;background:var(--ak-surface-mid)}
body.ak-app[data-aurekai-pattern=spatial] .region-photos figure.photo img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px}
body.ak-app[data-aurekai-pattern=spatial] .region-photos :is(figcaption,.terms,.via){color:var(--ak-on-variant)}
@media(max-width:900px){body.ak-app[data-aurekai-pattern=spatial] figure.map.with-list{grid-template-columns:minmax(0,1fr);grid-template-areas:"tools" "plate" "insp" "list"}body.ak-app[data-aurekai-pattern=spatial] .region-photos .grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
body.ak-app[data-aurekai-pattern=spatial] .ak-experience>[data-ak-region][class*=region-dress-]{--w-ground:var(--ak-surface-low)!important;--w-ink:var(--ak-on-surface)!important;--w-display:var(--ak-on-surface)!important;--w-accent:var(--ak-primary)!important;--w-muted:var(--ak-on-variant)!important;--w-rule:var(--ak-outline-variant)!important;--w-panel:var(--ak-surface-mid)!important;--w-face-display:var(--ak-sans)!important;--w-face-body:var(--ak-sans)!important;grid-column:1/-1!important;width:auto!important}
body.ak-app[data-aurekai-pattern=spatial] .region-photos .field{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
@media(max-width:900px){body.ak-app[data-aurekai-pattern=spatial] .region-photos .field{grid-template-columns:repeat(2,minmax(0,1fr))}}
/* Member journal inside the shell (profile_journal_index.h, profile_home.h):
   index = reading list on the front's strip/head/chips; article = zen column. */
.ak-journal-main{width:min(calc(100% - 32px),1240px);margin-inline:auto}
.ak-journal-lead{margin-top:1.25rem}
.ak-journal-lead h2{max-width:24ch}
.ak-journal-rows{padding-top:clamp(2rem,4vw,3rem)}
.ak-journal-rows ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--fd-line)}
.ak-journal-rows li{display:grid;gap:.4rem;padding:1.4rem 0;border-bottom:1px solid var(--fd-line);max-width:none}
.ak-journal-rows h3{font-size:clamp(1.15rem,1.8vw,1.45rem);font-weight:600;line-height:1.25;max-width:40ch}
.ak-journal-rows h3 a:hover{color:var(--fd-lime)}
.ak-journal-rows .fd-dek{max-width:72ch;-webkit-line-clamp:2;margin:0}
.ak-journal-rows .fd-card-top{justify-content:flex-start;gap:1rem}
.ak-journal-article .ak-journal-main{width:min(calc(100% - 32px),1240px)}
.ak-zen-bar{display:flex;align-items:center;gap:.75rem 1.5rem;flex-wrap:wrap;padding:.9rem 0;border-bottom:1px solid var(--ak-outline-variant,#444935);font:600 .72rem/1.4 var(--ak-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant,#c5c9af)}
.ak-zen-bar p{margin:0;flex:1}.ak-zen-bar p span{color:var(--ak-primary,#d0fc4f)}
.ak-zen-back{display:inline-flex;align-items:center;gap:.4rem;min-height:36px;text-decoration:none;color:var(--ak-on-surface,#dee4dd)}
.ak-zen-back:hover{color:var(--ak-primary,#d0fc4f)}
.ak-zen-tools{display:flex;gap:.4rem;align-items:center}
.ak-zen-tools button{display:inline-flex;align-items:center;gap:.4rem;min-height:36px;padding:0 .8rem;border-radius:999px;border:1px solid var(--ak-outline-variant,#444935);background:var(--ak-surface-low,#171d19);color:var(--ak-on-surface,#dee4dd);font:600 .75rem var(--ak-sans);letter-spacing:0;text-transform:none;cursor:pointer}
.ak-zen-tools button:hover{border-color:var(--ak-primary,#d0fc4f);color:var(--ak-primary,#d0fc4f)}
.ak-zen-tools .ak-icon{width:1rem;height:1rem}
.ak-zen{--zen-scale:1;max-width:680px;margin:0 auto;padding:clamp(2.5rem,6vw,4.5rem) 0 1rem;color:var(--ak-on-surface,#dee4dd)}
.ak-zen-kicker{display:flex;gap:.6rem;flex-wrap:wrap;margin:0 0 1.25rem;font:600 .68rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant,#c5c9af)}
.ak-zen-kicker span:first-child{padding:.2rem .6rem;border-radius:999px;background:color-mix(in srgb,var(--ak-primary,#d0fc4f) 16%,transparent);color:var(--ak-primary,#d0fc4f)}
.ak-zen-head h1{margin:0;font:500 clamp(2.1rem,5vw,3.3rem)/1.08 var(--ak-sans);letter-spacing:-.035em;text-wrap:balance;color:var(--ak-on-surface,#dee4dd)}
.ak-zen-lede{margin:1.1rem 0 0;font:400 1.2rem/1.55 'Literata',Georgia,serif;color:var(--ak-on-variant,#c5c9af)}
.ak-zen-by{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin:1.75rem 0 0;padding-bottom:2rem;border-bottom:1px solid var(--ak-outline-variant,#444935);font:600 .85rem var(--ak-sans)}
.ak-zen-initials{display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:50%;background:var(--ak-surface-high,#252b27);color:var(--ak-primary,#d0fc4f);font:700 .75rem var(--ak-sans)}
.ak-zen-meta{margin-left:auto;font-weight:500;color:var(--ak-on-variant,#c5c9af)}
.ak-zen-body{padding-top:2rem;font-size:calc(1.1rem * var(--zen-scale))}
.ak-zen-body .authored-site{background:none!important;color:inherit!important;padding:0!important;margin:0!important}
.ak-zen-body .authored-site :is(.authored-profile-story,.profile-block,.owned-section){max-width:none;padding:0!important;margin:0 0 2.25rem!important;background:none!important;border:0!important}
.ak-zen-body :is(p,li){font:400 1em/1.8 'Literata',Georgia,serif;color:var(--ak-on-surface,#dee4dd);margin:0 0 1.25em}
.ak-zen-body .authored-profile-story:first-child>p:first-of-type::first-letter{float:left;margin:.08em .12em 0 0;font:600 3.6em/.8 var(--ak-sans);color:var(--ak-primary,#d0fc4f)}
.ak-zen-body :is(h2,h3){margin:0 0 .8rem;font:500 clamp(1.4rem,2.6vw,1.75rem)/1.2 var(--ak-sans);letter-spacing:-.02em;color:var(--ak-on-surface,#dee4dd)}
.ak-zen-body a{color:var(--ak-primary,#d0fc4f);text-underline-offset:3px}
.ak-zen-body blockquote{margin:2rem 0;padding:.25rem 0 .25rem 1.5rem;border-left:3px solid var(--ak-primary,#d0fc4f);font:italic 400 1.3em/1.5 'Literata',Georgia,serif}
.ak-zen-body :is(img,figure){max-width:100%;border-radius:1rem}
.ak-zen-next{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--ak-outline-variant,#444935)}
.ak-zen-next h2{margin:0 0 1rem;font:600 .72rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant,#c5c9af)}
.ak-zen-next ol{list-style:none;margin:0 0 1rem;padding:0}
.ak-zen-next li{display:grid;gap:.2rem;padding:.9rem 0;border-bottom:1px solid var(--ak-outline-variant,#444935)}
.ak-zen-next li span{font:600 .66rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--ak-primary,#d0fc4f)}
.ak-zen-next li a{font:600 1.05rem/1.35 var(--ak-sans);text-decoration:none;color:var(--ak-on-surface,#dee4dd)}
.ak-zen-next li a:hover{color:var(--ak-primary,#d0fc4f)}
.ak-zen-next .fd-open{text-decoration:none;color:var(--ak-on-surface,#dee4dd);font:600 .85rem var(--ak-sans)}
@media(max-width:640px){.ak-zen-bar p{flex-basis:100%;order:3}.ak-zen-tools{margin-left:auto}.ak-zen-meta{margin-left:0;flex-basis:100%}.ak-zen{padding-top:2rem}}
.ak-wb .authored-site{all:unset;display:block;min-width:0}.ak-wb .ak-field input{min-width:0;width:100%}
.ak-packs-filter input:not([type=search]):not([type=hidden]){min-height:40px;width:12rem;padding:8px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:400 14px var(--ak-sans)}
/* What's on: the Stitch agenda. One region of dated events read forwards,
   date and time on the left, the event and its place beside it, the filter
   chips above. No preview sections under it (page-composition.cue). */
body.route-whats-on [data-exp-controls],body.route-whats-on .region-soon [data-exp-focus]{display:none!important}
body.route-whats-on .wrap>.hero h1{font:600 clamp(2.4rem,5vw,3.6rem)/1.05 var(--ak-sans);letter-spacing:-.035em;color:var(--ak-on-surface)}
body.route-whats-on .wrap>.hero .lede{font:400 clamp(1.05rem,1.6vw,1.3rem)/1.55 var(--ak-serif);color:var(--ak-on-variant);max-width:60ch}
body.route-whats-on :is(.wrap>.region,.ak-experience .region){max-width:none!important;width:auto!important;margin:0!important;padding:clamp(24px,4vw,44px) 0!important;background:none!important;border:0!important;border-radius:0!important;box-shadow:none!important;color:var(--ak-on-surface)!important}
body.route-whats-on .region .region-label{margin:0 0 6px;font:600 clamp(1.5rem,2.6vw,2.1rem)/1.15 var(--ak-sans)!important;letter-spacing:-.03em;color:var(--ak-on-surface)!important;text-transform:none}
body.route-whats-on .region .region-label::before{content:"Index schedule";display:block;margin-bottom:8px;font:500 11px/1.3 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
body.route-whats-on .agenda-tools{display:flex!important;flex-wrap:wrap;align-items:center;gap:10px 18px;margin:18px 0 8px!important;padding:0 0 18px!important;border:0!important;border-bottom:1px solid var(--ak-outline-variant)!important;border-radius:0!important;background:none!important}
body.route-whats-on .agenda-choices{display:flex!important;flex-wrap:wrap;gap:8px;flex-direction:row!important}
body.route-whats-on .agenda-choices button{min-height:34px;padding:7px 14px!important;border:1px solid var(--ak-outline-variant)!important;border-radius:999px!important;background:none!important;color:var(--ak-on-variant)!important;font:500 13px var(--ak-sans)!important;cursor:pointer}
body.route-whats-on .agenda-choices button[aria-pressed=true]{background:var(--ak-primary)!important;border-color:var(--ak-primary)!important;color:var(--ak-on-primary)!important}
body.route-whats-on .agenda-tools label{display:flex;align-items:center;gap:8px;margin-left:auto;font:500 10.5px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant)}
body.route-whats-on .agenda-tools input{min-height:36px;padding:6px 14px;border:1px solid var(--ak-outline-variant)!important;border-radius:999px!important;background:var(--ak-surface-low)!important;color:var(--ak-on-surface)!important;font:500 13px var(--ak-sans);text-transform:none;letter-spacing:0}
body.route-whats-on .agenda-tools output{font:500 11px 'DM Mono',monospace;color:var(--ak-on-variant)}
body.route-whats-on .agenda-tools small{flex-basis:100%;font-size:12px;color:var(--ak-on-variant)}
body.route-whats-on ol.agenda{display:grid!important;grid-template-columns:minmax(110px,180px) minmax(0,1fr);margin:0!important;padding:0!important;list-style:none}
body.route-whats-on ol.agenda>li{margin:0!important}
body.route-whats-on ol.agenda>.agenda-day{grid-column:1;padding:22px 0 0!important;border-top:1px solid var(--ak-outline-variant)!important}
body.route-whats-on .agenda-day h3{margin:0;font:600 1.3rem/1.1 var(--ak-sans)!important;letter-spacing:-.02em;color:var(--ak-on-surface)!important}
body.route-whats-on ol.agenda>.agenda-item{grid-column:2;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;padding:22px 0!important;border-top:1px solid var(--ak-outline-variant)!important}
body.route-whats-on .agenda-day+.agenda-item{grid-row:auto}
body.route-whats-on .agenda-item a{flex-basis:100%;text-decoration:none}
body.route-whats-on .agenda-item b{font:600 1.15rem/1.3 var(--ak-sans)!important;color:var(--ak-on-surface)!important}
body.route-whats-on .agenda-item a:hover b{color:var(--ak-primary)!important}
body.route-whats-on .agenda-item .starts{padding:2px 9px;border-radius:999px;background:color-mix(in srgb,var(--ak-primary) 16%,transparent);font:500 10.5px 'DM Mono',monospace!important;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-primary)!important}
body.route-whats-on .agenda-item :is(.at,.by){font:400 12.5px 'DM Mono',monospace!important;color:var(--ak-on-variant)!important}
@media(max-width:640px){body.route-whats-on ol.agenda{grid-template-columns:minmax(0,1fr)}body.route-whats-on .agenda-day,body.route-whats-on .agenda-item{grid-column:1}body.route-whats-on .agenda-item{border-top:0!important;padding-top:8px!important}body.route-whats-on .agenda-tools label{margin-left:0}}
body.route-whats-on .ak-experience{display:block!important;max-width:none!important}
body.route-whats-on .region .region-label{background:none!important;padding:0!important}
body.route-whats-on .agenda-day h3{border:0!important;padding:0!important}
/* Following an occurrence / requesting a community (participant_journey.h). */
.route-participation .pj-page{padding:24px 0 0}.route-participation .pj-page a{color:var(--ak-on-surface)}
.pj-breadcrumb{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px;font:500 12px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant)}
.pj-kicker{font:500 11px 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
.route-participation .pj-page h1{margin:10px 0 24px;max-width:24ch;font:600 clamp(2.2rem,4.6vw,3.6rem)/1.05 var(--ak-sans);letter-spacing:-.035em;overflow-wrap:anywhere}
.pj-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:32px}
.pj-source{white-space:pre-wrap;overflow-wrap:anywhere;font:400 1.1rem/1.75 var(--ak-serif);color:var(--ak-on-variant)}
.pj-source-link{display:inline-flex;align-items:center;min-height:40px;margin:14px 0;color:var(--ak-primary)!important}
.pj-notice{padding:14px 18px;border:1px solid var(--ak-outline-variant);border-radius:16px;background:var(--ak-surface-low);font-size:13.5px;color:var(--ak-on-variant)}
.pj-state{position:sticky;top:120px;align-self:start;padding:24px;border:1px solid var(--ak-outline-variant);border-radius:22px;background:var(--ak-surface-mid)}
.pj-state h2{margin:0 0 10px;font:600 1.35rem/1.2 var(--ak-sans)}.pj-state p{font-size:14px;color:var(--ak-on-variant)}.pj-state time{display:block;font:12px 'DM Mono',monospace}
.pj-state button,.pj-button{display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:42px;margin-top:8px;padding:10px 18px;border:0;border-radius:999px;background:var(--ak-primary);color:var(--ak-on-primary)!important;font:600 13px var(--ak-sans);text-decoration:none;cursor:pointer}
@media(max-width:850px){.pj-layout{grid-template-columns:minmax(0,1fr)}.pj-state{position:static}}
body.ak-app .ak-zen .ak-zen-next h2{margin:0 0 1rem;font:600 .72rem/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant,#c5c9af)}
body.ak-app .ak-zen-body .authored-site a{color:var(--ak-primary,#d0fc4f)}
/* WebSub console (/sources/push): carriers on the left, the add-a-feed panel
   and handshake console on the right. */
.route-push .spo-layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,1fr);gap:20px;align-items:start}
.route-push .spo-side{display:grid;gap:16px;position:sticky;top:110px}
.route-push .spo-side code{font:400 12.5px 'DM Mono',monospace;color:var(--ak-primary)}
.route-push .spo-filters{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin:0 0 18px}
.route-push .spo-filters label{display:grid;gap:6px;flex:1 1 200px;font:500 11px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant)}
.route-push .spo-filters :is(input,select){padding:10px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:400 14px var(--ak-sans);letter-spacing:0;text-transform:none}
.route-push .spo-filters button{min-height:40px;padding:9px 18px;border:0;border-radius:999px;background:var(--ak-primary);color:var(--ak-on-primary);font:600 14px var(--ak-sans);cursor:pointer}
.route-push .spo-rail{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
.route-push .spo-rail a{padding:7px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:500 13px var(--ak-sans);text-decoration:none;color:var(--ak-on-variant)}
.route-push .spo-rail a:hover{border-color:var(--ak-primary);color:var(--ak-on-surface)}
.route-push section h2{margin:6px 0 14px;font:600 1.35rem/1.2 var(--ak-sans);color:var(--ak-on-surface)}
.route-push :is(.spo-list,.spo-ledger){display:grid;gap:12px;margin:0;padding:0;list-style:none}
.route-push :is(.spo-list>li,.spo-ledger>li){border:1px solid var(--ak-outline-variant);border-radius:20px;background:var(--ak-surface-low);overflow:hidden}
.route-push .spo-ledger>li{padding:16px 18px}
.route-push .spo-list summary{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:center;padding:16px 18px;cursor:pointer;color:var(--ak-on-surface)}
.route-push .spo-list summary small{font:400 11.5px 'DM Mono',monospace;color:var(--ak-on-variant)}
.route-push .spo-list summary>span{padding:3px 10px;border-radius:999px;background:var(--ak-surface-high);font:500 11px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.06em}
.route-push [data-state=active] summary>span{background:color-mix(in srgb,var(--ak-primary) 18%,transparent);color:var(--ak-primary)}
.route-push [data-state=expired] summary>span,.route-push [data-state=failed] summary>span{background:color-mix(in srgb,#ff8a6b 18%,transparent);color:#ffb3a1}
.route-push :is(.spo-list,.spo-ledger) dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:12px;margin:0;padding:0 18px 18px}
.route-push .spo-ledger dl{padding:12px 0 0}
.route-push :is(.spo-list,.spo-ledger) dt{font:500 10.5px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-on-variant)}
.route-push :is(.spo-list,.spo-ledger) dd{margin:4px 0 0;font:400 14px/1.4 var(--ak-sans);overflow-wrap:anywhere}
.route-push :is(#material-demands,#fact-handoffs){margin-top:34px}
.route-push .spo-paging{display:flex;gap:16px;margin-top:14px}.route-push .spo-paging a{color:var(--ak-primary)}
.route-push p{color:var(--ak-on-variant)}
@media(max-width:980px){.route-push .spo-layout{grid-template-columns:minmax(0,1fr)}.route-push .spo-side{position:static}}
/* Account work board (/work-board; Stitch: autonomous surety/escrow dashboard
   layout: status strip, counted phases, dense rows + inspector). Markup in
   application_continuation.h ac_work_board; rows from the activity source. */
.ak-wb .work-board-nav{border:0;padding:20px 0 0}
.ak-wb .work-board-nav .ak-icon{width:16px;height:16px}
.ak-wb .work-board-phases{margin-bottom:22px}
.ak-wb .work-board-picker,.ak-wb .account-work-board>form{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:0 0 12px}
.ak-wb .account-work-board select{min-height:40px;padding:8px 14px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-lowest);color:var(--ak-on-surface);font:400 14px var(--ak-sans)}
.ak-wb .account-work-board form button:not(.ak-btn){min-height:40px;padding:8px 16px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-high);color:var(--ak-primary);font:500 13px var(--ak-sans);cursor:pointer}
.ak-wb .account-work-board [data-board-status]{margin:16px 0 10px;font:500 12px/1.5 'DM Mono',monospace;color:var(--ak-on-variant)}
.ak-wb .account-work-board [data-board-collection]{margin-top:12px}
.ak-wb .work-focus{margin:20px 0 8px;padding:18px 22px;border:1px solid var(--ak-outline-variant);border-left:3px solid var(--ak-primary);border-radius:0 18px 18px 0;background:var(--ak-surface-low);max-width:none}
.ak-wb .work-focus h2{font:600 clamp(1.4rem,2.6vw,2rem)/1.15 var(--ak-sans);margin:4px 0 6px;color:var(--ak-on-surface)}.ak-wb .work-focus h3{font:600 .95rem var(--ak-sans);margin:18px 0 4px}
.ak-wb .work-focus-kicker{font:500 11px 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--ak-primary);margin:0}
.ak-wb .work-focus-dates{color:var(--ak-on-variant);margin:0;font-size:.88rem}.ak-wb .work-focus-details{white-space:pre-line;line-height:1.55;margin:0}.ak-wb .work-focus-error{margin:0;overflow-wrap:anywhere}
.ak-wb .work-note{margin:8px 0;padding:10px 13px;border:1px solid var(--ak-outline-variant);border-radius:12px}.ak-wb .work-note summary{cursor:pointer;font-weight:600}.ak-wb .work-note-body{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:10px}
.ak-wb .work-focus-runs{margin:0;padding-left:18px}.ak-wb .work-focus-runs li{margin:8px 0}.ak-wb .work-focus-runs p{margin:2px 0;color:var(--ak-on-variant);white-space:pre-line}
.ak-wb .work-focus-steps{margin:0;padding-left:18px;columns:2 260px;font-size:.9rem}
.ak-wb .work-prefill{display:block;margin:12px 0;font-size:.9rem}.ak-wb .work-prefill input{font:inherit;padding:7px 12px;border:1px solid var(--ak-outline-variant);border-radius:999px;background:var(--ak-surface-lowest);color:inherit;min-width:min(320px,100%)}
.ak-wb .work-focus-acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.ak-wb .work-focus-acts form{margin:0}
.ak-wb .work-focus-acts button{font:500 14px var(--ak-sans);border:1px solid var(--ak-outline-variant);background:var(--ak-surface-high);color:var(--ak-on-surface);border-radius:999px;padding:8px 16px;cursor:pointer}
.ak-wb .work-focus-acts form:first-child button{background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary)}
.ak-wb .account-work-board>.work-board-group{margin-top:20px;padding:14px 20px;border:1px solid var(--ak-outline-variant);border-radius:18px;background:var(--ak-surface-low)}
.ak-wb .account-work-board>.work-board-group>summary{cursor:pointer;font-weight:600;min-height:44px;display:flex;align-items:center}
.ak-wb .work-board-group .work-board-group{margin-top:22px}
.ak-wb .work-board-group h2{display:flex;align-items:center;gap:8px;font:600 1.1rem var(--ak-sans);margin:0 0 4px;padding-bottom:6px;border-bottom:1px solid var(--ak-outline-variant);color:var(--ak-on-surface)}
.ak-wb .work-board-group h2 .ak-icon{width:18px;height:18px}.ak-wb .work-board-group h2 small{font-weight:400;color:var(--ak-on-variant)}
.ak-wb .work-board-list,.ak-wb .work-board-family,.ak-wb .work-board-family-list,.ak-wb .work-board-stream-list{list-style:none;margin:0;padding:0}
.ak-wb .work-board-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 18px;padding:11px 0;border-bottom:1px solid var(--ak-outline-variant)}
.ak-wb .work-board-row[data-focus=true]{background:var(--ak-surface-high);padding-inline:10px;border-radius:10px}
.ak-wb .work-board-row a{font-weight:600;text-decoration:none;overflow-wrap:anywhere}.ak-wb .work-board-row a:hover{color:var(--ak-primary)}
.ak-wb .work-board-row p{margin:0;font-size:.85rem;color:var(--ak-on-variant);grid-column:1}
.ak-wb .work-board-row time{font:500 12px 'DM Mono',monospace;color:var(--ak-on-variant);white-space:nowrap;grid-column:2;grid-row:1}
.ak-wb .work-board-empty{color:var(--ak-on-variant);font-size:.9rem;padding:10px 0}.ak-wb .work-board-note{margin:2px 0 6px;font-size:.88rem;color:var(--ak-on-variant)}
.ak-wb .work-board-note a{color:var(--ak-primary)}.ak-wb .work-board-more{margin-top:18px}.ak-wb .work-board-more[hidden]{display:none}
.ak-wb .work-inspect-mark{display:inline-grid;place-items:center;width:40px;height:40px;margin-bottom:8px;border-radius:12px;background:var(--ak-surface-high)}.ak-wb .work-inspect-mark .ak-icon{width:20px;height:20px}
.ak-wb .work-board-family{margin:9px 0 15px}
.ak-wb .work-board-family-head{display:flex;gap:8px;align-items:center;font-size:.86rem;font-weight:600;padding:8px 0 6px;border-bottom:1px solid var(--ak-outline-variant)}
.ak-wb .work-board-family-head .ak-icon{width:17px;height:17px}.ak-wb .work-board-family-head small{font-weight:400;color:var(--ak-on-variant)}
.ak-wb .work-board-stream{margin:5px 0 6px}.ak-wb .work-board-stream details{border:1px solid var(--ak-outline-variant);border-radius:10px;padding:0 10px}
.ak-wb .work-board-stream summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:40px;font-size:.84rem;font-weight:600}
.ak-wb .work-board-stream summary small{font-size:.75rem;font-weight:400;color:var(--ak-on-variant);white-space:nowrap}.ak-wb .work-board-stream-list{padding:0 5px 8px 16px}
.ak-wb .account-work-board[data-density=compact] .work-board-row{padding-block:4px;gap:1px 10px}.ak-wb .account-work-board[data-density=compact] .work-board-row p{font-size:.78rem}
.ak-wb .account-work-board[data-density=compact] .work-board-stream summary{min-height:30px}
@media(max-width:620px){.ak-wb .work-board-row{grid-template-columns:1fr}.ak-wb .work-board-row time{grid-column:1;grid-row:auto}}
/* The shared interaction collection (rows + inspector) in the dark shell. */
.ak-wb .ac-collection{--ac-line:var(--ak-outline-variant);--ac-ink:var(--ak-on-surface);--ac-paper:var(--ak-surface-low);--ac-soft:var(--ak-surface-high);--ac-accent:var(--ak-primary);border-radius:20px;font-family:var(--ak-sans)}
.ak-wb .ac-collection :is(input,select,textarea){background:var(--ak-surface-lowest);color:var(--ak-on-surface);border-color:var(--ak-outline-variant)}
.ak-wb .ac-collection button:not(.ac-title){background:var(--ak-surface-high);color:var(--ak-on-surface);border-color:var(--ak-outline-variant)}
.ak-wb .ac-collection [aria-pressed=true],.ak-wb .ac-collection [aria-current]{background:var(--ak-primary)!important;color:var(--ak-on-primary)!important;border-color:var(--ak-primary)!important}
.ak-wb .ac-text-search,.ak-wb .ac-review-status{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant);color:var(--ak-on-surface)}
.ak-wb .ac-reading-text{background:var(--ak-surface-lowest);color:var(--ak-on-surface);border-color:var(--ak-outline-variant)}
.ak-wb .ac-inspector blockquote{border-left-color:var(--ak-primary)}
.ak-wb .ac-review-status:is([data-state=pending],[data-state=conflict]){background:var(--ak-surface-high)}
.ak-wb .ak-split-handle::after{background:var(--ak-outline-variant)}.ak-wb .ak-split-handle:hover::after{background:var(--ak-primary)}
/* Installed tools (/apps): the per-card subtools and collections. */
.ak-pack .pack-subtools{border:1px solid var(--ak-outline-variant);border-radius:14px;padding:0 12px;background:var(--ak-surface-lowest)}
.ak-pack .pack-subtools summary{min-height:40px;display:flex;align-items:center;cursor:pointer;font:500 13px var(--ak-sans);color:var(--ak-on-surface)}
.ak-pack .pack-subtool-list{display:grid;gap:4px;padding:0 0 10px}.ak-pack .pack-subtool-list a{display:flex;justify-content:space-between;padding:7px 10px;border-radius:10px;background:var(--ak-surface-high);color:var(--ak-on-surface)!important;text-decoration:none;font-size:13px}
.ak-pack-open{display:grid;gap:8px;font-size:13.5px;color:var(--ak-on-variant)}.ak-pack-open details summary{cursor:pointer}.ak-pack-open code{font:12px 'DM Mono',monospace}
.ak-pack>footer .ak-actions{gap:8px}
.ak-packs-sec>header .ak-tag{align-self:center}
/* The studio's design chooser (ph_theme_edit through ui:card/ui:choice). */
.ak-wb .studio-design .ak-pattern{margin:0;padding:0;border:0;background:none;color:inherit}
.ak-wb .studio-design .ak-card>h2{font:600 1.2rem/1.2 var(--ak-sans);color:var(--ak-on-surface)}
.ak-wb .studio-design .ak-card>p{margin:6px 0 14px;color:var(--ak-on-variant)}
.ak-wb .studio-design .ak-action{display:grid;gap:14px}
.ak-wb .studio-design .ak-choice{display:flex;flex-wrap:wrap;gap:8px;padding-bottom:12px;border-bottom:1px solid var(--ak-outline-variant)}
.ak-wb .studio-design .ak-choice::before{content:attr(aria-label);flex-basis:100%;font:500 10.5px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-primary)}
.ak-wb .ak-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid var(--ak-outline-variant);border-radius:999px;font:500 13px var(--ak-sans);color:var(--ak-on-variant);cursor:pointer}
.ak-wb .ak-pill input{accent-color:var(--ak-primary);margin:0}
.ak-wb .ak-pill:has(input:checked){border-color:var(--ak-primary);color:var(--ak-on-surface);background:color-mix(in srgb,var(--ak-primary) 12%,transparent)}
.ak-wb .studio-design .ak-action>button{justify-self:start}
.ak-pack>footer .ak-actions{flex-wrap:nowrap}.ak-pack>footer small{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
/* /capability: the tool-definition studio layout (x402_capability_and_aperture_forms.h). */
.route-capability .ak-wb-hero .ak-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end}
.route-capability .ak-kicker span{margin:0 6px;color:var(--ak-on-variant)}
.route-capability .cap-note{flex-basis:100%;margin:0;font-size:13px;color:var(--ak-on-variant);text-align:right}
.route-capability .cap-studio{align-items:start;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}
.route-capability .cap-side{display:grid;gap:16px;min-width:0}
.cap-defs{display:grid;gap:12px;margin:0;padding:0;list-style:none}
.cap-defs>li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 18px;padding:16px 18px;border:1px solid var(--ak-outline-variant);border-radius:16px;background:var(--ak-surface-mid)}
.cap-defs .cap-id{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.cap-defs h3 code{font:500 15px/1.3 'DM Mono',monospace;color:var(--ak-primary);overflow-wrap:anywhere}
.cap-defs p{grid-column:1;margin:0;font-size:14px;line-height:1.5}
.cap-defs .cap-price{grid-column:2;grid-row:1/span 2;align-self:start;text-align:right;font:500 20px/1.1 'DM Mono',monospace;color:var(--ak-on-surface);white-space:nowrap}
.cap-defs .cap-price small{display:block;margin-top:4px;font-size:11px;color:var(--ak-on-variant)}
.cap-defs .cap-price.is-unpriced{font-size:15px;color:var(--ak-on-variant)}
.cap-defs .cap-ways{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.cap-defs .cap-ways .ak-chip{padding:5px 11px;font-size:12px}
.cap-json{max-height:34rem;margin:0;overflow:auto;white-space:pre;font-size:12.5px;line-height:1.6}
.route-capability .ak-panel .cap-note{margin-top:12px;text-align:left}
.route-capability .ak-panel code{font:400 12.5px 'DM Mono',monospace;color:var(--ak-primary)}
@media(max-width:980px){.route-capability .cap-studio{grid-template-columns:minmax(0,1fr)}.route-capability .ak-wb-hero .ak-actions{justify-content:flex-start}.route-capability .cap-note{text-align:left}}
@media(max-width:560px){.cap-defs>li{grid-template-columns:minmax(0,1fr)}.cap-defs .cap-price{grid-column:1;grid-row:auto;text-align:left}}
/* Campaign link builder (campaign_workspace.h) on the one shell. */
.route-campaign .ak-kicker a{text-decoration:none}
.route-campaign .cwl-form>p{margin:0 0 18px;color:var(--ak-on-variant)}
.route-campaign .cwl-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.route-campaign .cwl-fields .is-wide{grid-column:1/-1}
.route-campaign .ak-field label span{text-transform:none;letter-spacing:0;color:var(--ak-on-variant)}
.route-campaign .ak-field input{display:block;width:100%;box-sizing:border-box}
.route-campaign .cwl-hint{margin:6px 0 0;font:400 13px/1.45 var(--ak-sans);letter-spacing:0;text-transform:none;color:var(--ak-on-variant)}
.route-campaign .cwl-form>.ak-btn{margin-top:22px}
.route-campaign .cwl-scope{margin-top:18px}
.route-campaign .cwl-notice{margin:0 0 18px;padding:14px 18px;border:1px solid #ffb4ab;border-radius:16px;background:color-mix(in srgb,#ffb4ab 10%,transparent)}
.route-campaign .cwl-notice p{margin:4px 0 0;color:var(--ak-on-variant)}
.route-campaign .cwl-result{margin:0 0 18px;border-color:var(--ak-primary)}
.route-campaign .cwl-result label{display:block;margin:10px 0 6px;font:500 11px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-on-variant)}
.route-campaign .cwl-result textarea{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-lowest);color:var(--ak-primary);font:400 14px/1.5 'DM Mono',monospace;overflow-wrap:anywhere}
@media(max-width:640px){.route-campaign .cwl-fields{grid-template-columns:minmax(0,1fr)}.route-campaign .cwl-form>.ak-btn{width:100%;justify-content:center}}
/* Published productions (production_publication.h) on the one shell; the
   gallery used to carry its own paper-coloured <style>. */
.production-gallery{padding:clamp(28px,5vw,64px) 0 0;color:var(--ak-on-surface)}
.production-gallery :is(h1,h2){max-width:18ch;margin:12px 0 18px;font:600 clamp(2.2rem,5vw,4.2rem)/1.04 var(--ak-sans);letter-spacing:-.035em;text-wrap:balance}
.production-gallery>p:not(.ak-kicker):not(.production-kicker){max-width:62ch;font:400 clamp(1.02rem,1.5vw,1.25rem)/1.55 var(--ak-serif);color:var(--ak-on-variant)}
.production-gallery .ak-kicker a{text-decoration:none}
.production-kicker{font:500 11px/1.3 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ak-primary)}
.production-editions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:28px 0}
.production-edition{min-width:0;border:1px solid var(--ak-outline-variant);border-radius:22px;overflow:hidden;background:var(--ak-surface-low);transition:border-color .2s ease}
.production-edition:hover,.production-edition:focus-within{border-color:var(--ak-primary)}
.production-edition>header{padding:24px;background:var(--ak-surface-mid);border-bottom:1px solid var(--ak-outline-variant)}
.production-edition h3{margin:10px 0;font:600 clamp(1.5rem,2.4vw,2rem)/1.12 var(--ak-sans);letter-spacing:-.025em;color:var(--ak-on-surface)}
.production-edition .production-kicker:last-child{color:var(--ak-on-variant)}
.production-copy{padding:22px 24px 24px}
.production-copy>p{margin:0 0 12px;line-height:1.6;color:var(--ak-on-variant)}
.production-outline-preview{display:grid;gap:8px;margin:16px 0;padding:0;list-style:none}
.production-outline-preview li{display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;align-items:start;padding:12px 14px;border:1px solid var(--ak-outline-variant);border-radius:14px;background:var(--ak-surface-mid)}
.production-outline-preview b{font:500 15px/1.4 'DM Mono',monospace;color:var(--ak-primary)}
.production-outline-preview small{display:block;margin-top:3px;font:400 11.5px 'DM Mono',monospace;color:var(--ak-on-variant)}
.production-handoff{padding-left:12px;border-left:2px solid var(--ak-primary);font-size:13px}
.production-scope{font-size:12.5px}
.production-gallery a:not(.ak-btn):is([data-production-inspect],[data-production-reuse]),.production-gallery>a{display:inline-flex;align-items:center;min-height:40px;margin:8px 8px 0 0;padding:8px 16px;border:1px solid var(--ak-outline-variant);border-radius:999px;color:var(--ak-on-surface);font:500 14px/1.2 var(--ak-sans);text-decoration:none}
.production-gallery a:not(.ak-btn):is([data-production-reuse]){background:var(--ak-primary);border-color:var(--ak-primary);color:var(--ak-on-primary);font-weight:600}
.production-gallery a:focus-visible{outline:2px solid var(--ak-primary);outline-offset:3px}
@media(max-width:760px){.production-editions{grid-template-columns:minmax(0,1fr)}}
/* Notes, a community body, a recording and a resolved address on the one
   shell (world_cache_and_cms_route.h, surface_fragments_and_ops.h). */
.route-notes .ak-kicker a{text-decoration:none}
.notes-list>li>a{display:grid;gap:4px;padding:14px 0;text-decoration:none}
.notes-list>li>a:hover strong{color:var(--ak-primary)}
.notes-text{max-width:68ch;font:400 1.15rem/1.75 var(--ak-serif);color:var(--ak-on-surface)}
.notes-text p{margin:0 0 1.1em}
.route-listen-program .ak-kicker span,.route-community-body .ak-kicker span,.route-address .ak-kicker span{margin:0 6px;color:var(--ak-on-variant)}
.cb-posts>li{display:grid;gap:6px;grid-template-columns:minmax(0,1fr)}
.cb-posts>li p{margin:0;color:var(--ak-on-variant)}
.address-facts{max-width:52rem}
.address-facts a{color:var(--ak-primary);text-decoration:none;overflow-wrap:anywhere}
.ak-live.is-off::before{background:var(--ak-outline)}
/* Account continuity (account_continuity_web.h): the one-use move code. */
.ak-pair-code{margin:10px 0 14px;font:600 clamp(2.6rem,7vw,4.2rem)/1 'DM Mono',ui-monospace,monospace;letter-spacing:.06em;color:var(--ak-primary);font-variant-numeric:tabular-nums}
.ak-pair-code span{margin:0 .2em;color:var(--ak-outline)}
.ak-pair-code.is-idle{color:var(--ak-outline)}
.ak-pair>p:not(.ak-kicker,.ak-pair-code){margin-bottom:14px;color:var(--ak-on-variant)}
.ak-wb .ak-rows>li>form{grid-row:1/span 2;grid-column:2}
/* Work orders, release sign-offs, disputes and vouches (work_orders.h):
   the work-order composer, escrow ledger, hearing room and vouching desk
   Stitch screens on the one shell. */
.work-orders .wo-ledger{display:grid;gap:12px}
.work-orders .wo-row{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,1fr) auto;gap:14px 24px;align-items:center;padding:18px 22px;border:1px solid var(--ak-outline-variant);border-radius:18px;background:var(--ak-surface-low)}
.work-orders .wo-row h3{margin:6px 0 4px;font:600 1.15rem/1.25 var(--ak-sans);color:var(--ak-on-surface)}
.work-orders .wo-row h3 a{text-decoration:none}.work-orders .wo-row h3 a:hover{color:var(--ak-primary)}
.work-orders .wo-row small{display:block;font-size:12.5px;color:var(--ak-on-variant)}
.work-orders .wo-row p{margin-top:4px;color:var(--ak-on-surface)}
.wo-sig{display:inline-flex;gap:4px;vertical-align:middle;margin-right:10px}
.wo-sig i{display:block;width:clamp(18px,3vw,34px);height:6px;border-radius:9px;background:var(--ak-surface-highest)}
.wo-sig i.is-on{background:var(--ak-primary)}
.wo-count{font:500 12px/1.4 'DM Mono',monospace;letter-spacing:.04em;color:var(--ak-primary)}
.work-orders .wo-split{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,1fr);gap:24px;align-items:start;margin-top:8px}
.work-orders .wo-stages,.work-orders .wo-side{display:grid;gap:16px;align-content:start;min-width:0}
.work-orders .wo-head{display:flex;justify-content:space-between;align-items:center;gap:12px}
.work-orders .wo-stage>header{display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:8px}
.work-orders .wo-stage h3{font:600 1.2rem/1.3 var(--ak-sans)}
.work-orders .wo-stage>p{margin-top:8px}
.work-orders .wo-amt{font:600 1.35rem/1.1 var(--ak-sans);color:var(--ak-primary);text-align:right;white-space:nowrap}
.work-orders .wo-amt small{display:block;font:500 10.5px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-on-variant)}
.work-orders .wo-due{font:500 12px 'DM Mono',monospace;color:var(--ak-on-variant)}
.work-orders .wo-release{margin-top:16px;padding-top:14px;border-top:1px solid var(--ak-outline-variant)}
.work-orders .wo-quorum{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.work-orders :is(.wo-signers,.wo-parties){display:grid;gap:6px;margin:0 0 12px;padding:0;list-style:none}
.work-orders :is(.wo-signers,.wo-parties)>li{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px 14px;padding:10px 14px;border-radius:12px;background:var(--ak-surface-mid)}
.work-orders :is(.wo-signers,.wo-parties) strong{display:block;font:500 14px/1.3 var(--ak-sans);color:var(--ak-on-surface)}
.work-orders :is(.wo-signers,.wo-parties) small{display:block;font:400 12px/1.4 'DM Mono',monospace;color:var(--ak-on-variant)}
.work-orders .wo-signers>li>span:last-of-type{font:500 12px 'DM Mono',monospace;text-align:right}
.work-orders .wo-signers .is-on,.work-orders .wo-parties em.is-on{color:var(--ak-primary)}
.work-orders .wo-signers .is-held{color:#ffb4ab}.work-orders .wo-signers .is-wait{color:var(--ak-on-variant)}
.work-orders .wo-signers q{flex-basis:100%;font:italic 400 14px/1.5 var(--ak-serif);color:var(--ak-on-variant)}
.work-orders .wo-parties>li>span:last-child{text-align:right}
.work-orders .wo-parties b{display:block;font:600 14px var(--ak-sans);color:var(--ak-on-surface)}
.work-orders .wo-parties em{font:500 11px 'DM Mono',monospace;font-style:normal;letter-spacing:.06em;text-transform:uppercase;color:var(--ak-on-variant)}
.work-orders .wo-sum{margin:8px 0 14px;font:600 clamp(2.2rem,4vw,3.4rem)/1 var(--ak-sans);letter-spacing:-.03em;color:var(--ak-on-surface);font-variant-numeric:tabular-nums}
.work-orders .wo-sum small{font-size:.4em;color:var(--ak-on-variant)}
.work-orders .wo-note{margin-top:14px;font-size:12.5px;line-height:1.5;color:var(--ak-on-variant)}
.work-orders .wo-terms{margin:6px 0 14px;font:400 15px/1.6 var(--ak-serif);white-space:pre-wrap;color:var(--ak-on-surface)}
.work-orders .wo-side h3{margin-top:14px}
.work-orders .wo-raise{margin-top:12px}.work-orders .wo-raise>summary{list-style:none;width:max-content}.work-orders .wo-raise>summary::-webkit-details-marker{display:none}
.work-orders .wo-raise[open]>summary{margin-bottom:14px}
.work-orders .wo-accept,.work-orders .wo-release .ak-action{margin-top:8px}
.work-orders .ak-action{display:grid;gap:12px}
.work-orders .ak-action>button{justify-self:start}
.work-orders .ak-choice input{accent-color:var(--ak-primary)}
.work-orders .wo-docket{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,420px);gap:24px;align-items:start;margin:28px 0 24px}
.work-orders .wo-docket h1{margin:10px 0 8px;font:600 clamp(1.8rem,3.6vw,2.8rem)/1.1 var(--ak-sans);letter-spacing:-.03em;color:var(--ak-on-surface)}
.work-orders .wo-docket .ak-live{color:var(--ak-on-surface)}
.work-orders .wo-statements{display:grid;gap:14px;margin:0 0 18px;padding:0;list-style:none}
.work-orders .wo-statements>li{padding:4px 0 4px 16px;border-left:2px solid var(--ak-outline-variant)}
.work-orders .wo-statements>li.is-claim{border-left-color:var(--ak-primary)}
.work-orders .wo-statements blockquote,.work-orders .wo-ruling{margin:6px 0 0;font:400 16px/1.6 var(--ak-serif);white-space:pre-wrap;color:var(--ak-on-surface)}
.work-orders .wo-ruling{font-size:clamp(1.05rem,1.8vw,1.3rem);font-style:italic}
.work-orders .wo-decision .ak-panel{border-color:var(--ak-primary)}
.work-orders .wo-add{margin-top:4px}
@media(max-width:980px){.work-orders .wo-split,.work-orders .wo-docket{grid-template-columns:minmax(0,1fr)}.work-orders .wo-row{grid-template-columns:minmax(0,1fr) auto}.work-orders .wo-row>div:nth-child(2),.work-orders .wo-row>div:nth-child(3){grid-column:1/-1}}

/* The activity chip sits fixed at the top right under the bar; the headers it
 * would cover leave it room instead of hiding their own controls. */
body:has(.ak-work-rail) :is(.ak-zen-bar,.fd-strip){padding-right:min(12.5rem,34vw)}
