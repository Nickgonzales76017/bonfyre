/*! Generated from deploy/tailwind/styles/aurekai-site-program.pcss; do not edit this output. */
/* Server-lowered SiteProgram composition.
 *
 * The page gets its subjects, applications, ordering and profile from native
 * CMS records.  This stylesheet owns only the shared document geometry: no
 * source, route, protocol, browser fetch or application decision lives here.
 */
:root{color-scheme:dark;--bf-ground:#090a0e;--bf-ink:#f4f0e9;--bf-display-ink:#f4f0e9;--bf-muted:#a49e95;--bf-rule:rgba(244,240,233,.16);--bf-panel:#12141b;--bf-accent:#e36f45;--bf-measure:74rem;--bf-gap:4rem;--bf-radius:0;--bf-section-space:4rem;--bf-display:ui-serif,Georgia,serif;--bf-text:ui-sans-serif,system-ui,sans-serif}
*{box-sizing:border-box}.site-program-body{background:var(--bf-ground);color:var(--bf-ink);font:400 16px/1.55 var(--bf-text);margin:0}.site-composition{display:grid;gap:var(--bf-gap);margin:0 auto;max-width:var(--bf-measure);padding:clamp(1.25rem,4vw,4rem) clamp(1rem,3vw,2rem) calc(var(--bf-section-space) * 1.5)}.site-program-masthead{border-bottom:1px solid var(--bf-rule);display:grid;gap:.5rem;grid-template-columns:1fr auto;padding-bottom:1.25rem}.site-program-masthead p{color:var(--bf-accent);font-size:.68rem;font-weight:800;letter-spacing:.16em;margin:0;text-transform:uppercase}.site-program-masthead h1{color:var(--bf-display-ink);font:400 clamp(2.7rem,8vw,7rem)/.88 var(--bf-display);grid-column:1;margin:0;max-width:12ch}.site-program-profile{align-self:end;color:var(--bf-muted);font:600 .68rem/1.2 ui-monospace,SFMono-Regular,monospace;letter-spacing:.08em;max-width:13ch;text-align:right;word-break:break-word}
.site-program-nav{display:flex;flex-wrap:wrap;gap:.35rem .9rem;margin-top:calc(var(--bf-gap) * -.5)}.site-program-nav a{color:var(--bf-muted);font:700 .69rem/1.2 var(--bf-text);letter-spacing:.1em;text-decoration:none;text-transform:uppercase}.site-program-nav a:hover{color:var(--bf-accent);text-decoration:underline;text-underline-offset:.3em}
.site-program-slot{min-width:0}.site-program-slot.slot-hero,.site-program-slot.slot-lead,.site-program-slot.slot-feature{border-bottom:1px solid var(--bf-rule);padding-bottom:clamp(2rem,4vw,4rem)}.site-program-slot.slot-sidebar,.site-program-slot.slot-ticker{border-block:1px solid var(--bf-rule);padding-block:1rem}.site-program-slot.slot-gallery{margin-inline:calc(clamp(1rem,3vw,2rem) * -1)}
.site-program-application{min-width:0}.site-program-empty{border-inline-start:2px solid var(--bf-accent);color:var(--bf-muted);margin:0;max-width:48ch;padding:.35rem 0 .35rem 1rem}.application-publication{display:grid;gap:1.2rem}.publication-lead-meta{align-items:baseline;display:flex;gap:.75rem;justify-content:space-between}.publication-lead-meta p{font-size:.78rem;font-weight:750;letter-spacing:.08em;margin:0;text-transform:uppercase}.publication-lead-meta time{color:var(--bf-muted);font-size:.78rem}.publication-lead-title{font:400 clamp(2rem,5vw,4.75rem)/.98 var(--bf-display);letter-spacing:-.035em;margin:0;max-width:18ch}.publication-lead-title a{color:inherit;text-decoration:none}.publication-lead-title a:hover{text-decoration:underline;text-decoration-color:var(--bf-accent);text-decoration-thickness:.08em;text-underline-offset:.11em}.publication-river{border-top:1px solid var(--bf-rule);display:grid;list-style:none;margin:1.25rem 0 0;padding:0}.publication-river li{border-bottom:1px solid var(--bf-rule)}.publication-river a{align-items:baseline;color:inherit;display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) minmax(10rem,16rem);padding:1rem 0;text-decoration:none}.publication-river a:hover span{color:var(--bf-accent)}.publication-river span{font:600 clamp(1rem,2vw,1.35rem)/1.15 var(--bf-text)}.publication-river small{color:var(--bf-muted);font-size:.78rem;text-align:right}
.community-site-body{display:grid;gap:1.5rem}.community-site-head{border-bottom:1px solid var(--bf-rule);display:grid;gap:.7rem;padding-bottom:1.2rem}.community-site-head h2,.application-listen h2,.application-watch h2{font:400 clamp(1.8rem,4vw,3.5rem)/.98 var(--bf-display);letter-spacing:-.025em;margin:0}.community-site-head p{color:var(--bf-muted);margin:0;max-width:62ch}.community-member-count{color:var(--bf-accent)!important;font:700 .72rem/1.2 ui-monospace,SFMono-Regular,monospace!important;letter-spacing:.08em;text-transform:uppercase}.community-site-thread{display:grid;gap:0}.community-site-post{border-bottom:1px solid var(--bf-rule);padding:1.3rem 0}.community-site-post header{color:var(--bf-muted);display:flex;font:600 .75rem/1.2 ui-monospace,SFMono-Regular,monospace;gap:.7rem;justify-content:space-between}.community-site-post h3{font:600 1.2rem/1.2 var(--bf-text);margin:1rem 0 .35rem}.community-site-post p{margin:0;max-width:68ch}
.application-board{display:grid;gap:1px;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));list-style:none;margin:0;padding:0;background:var(--bf-rule)}.application-board li{min-width:0}.application-board a,.application-board div{background:var(--bf-ground);color:inherit;display:grid;gap:.55rem;min-height:10rem;padding:1.15rem;text-decoration:none}.application-board a:hover{background:var(--bf-panel);color:var(--bf-accent)}.application-board small{color:var(--bf-accent);font:700 .68rem/1.2 ui-monospace,SFMono-Regular,monospace;letter-spacing:.09em;text-transform:uppercase}.application-board strong{font:400 clamp(1.15rem,2vw,1.7rem)/1.02 var(--bf-display)}.application-board span{color:var(--bf-muted);font-size:.83rem;line-height:1.35}
.application-listen,.application-watch{display:grid;gap:1rem}.application-listen header,.application-watch header{display:grid;gap:.45rem}.application-listen header>p,.application-watch header>p{color:var(--bf-accent);font:800 .68rem/1.2 var(--bf-text);letter-spacing:.15em;margin:0;text-transform:uppercase}.application-listen header p:last-child{color:var(--bf-muted);font-size:.9rem;letter-spacing:0;text-transform:none}.application-listen audio,.application-watch video{background:#000;display:block;max-width:100%;width:100%}.application-watch video{aspect-ratio:16/9}.application-boundary{border-top:1px solid var(--bf-rule);color:var(--bf-muted);font-size:.78rem;margin:0;padding-top:.85rem}.application-listen a,.application-watch a{color:var(--bf-accent)}
/* Profiles are CMS-selected art direction.  The native lowerer reads the
 * closed token set from the selected published PresentationTemplate and puts
 * only those values on --bf-* variables.  There are deliberately no
 * profile-name selectors here: adding or switching a studied profile cannot
 * require a stylesheet branch or change the semantic tree. */
@media(min-width:760px){.site-composition{grid-template-columns:minmax(0,1fr) minmax(13rem,19rem)}.site-program-masthead,.site-program-slot.slot-hero,.site-program-slot.slot-lead,.site-program-slot.slot-feature,.site-program-slot.slot-gallery,.site-program-slot.slot-body{grid-column:1/-1}.site-program-slot.slot-sidebar,.site-program-slot.slot-rail{grid-column:2}.site-program-slot.slot-secondary,.site-program-slot.slot-ticker{grid-column:1}.site-program-slot.slot-footer_feature{grid-column:1/-1}.site-program-slot.slot-hero .application-watch{margin-inline:calc((var(--bf-measure) - 100vw)/2);max-width:none}.site-program-slot.slot-hero .application-watch header,.site-program-slot.slot-hero .application-watch .application-boundary{margin-inline:auto;max-width:var(--bf-measure);padding-inline:clamp(1rem,3vw,2rem)}}
@media(max-width:620px){.site-program-masthead{grid-template-columns:1fr}.site-program-profile{align-self:start;grid-column:1;text-align:left}.publication-lead-meta,.publication-river a{align-items:start;grid-template-columns:1fr}.publication-river small{text-align:left}.site-composition{gap:2.75rem}.site-program-slot.slot-gallery{margin-inline:0}}

/* A person's or publisher's own address, in the estate's dress: one ground,
 * the same two faces, lines instead of panels.  A part with nothing in it
 * takes no room. */
:root{--bf-ground:#0d130f;--bf-ink:#dde6da;--bf-display-ink:#f5f7ee;--bf-muted:#8c9a8d;--bf-rule:rgba(221,230,218,.17);--bf-panel:#17211a;--bf-accent:#b5df32;--bf-display:'DM Sans',ui-sans-serif,system-ui,sans-serif;--bf-text:'DM Sans',ui-sans-serif,system-ui,sans-serif}
.site-program-body .site-composition{gap:0;max-width:none;padding:0 max(22px,calc(50vw - 620px)) clamp(4rem,8vw,7rem)}
.site-program-body .site-program-masthead{display:block;padding:clamp(3.5rem,9vw,8.5rem) 0 clamp(2.5rem,5vw,4.5rem);border-bottom:1px solid var(--bf-rule)}
.site-program-body .site-program-masthead p{margin:0 0 clamp(1.25rem,2.5vw,2rem);color:var(--bf-muted);font:500 .78rem/1 'DM Mono',ui-monospace,monospace;letter-spacing:.09em}
.site-program-body .site-program-masthead h1{max-width:none;font:600 clamp(2.6rem,9.5vw,9rem)/.88 var(--bf-display);letter-spacing:-.06em;overflow-wrap:anywhere}
.site-program-body .site-program-profile{display:none}
.site-program-body .site-program-slot:has(>.site-program-application>.site-program-empty:only-child){display:none}
.site-program-body .site-composition:not(:has(.site-program-slot:not(.slot-surfaces) .application-data))::after{content:"Nothing has been posted here yet.";display:block;padding-top:clamp(2rem,5vw,4rem);font:400 clamp(1.3rem,2vw,1.85rem)/1.25 'Instrument Serif',Georgia,serif;color:var(--bf-muted)}
.site-program-body .site-program-slot{margin:0;padding:clamp(3rem,7vw,6rem) 0 0;border:0;background:none}
.site-program-body .application-data>header h2{margin:0;font:600 clamp(2.2rem,5.5vw,4.75rem)/.92 var(--bf-display);letter-spacing:-.055em;color:var(--bf-display-ink)}
.site-program-body .application-data>header p{max-width:34rem;margin:1rem 0 0;font:400 clamp(1.05rem,1.5vw,1.35rem)/1.3 'Instrument Serif',Georgia,serif;color:var(--bf-muted)}
.site-program-body .application-data>header small{display:block;margin-top:1rem;font:400 .76rem/1 'DM Mono',ui-monospace,monospace;letter-spacing:.06em;color:var(--bf-muted)}
.site-program-body ol.application-board{display:block;columns:auto;list-style:none;margin:clamp(1.5rem,3vw,2.5rem) 0 0;padding:0;counter-reset:bf-board;border-bottom:1px solid var(--bf-rule)}
.site-program-body ol.application-board>li{margin:0;padding:0;border:0;border-top:1px solid var(--bf-rule);background:none;break-inside:avoid;counter-increment:bf-board}
.site-program-body ol.application-board>li>:is(a,div){display:grid;grid-template-columns:4.5rem minmax(0,1fr) auto;align-items:baseline;gap:1rem;padding:clamp(1rem,2vw,1.6rem) 0;color:var(--bf-ink);text-decoration:none;transition:padding .35s cubic-bezier(.2,.8,.2,1),background .35s,color .35s}
.site-program-body ol.application-board>li>:is(a,div)::before{content:counter(bf-board,decimal-leading-zero);font:500 .78rem/1 'DM Mono',ui-monospace,monospace;letter-spacing:.06em;color:var(--bf-muted)}
.site-program-body ol.application-board>li>a::after{content:"\2192";font-size:1.4rem}
.site-program-body ol.application-board small:empty{display:none}
.site-program-body ol.application-board strong{font:600 clamp(1.6rem,3.6vw,3.25rem)/1 var(--bf-display);letter-spacing:-.05em;color:var(--bf-display-ink)}
.site-program-body ol.application-board>li>a:hover{background:var(--bf-accent);color:#0d130f;padding-inline:clamp(.75rem,1.6vw,1.6rem)}
.site-program-body ol.application-board>li>a:hover :is(strong,small),.site-program-body ol.application-board>li>a:hover::before{color:#0d130f}
.site-program-body .site-program-slot,.site-program-body .site-program-application,.site-program-body .application-data{display:block;width:auto;max-width:none;grid-column:1/-1}
.site-program-body .application-data>header{margin:0;padding:0;border:0;background:none}
.site-program-body .site-composition>footer.region{display:block;margin:clamp(3rem,7vw,6rem) 0 0;padding:1.5rem 0 0;border-top:1px solid var(--bf-rule);grid-column:1/-1}
.site-program-body .site-composition>footer.region .src{max-width:38rem;margin:0;padding:0;font:400 .95rem/1.5 var(--bf-text);color:var(--bf-muted);opacity:1}
html .site-program-body .site-composition,html .site-program-body .site-composition[data-bf-profile]{display:block;width:auto;max-width:none;margin:0}
.site-program-body .site-program-application.application-board{display:block;background:none;gap:0}
.site-program-body ol.application-board>li>:is(a,div){min-height:0;background:none}
.site-program-body ol.application-board>li>a:hover{background:var(--bf-accent)}
.site-program-body ol.application-board{background:none;gap:0}
html .site-program-body .site-composition{display:flex;flex-direction:column}
.site-program-body .site-composition::after{order:1}
.site-program-body .site-composition>footer.region{order:2}
