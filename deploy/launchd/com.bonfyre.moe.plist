<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.bonfyre.moe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nickgonzales/.bonfyre/bin/bonfyre-moe</string>
		<string>serve</string>
		<string>--port</string>
		<string>7000</string>
		<string>--gpu-layers</string>
		<string>99</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/nickgonzales/.bonfyre/mcp/logs/moe.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/nickgonzales/.bonfyre/mcp/logs/moe.out.log</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
