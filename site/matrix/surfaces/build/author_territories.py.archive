"""ARCHIVED: territory-presentations.jsonl and local Bun import replace this SSH writer.

The four hosts were one page with three strings swapped, which is the same
failure the world layer exists to answer one level down: a thing with its own
question rendered as a row in somebody else's list. A territory's door differs
in what it leads with, not in how it phrases the same greeting -- .live opens
on what is happening because now outranks published there; .work opens on what
is refused and what is owed, because an obligation you cannot see is the only
thing a work surface can get badly wrong.

sections is the order and the omission together. A section absent from the list
is not rendered at all, which is how .life gets to have no machine band and
.work gets to not lead with video.
"""
import json, subprocess

KEY = "/Users/nickgonzales/.ssh/bonfyre_oracle"
HOST = "ubuntu@aurekai.live"
DB = "/var/lib/bonfyre/cms/bonfyre_cms.db"
CMS = "/usr/local/bin/bonfyre-cms"

ROWS = [
 dict(territory="live", character="marquee", template="ghost-dope",
      question="What deserves attention now?",
      eyebrow="aurekai.live · what is on",
      head="Tonight is <em>already happening.</em>",
      lede="Rooms, sets and occurrences, ranked by what is on now — because in this "
           "territory now outranks published, and nowhere else does.",
      sections="reels,wall,territories,locked,retention,machine,sitemap",
      lead_source_kinds="video,post,image",
      cannot_infer="what is on now is what the sources said was on; a room listed here "
                   "is not a room that will open, and an act named is not an act that "
                   "confirmed",
      status="published"),

 dict(territory="life", character="shelf", template="ghost-bokeh",
      question="What matters in my world?",
      eyebrow="aurekai.life · your own world",
      head="The things you <em>kept.</em>",
      lede="A personal world is not a feed. Nothing here is ranked by attention, because "
           "a kept set sorted by popularity is a recommendation engine wearing the "
           "clothes of a kept set.",
      sections="wall,reels,territories,locked,sitemap",
      lead_source_kinds="image,video",
      cannot_infer="a kept thing is not an endorsed thing, and this door shows what is "
                   "public until somebody signs in — the personal half is behind a "
                   "session and its absence here is not its absence",
      status="published"),

 dict(territory="shop", character="counter", template="ghost-source",
      question="What economic opportunity is useful?",
      eyebrow="aurekai.shop · what is offered",
      head="An offer is not a <em>promise.</em>",
      lede="Fifteen things happen between a product and owning it, and most stores "
           "collapse them. Here each one has an owner, and the estate says which it has "
           "actually reached.",
      sections="commerce,territories,reels,locked,machine,sitemap",
      lead_source_kinds="post,image",
      cannot_infer="a price shown is a price quoted; nothing here is an offer that has "
                   "been accepted, a payment that has cleared, or a promise that anything "
                   "is in stock",
      status="published"),

 dict(territory="work", character="desk", template="ghost-ease",
      question="What should move forward?",
      eyebrow="aurekai.work · what moves",
      head="What is <em>blocking</em> what.",
      lede="Obligations, requirements and capital paths, ordered by what stops something "
           "else — held per condition rather than as a verdict.",
      sections="locked,retention,machine,territories,reels,sitemap",
      lead_source_kinds="text,post",
      cannot_infer="an ordered queue is not an instruction; what is shown as blocking is "
                   "what this estate can see, and reachability stops at the human line "
                   "rather than committing anything",
      status="published"),
]


def sh(a):
    return subprocess.run(["ssh", "-i", KEY, HOST, " ".join(a)],
                          capture_output=True, text=True)


for r in ROWS:
    payload = json.dumps(r, ensure_ascii=False).replace('"', '\\"')
    out = sh([CMS, "entry", "create", "territory_presentation", "--db", DB,
              "--ns", "root", f'"{payload}"'])
    print(f"{r['territory']:6} {r['character']:8} {r['template']:16} "
          f"{((out.stdout or out.stderr).strip().splitlines() or [''])[-1]}")
