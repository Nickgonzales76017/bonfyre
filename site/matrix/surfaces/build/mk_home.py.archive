"""Compile the public territory aperture.

This is not an estate catalogue. A visitor can give the Matrix a real public
address immediately; the native intake owner prepares a bounded evidence route.
Other doors lead to existing owners and never impersonate them.
"""
from pathlib import Path

OUT = Path(__file__).resolve().parents[1] / "home.html"

HTML = r'''<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101713">
<!--BF_RESOLVED_IDENTITY-->
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Instrument+Serif:ital@0;1&display=swap">
<style>
:root{--paper:#f1efe7;--ink:#102019;--muted:#617067;--line:rgba(16,32,25,.18);--panel:#fbfaf5;--accent:#b5df32;--signal:#ef6547;--night:#111913;--night2:#1c2a20;--mono:'DM Mono',monospace;--sans:'DM Sans',sans-serif;--serif:'Instrument Serif',Georgia,serif}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);letter-spacing:-.02em}a{color:inherit;text-decoration:none}.wrap{width:min(1220px,calc(100% - 40px));margin:auto}.eyebrow{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:0;display:flex;gap:.5rem;align-items:center}.eyebrow i{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 24%,transparent)}
.rail{height:56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:18px}.word{font-family:var(--mono);font-size:.95rem;font-weight:500;letter-spacing:-.08em}.word b{color:var(--signal)}.rail nav{display:flex;align-items:center;gap:18px;font-family:var(--mono);font-size:.67rem;white-space:nowrap}.rail nav a:not(.join){color:var(--muted)}.join{background:var(--ink);color:var(--paper);padding:.48rem .8rem;border-radius:999px}.join:hover{background:var(--signal)}
.hero{padding:clamp(54px,10vw,132px) 0 38px;min-height:560px;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:min(62vw,750px);aspect-ratio:1;right:-14vw;top:-12vw;border:1px solid var(--line);border-radius:50%;box-shadow:0 0 0 66px transparent,0 0 0 67px var(--line),0 0 0 142px transparent,0 0 0 143px var(--line);opacity:.72;pointer-events:none}.hero-grid{display:grid;grid-template-columns:minmax(0,1.22fr) minmax(280px,.78fr);gap:40px;align-items:end;position:relative;z-index:1}.hero h1{font-size:clamp(3.5rem,9.8vw,8.4rem);font-weight:600;line-height:.79;letter-spacing:-.075em;margin:16px 0 25px;max-width:8.5ch}.hero h1 em{font-family:var(--serif);font-weight:400}.hero .sub{max-width:43ch;color:var(--muted);font-size:1.08rem;line-height:1.45;margin:0}.territory{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;color:var(--muted);padding-bottom:8px;border-bottom:1px solid var(--line);text-transform:uppercase}.territory b{color:var(--ink);font-weight:500}.orbit{display:grid;place-items:center;aspect-ratio:1;background:radial-gradient(circle at center,var(--accent) 0 12%,transparent 12.4%),repeating-radial-gradient(circle at center,transparent 0 43px,rgba(16,32,25,.17) 44px 45px);border-radius:50%;border:1px solid var(--line);max-width:330px;margin-left:auto}.orbit span{background:var(--night);color:#f4f0e6;border-radius:999px;padding:.75rem 1rem;font-family:var(--mono);font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;transform:translateY(94px)}
.aperture{background:var(--night);color:#edf1e8;padding:24px 0 28px}.aperture-grid{display:grid;grid-template-columns:.7fr 1.45fr .85fr;gap:18px;align-items:center}.aperture h2{font-size:clamp(1.65rem,3vw,2.8rem);line-height:.95;letter-spacing:-.055em;margin:8px 0 0}.aperture h2 em{font-family:var(--serif);font-weight:400}.aperture .eyebrow{color:#a7b3aa}.aperture .eyebrow i{background:var(--signal)}.url-form{display:flex;border:1px solid rgba(238,241,232,.28);padding:5px;background:#17241b;gap:5px}.url-form input{min-width:0;flex:1;border:0;background:transparent;color:#f4f5ed;font:500 .95rem var(--mono);padding:.75rem}.url-form input:focus{outline:2px solid var(--accent);outline-offset:-2px}.url-form button{border:0;background:var(--accent);color:#112017;font:500 .69rem var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:.65rem .95rem;cursor:pointer}.url-form button:hover{background:#e7f27c}.ap-note{font-size:.77rem;color:#a7b3aa;line-height:1.4;margin:7px 0 0}.intake-result{font-size:.8rem;margin-top:9px}.intake-result:empty{display:none}
.moves{padding:76px 0}.moves-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:21px}.moves h2{font-size:clamp(2.25rem,5.5vw,5rem);line-height:.87;letter-spacing:-.07em;margin:10px 0 0}.moves h2 em{font-family:var(--serif);font-weight:400}.moves-head p:last-child{max-width:30ch;color:var(--muted);line-height:1.45;margin:0}.move-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.move{min-height:310px;padding:23px;display:flex;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel);transition:background .2s,transform .2s}.move:hover{background:#fff;transform:translateY(-3px)}.move .number{font:500 .7rem var(--mono);color:var(--signal);letter-spacing:.1em}.move h3{font-size:clamp(1.7rem,3vw,2.55rem);letter-spacing:-.06em;line-height:.92;margin:62px 0 12px}.move p{color:var(--muted);line-height:1.45;font-size:.93rem;margin:0;max-width:29ch}.move .go{margin-top:auto;font:500 .7rem var(--mono);letter-spacing:.08em;text-transform:uppercase;padding-top:24px}.move .go b{color:var(--signal);font-size:1rem}
.signal{background:var(--night2);color:#eaf0e9;padding:44px 0}.signal-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(238,241,232,.17);border:1px solid rgba(238,241,232,.17)}.signal-card{background:var(--night2);padding:24px;min-height:210px}.signal-card h3{font-size:1.7rem;letter-spacing:-.05em;margin:14px 0 8px}.signal-card p{color:#adb8ae;line-height:1.45;max-width:43ch;margin:0}.weather{margin-top:23px;font-family:var(--mono);font-size:.72rem;line-height:1.55;color:#dfe7dd}.weather strong{font-weight:500;color:var(--accent)}.signal-card a{display:inline-block;margin-top:24px;font:500 .7rem var(--mono);letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid var(--accent);padding-bottom:3px}.rail nav{display:flex;flex-wrap:wrap;gap:2px 14px;align-items:center;flex:1;min-width:0}.rail nav a{font:500 .68rem var(--mono);color:var(--muted);white-space:nowrap}.rail nav a:hover{color:var(--ink)}.rail .word{display:inline-flex;align-items:center;gap:8px;flex:none;font:500 .8rem var(--mono);letter-spacing:.06em}.foot{padding:25px 0 38px;display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:.78rem}.foot a{font-family:var(--mono);font-size:.67rem;color:var(--ink)}
body.live{--paper:#100d13;--ink:#f3eaf0;--muted:#b69fac;--line:rgba(255,255,255,.17);--panel:#18111b;--accent:#ff694b;--signal:#d6ef4d;--night:#080609;--night2:#15101b}body.shop{--paper:#f7f9fc;--ink:#111a29;--muted:#59687a;--line:rgba(17,26,41,.16);--panel:#fff;--accent:#2e67d9;--signal:#ec9c36;--night:#111827;--night2:#1b2638}body.work{--paper:#f4f7f8;--ink:#121b24;--muted:#52616d;--line:rgba(18,27,36,.16);--panel:#fff;--accent:#2472c8;--signal:#dc694a;--night:#111a24;--night2:#1a2733}body.life{--paper:#faf7f0;--ink:#27231d;--muted:#756d62;--line:rgba(39,35,29,.16);--panel:#fffdf8;--accent:#758f55;--signal:#b15f44;--night:#242019;--night2:#302a20}body.life .hero h1{font-family:var(--serif);font-weight:400;letter-spacing:-.05em;line-height:.88}body.live .orbit,body.shop .orbit,body.work .orbit{background:radial-gradient(circle at center,var(--accent) 0 12%,transparent 12.4%),repeating-radial-gradient(circle at center,transparent 0 43px,rgba(255,255,255,.18) 44px 45px)}@media(max-width:760px){.wrap{width:min(100% - 28px,1220px)}.rail nav a:not(.join){display:none}.hero{min-height:auto;padding-top:62px}.hero-grid,.aperture-grid,.signal-grid{grid-template-columns:1fr}.orbit{display:none}.moves-head{display:block}.moves-head p:last-child{margin-top:16px}.move-grid{grid-template-columns:1fr}.move{min-height:230px}.move h3{margin-top:32px}.aperture{padding:28px 0}.url-form{display:block}.url-form button{margin-top:6px;width:100%}.hero:after{right:-55vw;top:-8vw}.foot{display:block}.foot a{display:block;margin-top:12px}}
</style></head><body><header class="wrap rail"><a class="word" href="/"><span id="bf-mk"></span>BONF&Yuml;RE</a><nav><!--BF_NAV--></nav><a class="join" href="/login" id="session-link">Sign in &rarr;</a></header><main><section class="wrap hero"><p class="eyebrow"><i></i><span id="eyebrow">Aurekai / public entry</span></p><div class="hero-grid"><div><h1 id="title">Start with <em>something real.</em></h1><p class="sub" id="sub">An address, an offer, an occurrence, a place, or a question. Let the thing lead; the right owner can meet it after.</p></div><div><p class="territory"><b id="territory">PUBLIC</b> · a distinct way into the same fabric</p><div class="orbit" aria-hidden="true"><span id="orbit-label">Awaiting a signal</span></div></div></div></section><section class="aperture"><div class="wrap aperture-grid"><div><p class="eyebrow"><i></i>01 / public address</p><h2>Bring in a thing that already <em>exists.</em></h2></div><div><form class="url-form" action="/_surface/intake" method="get" hx-get="/_surface/intake" hx-target="#intake-result" hx-swap="innerHTML"><input name="url" type="url" inputmode="url" autocomplete="url" placeholder="https://a real public address" required aria-label="Public address"><button type="submit">Prepare route →</button></form><div id="intake-result" class="intake-result" aria-live="polite"></div><p class="ap-note">This prepares a reviewed handoff. It does not fetch, publish, or claim the address.</p></div><div><p class="ap-note">A source remains outside until a native owner admits evidence. That boundary is the point.</p></div></div></section><section class="wrap moves"><div class="moves-head"><div><p class="eyebrow"><i></i>Choose the next move</p><h2>Not an app.<br><em>An opening.</em></h2></div><p>These are doors into owners that already exist. They do not make a promise before the evidence, authority, or effect boundary is reached.</p></div><div class="move-grid"><a class="move" href="/discover"><span class="number">02 / LOOK</span><h3 id="look-title">Follow a real signal.</h3><p id="look-copy">See public sources and maintained observations without turning a directory into a claim.</p><span class="go">Open discovery <b>→</b></span></a><a class="move" href="/market"><span class="number">03 / EXCHANGE</span><h3 id="exchange-title">Make an offer legible.</h3><p id="exchange-copy">Move toward a checkable exchange only where the responsible owner can quote and settle it.</p><span class="go">Open exchange <b>→</b></span></a><a class="move" href="/studio/"><span class="number">04 / CONTINUE</span><h3 id="work-title">Take it into a room.</h3><p id="work-copy">Use your authorized working context for decisions, evidence, drafts, and durable coordination.</p><span class="go">Open work <b>→</b></span></a></div></section><section class="signal"><div class="wrap signal-grid"><article class="signal-card"><p class="eyebrow"><i></i>Public weather / live carrier</p><h3>Let the outside change the page.</h3><p>Reading the public observation surface without retaining a source body here.</p><div class="weather" id="weather">Checking available public weather carriers…</div></article><article class="signal-card"><p class="eyebrow"><i></i>Address plane</p><h3>One thing can meet people in more than one place.</h3><p>Web, rooms, physical carriers, and machine routes are coordinates—not duplicate institutions.</p><a href="/.well-known/bonfyre">Inspect this address →</a></article></div></section></main><footer class="wrap foot"><span>Bonfÿre × Aurekai</span><a href="/.well-known/bonfyre">Machine-readable address →</a></footer><script defer src="/assets/matrix-htmx.js"></script><script defer src="/assets/bonfyre-kit.js"></script><script>(()=>{const host=location.hostname.toLowerCase(),key=host.includes('.life')?'life':host.includes('.live')?'live':host.includes('.shop')?'shop':'work',copy={life:['LIFE','Aurekai Life / keep what matters close','Keep what <em>matters.</em>','Begin with a person, place, need, or public thing—then decide what deserves a private, durable place.','A kept signal','Find what touches home.','Use a public observation only as a route to a decision, a memory, or a person who needs it.','Meet a nearby need.','A useful exchange begins with a real need, not an endless storefront.','Continue your own thread.','Your Life context stays yours until you deliberately carry it elsewhere.'],live:['LIVE','Aurekai Live / what is happening now','Make the moment <em>count.</em>','Bring a public occurrence, signal, or place into a route that can become evidence without pretending it is already yours.','A live signal','See what is moving.','Follow maintained public signals without mistaking attention for truth.','Gather around a real thing.','An offer, a venue, a route, or a need can become legible before it becomes commerce.','Carry the moment forward.','Move from occurrence to the room that can hold responsibility for it.'],shop:['SHOP','Aurekai Shop / a checkable exchange','Make the exchange <em>real.</em>','Start with an actual offer, need, place, or route. The market can only become real where its owner can quote, commit, and settle.','A checkable route','Compare what is present.','Discovery is evidence-aware: an advertised capability is not an admitted provider.','Open the exchange.','Use the market owner for offers and terms rather than turning this page into a catalog.','Take a decision to work.','Contracts, exceptions, and obligations belong in a responsible working room.'],work:['WORK','Aurekai Work / evidence before action','Take the next <em>responsible step.</em>','Start with the thing that needs a decision. Evidence, authority, and work meet only at the owner that can carry each boundary.','A pending decision','Inspect what is known.','Open the maintained record before creating another private copy of the world.','Make terms checkable.','A price, commitment, or settlement only exists when its native owner can issue it.','Enter the working room.','Continue through the signed-in operating context, not a presentation shell.']}[key];document.body.className=key;[['territory',0],['eyebrow',1],['title',2],['sub',3],['orbit-label',4],['look-title',5],['look-copy',6],['exchange-title',7],['exchange-copy',8],['work-title',9],['work-copy',10]].forEach(([id,i])=>{const n=document.getElementById(id);if(n){if(id==='title')n.innerHTML=copy[i];else n.textContent=copy[i]}});fetch('/account',{headers:{Accept:'application/json'},credentials:'same-origin'}).then(r=>r.ok?r.json():null).then(d=>{if(d&&d.valid){const a=document.getElementById('session-link');a.href='/account';a.textContent='Your account →'}}).catch(()=>{});fetch('/foreign/weather',{headers:{Accept:'application/json'},credentials:'same-origin'}).then(r=>r.ok?r.json():null).then(d=>{const e=document.getElementById('weather');if(!d||!Array.isArray(d.sources)){e.textContent='No public carrier is available from this address right now.';return}const active=d.sources.filter(s=>s.tier==='HOT'||s.tier==='WARM');e.innerHTML='<strong>'+active.length+'</strong> available carrier'+(active.length===1?'':'s')+' · public observation only'}).catch(()=>{document.getElementById('weather').textContent='The public carrier could not be read right now.'})})();</script></body></html>'''

HTML = HTML.replace(
    '<section class="signal">',
    '<nav class="wrap rail" aria-label="Public subject rooms">'
    '<a href="/s/whats-on/all">What is happening</a>'
    '<a href="/s/sets/all">Collections people can shape</a>'
    '<a href="/s/prices/observed">What the world costs</a>'
    '</nav><section class="signal">',
    1,
)
OUT.write_text(HTML, encoding="utf-8")
print(f"wrote {OUT} ({len(HTML)} bytes)")
