HTML = HTML.replace(
    '<div id="choices"></div><div class="actions"><button class="primary" id="download" disabled>Download plan</button><button class="ghost" id="clear">Clear</button></div>',
    '<div id="choices"></div><div class="actions"><button class="primary" id="download" disabled>Download plan</button><button class="ghost" id="clear">Clear</button></div>'
    '<section class="formation-draft"><div class="eyebrow">Compile a working root</div><h2>Start a source collection and World draft</h2><p class="hint">This writes a typed reagent selection and a World declaration to the native CMS. Both remain private drafts: no retained body is promoted, no page or route is published, and no authority, provider, payment, claim, or external effect is created.</p><input id="world-title" maxlength="240" placeholder="Name this publication or operating world"><textarea id="world-lede" maxlength="1800" placeholder="What should this World help people understand, decide, make, or operate?"></textarea><select id="world-character"><option value="editorial">Editorial publication</option><option value="catalog">Catalog and comparison</option><option value="spatial">Place and spatial context</option><option value="community">Community workspace</option></select><button class="primary" id="create-world" disabled>Create collection + World draft</button><div id="world-result" aria-live="polite"></div></section>',
)
HTML = HTML.replace(
    '.choice{display:flex;gap:9px;border-top:1px solid var(--line);padding:11px 0}',
    '.choice{display:flex;gap:9px;border-top:1px solid var(--line);padding:11px 0}.formation-draft{margin-top:25px;padding-top:16px;border-top:1px solid var(--line)}.formation-draft h2{font-size:17px;margin:5px 0}.formation-draft input,.formation-draft textarea,.formation-draft select{width:100%;margin:6px 0;background:#0d1520;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:9px;font:12px var(--sans)}.formation-draft textarea{min-height:86px;resize:vertical}',
)
HTML = HTML.replace(
    "async function observe(){",
    "function formationReady(){let b=$('create-world');if(b)b.disabled=!(picked&&$('world-title').value.trim()&&$('world-lede').value.trim())}async function cmsDraft(type,payload,headers){let r=await fetch('/cms/v1/api/'+type,{method:'POST',headers,credentials:'same-origin',body:new URLSearchParams(payload).toString()}),body=await r.json().catch(()=>({}));return {ok:r.ok&&body.outcome==='saved',body,status:r.status}}async function createWorldDraft(){let title=$('world-title').value.trim(),lede=$('world-lede').value.trim(),character=$('world-character').value,out=$('world-result');out.innerHTML='';if(!picked||!title||!lede)return;let token=K.token(),headers={'Content-Type':'application/x-www-form-urlencoded',Accept:'application/json'};if(token)headers.Authorization='Bearer '+token;let suffix=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,8),collectionId='foreign-collection-'+suffix,worldId='foreign-world-'+suffix,source=B(picked).source,selector=JSON.stringify({source_refs:[source]}),material=JSON.stringify(['PublicationOccurrence']);$('create-world').disabled=true;try{let collection=await cmsDraft('source_collection',{collection_id:collectionId,subject_address:picked.subject_id,source_selector:selector,material_kind:material,refresh_policy:'manual',status:'draft'},headers);if(!collection.ok){out.append(E('div','toast err',collection.status===401||collection.status===403?'Sign in with a CMS write closure to create a private collection.':(collection.body.detail||'The native CMS refused this source collection.')));return}let world=await cmsDraft('world',{world:worldId,title,character,lede,subject:picked.subject_id,sources:'source_collection:'+collectionId,grammars:'discover',cannot_infer:'This World is a human-authored draft over one selected foreign source collection. It does not admit source material, create a public route, assign contributors, establish an institution, licence material, or authorize an effect.',status:'draft'},headers);if(!world.ok){out.append(E('div','toast err','The collection draft was created, but the World draft was refused. The collection remains private and can be continued in CMS. '+(world.body.detail||'')));return}out.append(E('div','toast','Typed source collection and World drafts were created in the native CMS. They are private, unlaunched inputs to later material compilation and governance.'))}catch(e){out.append(E('div','toast err','The CMS could not be reached; no unconfirmed draft was assumed created.'))}finally{formationReady()}}async function observe(){",
)
HTML = HTML.replace(
    "$('observe').onclick=observe;$('url').onkeydown=e=>{if(e.key==='Enter')observe()};",
    "$('observe').onclick=observe;$('url').onkeydown=e=>{if(e.key==='Enter')observe()};$('create-world').onclick=createWorldDraft;$('world-title').oninput=formationReady;$('world-lede').oninput=formationReady;",
)
HTML = HTML.replace(
    "r.onclick=()=>{picked=t;list();detail();plan()};",
    "r.onclick=()=>{picked=t;list();detail();plan();formationReady()};",
)
HTML = HTML.replace(
    "$('download').disabled=!picked;let c=$('connection');",
    "$('download').disabled=!picked;formationReady();let c=$('connection');",
)
HTML = HTML.replace(
    'Start a source collection and World draft',
    'Publish a source collection and World',
)
HTML = HTML.replace(
    'This writes a typed reagent selection and a World declaration to the native CMS. Both remain private drafts: no retained body is promoted, no page or route is published, and no authority, provider, payment, claim, or external effect is created.',
