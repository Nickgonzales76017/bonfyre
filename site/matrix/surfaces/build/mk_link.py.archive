)
HTML = HTML.replace(
    "function cataloguePath(offset){let p='/foreign/twins'+(offset?'/page/'+offset:'');return p+(searchTerm?'?q='+encodeURIComponent(searchTerm):'')}async function loadMore(){if(loadingMore||nextOffset===null)return;loadingMore=true;list();let r=await K.get(cataloguePath(nextOffset));if(r.ok){let more=r.body.twins||[];let seen=new Set(twins.map(x=>x.url));twins.push(...more.filter(x=>!seen.has(x.url)));total=r.body.total||total;estateTotal=r.body.estate_total||estateTotal;nextOffset=r.body.next_offset===null?null:r.body.next_offset}else{nextOffset=null}loadingMore=false;list()}async function reloadSearch(){loadingMore=true;let r=await K.get(cataloguePath(0));loadingMore=false;if(!r.ok){$('list').innerHTML='';return $('list').append(K.note(r,'ForeignTwin catalogue search'))}twins=r.body.twins||[];total=r.body.total||twins.length;estateTotal=r.body.estate_total||total;nextOffset=r.body.next_offset===null?null:r.body.next_offset;picked=null;list();plan()}function status(name,x,detail){",
    "function cataloguePath(offset){let p='/foreign/twins'+(offset?'/page/'+offset:''),q=[];if(searchTerm)q.push('q='+encodeURIComponent(searchTerm));if(offset&&catalogueGeneration)q.push('snapshot='+encodeURIComponent(catalogueGeneration));return p+(q.length?'?'+q.join('&'):'')}async function loadMore(){if(loadingMore||nextOffset===null)return;loadingMore=true;list();let r=await K.get(cataloguePath(nextOffset));if(r.ok&&r.body.state==='snapshot_mismatch'){loadingMore=false;return reloadSearch()}if(r.ok){let more=r.body.twins||[];let seen=new Set(twins.map(x=>x.url));twins.push(...more.filter(x=>!seen.has(x.url)));total=r.body.total||total;estateTotal=r.body.estate_total||estateTotal;nextOffset=r.body.next_offset===null?null:r.body.next_offset}else{nextOffset=null}loadingMore=false;list()}async function reloadSearch(){loadingMore=true;let r=await K.get(cataloguePath(0));loadingMore=false;if(!r.ok||r.body.state!=='current'){$('list').innerHTML='';return $('list').append(K.note(r,'ForeignTwin catalogue search'))}twins=r.body.twins||[];total=r.body.total||twins.length;estateTotal=r.body.estate_total||total;catalogueGeneration=r.body.catalogue_generation||'';nextOffset=r.body.next_offset===null?null:r.body.next_offset;picked=null;list();plan()}function status(name,x,detail){",
)
HTML = HTML.replace(
