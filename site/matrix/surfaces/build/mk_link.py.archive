)
HTML = HTML.replace('Create collection + World draft', 'Publish collection + World')
HTML = HTML.replace("refresh_policy:'manual',status:'draft'", "refresh_policy:'manual',status:'published'")
HTML = HTML.replace(
    'This World is a human-authored draft over one selected foreign source collection. It does not admit source material, create a public route, assign contributors, establish an institution, licence material, or authorize an effect.',
    'This World is a human-authored publication over one selected foreign source collection. It does not admit source material, assign contributors, establish an institution, licence material, or authorize an effect.',
)
HTML = HTML.replace("or authorize an effect.',status:'draft'", "or authorize an effect.',status:'published'")
HTML = HTML.replace(
    'Typed source collection and World drafts were created in the native CMS. They are private, unlaunched inputs to later material compilation and governance.',
    "Published source collection and World created. Read the native composed publication at /w/'+worldId+'.",
)
HTML = HTML.replace(
    "out.append(E('div','toast err',collection.status===401||collection.status===403?'Sign in with a CMS write closure to create a private collection.'",
    "out.append(E('div','toast err',collection.status===401||collection.status===403?'Sign in with a CMS publish closure to create this World.'",
)
HTML = HTML.replace(
    "The collection draft was created, but the World draft was refused. The collection remains private and can be continued in CMS. ",
    "The published source collection was created, but its World was refused. It can be completed in CMS without selecting a different source. ",
)
HTML = HTML.replace(
    "out.append(E('div','toast','Published source collection and World created. Read the native composed publication at /w/'+worldId+'.'))",
    "out.append(E('div','toast','Published source collection and World created.'));let link=E('a','primary','Open publication →');link.href='/w/'+encodeURIComponent(worldId);out.append(link)",
)
HTML = HTML.replace('createWorldDraft', 'createWorld')
HTML = HTML.replace(
    'The CMS could not be reached; no unconfirmed draft was assumed created.',
    'The CMS did not confirm a World. Check CMS before retrying so an already-written source selection is not duplicated.',
)
open(OUT, "w").write(HTML)
print("wrote", OUT, len(HTML), "bytes")
