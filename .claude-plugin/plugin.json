{
  "name": "aurekai",
  "description": "Operate the Aurekai institution natively: the architecture atlas as the canonical registry, the receipted DFW parcel estate, the eighteen carrier protocols, the desk's open decisions, and density work -- with the atlas validated on every entry edit, re-exported when a turn changes it, and the session itself recorded as an observable AgentSession event stream.",
  "version": "1.0.0",
  "author": {
    "name": "Nick Gonzales",
    "url": "https://github.com/Nickgonzales76017/bonfyre"
  },
  "homepage": "https://aurekai.life",
  "keywords": ["architecture", "atlas", "institution", "carriers", "estate", "aurekai"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/institution-state.py\"",
            "timeout": 45,
            "statusMessage": "Reading what the institution is holding..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/agent-session.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/atlas-recall.py\"",
            "timeout": 25,
            "statusMessage": "Consulting the atlas..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/live-tree-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/atlas-guard.py\"",
            "timeout": 180,
            "statusMessage": "Validating the atlas..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/institution-state.py\"",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/agent-session.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/atlas-export-guard.py\"",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/agent-session.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/agent-session.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/agent-session.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
