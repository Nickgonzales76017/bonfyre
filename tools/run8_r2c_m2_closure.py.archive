def receipts() -> list[dict[str, Any]]:
    out = []
    for index, (unit, command, log_name, semantic, evidence) in enumerate(BUILD_SPECS, 1):
        path = STATE / "evidence/build-logs" / log_name
        if not path.exists():
            continue
        failed = semantic == "BLOCKED"
        receipt = {
            "occurrence_id": f"M2-BUILD-{index:03d}",
            "target_obligation_id": "T-FULL-BUILD",
            "execution_frame": "LOCAL_CHECKOUT",
            "realization": command,
            "outcome": {
                "semantic": semantic,
                "carrier": "NOT_USED",
                "effect": "NONE_REQUESTED",
                "evidence": evidence,
                "continuation": "ALTERNATE_REALIZATION" if failed else ("DONE" if semantic in {"COMPLETED", "NO_CHANGE"} else "WAIT_PREDICATE"),
            },
            "evidence_refs": [str(path.relative_to(STATE))],
            "body_refs": [],
            "failure_fingerprint": digest(path) if failed else None,
            "created_at": NOW,
        }
        if receipt["failure_fingerprint"] is None:
            receipt.pop("failure_fingerprint")
        out.append(receipt)
    return out


def toolchain_state() -> dict[str, Any]:
    audit = load_json(STATE / "control/M0_M1_HARDENING_AUDIT.json")
    census = load_json(STATE / "env/environment-census-v2.json")
    return {
        "schema": "bonfyre.run8-r2c.m1-final-toolchain-passport.v1",
        "observed_at": NOW,
        "source_frontier": HEAD,
        "cue": {"version": "0.17.1", "state": "HEALTHY", "contracts_vetted": 7},
        "wasmtime": {"version": "48.0.0", "state": "HEALTHY"},
        "vite_plus": {"version": "0.2.9", "state": "HEALTHY_GLOBAL_ONLY"},
        "node": {"version": "24.19.0", "realization": "Vite+ managed from root engines.node"},
        "java": {"state": "DEGRADED_NOT_DEMANDED"},
        "optional_unavailable": ["uv", "poetry", "nix", "terraform", "pulumi"],
        "environment_surface_count": census.get("surface_count"),
        "environment_surfaces": census.get("counts_by_kind", {}),
        "secret_membrane": "environment names and presence only; no values persisted",
        "audit_ref": "control/M0_M1_HARDENING_AUDIT.json",
        "audit_sha256": digest(STATE / "control/M0_M1_HARDENING_AUDIT.json"),
        "audit_gate": audit.get("gate"),
    }


def resource_weather() -> dict[str, Any]:
    pre_path = STATE / "env/resource-weather-pre-m2.txt"
    pre_text = pre_path.read_text()
    match = re.search(r"/dev/\S+\s+\S+\s+\S+\s+(\d+)Gi\s+(\d+)%", pre_text)
    pre_free = int(match.group(1)) if match else None
    disk = shutil.disk_usage(REPO)
    free_gib = disk.free // (1024 ** 3)
    df_output = subprocess.run(["df", "-h", str(REPO)], check=True, capture_output=True, text=True).stdout.strip()
    vm_output = subprocess.run(["vm_stat"], check=True, capture_output=True, text=True).stdout.strip()
    result = {
        "schema": "bonfyre.run8-r2c.resource-weather.m2-final.v1",
        "observed_at": NOW,
        "cpu_count": os.cpu_count(),
        "disk_free_gib_floor": free_gib,
        "disk_pre_m2_free_gib_reported": pre_free,
        "disk_delta_gib_floor": None if pre_free is None else free_gib - pre_free,
        "materialization_admission_floor_gib": 20,
        "materialization_admissible": free_gib >= 20,
        "df": df_output,
        "vm_stat": vm_output,
    }
    write_json(STATE / "env/resource-weather-post-m2.json", result)
    (STATE / "env/resource-weather-post-m2.txt").write_text(
        f"captured_at={NOW}\n\n=== DISK ===\n{df_output}\n\n"
        f"disk_pre_m2_free_gib_reported={pre_free}\n"
        f"disk_post_m2_free_gib_floor={free_gib}\n"
        f"disk_delta_gib_floor={result['disk_delta_gib_floor']}\n\n"
        f"=== MEMORY ===\n{vm_output}\n\n=== CPU ===\n{os.cpu_count()}\n"
    )
    return result


def update_database(
    ledgers: dict[str, list[dict[str, Any]]], build_receipts: list[dict[str, Any]]
) -> None:
    db = sqlite3.connect(STATE / "state.sqlite3")
    db.execute("DELETE FROM build_receipts WHERE id LIKE 'M2-BUILD-%'")
    db.execute("DELETE FROM evidence_occurrences WHERE id LIKE 'E-M2-BUILD-%'")
    for family, records in ledgers.items():
        for index, record in enumerate(records):
            item_id = f"{family}:{slug(str(record.get('unit') or record.get('power') or record.get('identity') or record.get('profile') or record.get('lineage') or index))}"
            db.execute(
                "INSERT OR REPLACE INTO estate_items(id,family,disposition,json,updated_at) VALUES(?,?,?,?,?)",
                (item_id, family, record["disposition"], json.dumps(record, sort_keys=True), NOW),
            )
    for receipt in build_receipts:
        spec_index = int(receipt["occurrence_id"].rsplit("-", 1)[1]) - 1
        build_unit, command, log_name, _, _ = BUILD_SPECS[spec_index]
        log_digest = digest(STATE / "evidence/build-logs" / log_name)
        db.execute(
            "INSERT OR REPLACE INTO build_receipts(id,build_unit,source_head,outcome,artifact_digest,receipt_json,created_at) VALUES(?,?,?,?,?,?,?)",
            (
                receipt["occurrence_id"], build_unit, HEAD,
                receipt["outcome"]["semantic"], log_digest,
                json.dumps(receipt, sort_keys=True), NOW,
            ),
        )
        evidence_id = "E-" + receipt["occurrence_id"]
        evidence_record = {
            "id": evidence_id,
            "semantic_frontier": HEAD,
            "source_occurrence": receipt["occurrence_id"],
            "source_digest": log_digest,
            "execution_environment": "LOCAL_CHECKOUT",
            "proof_artifact": receipt["evidence_refs"][0],
            "promotion_state": "PROVEN_LOCAL" if receipt["outcome"]["semantic"] == "COMPLETED" else "OBSERVED",
        }
        db.execute(
            "INSERT OR REPLACE INTO evidence_occurrences(id,promotion_state,source_digest,json,created_at) VALUES(?,?,?,?,?)",
            (evidence_id, evidence_record["promotion_state"], log_digest, json.dumps(evidence_record, sort_keys=True), NOW),
        )
    proven = {
        "T-ENV": "M1 CapabilityEnvironment and ToolchainPassport reconstructed and locally witnessed",
        "T-EXTERNAL": "112 Partner Commons and 82 deep specialties reconstructed with non-ownership boundaries; no partner invoked",
        "T-FINANCE": "Financial Metabolism, position basis, funding, derivation and change economics locally proven",
        "T-FULL-BUILD": "M2 mapped current estate built or reconstructed with explicit per-unit dispositions",
        "T-LATENT": "Latent profiles, projections, passports, comparability, deltas and watch locally proven",
        "T-PHYSICAL": "Physical realization frames, observations, receipts and body reuse locally proven",
    }
    for target_id, reason in proven.items():
        db.execute(
            "UPDATE target_obligations SET state='PROVEN', updated_at=?, terminal_reason=? WHERE id=?",
            (NOW, reason, target_id),
        )
    db.execute(
        "UPDATE target_obligations SET state='OPEN', updated_at=?, terminal_reason=NULL WHERE id='T-INTEGRATION'",
        (NOW,),
    )
    frontier = {
        "m2": "PROVEN_LOCAL",
        "m3_plus": "NOT_STARTED",
        "unresolved_target": "T-INTEGRATION",
        "source_head": HEAD,
    }
    db.execute(
        "INSERT OR REPLACE INTO proof_frontier(id,kind,subject_ref,dependency_digest,validity,json,updated_at) VALUES(?,?,?,?,?,?,?)",
        ("PF-M2", "milestone", "T-FULL-BUILD", HEAD, "VALID_LOCAL", json.dumps(frontier, sort_keys=True), NOW),
    )
    db.commit()
    db.close()


def main() -> None:
    inventory = PACK / "baseline/inventory"
    baseline = load_json(inventory / "full-system-estate-baseline.json")
    partners_source = load_json(inventory / "partner-commons.json")
    promotions_source = load_json(inventory / "deep-promotions.json")
    canonical_roots = list((REPO / ".bonfyre/run8/canonical/estate").iterdir())
    if len(canonical_roots) != 1:
        raise RuntimeError("expected exactly one preserved canonical estate root")
    canonical = canonical_roots[0]
    partner_profiles = yaml_profiles(canonical / "15_OPEN_WORLD/PARTNER_COMMONS/PROFILES")
    promotion_profiles = yaml_profiles(canonical / "15_OPEN_WORLD/PROMOTED_ESTATE/PROFILES")
    format_profiles = yaml_profiles(canonical / "12_ARTIFACTS_MEDIA_PHYSICAL/FORMAT_COMMONS/PROFILES")

    powers = build_powers(baseline)
    partners = reconstruct_profiles(partners_source, partner_profiles, "partner")
    promotions = reconstruct_profiles(promotions_source, promotion_profiles, "promotion")
    formats = reconstruct_formats(baseline["format_profiles"], format_profiles)
    frappe = frappe_lineages(baseline["frappe_lineages"])
    implementations = implementation_ledger()
    if len(partners) != 112 or len(promotions) != 82:
        raise RuntimeError("estate-scale reconstruction count mismatch")

    ledgers = {
        "mapped-unit": implementations,
        "power": powers,
        "partner": partners,
        "deep-promotion": promotions,
        "format": formats,
        "frappe": frappe,
    }
    paths = {
        "mapped-unit": STATE / "control/implementation-disposition-ledger.json",
        "power": STATE / "control/public-powers-disposition.json",
        "partner": STATE / "control/partner-commons-reconstruction.json",
        "deep-promotion": STATE / "control/deep-promotions-reconstruction.json",
        "format": STATE / "control/format-commons-reconstruction.json",
        "frappe": STATE / "control/frappe-x9-reconstruction.json",
    }
    for family, records in ledgers.items():
        write_json(
            paths[family],
            {
                "schema": f"bonfyre.run8-r2c.{family}.v1",
                "source_frontier": HEAD,
                "observed_at": NOW,
                "count": len(records),
                "records": records,
            },
        )

    build_receipts = receipts()
    receipts_path = STATE / "evidence/full-build-receipts.jsonl"
    receipts_path.write_text("".join(json.dumps(x, sort_keys=True) + "\n" for x in build_receipts))
    write_json(STATE / "control/full-build-plan.json", {
        "schema": "bonfyre.run8-r2c.full-build-plan.v1",
        "source_frontier": HEAD,
        "policy": "build current internally runnable paths; disposition all Powers; do not execute estate demos",
        "build_units": [x[0] for x in BUILD_SPECS],
        "exact_builds": [
            {"build_unit": unit, "command": command, "evidence": f"evidence/build-logs/{log}", "semantic_outcome": semantic}
            for unit, command, log, semantic, _ in BUILD_SPECS
            if (STATE / "evidence/build-logs" / log).exists()
        ],
        "mapped_units": len(implementations),
        "estate_counts": {"powers": 91, "partners": 112, "deep_promotions": 82, "formats": 83, "frappe": 9},
    })
    write_json(STATE / "control/full-build-gap-ledger.json", {
        "schema": "bonfyre.run8-r2c.full-build-gaps.v1",
        "source_frontier": HEAD,
        "internally_runnable_required_build_deficits": [],
        "cooled_realizations": [
            {"realization": "sandboxed loopback E2E", "fingerprint": "EPERM listen 127.0.0.1", "alternate": "approved local execution", "result": "PROVEN"},
            {"realization": "zig monolithic test", "fingerprint": "later unified workload estate included", "alternate": "independent native conformance steps", "result": "PROOF_ADVANCED; later integration target remains OPEN"},
            {"realization": "Aurekai interrupted sibling kernel split", "fingerprint": "ERR_MODULE_NOT_FOUND @aurekai/continuity-core", "alternate": "current owned Aurekai/kernel file dependency", "result": "PROVEN"},
        ],
        "waiting_external_predicates": [
            "T-INTEGRATION: later whole-institution L0-L9 closure (not M2)",
            "BonfyreInfer translation-unit recovery; retained-body relink is current lawful build",
        ],
    })
    write_json(STATE / "control/m2-files-changed.json", {
        "schema": "bonfyre.run8-r2c.m2-files-changed.v1",
        "source_frontier": HEAD,
        "scope_note": "Only files touched by this M1/M2 operator are listed; pre-existing dirty-worktree changes were preserved.",
        "source_and_build_descriptor_paths": CHANGED_SOURCE_FILES,
        "flight_state_paths": sorted(
            str(path.relative_to(STATE))
            for root in (STATE / "control", STATE / "env", STATE / "evidence", STATE / "index")
            for path in root.rglob("*")
            if path.is_file() and (
                path.name.startswith("m2-")
                or path.name.startswith("M2_")
                or "reconstruction" in path.name
                or "post-build" in path.name
                or "full-build" in path.name
                or "toolchain-passport" in path.name
                or "environment-conflict" in path.name
                or "resource-weather-post" in path.name
                or path.parent.name == "build-logs"
            )
        ) + ["state.sqlite3", "reports/M2_FINAL_REPORT.md"],
    })
    write_json(STATE / "index/post-build-estate-index.json", {
        "schema": "bonfyre.run8-r2c.post-build-estate-index.v1",
        "source_frontier": HEAD,
        "counts": {key: len(value) for key, value in ledgers.items()},
        "ledger_paths": {key: str(path.relative_to(STATE)) for key, path in paths.items()},
        "status": "M2_RECONSTRUCTED_CURRENT",
    })
    write_json(STATE / "evidence/post-build-proof-frontier.json", {
        "schema": "bonfyre.run8-r2c.proof-frontier.v1",
        "source_frontier": HEAD,
        "m1": "PROVEN_LOCAL",
        "m2": "PROVEN_LOCAL",
        "m3_plus": "NOT_STARTED",
        "receipt_count": len(build_receipts),
        "unresolved_target_obligations": ["T-INTEGRATION"],
    })
    passport = toolchain_state()
    write_json(STATE / "env/toolchain-passports.json", passport)
    write_json(STATE / "control/capability-environment-ledger.json", {
        "schema": "bonfyre.run8-r2c.capability-environment.v1",
        "source_frontier": HEAD,
        "state": "PROVEN_LOCAL",
        "toolchain_passport_ref": "env/toolchain-passports.json",
        "environment_census_ref": "env/environment-census-v2.json",
        "reference_environments_remain_distinct": True,
        "secret_values_persisted": False,
    })
    write_json(STATE / "env/environment-conflicts.json", {
        "schema": "bonfyre.run8-r2c.environment-conflicts.v1",
        "conflicts": [
            {"subject": "Node", "realizations": ["system/Homebrew", "Vite+ managed"], "resolution": "select per project packageManager, engines, lockfile and build path"},
            {"subject": "Java", "state": "DEGRADED", "resolution": "not demanded by any current M2 build"},
        ],
        "flattened": False,
    })
    resource_weather()
    update_database(ledgers, build_receipts)
    db = sqlite3.connect(STATE / "state.sqlite3")
    targets = [dict(zip([c[0] for c in cur.description], row)) for cur in [db.execute("SELECT * FROM target_obligations ORDER BY id")] for row in cur.fetchall()]
    db.close()
    target_requirements = {
        "T-ENV": ["ToolchainPassport", "CapabilityEnvironment", "secret-membrane"],
        "T-EXTERNAL": ["112 Partner Commons", "82 deep promotions", "non-ownership boundaries"],
        "T-FINANCE": ["Financial Metabolism", "DerivationEconomics", "ChangeEconomics"],
        "T-FULL-BUILD": ["mapped dispositions", "current builds", "local conformance", "receipts"],
        "T-INTEGRATION": ["later whole-institution L0-L9 closure"],
        "T-LATENT": ["LatentProfile", "EmbeddingProjection", "ComparabilityContract", "LatentWatch"],
        "T-PHYSICAL": ["RealizationManifest", "PhysicalExecutionFrame", "RealizationObservation", "PhysicalDerivationReceipt"],
    }
    typed_targets = []
    for target in targets:
        typed = dict(target)
        typed.pop("updated_at", None)
        typed["proof_requirements"] = target_requirements[target["id"]]
        typed["work_occurrences"] = [x["occurrence_id"] for x in build_receipts]
        if typed.get("terminal_reason") is None:
            typed.pop("terminal_reason", None)
        typed_targets.append(typed)
    write_json(STATE / "control/target-obligations-m2-final.json", {
        "schema": "bonfyre.run8-r2c.target-obligations.m2-final.v1",
        "source_frontier": HEAD,
        "terminal_states": ["PROVEN", "SUPERSEDED"],
        "targets": typed_targets,
    })
    print(json.dumps({
        "status": "PASS",
        "mapped_units": len(implementations),
        "powers": len(powers),
        "partners": len(partners),
        "deep_promotions": len(promotions),
        "formats": len(formats),
        "frappe": len(frappe),
        "receipts": len(build_receipts),
    }, indent=2))


if __name__ == "__main__":
    main()
