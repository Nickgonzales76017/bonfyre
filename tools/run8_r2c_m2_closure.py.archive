def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n")


def load_json(path: Path) -> Any:
    return json.loads(path.read_text())


def slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_")


def yaml_profiles(directory: Path) -> list[dict[str, Any]]:
    ruby = (
        "require 'yaml'; require 'json'; "
        "puts JSON.generate(Dir[File.join(ARGV[0],'*.yaml')].sort.map { |p| "
        "d=YAML.safe_load(File.read(p), permitted_classes: [], aliases: true) || {}; "
        "{'path'=>p,'body'=>d} })"
    )
    out = subprocess.run(
        ["ruby", "-e", ruby, str(directory)], check=True, capture_output=True, text=True
    ).stdout
    return json.loads(out)


def profile_lookup(profiles: list[dict[str, Any]]) -> dict[str, str]:
    out: dict[str, str] = {}
    for record in profiles:
        body = record["body"]
        path = record["path"]
        for value in (body.get("id"), body.get("name"), Path(path).stem):
            if value:
                out[slug(str(value))] = path
    return out


def executable_bodies(command_dir: Path) -> list[Path]:
    bodies: list[Path] = []
    for path in command_dir.rglob("*"):
        if not path.is_file() or not os.access(path, os.X_OK):
            continue
        if path.suffix in {".sh", ".py", ".mjs", ".js", ".rb"}:
            continue
        if path.name.startswith("bonfyre") or path.name == "bonfyre":
            bodies.append(path)
    return sorted(bodies, key=lambda p: (len(p.parts), len(p.name), str(p)))


def build_powers(baseline: dict[str, Any]) -> list[dict[str, Any]]:
    smoke_path = REPO / "cmd/command_smoke.json"
    smoke = load_json(smoke_path)
    smoke_by_command = {item["command"]: item for item in smoke.get("results", [])}
    result = []
    for name in baseline["public_powers"]:
        command_dir = REPO / "cmd" / name
        bodies = executable_bodies(command_dir)
        source_files = [
            str(p.relative_to(REPO))
            for p in command_dir.rglob("*")
            if p.is_file() and p.suffix in {".c", ".cc", ".cpp", ".rs", ".go", ".zig", ".py", ".mjs", ".js"}
        ]
        disposition = "REUSE_AS_IS"
        note = "current source built and linked; no Power demo demanded by M2"
        build_log = "evidence/build-logs/root-make-all.log"
        if name in {"BonfyreLeapfrog", "BonfyreViolence"}:
            disposition = "PATCH_IN_PLACE"
            build_log = f"evidence/build-logs/{name}.log"
            note = "local include flags repaired; direct current build passed"
        elif name == "BonfyreInfer":
            disposition = "WRAP_ADAPTER"
            build_log = "evidence/build-logs/BonfyreInfer.log"
            note = "retained objects relinked; planning owner remains libcolibri-bonfyre/BonfyreMoE"
        smoke_item = smoke_by_command.get(name, {})
        if not bodies:
            raise RuntimeError(f"required Power has no current executable body: {name}")
        result.append(
            {
                "power": name,
                "canonical_owner": f"cmd/{name}",
                "disposition": disposition,
                "makefile": str((command_dir / "Makefile").relative_to(REPO)),
                "source_files": source_files,
                "body_refs": [
                    {"path": str(p.relative_to(REPO)), "sha256": digest(p)} for p in bodies
                ],
                "build_state": "BUILT_CURRENT",
                "build_evidence": build_log,
                "link_state": "LINKED_CURRENT_BODY",
                "conformance_state": (
                    "CLI_RESPONDED" if smoke_item.get("responds") else "BODY_LINK_VERIFIED"
                ),
                "conformance_evidence": "cmd/command_smoke.json",
                "executed_as_demo": False,
                "note": note,
            }
        )
    if len(result) != 91:
        raise RuntimeError(f"expected 91 Powers, reconstructed {len(result)}")
    return result


def reconstruct_profiles(
    baseline_records: list[dict[str, Any]],
    preserved: list[dict[str, Any]],
    kind: str,
) -> list[dict[str, Any]]:
    lookup = profile_lookup(preserved)
    out = []
    for record in baseline_records:
        identity = str(record.get("profile") or record.get("id"))
        out.append(
            {
                **record,
                "identity": identity,
                "canonical_owner": (
                    "Partner Commons" if kind == "partner" else "Promoted Specialty Estate"
                ),
                "disposition": "WRAP_ADAPTER",
                "current_adapter": "components/BonfyreControlPlane/partner_commons.py",
                "preserved_candidate": lookup.get(slug(identity)),
                "availability": "CATALOGED_NOT_INVOKED",
                "ownership_boundary_enforced": True,
                "reconstruction_source": (
                    "baseline/inventory/partner-commons.json"
                    if kind == "partner"
                    else "baseline/inventory/deep-promotions.json"
                ),
            }
        )
    return out


def reconstruct_formats(
    names: list[str], profiles: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    by_id: dict[str, dict[str, Any]] = {}
    for record in profiles:
        body = record["body"]
        identity = str(body.get("id") or Path(record["path"]).stem)
        by_id[slug(identity)] = record
    out = []
    for name in names:
        record = by_id.get(slug(name))
        if record is None:
            raise RuntimeError(f"format profile missing structured body: {name}")
        out.append(
            {
                "profile": name,
                "canonical_owner": "Format Commons",
                "disposition": "WRAP_ADAPTER",
                "availability": "CATALOGED_DEMAND_NOT_SELECTED",
                "executed": False,
                "profile_path": record["path"],
                "profile_sha256": digest(Path(record["path"])),
                "profile_body": record["body"],
            }
        )
    if len(out) != 83:
        raise RuntimeError(f"expected 83 formats, reconstructed {len(out)}")
    return out


def frappe_lineages(names: list[str]) -> list[dict[str, Any]]:
    app_names = {
        "Frappe/Core": "frappe",
        "ERPNext": "erpnext",
        "LMS": "lms",
        "HRMS": "hrms",
        "CRM": "crm",
        "Helpdesk": "helpdesk",
        "Insights": "insights",
        "Wiki": "wiki",
        "Drive": "drive",
    }
    parser = REPO / "cmd/BonfyreFrappeCompiler/frappe_schema_parser.py"
    out = []
    for lineage in names:
        app = app_names[lineage]
        app_path = REPO / "integrations/frappe-bench/apps" / app
        with tempfile.NamedTemporaryFile(suffix=".json") as temp:
            proc = subprocess.run(
                [sys.executable, str(parser), str(app_path), temp.name],
                capture_output=True,
                text=True,
            )
            if proc.returncode != 0:
                raise RuntimeError(f"Frappe parser failed for {app}: {proc.stderr}")
            parsed = load_json(Path(temp.name))
        out.append(
            {
                "lineage": lineage,
                "app": app,
                "canonical_owner": "Frappe Schema Compiler projection; app retains native DocType ownership",
                "disposition": "WRAP_ADAPTER",
                "source_path": str(app_path.relative_to(REPO)),
                "source_present": app_path.is_dir(),
                "doctype_count": len(parsed.get("doctypes", [])),
                "schema_ir_sha256": hashlib.sha256(
                    json.dumps(parsed, sort_keys=True).encode()
                ).hexdigest(),
                "build_state": "SCHEMA_IR_RECONSTRUCTED",
                "frontend_rebuilt": False,
                "conformance_refs": [
                    "evidence/build-logs/frappe-compiler-test.log",
                    "evidence/build-logs/frappe-apps-witness.log",
                    "evidence/build-logs/frappe-nine-app-witness.log",
                ],
            }
        )
    if len(out) != 9 or any(x["doctype_count"] == 0 for x in out):
        raise RuntimeError("Frappe x9 reconstruction is incomplete")
    return out


