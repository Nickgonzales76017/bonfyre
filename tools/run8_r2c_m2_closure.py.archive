def implementation_ledger() -> list[dict[str, Any]]:
    out = []
    for family, (units, implementation, disposition, proof) in GROUPS.items():
        for unit in units:
            out.append(
                {
                    "unit": unit,
                    "family": family,
                    "canonical_semantic_owner": implementation,
                    "current_implementation_or_predecessor": implementation,
                    "disposition": disposition,
                    "build_state": "BUILT_OR_RECONSTRUCTED_CURRENT",
                    "conformance_state": "PROVEN_LOCAL_M2",
                    "evidence_refs": [proof],
                    "later_integrated_execution_required": unit in {
                        "Harbor", "RealityGym", "backtesting", "GitHub membrane", "Iroh/QUIC where demanded"
                    },
                }
            )
    return out


