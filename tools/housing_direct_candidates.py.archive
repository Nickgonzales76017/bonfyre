#!/usr/bin/env python3
"""Project retained direct housing portals into provenance-bound candidates.

ForeignTwin owns observation.  This reader accepts only a retained body whose
digest still matches its ``bonfyre-foreign-observation.v1`` receipt.  A public
listing card can identify a property/unit candidate and quote its advertised
rent, but it never establishes that the unit remains available.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import tempfile
from pathlib import Path

from housing_shadow_inventory import (
    extract_embedded_units,
    extract_identity,
    extract_platforms,
    extract_portal_listings,
    extract_structured_offers,
)
from housing_receipt_policy import admission_failure, evidence as policy_evidence


SCHEMA = "bonfyre-housing-direct-candidate.v1"


def sha256_path(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 16), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_receipts(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def verified_body(receipt: dict, root: Path) -> tuple[Path, str] | None:
    if receipt.get("observation_kind") != "source_observed" or not receipt.get("body_path"):
        return None
    path = Path(receipt["body_path"])
    if not path.is_absolute():
        path = root / path
    if not path.is_file():
        return None
    digest = sha256_path(path)
    return (path, digest) if digest == receipt.get("content_sha256") else None


def offer_key(offer: dict) -> str:
    return str(offer.get("unit_id") or offer.get("plan_id") or "|".join(
        str(offer.get(key) or "") for key in ("plan_name", "unit_address", "advertised_price", "bedrooms")
    ))


def derive_candidates(receipts: list[dict], root: Path, twin_ids: set[str]) -> tuple[list[dict], list[dict]]:
    candidates: dict[str, dict] = {}
    boundaries: list[dict] = []
    for receipt in receipts:
        if receipt.get("twin_id") not in twin_ids:
            continue
        policy_failure = admission_failure(receipt)
        if policy_failure:
            boundaries.append({
                "twin_id": receipt.get("twin_id"),
                "source_url": receipt.get("source_url"),
                "reason": policy_failure,
            })
            continue
        resolved = verified_body(receipt, root)
        if resolved is None:
            boundaries.append({
                "twin_id": receipt.get("twin_id"),
                "source_url": receipt.get("source_url"),
                "reason": "body_missing_or_digest_mismatch_or_not_observed",
            })
            continue
        body_path, body_sha256 = resolved
        body = body_path.read_text(encoding="utf-8", errors="replace")
        property_name, address = extract_identity(body)
        # A portal's generic title is not an independently established property identity.
        if property_name and property_name.strip().lower() in {"rental listings", "available rentals"}:
            property_name = None
        offers = extract_portal_listings(body, receipt["source_url"])
        if not offers:
            offers = extract_structured_offers(body, receipt["source_url"])
        if not offers:
            offers = extract_embedded_units(body, receipt["source_url"])
        if not offers:
            boundaries.append({
                "twin_id": receipt.get("twin_id"),
                "source_url": receipt.get("source_url"),
                "reason": "no_recognized_property_or_unit_record",
            })
            continue
        for offer in offers:
            stable = offer_key(offer)
            candidate_id = hashlib.sha256(
                f"{receipt['source_url']}\n{body_sha256}\n{stable}".encode("utf-8")
            ).hexdigest()[:16]
            unit_scoped = bool(offer.get("unit_id")) or offer.get("rent_exactness") == "unit_exact"
            candidates[candidate_id] = {
                "schema": SCHEMA,
                "candidate_id": candidate_id,
                "candidate_scope": "unit" if unit_scoped else "property_floorplan",
                "property_key": receipt["source_url"].split("://", 1)[-1].split("/", 1)[0].lower(),
                "property_name": property_name,
                "property_address": address,
                "unit_id": offer.get("unit_id"),
                "unit_address": offer.get("unit_address"),
                "plan_name": offer.get("plan_name"),
                "bedrooms": offer.get("bedrooms"),
                "bathrooms": offer.get("bathrooms"),
                "sqft": offer.get("sqft"),
                "advertised_price": offer.get("advertised_price"),
                "exact_unit_rent": offer.get("exact_unit_rent"),
                "rent_exactness": offer.get("rent_exactness"),
                "price_currency": offer.get("price_currency"),
                "source_inventory_signal": offer.get("availability_signal"),
                "source_available_date_text": offer.get("available_date_text"),
                "extractor": offer.get("extractor"),
                "platforms": extract_platforms(body),
                "source_twin_id": receipt["twin_id"],
                "source_url": receipt["source_url"],
                "source_observed_at": receipt.get("observed_at"),
                "source_content_sha256": body_sha256,
                "source_policy_evidence": policy_evidence(receipt),
                "provenance_status": "current_foreign_policy_evidenced",
                "availability_claim": False,
                "availability_verified": False,
                "availability_status": "candidate_only",
                "verification_blocked_on": "exact availability needs a contact or application effect, which this run forbids",
            }
    # A refreshed receipt may deliberately replace the same retention path.  The
    # old receipt remains historical evidence, but it must not obscure a newer
    # digest-bound projection from the same ForeignTwin.
    projected_twins = {row["source_twin_id"] for row in candidates.values()}
    boundaries = [row for row in boundaries if row["twin_id"] not in projected_twins]
    return sorted(candidates.values(), key=lambda row: (row["source_url"], row["candidate_id"])), boundaries


def merge_owned_jsonl(path: Path, rows: list[dict]) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(f".{path.name}.lock")
    temporary_path: str | None = None
    with lock_path.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            current_keys = {row["candidate_id"] for row in rows}
            preserved = []
            if path.exists():
                for line in path.read_text(encoding="utf-8").splitlines():
                    if line.strip():
                        row = json.loads(line)
                        if row.get("schema") == SCHEMA and row.get("candidate_id") not in current_keys:
                            # Keep the historical row readable, but do not let its
                            # old body-only receipt masquerade as current-policy
                            # provenance.  A fresh allowed receipt replaces it.
                            row["provenance_status"] = "provenance_unknown"
                            row["provenance_unknown_reason"] = (
                                "legacy receipt lacks current ForeignTwin policy evidence"
                            )
                            preserved.append(row)
                        elif row.get("schema") != SCHEMA:
                            preserved.append(row)
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                             prefix=f".{path.name}.", suffix=".tmp", delete=False) as handle:
                temporary_path = handle.name
                for row in preserved + rows:
                    handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
            os.replace(temporary_path, path)
            temporary_path = None
            return len(preserved)
        finally:
            if temporary_path:
                Path(temporary_path).unlink(missing_ok=True)
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--state", type=Path, required=True)
    parser.add_argument("--source-ids", required=True, help="comma-separated ForeignTwin ids")
    parser.add_argument("--repo-root", type=Path, default=Path("."))
    parser.add_argument("--candidates-out", type=Path)
    args = parser.parse_args(argv)
    twin_ids = {value.strip() for value in args.source_ids.split(",") if value.strip()}
    candidates, boundaries = derive_candidates(
        load_receipts(args.state / "source-receipts.jsonl"), args.repo_root, twin_ids
    )
    output = args.candidates_out or args.state / "availability-candidates.jsonl"
    preserved = merge_owned_jsonl(output, candidates)
    print(json.dumps({
        "candidates": len(candidates),
        "foreign_candidate_rows_preserved": preserved,
        "source_ids": sorted(twin_ids),
        "unprojected_receipts": boundaries,
    }, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
