#!/usr/bin/env python3
"""Compile one PlacementPlane declaration into provider-specific, reviewable plans.

This compiler produces declarations and migration material only.  Applying a
Cloudflare route, provisioning a tunnel, or running the generated SQL remains
an explicit deployment act that records a PlacementReceipt.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"placement-plane: {message}")


def require(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def dump(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def text(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value, encoding="utf-8")


def service_by_id(services: list[dict], service_id: str) -> dict:
    found = next((service for service in services if service.get("id") == service_id), None)
    require(found is not None, f"required service missing: {service_id}")
    return found


def host(origin: str) -> str:
    return origin.removeprefix("https://").rstrip("/")


def sql() -> str:
    return """-- Generated by tools/compile_placement_plane.py; apply through the Supabase migration path.
-- This is a continuity membrane.  It stores projections and opaque sealed
-- transaction material; it never stores signing keys or becomes BonfyreAuth.
create table if not exists placement_generation (
  generation text primary key,
  declaration_digest text not null,
  compiled_at timestamptz not null default now(),
  frontier text not null,
  active boolean not null default false
);

create table if not exists placement_service (
  generation text not null references placement_generation(generation) on delete cascade,
  service_id text not null,
  semantic_owner text not null,
  primary_provider text not null,
  demand jsonb not null,
  public_origin text,
  primary key (generation, service_id)
);

create table if not exists placement_receipt (
  receipt_id text primary key,
  generation text not null references placement_generation(generation),
  service_id text not null,
  provider text not null,
  outcome text not null check (outcome in ('planned','applied','healthy','degraded','retired')),
  observed_at timestamptz not null default now(),
  evidence_ref text not null,
  detail jsonb not null default '{}'::jsonb
);

-- An authorization code is opaque outside the Oracle authority process.  Its
-- session envelope is sealed by that process before it reaches this table.
create table if not exists oauth_authorization_transaction (
  code_digest text primary key,
  client_id text not null,
  redirect_uri text not null,
  code_challenge text not null,
  scope text not null,
  sealed_session text not null,
  expires_at timestamptz not null,
  created_at timestamptz not null default now()
);
create index if not exists oauth_authorization_transaction_expiry
  on oauth_authorization_transaction (expires_at);

-- DELETE ... RETURNING makes code exchange single-use even when multiple
-- gateway processes race.  The authority process unseals only its own result.
create or replace function placement_consume_oauth_transaction(p_code_digest text)
returns table (client_id text, redirect_uri text, code_challenge text, scope text, sealed_session text)
language sql
security definer
set search_path = public
as $$
  delete from oauth_authorization_transaction
  where code_digest = p_code_digest and expires_at > now()
  returning client_id, redirect_uri, code_challenge, scope, sealed_session;
$$;
"""


def ingress(mcp_host: str, auth_host: str) -> str:
    return f"""# Generated PlacementPlane ingress fragment.  These exact hosts MUST precede
# *.aurekai.work so machine control is never treated as an estate object.
ingress:
  - hostname: {mcp_host}
    service: http://127.0.0.1:8791
  - hostname: {auth_host}
    service: http://127.0.0.1:8791
  - hostname: aurekai.work
    service: http://127.0.0.1:8787
  - hostname: \"*.aurekai.work\"
    service: http://127.0.0.1:8787
  - service: http_status:404
"""


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--out", required=True, type=Path)
    args = parser.parse_args()
    declaration = json.loads(args.input.read_text(encoding="utf-8"))
    require(declaration.get("schema_version") == "bonfyre.placement-plane.v1", "unsupported schema_version")
    require(declaration.get("law") == "No realization may be the sole residence of truth required to reconstruct itself.", "reconstruction law missing")
    providers = declaration.get("providers")
    require(providers == ["cloudflare", "supabase", "oracle"], "provider machine must be Cloudflare, Supabase, Oracle")
    services = declaration.get("services")
    require(isinstance(services, list), "services must be a list")
    ids = [service.get("id") for service in services]
    require(len(ids) == len(set(ids)), "service ids must be unique")
    mcp = service_by_id(services, "mcp-resource")
    auth = service_by_id(services, "oauth-authority")
    estate = service_by_id(services, "public-estate")
    continuity = service_by_id(services, "continuity-projection")
    material = service_by_id(services, "immutable-material")
    require(mcp.get("primary") == "oracle" and auth.get("primary") == "oracle", "MCP and OAuth execute on Oracle")
    require(continuity.get("primary") == "supabase", "continuity projection must be on Supabase")
    require(estate.get("primary") == "cloudflare" and estate.get("public_origin"), "public estate requires a Cloudflare public origin")
    require(material.get("primary") == "cloudflare" and material.get("public_origin"), "immutable material requires a direct Cloudflare public origin")
    mcp_origin, auth_origin = mcp.get("public_origin"), auth.get("public_origin")
    require(mcp_origin != auth_origin, "MCP resource and authorization server require distinct canonical origins")
    legacy_exclusions = declaration.get("legacy_worker_exclusions")
    canonical_exclusions = declaration.get("canonical_worker_exclusions")
    expected_legacy = {"aurekai.work/oauth*", "aurekai.work/mcp*", "aurekai.work/.well-known/oauth-*"}
    expected_canonical = {"mcp.aurekai.work/*", "auth.aurekai.work/*"}
    require(expected_legacy.issubset(set(legacy_exclusions or [])), "legacy OAuth/MCP no-worker exclusions missing")
    require(expected_canonical.issubset(set(canonical_exclusions or [])), "canonical control-host no-worker exclusions missing")
    exclusions = [*(canonical_exclusions or []), *(legacy_exclusions or [])]

    digest = hashlib.sha256(json.dumps(declaration, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    out = args.out
    dump(out / "placement-receipt.json", {
        "schema_version": "bonfyre.placement-receipt.v1",
        "declaration_digest": f"sha256:{digest}",
        "state": "planned",
        "law": declaration["law"],
        "services": [{"id": s["id"], "semantic_owner": s["semantic_owner"], "primary": s["primary"], "projections": s.get("projections", [])} for s in services],
    })
    dump(out / "cloudflare" / "worker-route-plan.json", {
        "action": "create-no-worker-routes-before-broad-estate-worker-route",
        "routes": [{"pattern": pattern, "script": None} for pattern in exclusions],
        "invariant": "Canonical MCP/OAuth control hosts and legacy compatibility paths bypass the static estate Worker.",
    })
    dump(out / "cloudflare" / "r2-material-domain-plan.json", {
        "bucket": "aurekai-estate",
        "domain": host(material["public_origin"]),
        "action": "attach-custom-domain-and-create-no-worker-exclusion",
        "worker_exclusion": f"{host(material['public_origin'])}/*",
        "invariant": "Immutable material delivery bypasses the estate Worker; direct material residency remains distinct from page routing and semantic ownership.",
    })
    text(out / "cloudflared" / "placement-plane-ingress.yml", ingress(host(mcp_origin), host(auth_origin)))
    text(out / "systemd" / "bonfyre-oauth-mcp-placement.conf", f"""# Generated PlacementPlane service environment.
[Service]
Environment=BONFYRE_MCP_PUBLIC_ORIGIN={mcp_origin}
Environment=BONFYRE_AUTH_PUBLIC_ORIGIN={auth_origin}
""")
    text(out / "supabase" / "placement-plane.sql", sql())
    dump(out / "oracle" / "service-bindings.json", {
        "gateway": "bonfyre-oauth-mcp",
        "listen": "127.0.0.1:8791",
        "mcp_origin": mcp_origin,
        "auth_origin": auth_origin,
        "durable_projection": "supabase.oauth_authorization_transaction",
        "invariant": "Oracle is authoritative execution; Supabase stores only sealed transaction continuity and projection receipts.",
    })
    dump(out / "failure-matrix.json", {
        "cloudflare_unavailable": {"public_delivery": "degraded", "native_effects": "unreachable from public edge", "truth": "retained outside delivery"},
        "supabase_unavailable": {"public_delivery": "serves last material", "oauth_code_exchange": "refused when durable store is configured", "native_effects": "continue only at owner discretion"},
        "oracle_unavailable": {"public_delivery": "serves last proven material", "search_projection": "serves last indexed result", "mcp_and_oauth": "degraded", "truth": "reconstruct from material and continuity projections"},
    })


if __name__ == "__main__":
    main()
