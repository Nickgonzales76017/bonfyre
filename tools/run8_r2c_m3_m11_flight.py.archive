#!/usr/bin/env python3
"""Execute the admitted Run8-R2C M3--M11 flight without widening authority.

All candidate commercial and realization mutations in this program are local
SHADOW objects.  The only network operation is the read-only GitHub ref
observation in M3.  Reference environment files are never read or sourced.
"""

from __future__ import annotations

import dataclasses
import datetime as dt
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
from decimal import Decimal
from pathlib import Path
from typing import Any

REPO = Path("/Users/nickgonzales/Documents/Bonfyre")
STATE = REPO / ".bonfyre/run8-r2c/20260823T032652Z-27525"
PACK = Path("/Users/nickgonzales/Downloads/Bonfyre_Run8_R2C_FULL_SYSTEM_BUILD_FLIGHT_2026-08-22")
HEAD = "13956e291440dd263d674580c391b74b43cbcec6"
CONTROL, EVIDENCE, ENV, REPORTS = (STATE / x for x in ("control", "evidence", "env", "reports"))
