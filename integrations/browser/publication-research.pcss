/*! Generated from integrations/browser/publication-research.pcss; do not edit this output. */
:root{color-scheme:light;background:#f6f4ee;color:#1d3028;font:16px/1.55 system-ui}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{min-height:44px;padding:10px 16px;border:1px solid #294d3d;border-radius:7px;background:#294d3d;color:#fff;cursor:pointer}button.secondary{background:transparent;color:#294d3d;border-color:#c2ccbe}button:disabled{opacity:.5;cursor:default}input,select{width:100%;min-height:44px;border:1px solid #b9c6b8;border-radius:6px;padding:10px;background:#fff;color:inherit}input[type=checkbox]{width:18px;min-height:18px;margin:4px 0;flex:none}a{color:#295b42}label{display:grid;gap:7px}h1,h2,h3{line-height:1.15}h1{font:400 clamp(36px,4.4vw,64px)/1.04 Georgia,serif;letter-spacing:-.035em;max-width:17ch;margin:16px 0}h2{font:400 25px/1.15 Georgia,serif;margin:0}h3{font-size:19px}.eyebrow{font:700 11px/1.3 system-ui;text-transform:uppercase;letter-spacing:.14em}.intake-heading{padding:clamp(28px,5vw,72px) clamp(20px,5vw,80px) 32px;border-top:1px solid #d3dace}.intake-heading>p:last-child{max-width:70ch;color:#526254}.intake-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:45px;padding:0 clamp(20px,5vw,80px) 80px;max-width:1700px}.intake-layout main{min-width:0}.intake-layout aside{align-self:start;position:sticky;top:24px;background:#e7eddf;padding:26px;border:1px solid #d1dbc7;border-radius:14px}.intake-layout aside>label{margin:22px 0}.fine,small{font-size:13px;color:#596c5b}#publication-search{display:flex;gap:14px;align-items:end}#publication-search label{flex:1;font-size:13px;font-weight:650}#intake-status{min-height:25px;font-size:14px}#publication-results article{padding:25px 0;border-top:1px solid #cbd5c4}#publication-results label{display:flex;align-items:start;gap:14px}#publication-results p{max-width:78ch;color:#526254}#publication-results blockquote{margin:15px 0;padding:10px 20px;border-left:3px solid #b0c39e;white-space:pre-wrap;overflow-wrap:anywhere}#publication-results summary{cursor:pointer;font-size:14px}#publication-results a{display:inline-flex;margin-top:12px;font-size:14px;min-height:35px;align-items:center}#selected-inputs{padding-left:20px}#selected-inputs li{margin:17px 0;overflow-wrap:anywhere}#selected-inputs button{padding:5px 10px;min-height:35px;display:block;margin-top:7px;font-size:13px}#preparation{border-top:1px solid #bccbb0;margin-top:26px;padding-top:8px}#preparation button{margin:8px 0;display:block}[hidden]{display:none!important}@media(max-width:900px){.intake-layout{grid-template-columns:1fr;gap:30px}.intake-layout aside{position:static}.intake-heading{padding:28px 20px}.intake-layout{padding:0 20px 40px}#publication-search{align-items:stretch;flex-direction:column}}

#retained-reader-search{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:end;padding:24px;margin:0 0 24px;background:#edf2e5;border:1px solid #c4d1b8;border-radius:18px}#retained-reader-search>label{min-width:0;font-size:13px;font-weight:650}#retained-reader-search>label:nth-of-type(2),#retained-reader-search>p{grid-column:1/-1}#retained-reader-search select{max-width:100%;text-overflow:ellipsis}#retained-reader-search>p{margin:0}#publication-results article:has(input:disabled){opacity:.7}#publication-results article:has(input:checked){border-left:3px solid #496b35;padding-left:18px;background:#f1f4e8}#publication-results article{transition:background-color .15s ease}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #aa862a;outline-offset:3px}@media(max-width:650px){#retained-reader-search{grid-template-columns:minmax(0,1fr);padding:18px}#retained-reader-search>label,#retained-reader-search>button{grid-column:1}}@media(prefers-reduced-motion:reduce){#publication-results article{transition:none}}

/* The source owner supplies rows; the shared collection supplies interaction. */
[data-source-review] .intake-layout{grid-template-columns:minmax(0,1fr) 300px;gap:28px;max-width:1900px;padding-left:clamp(18px,3vw,48px);padding-right:clamp(18px,3vw,48px)}
[data-source-review] .intake-heading{padding:32px clamp(18px,3vw,48px) 24px}[data-source-review] .intake-heading h1{font-size:clamp(34px,4vw,56px);max-width:24ch}[data-source-review] .intake-heading>button{float:right;margin-top:-50px}
#publication-results .ac-collection{border-radius:18px;--ac-paper:#fbfcf5;--ac-soft:#eaf0df;--ac-line:#c2cfb3;font:14px/1.5 system-ui}#publication-results .ac-body{min-height:460px;max-height:70vh}#publication-results .ac-row{padding:8px 4px;border-bottom:1px solid #e3e9d9;border-radius:5px}#publication-results .ac-inspector{background:#fffdf5;padding:22px}#publication-results .ac-title strong{font:400 21px/1.25 Georgia,serif}#publication-results .ac-inspector h3{font:400 31px/1.14 Georgia,serif}#publication-results .ac-toolbar{gap:8px}#publication-results .ac-search input{min-width:0}#publication-results .ac-inspector p{color:#526254;max-width:none}#publication-results .ac-inspector summary{cursor:pointer}#publication-results .ac-inspector a{display:inline-flex;margin-top:12px;min-height:40px;align-items:center}
[data-source-review][aria-busy=true] #intake-status::before{content:'';display:inline-block;width:8px;height:8px;background:#789660;border-radius:50%;margin-right:8px}
@media(max-width:1100px){[data-source-review] .intake-layout{grid-template-columns:minmax(0,1fr)}[data-source-review] .intake-layout>aside{position:static}#publication-results .ac-body{max-height:760px}}
@media(max-width:700px){[data-source-review] .intake-heading>button{float:none;margin:10px 0 0}#publication-results .ac-body{max-height:none;min-height:0}#publication-results .ac-list{max-height:420px}#publication-results .ac-inspector{max-height:560px;padding:18px}#publication-results .ac-toolbar{align-items:stretch}#publication-results .ac-search{flex-basis:100%}#publication-results .ac-inspector dl{grid-template-columns:1fr;gap:6px}#publication-results .ac-inspector dd{margin-bottom:10px}#publication-results .ac-inspector [role=tablist]{flex-wrap:wrap}}
