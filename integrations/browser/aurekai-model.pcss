/*! Generated from integrations/browser/aurekai-model.pcss; do not edit this output. */
/* Model Commons workbench: the sandbox runner's two panels. Your input on the
   left with one primary action, the answer on the right. Dark Stitch palette
   from the shell's --ak-* tokens; the page around it is model-commons.css. */
.ak-model-workbench{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:16px;margin:0;color:var(--ak-on-surface,#dee4dd);font:15px/1.55 var(--ak-sans,'DM Sans',system-ui,sans-serif);text-align:left;color-scheme:dark}
.ak-model-workbench *{box-sizing:border-box}.ak-model-workbench [hidden]{display:none!important}
.ak-model-workbench :is(h2,h3,h4,p){margin:0}
.ak-model-workbench>noscript{grid-column:1/-1;color:var(--ak-on-variant,#c5c9af)}
.ak-model-try,.ak-model-out{display:grid;align-content:start;gap:14px;min-width:0;padding:22px;border-radius:28px;background:var(--ak-surface-low,#171d19)}
.ak-model-out{background:var(--ak-surface-lowest,#0a100c);border:1px solid var(--ak-surface-high,#252b27)}
.ak-model-workbench h2{font:500 12px/1.4 'DM Mono',ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ak-on-variant,#c5c9af)}
.ak-model-workbench h3{font:600 18px/1.3 var(--ak-sans,sans-serif)}
.ak-model-workbench :is(button,input,select,textarea){font:inherit;color:inherit}
.ak-model-workbench button{min-height:44px;cursor:pointer;border:0;border-radius:999px;padding:10px 20px;background:var(--ak-surface-high,#252b27);color:var(--ak-on-surface,#dee4dd);font-weight:500}
.ak-model-workbench button:disabled{cursor:default;opacity:.45}
.ak-model-workbench :is(button,a,input,select,textarea):focus-visible{outline:2px solid var(--ak-primary,#d0fc4f);outline-offset:3px}
.ak-model-workbench .ak-model-primary{min-height:56px;padding:12px 30px;background:var(--ak-primary,#d0fc4f);color:var(--ak-on-primary,#0f1511);font-size:17px;font-weight:600}
.ak-model-workbench .ak-model-quiet{background:transparent;color:var(--ak-on-variant,#c5c9af);text-decoration:underline;text-underline-offset:3px;padding:10px 6px}
.ak-model-status{min-height:22px;color:var(--ak-on-variant,#c5c9af)}
.ak-model-workbench form{display:grid;gap:14px}
.ak-model-workbench label{display:grid;gap:6px;font:500 11px/1.3 'DM Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ak-on-variant,#c5c9af)}
.ak-model-workbench :is(input,select,textarea){width:100%;min-height:44px;border:1px solid var(--ak-surface-high,#252b27);border-radius:14px;background:var(--ak-surface-lowest,#0a100c);padding:10px 14px;font-size:15px;letter-spacing:normal;text-transform:none}
.ak-model-workbench textarea{resize:vertical;min-height:200px;padding:16px;border-radius:20px;font:14px/1.65 'DM Mono',ui-monospace,monospace}
.ak-model-workbench textarea::placeholder{color:var(--ak-on-variant,#c5c9af);opacity:.7}
.ak-model-workbench :is(input,select,textarea):disabled{opacity:.6}
.ak-model-workbench form>.ak-model-primary{justify-self:start}
.ak-model-limits{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ak-model-limits label{padding:12px 14px;border-radius:16px;background:var(--ak-surface-mid,#1b211d)}
.ak-model-limits input{min-height:36px;padding:4px 0;border:0;border-radius:0;background:transparent;font:600 17px 'DM Mono',ui-monospace,monospace;color:var(--ak-primary,#d0fc4f)}
.ak-model-caption,.ak-model-empty{font-size:13px;color:var(--ak-on-variant,#c5c9af)}
.ak-model-empty{padding:40px 0;text-align:center}
.ak-model-review,.ak-model-result{display:grid;gap:10px}
.ak-model-review{padding:18px;border-radius:20px;background:var(--ak-surface-low,#171d19)}
.ak-model-review p{color:var(--ak-on-variant,#c5c9af)}
.ak-model-actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:6px}
.ak-model-result>div{display:grid;gap:12px}
.ak-model-result pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;max-height:480px;overflow:auto;padding:18px;border-radius:20px;background:var(--ak-surface-low,#171d19);font:14px/1.65 'DM Mono',ui-monospace,monospace}
.ak-model-usage{display:grid;gap:4px;font-size:13px;color:var(--ak-on-variant,#c5c9af)}
.ak-model-workbench .ak-model-go{display:inline-flex;align-items:center;justify-self:start;min-height:48px;padding:0 24px;border-radius:999px;background:var(--ak-primary,#d0fc4f);color:var(--ak-on-primary,#0f1511);font-weight:600;text-decoration:none}
@media(max-width:820px){.ak-model-workbench{grid-template-columns:minmax(0,1fr)}.ak-model-try,.ak-model-out{padding:18px;border-radius:22px}}
@media(max-width:420px){.ak-model-limits{grid-template-columns:1fr}.ak-model-workbench form>.ak-model-primary{justify-self:stretch}}
@media(prefers-reduced-motion:reduce){.ak-model-workbench *{scroll-behavior:auto}}
