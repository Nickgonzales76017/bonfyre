/*! Generated from integrations/browser/aurekai-model.pcss; do not edit this output. */
.ak-model-workbench{margin:28px 0;padding:24px;max-width:760px;border:1px solid #dce3d5;border-radius:22px;background:#fbfcf8;color:#25342b;font:14px/1.55 'DM Sans',system-ui,sans-serif;text-align:left;color-scheme:light}
.ak-model-workbench *{box-sizing:border-box}.ak-model-workbench [hidden]{display:none!important}.ak-model-workbench h2,.ak-model-workbench h3,.ak-model-workbench h4,.ak-model-workbench p{margin:0}
.ak-model-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}.ak-model-heading>div>p{font-size:10px;letter-spacing:.13em;color:#6e7e63;margin-bottom:5px}.ak-model-heading h2{font:500 24px/1.3 Georgia,serif;overflow-wrap:anywhere}
.ak-model-workbench button,.ak-model-workbench input,.ak-model-workbench select,.ak-model-workbench textarea{font:inherit;color:inherit}.ak-model-workbench button{min-height:44px;cursor:pointer;border:1px solid #ccd7c5;background:#f4f7ef;border-radius:10px;padding:9px 15px;letter-spacing:normal;text-transform:none}.ak-model-workbench button:disabled{cursor:default;opacity:.5}.ak-model-heading>button{font-size:11px;padding:7px 10px;flex:none}
.ak-model-workbench :is(button,a,input,select,textarea):focus-visible{outline:3px solid #658c54;outline-offset:3px}.ak-model-workbench .ak-model-primary{background:#284a35;border-color:#284a35;color:#fff}
.ak-model-status{color:#5d6e55;min-height:24px;margin-bottom:16px!important}.ak-model-workbench form{display:grid;gap:14px}.ak-model-workbench label{display:grid;gap:6px;font-size:12px;font-weight:500}.ak-model-workbench :is(input,select,textarea){width:100%;min-height:44px;border:1px solid #d3dccd;border-radius:10px;background:#fff;padding:10px 12px;font-size:14px;font-weight:400}.ak-model-workbench textarea{resize:vertical;min-height:125px;line-height:1.6}.ak-model-workbench :is(input,select,textarea):disabled{background:#f2f4ef;color:#7a8274}.ak-model-workbench form>button{justify-self:start}
.ak-model-limits{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ak-model-caption{font-size:11px;color:#6f7c65}.ak-model-review,.ak-model-result{border-top:1px solid #dce3d5;margin-top:22px;padding-top:18px;display:grid;gap:10px}.ak-model-review h3{font-size:16px;font-weight:600}.ak-model-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:8px}.ak-model-result>div{display:grid;gap:12px}.ak-model-result h4{font-size:13px;font-weight:600;margin:12px 0 5px}.ak-model-result pre{margin:6px 0;white-space:pre-wrap;overflow-wrap:anywhere;max-height:420px;overflow:auto;background:#fff;border:1px solid #e0e7d9;border-radius:12px;padding:16px;font:14px/1.65 system-ui,sans-serif}.ak-model-result a{color:#31593d;text-underline-offset:3px;min-height:44px;display:flex;align-items:center}
@media(max-width:540px){.ak-model-workbench{padding:17px;border-radius:17px}.ak-model-heading{display:block}.ak-model-heading>button{margin-top:10px}.ak-model-limits{grid-template-columns:1fr}.ak-model-workbench form>button{width:100%}.ak-model-heading h2{font-size:21px}.ak-model-review .ak-model-actions button{flex:1}}
@media(prefers-reduced-motion:reduce){.ak-model-workbench *{scroll-behavior:auto}}
