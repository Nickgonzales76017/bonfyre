.cycle-move-dialog{width:min(560px,calc(100vw - 28px));max-height:calc(100dvh - 40px);overflow:auto;padding:24px}.cycle-move-dialog label{display:flex;flex-direction:column;gap:8px}.cycle-move-dialog input{font:inherit;min-height:44px}.cycle-move-dialog table{width:100%;margin:16px 0}.cycle-move-dialog th,.cycle-move-dialog td{text-align:left;padding:8px}.cycle-move-dialog .actions{margin-top:16px;display:flex;flex-wrap:wrap;gap:8px}#cycle-move-error{color:var(--danger,#8a251f)}.cycle-original{font-size:13px}
