/*! Generated from integrations/browser/source-library.pcss; do not edit this output. */

:root{color-scheme:light;--ink:#213e2d;--paper:#f7f8ee;--line:#c8d4bd;--muted:#627459}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 system-ui,sans-serif}[hidden]{display:none!important}main[data-source-library]{max-width:1560px;margin:auto;padding:32px clamp(16px,4vw,64px) 70px}header{display:flex;align-items:end;gap:20px;padding-bottom:24px;border-bottom:1px solid var(--line);margin-bottom:22px}header>div{flex:1}header h1{font:400 clamp(32px,4vw,54px)/1.07 Georgia,serif;margin:10px 0 18px;max-width:19ch}header p{max-width:65ch;margin:0;color:var(--muted)}header p:first-child{font:600 10px ui-monospace,monospace;letter-spacing:.1em}a{color:#2f573a;overflow-wrap:anywhere}button{min-height:44px;padding:10px 15px;font:600 13px system-ui;border:1px solid #acc399;border-radius:9px;background:#fffef8;color:var(--ink);cursor:pointer}button:disabled{opacity:.5;cursor:default}nav[aria-label='Source actions']{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}nav[aria-label='Source actions']>button:first-child{background:#2d5039;color:#fff}.source-drop{padding:25px;border:2px dashed #adbf9e;border-radius:14px;background:#edf3e3;text-align:center;color:#58714b;cursor:pointer}.source-drop[data-dragging=true]{background:#dbeac9}.source-actions{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.ac-inspector section>a{display:block;margin:14px 0}.ac-inspector img,.ac-inspector audio,.ac-inspector video{max-width:100%;display:block;margin:14px 0}.ac-inspector code{font:11px ui-monospace,monospace;overflow-wrap:anywhere}.source-preview-text{white-space:pre-wrap;overflow-wrap:anywhere;font:14px/1.7 ui-monospace,monospace;max-height:320px;overflow:auto;padding:14px;border:1px solid var(--line);background:#fffef7}.source-dialog{border:1px solid var(--line);border-radius:18px;background:#f8faef;color:var(--ink);padding:28px;width:min(900px,calc(100vw - 24px));max-height:92dvh;overflow:auto;font:15px/1.55 system-ui}.source-dialog::backdrop{background:#102c20aa;backdrop-filter:blur(3px)}.source-dialog h2{font:400 32px/1.15 Georgia,serif;margin:0 0 18px}.source-dialog label,main>label{display:grid;gap:6px;font-size:13px;margin:12px 0}.source-dialog input:not([type=checkbox]),.source-dialog select,.source-dialog textarea,main>label select{min-width:0;width:100%;border:1px solid #b5c7a6;border-radius:8px;padding:10px 12px;font:15px system-ui;background:#fffef9;color:var(--ink)}.source-dialog textarea{min-height:140px;resize:vertical}.source-dialog footer{display:flex;gap:10px;justify-content:flex-end;margin-top:25px;flex-wrap:wrap}.source-dialog footer button:first-child{background:#2d5039;color:#fff}.source-dialog [role=status]{background:#e5efd9;padding:12px;border-radius:9px}.source-intake-list{max-height:48vh;overflow:auto;border-top:1px solid var(--line);margin-top:20px}.source-intake-list label{display:grid;grid-template-columns:26px minmax(120px,1fr) 180px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);gap:12px}.source-intake-list small{color:var(--muted)}:focus-visible{outline:3px solid #a3792b;outline-offset:3px}main>label{max-width:240px}[data-source-library]>[role=status]{min-height:30px;color:var(--muted);font-size:13px}@media(max-width:800px){header{display:block}header>a{display:inline-block;margin:14px 12px 0 0}.source-intake-list label{grid-template-columns:26px minmax(0,1fr)}.source-intake-list small{grid-column:2}.source-dialog{padding:20px 16px}.ac-inspector{max-height:650px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
/* Stitch reading desk: native records and actions unchanged. */
main[data-source-library]{--reader-paper:#fff8f0;--reader-line:#cbc6bd;--reader-ink:#1d1b16;--reader-accent:#8e4e1e;background:var(--reader-paper);color:var(--reader-ink)}
body:has(main[data-source-library]){background:#fff8f0;color:#1d1b16}
main[data-source-library]>header h1{font:400 clamp(39px,5vw,72px)/1.05 Newsreader,Georgia,serif;letter-spacing:-.04em;color:#1d1b16}
main[data-source-library] .source-reader-toolbar{display:grid;grid-template-columns:minmax(150px,1fr) auto auto minmax(145px,210px);align-items:center;gap:12px;padding:21px;background:#f3ede4;border:1px solid #cbc6bd;border-radius:14px;margin:28px 0 20px}
main[data-source-library] .source-reader-toolbar>strong{font:500 27px/1.2 Newsreader,Georgia,serif}
main[data-source-library] .source-reader-toolbar button{white-space:nowrap;background:#fff8f0;color:#1d1b16;border:1px solid #cbc6bd;border-radius:999px;min-height:44px}
main[data-source-library] .source-reader-toolbar button[aria-pressed=true]{background:#8e4e1e;color:#fff8f0;border-color:#8e4e1e}
main[data-source-library] .source-reader-toolbar label{display:grid;gap:3px;font:600 11px/1.3 system-ui}
main[data-source-library] .source-reader-toolbar select{min-height:44px;background:#fff8f0;color:#1d1b16;border:1px solid #cbc6bd;border-radius:8px;padding:8px}
main[data-source-library] .source-reader-hint{grid-column:1/-1;margin:0;color:#494740;font:12px/1.55 system-ui}
main[data-source-library] .ac-collection{--ac-paper:#fff8f0;--ac-soft:#f3ede4;--ac-ink:#1d1b16;--ac-line:#cbc6bd;--ac-accent:#8e4e1e}
main[data-source-library][data-reading-mode=focus] .ac-body{display:block!important;grid-template-columns:none!important;max-height:none!important}
main[data-source-library][data-reading-mode=focus] .ac-list,main[data-source-library][data-reading-mode=focus] .ak-split-handle{display:none!important}
main[data-source-library][data-reading-mode=focus] .ac-inspector{width:min(100%,1030px);margin:auto;min-height:60dvh;max-height:none!important;overflow:visible!important;border:0;padding:clamp(18px,3vw,45px)}
main[data-source-library][data-reading-mode=focus] .ac-inspector h3{font:400 clamp(36px,5vw,66px)/1.06 Newsreader,Georgia,serif;letter-spacing:-.03em}
main[data-source-library] :is(.source-original-text,.ac-reading-text){background:#fffaf3;color:#1d1b16;font:17px/1.85 Literata,Georgia,serif;white-space:pre-wrap;overflow-wrap:anywhere}
main[data-source-library][data-reading-mode=focus] :is(.source-original-text,.ac-reading-text){max-height:none!important}
main[data-source-library][data-reader-size=comfortable] :is(.source-original-text,.ac-reading-text){font-size:19px!important;line-height:1.95!important}
main[data-source-library][data-reader-size=large] :is(.source-original-text,.ac-reading-text){font-size:23px!important;line-height:2!important}
@media(max-width:960px){main[data-source-library] .source-reader-toolbar{grid-template-columns:1fr 1fr}main[data-source-library] .source-reader-toolbar>strong{grid-column:1/-1}}
@media(max-width:600px){main[data-source-library] .source-reader-toolbar{grid-template-columns:1fr}main[data-source-library] .source-reader-toolbar>strong{grid-column:auto}main[data-source-library] .source-reader-toolbar button{white-space:normal}}
/* Stitch Zen reader / real source library: reversible, per-page visual state only. */
main[data-source-library][data-reader-ground=paper]{--zen-bg:#fff8f0;--zen-panel:#f3ede4;--zen-ink:#1d1b16;--zen-muted:#494740;--zen-line:#cbc6bd;--zen-accent:#8e4e1e}
main[data-source-library][data-reader-ground=obsidian]{--zen-bg:#0f1511;--zen-panel:#1b211d;--zen-ink:#dee4dd;--zen-muted:#c5c9af;--zen-line:#444935;--zen-accent:#d0fc4f}
main[data-source-library][data-reader-ground=twilight]{--zen-bg:#171d19;--zen-panel:#252b27;--zen-ink:#e9ebdc;--zen-muted:#d0d3bd;--zen-line:#5a604f;--zen-accent:#d0fc4f}
main[data-source-library][data-reader-ground=sepia]{--zen-bg:#252b27;--zen-panel:#34382e;--zen-ink:#f2e7d1;--zen-muted:#dbcfb8;--zen-line:#706752;--zen-accent:#eac17d}
body:has(main[data-source-library][data-reading-mode=focus]){background:var(--zen-bg,#fff8f0);color:var(--zen-ink,#1d1b16)}
main[data-source-library][data-reading-mode=focus]{--ac-paper:var(--zen-bg);--ac-soft:var(--zen-panel);--ac-line:var(--zen-line);--ac-ink:var(--zen-ink);--ac-accent:var(--zen-accent);color:var(--zen-ink);background:var(--zen-bg)}
main[data-source-library][data-reading-mode=focus] :is(.ac-collection,.ac-inspector,.ac-list,.ac-toolbar){color:var(--zen-ink);background:var(--zen-bg);border-color:var(--zen-line)}
main[data-source-library][data-reading-mode=focus] .source-reader-toolbar{color:var(--zen-ink);background:var(--zen-panel);border-color:var(--zen-line)}
main[data-source-library][data-reading-mode=focus] .source-reader-toolbar :is(select,button){background:var(--zen-bg);color:var(--zen-ink);border-color:var(--zen-line)}
main[data-source-library][data-reading-mode=focus] .source-reader-toolbar button[aria-pressed=true]{background:var(--zen-accent);color:var(--zen-bg);border-color:var(--zen-accent)}
main[data-source-library][data-reading-mode=focus] .source-reader-toolbar :is(p,label){color:var(--zen-muted)}
main[data-source-library][data-reading-mode=focus] :is(.source-original-text,.ac-reading-text,.source-preview-text){color:var(--zen-ink);background:var(--zen-panel);border-color:var(--zen-line)}
main[data-source-library][data-reader-font=sans][data-reading-mode=focus] :is(.source-original-text,.ac-reading-text,.source-preview-text){font-family:'DM Sans',system-ui,sans-serif!important}
main[data-source-library][data-reader-font=literata][data-reading-mode=focus] :is(.source-original-text,.ac-reading-text,.source-preview-text){font-family:Literata,Georgia,serif!important}
main[data-source-library] .source-reader-toolbar progress{height:7px;width:100%;accent-color:var(--zen-accent,#8e4e1e);align-self:center}
main[data-source-library][data-reading-mode=focus][data-reader-dim=true] > :is(header,nav[aria-label='Source actions'],.source-drop){opacity:.20;transition:opacity .18s ease}
main[data-source-library][data-reading-mode=focus][data-reader-dim=true] > :is(header,nav[aria-label='Source actions'],.source-drop):is(:hover,:focus-within){opacity:1}
main[data-source-library][data-reading-mode=focus][data-reader-dim=true] .source-reader-toolbar{opacity:.30;transition:opacity .18s ease}
main[data-source-library][data-reading-mode=focus][data-reader-dim=true] .source-reader-toolbar:is(:hover,:focus-within){opacity:1}
@media(prefers-reduced-motion:reduce){main[data-source-library][data-reader-dim=true] *{transition:none!important}}
body:has(main[data-source-library][data-reading-mode=focus][data-reader-ground=obsidian]){background:#0f1511;color:#dee4dd}
body:has(main[data-source-library][data-reading-mode=focus][data-reader-ground=twilight]){background:#171d19;color:#e9ebdc}
body:has(main[data-source-library][data-reading-mode=focus][data-reader-ground=sepia]){background:#252b27;color:#f2e7d1}
main[data-source-library] .source-citation-review{padding:18px;border:1px solid var(--zen-line,#b9c7b5);border-radius:14px;background:var(--zen-panel,#f3ede4);color:var(--zen-ink,#213e2d);margin:16px 0}
main[data-source-library] .source-citation-review h4{font:500 clamp(20px,2.5vw,26px)/1.2 Georgia,serif;margin:0 0 8px}
main[data-source-library] .source-citation-review p{font:13px/1.5 system-ui;margin:9px 0}
main[data-source-library] .source-citation-text{display:block;width:100%;max-width:100%;min-height:170px;resize:vertical;padding:12px;border:1px solid var(--zen-line,#b9c7b5);border-radius:8px;background:var(--zen-bg,#fff8f0);color:var(--zen-ink,#213e2d);font:12px/1.55 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere}
main[data-source-library] .source-citation-review button{min-height:44px;margin-top:12px}
main[data-source-library] .source-citation-review :is(textarea,button):focus-visible{outline:2px solid var(--zen-accent,#8e4e1e);outline-offset:3px}
