/*! Generated from integrations/browser/account-choices.pcss; do not edit this output. */

/* Named, inspectable choices, shared by personal and organisational entrances. */
.reference-picker {
  --choice-line:var(--rule,#c7d3bd);
  min-width:0;margin:18px 0;
  & form { @apply flex items-end; gap:10px;
    & label { flex:1;min-width:0; }
  }
  & input { width:100%;min-width:0;border-radius:9px;min-height:44px; }
  & button { min-height:44px;border-radius:9px; }
}
.reference-picker>p{font-size:13px;color:var(--dim,#566850);line-height:1.5;margin:12px 0}.reference-picker [role=listbox]{max-height:310px;overflow:auto;border:1px solid var(--choice-line);border-radius:12px;background:var(--paper,#fffef8)}.reference-picker [role=listbox]:empty{display:none}.reference-option{padding:14px 16px;border-bottom:1px solid var(--choice-line);cursor:pointer;display:grid;gap:5px;min-height:62px}.reference-option:last-child{border-bottom:0}.reference-option small{color:var(--dim,#586b50);overflow-wrap:anywhere}.reference-option[aria-selected=true],.reference-option:hover{background:var(--soft,#e9f0df)}.reference-option[aria-disabled=true]{opacity:.55;cursor:default}.reference-selected{border:1px solid var(--live,#36563e);border-radius:12px;padding:18px;margin-top:14px;background:var(--soft,#e9f0df)}.reference-selected[hidden]{display:none!important}.reference-selected p{font-size:13px;overflow-wrap:anywhere}.reference-selected a{display:block;color:inherit;padding:10px 0;font-weight:600;min-height:44px}.reference-selected button{background:var(--paper,#fffef8);color:var(--ink,#243e2a);border:1px solid var(--choice-line)}.account-profile-links{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.account-profile-links a{display:grid;gap:5px;color:inherit;text-decoration:none;border:1px solid var(--rule);padding:15px;border-radius:12px;background:var(--soft)}.account-profile-links a small{font-size:12px;color:var(--dim)}#connect [data-profile-recognition]{font-size:13px;line-height:1.6;color:var(--dim);overflow-wrap:anywhere;min-height:24px}#connect details{border-top:1px solid var(--rule);padding-top:12px}#connect summary{cursor:pointer;font-size:13px;min-height:36px}#connect input{border-radius:9px;min-height:44px}.account-choice-dialog{box-sizing:border-box;max-width:600px;width:calc(100vw - 32px);border:1px solid var(--rule,#afc49e);padding:28px;border-radius:18px;background:var(--paper,#fffef8);color:var(--ink,#203b2a);font:15px/1.6 system-ui;max-height:90dvh}.account-choice-dialog::backdrop{background:#10251eaa;backdrop-filter:blur(4px)}.account-choice-dialog h2{font:400 32px Georgia,serif}.account-choice-dialog dl{display:grid;grid-template-columns:auto minmax(0,1fr);gap:14px}.account-choice-dialog dd{margin:0;overflow-wrap:anywhere}.account-choice-dialog dt{font-weight:600}.account-choice-dialog footer{display:flex;gap:12px;justify-content:flex-end}.account-choice-dialog button{min-height:44px;border-radius:9px}.account-space-actions{display:flex;gap:18px;flex-wrap:wrap;font-size:14px}.account-space-actions a{color:inherit}.reference-picker :focus-visible,.account-choice-dialog :focus-visible,.account-profile-links a:focus-visible{outline:3px solid var(--live,#3d714d);outline-offset:3px}@media(max-width:600px){.reference-picker form{align-items:stretch;flex-direction:column}.reference-picker [role=listbox]{max-height:290px}.account-profile-links{grid-template-columns:1fr 1fr}.account-choice-dialog{padding:20px}.account-choice-dialog dl{grid-template-columns:1fr;gap:5px}.account-choice-dialog dd{margin-bottom:10px}}@media(prefers-reduced-motion:reduce){.reference-picker *,.account-choice-dialog *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
