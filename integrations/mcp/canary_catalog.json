  {
    "name": "canary_policy_upsert",
    "description": "Create or update a capability-specific canary. Only a valid passed certificate, safe effect classes, a distinct fallback and 1-25 percent are accepted.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "fallback_provider": {
          "type": "string"
        },
        "percentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "effect_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PURE",
              "READ_ONLY",
              "CANDIDATE_WRITE"
            ]
          }
        },
        "enable": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "capability",
        "provider",
        "fallback_provider",
        "percentage",
        "effect_classes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
