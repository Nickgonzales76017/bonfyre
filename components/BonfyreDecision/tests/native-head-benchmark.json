{
  "schema": "bonfyre.native-head-microbenchmark.v1",
  "scope": "Synthetic native head only, excluding compilation/import, tokenizer, backbone, RPC and application latency. No trained tensors or model download.",
  "environment": {
    "os_arch": "Darwin arm64",
    "compiler": "Apple clang 17.0.0 (clang-1700.0.13.5)",
    "flags": "-O2 -std=c11 -Wall -Wextra -Werror -DBF_DECISION_ACCELERATE -DACCELERATE_NEW_LAPACK -framework Accelerate -lm",
    "env": {
      "VECLIB_MAXIMUM_THREADS": "1"
    }
  },
  "method": {
    "warmup_per_workload": 3,
    "samples_per_workload_per_trial": 21,
    "trials": 3,
    "order": "baseline/raw/owned, owned/raw/baseline, baseline/raw/owned",
    "summary": "median of per-trial medians; p95 is sorted sample index 19 of 21",
    "allocation": "Weights and workspace allocated before warmups. Immutable owner creation/copy/validation excluded from repeated-request measurement."
  },
