def test_codex_coordinate_enrichment_preserves_existing_attempt_identity(tmp_path):
    epoch = tmp_path / "epochs" / "codex-20260824T010000-abc"
    epoch.mkdir(parents=True)
    epoch.joinpath("command.json").write_text(json.dumps([
        "codex", "exec", "--model=gpt-5.6", "--json", "-",
    ]))
    epoch.joinpath("stdout.log").write_text(json.dumps({
        "type": "turn.completed", "usage": {"input_tokens": 50},
    }))
    db = sqlite3.connect(":memory:")
    prior = fm.provider_model_usage_from_receipt(
        {"provider": "codex", "input_tokens": 50},
        occurrence_id="usage:codex-20260824T010000-abc:turn-0",
        attempt_ref="attempt:codex-20260824T010000-abc:turn-0",
        realization_ref="realization:codex-20260824T010000-abc",
        receipt_ref="receipt:codex-20260824T010000-abc:stdout.log:sha256:"
                    + hashlib.sha256(epoch.joinpath("stdout.log").read_bytes()).hexdigest(),
        observed_at="20260824T010000",
    )
    fm.record_provider_model_usage(db, prior, target_ref="work-occurrence:codex-20260824T010000-abc")
    fm.reconcile_run8_epochs(db, tmp_path)
    row = db.execute("SELECT model_ref,route_ref FROM usage_occurrence_details").fetchone()
    assert row == ("gpt-5.6", "codex-cli:exec")


def test_run8_receipt_replay_reports_replay_without_duplicate_charge(tmp_path):
    epoch = tmp_path / "epochs" / "codex-20260824T010000-abc"
    epoch.mkdir(parents=True)
    epoch.joinpath("stdout.log").write_text(json.dumps({
        "type": "turn.completed", "usage": {"input_tokens": 50},
    }))
    db = sqlite3.connect(":memory:")
    first = fm.reconcile_run8_epochs(db, tmp_path)
    second = fm.reconcile_run8_epochs(db, tmp_path)
    assert first["usage_occurrences"] == 1
    assert second["usage_occurrences"] == 0
    assert second["replayed_attempts"] == 1
    assert db.execute("SELECT count(*) FROM usage_occurrences").fetchone()[0] == 1
