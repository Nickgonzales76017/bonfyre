    assert row == ("codex", "gpt-5.6", "codex-cli:exec")


def test_v6_compaction_preserves_terminal_coordinates_and_immutable_command(tmp_path):
    epoch = tmp_path / "epochs" / "codex-20260824T010000-abc"
    epoch.mkdir(parents=True)
    command = ["codex", "exec", "--model", "gpt-5.6", "--json", "-"]
    terminal = {"type": "turn.completed", "route": "responses-api",
                "usage": {"input_tokens": 50}}
    epoch.joinpath("command.json").write_text(json.dumps(command))
    epoch.joinpath("stdout.log").write_text(json.dumps(terminal))
    envelope = fm.terminal_epoch_receipt_envelope(epoch)
    assert envelope["schema"] == fm.TERMINAL_EPOCH_RECEIPT_SCHEMA
    assert envelope["provider"] == "codex"
    assert envelope["model"] == "gpt-5.6"
    assert envelope["route"] == "responses-api"
    assert envelope["carrier_command"]["argv"] == command
    assert envelope["carrier_command"]["argv_sha256"]

    # This models the post-compaction state: only a bounded stdout tail and
    # the versioned envelope survive; command.json itself is no longer there.
    epoch.joinpath("stdout.log").unlink()
    epoch.joinpath("command.json").unlink()
    epoch.joinpath("compaction.json").write_text(json.dumps({
        "version": "Run8EpochCompaction-v6",
        "files": [{"name": "stdout.log", "tail_utf8": json.dumps(terminal)}],
        "terminal_epoch_receipt": envelope,
    }))
    db = sqlite3.connect(":memory:")
    fm.reconcile_run8_epochs(db, tmp_path)
    row = db.execute("SELECT provider_ref,model_ref,route_ref FROM usage_occurrence_details").fetchone()
    assert row == ("codex", "gpt-5.6", "responses-api")


def test_tampered_compacted_command_metadata_cannot_enrich_usage(tmp_path):
    epoch = tmp_path / "epochs" / "codex-20260824T010000-abc"
    epoch.mkdir(parents=True)
    terminal = {"type": "turn.completed", "usage": {"input_tokens": 50}}
    envelope = {
        "schema": fm.TERMINAL_EPOCH_RECEIPT_SCHEMA,
        "provider": "codex", "model": "gpt-5.6", "route": "codex-cli:exec",
        "carrier_command": {"source": "command.json",
                            "argv": ["codex", "exec", "--model", "gpt-5.6"],
                            "argv_sha256": "tampered"},
    }
    epoch.joinpath("compaction.json").write_text(json.dumps({
        "version": "Run8EpochCompaction-v6",
        "files": [{"name": "stdout.log", "tail_utf8": json.dumps(terminal)}],
        "terminal_epoch_receipt": envelope,
    }))
    db = sqlite3.connect(":memory:")
    fm.reconcile_run8_epochs(db, tmp_path)
    row = db.execute("SELECT provider_ref,model_ref,route_ref FROM usage_occurrence_details").fetchone()
    assert row == ("codex", None, None)


