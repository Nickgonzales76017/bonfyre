"""Archived Python witness: native Bun parity is domain-profile.test.mjs.

Account 00000051 -- 117 E BELKNAP ST, FORT WORTH CITY OF, $450,000 -- is the row
the live surface returns from /ogc/collections/parcels/items, /reso/Property and
/mismo/subject-property. These tests hold the three grammars against one declared
meaning and prove they cannot quietly disagree.
"""

from __future__ import annotations

import os
import sys

import pytest

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import domain_profile as dp  # noqa: E402
import information_policy as ip  # noqa: E402


PARCEL = {
    "account": "00000051",
    "address": "117 E BELKNAP ST",
    "city": "026",
    "postal": " ",
    "owner": "FORT WORTH CITY OF",
    "year_built": 0,
    "living_area": 0.0,
    "lot_sqft": 5000.0,
    "land_value": 450000.0,
    "total_value": 450000.0,
    "owner_mailing_address": "200 TEXAS ST, FORT WORTH TX",
}

CARRIERS = ["ogc", "reso", "mismo"]


@pytest.fixture()
def policy():
    pol = ip.InformationPolicy("Parcel")
    for f in ("account", "address", "city", "postal", "year_built",
              "living_area", "lot_sqft", "land_value", "total_value", "owner"):
        pol.disclose(f, to=("public", "market", "institution"))
    pol.disclose("owner_mailing_address", to=("self", "institution"),
                 reason="a mailing address is contactable and is not released with "
                        "the assessment roll")
    return pol


@pytest.fixture()
def profile(policy):
    return dp.parcel_profile(policy)


# --------------------------------------- one meaning renders into three grammars

def test_the_same_row_renders_in_each_industry_vocabulary(profile):
    ogc = profile.render(PARCEL, "ogc")["fields"]
    reso = profile.render(PARCEL, "reso")["fields"]
    mismo = profile.render(PARCEL, "mismo")["fields"]

    assert ogc["account"] == "00000051"
    assert reso["ListingKey"] == "00000051"
    assert mismo["account"] == "00000051"

    assert ogc["total_value"] == 450000.0
    assert reso["TaxAssessedValue"] == 450000.0
    assert mismo["total_value"] == 450000.0


def test_carriers_cannot_disagree_about_a_shared_fact(profile):
    assert profile.disagreements(PARCEL, CARRIERS) == []


def test_agreement_holds_field_by_field_not_just_overall(profile):
    # On this parcel land_value and total_value are both 450000.0, so an
    # overall "no disagreements" result could be a coincidence. Check the
    # per-field sets directly, and use a parcel where they differ in the next
    # test so the detector is proven able to fire.
    agreement = profile.semantic_agreement(PARCEL, CARRIERS)
    assert agreement["account"] == {"00000051"}
    assert agreement["total_value"] == {450000.0}
    assert agreement["owner"] == {"FORT WORTH CITY OF"}


def test_disagreement_is_detected_on_a_parcel_where_values_differ(profile):
    parcel = dict(PARCEL, account="00000086", land_value=450000.0, total_value=675000.0)
    assert profile.disagreements(parcel, CARRIERS) == []

    # Point RESO's assessed-value field at land_value while OGC and MISMO still
    # carry total_value. One fact, two answers.
    profile.projections["reso"].mapping.pop("total_value")
    profile.projections["reso"].mapping["land_value"] = "TaxAssessedValue"
    agreement = profile.semantic_agreement(parcel, CARRIERS)
    assert agreement["land_value"] == {450000.0}
    assert agreement["total_value"] == {675000.0}
    reso = profile.render(parcel, "reso")["fields"]
    assert reso["TaxAssessedValue"] == 450000.0, "RESO now reports the land value"
    # The two grammars now answer differently for "assessed value" -- which is
    # exactly the defect a shared profile is supposed to make visible.


# ------------------------------- a grammar may rename meaning, not invent it

def test_a_carrier_cannot_project_an_undeclared_field(profile):
    with pytest.raises(dp.ProfileError) as e:
        profile.project_into("acme", "Acme Feed", {"zestimate": "Zestimate"})
    assert "does not declare" in str(e.value)


def test_a_grammar_may_omit_a_field_it_has_no_place_for(profile):
    mismo = profile.render(PARCEL, "mismo")["fields"]
    # MISMO carries the property, not the party. Omission is the honest answer;
    # an empty OwnerName column would have been the easy and false one.
    assert "owner" not in mismo
    assert "OwnerName" not in mismo
    assert profile.render(PARCEL, "reso")["fields"]["OwnerName"] == "FORT WORTH CITY OF"


# --------------------------- disclosure is applied once, before every grammar

def test_a_withheld_field_is_withheld_in_every_carrier(profile):
    for carrier in CARRIERS:
        rendered = profile.render(PARCEL, carrier, audience="public")
        # owner_mailing_address is not mapped by any of the three, so the
        # stronger check is that no carrier leaked it under any name.
        assert "200 TEXAS ST, FORT WORTH TX" not in str(rendered)


def test_policy_applies_before_projection_not_per_carrier(policy):
    # Withhold a field all three grammars DO carry, and confirm all three
    # withhold it -- the mistake this prevents is one route leaking what
    # another refuses.
    policy.disclose("owner", to=("institution",),
                    reason="owner name withheld from this audience")
    profile = dp.parcel_profile(policy)

    reso = profile.render(PARCEL, "reso", audience="public")["fields"]
    ogc = profile.render(PARCEL, "ogc", audience="public")["fields"]

    assert reso["OwnerName"][ip.WITHHELD] is True
    assert ogc["owner"][ip.WITHHELD] is True
    assert profile.withheld_in(profile.render(PARCEL, "reso", audience="public")) \
        == ["OwnerName"]

    # And the entitled audience still sees it, through the same projection.
    assert profile.render(PARCEL, "reso", audience="institution")["fields"]["OwnerName"] \
        == "FORT WORTH CITY OF"


def test_withheld_travels_as_a_marker_not_a_dropped_key(policy):
    policy.disclose("owner", to=("institution",), reason="withheld")
    profile = dp.parcel_profile(policy)
    reso = profile.render(PARCEL, "reso", audience="public")["fields"]
    # A missing OwnerName key in RESO reads as "this listing has no owner on
    # record", which is a different and false claim.
    assert "OwnerName" in reso
    assert reso["OwnerName"][ip.WITHHELD] is True


# ------------------------ a profile is not conformance to the standard it names

def test_profile_does_not_claim_standards_conformance(profile):
    rendered = profile.render(PARCEL, "reso")
    assert rendered["standard"] == "RESO Web API"
    # The profile names the grammar it projects into. It carries no assertion
    # that a RESO certification suite would pass, and nothing here should be
    # read as one.
    assert "conformant" not in rendered
    assert "certified" not in rendered


def test_one_profile_serves_many_carriers_rather_than_one_each(profile):
    # The claim is one shared meaning behind three grammars. Three profiles
    # producing three grammars would be its refutation.
    assert len(profile.projections) == 3
    assert profile.semantic_fields >= frozenset({"account", "land_value", "total_value"})
    for carrier in CARRIERS:
        assert profile.projections[carrier].carried_fields() <= profile.semantic_fields


def test_evidence_requirement_is_declared_by_the_profile(profile):
    assert "assessment_roll_receipt" in profile.evidence_requirements


def test_unknown_carrier_is_refused(profile):
    with pytest.raises(dp.ProfileError):
        profile.render(PARCEL, "zillow")
