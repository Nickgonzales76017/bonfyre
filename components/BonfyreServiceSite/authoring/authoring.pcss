/*! Generated from components/BonfyreServiceSite/authoring/authoring.pcss; do not edit this output. */
/* Browser-only editor; public profile readers never load this asset. */
:root{color-scheme:dark}
body.authoring-page{margin:0;background:var(--ak-surface-low);color:var(--ak-on-surface);font:15px/1.5 var(--ak-sans)}
.authoring-page .authoring-top{display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:15px 24px;background:var(--ak-surface-high);color:var(--ak-on-surface);border:1px solid var(--ak-outline-variant)}
.authoring-page .authoring-top a{color:inherit;text-decoration:none}
.authoring-page .authoring-top strong{font:600 18px var(--ak-serif)}
.authoring-page .authoring-top form{display:flex;align-items:center;gap:9px;margin-left:auto}
.authoring-page .authoring-top label{display:flex;align-items:center;gap:7px;font-size:12px}
.authoring-page .authoring-top input{width:clamp(130px,20vw,250px);border:1px solid var(--ak-outline-variant);border-radius:8px;padding:8px;background:var(--ak-surface-low);color:var(--ak-on-surface)}
.authoring-page .authoring-top button{border:1px solid var(--ak-outline-variant);border-radius:8px;background:var(--ak-surface-low);color:var(--ak-on-surface);padding:8px 15px;font-weight:650;cursor:pointer}
.authoring-page .aurekai-authoring{display:grid;gap:12px;min-height:calc(100vh - 100px)}
.authoring-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:14px 24px;background:var(--ak-surface-low);border-bottom:1px solid var(--ak-outline-variant)}
.authoring-toolbar h1{margin:0;font:500 clamp(20px,2.4vw,30px) var(--ak-serif)}
.authoring-modes,.authoring-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.authoring-modes button,.authoring-actions button,.authoring-review button{border:1px solid var(--ak-outline-variant);border-radius:10px;background:var(--ak-surface-low);color:var(--ak-on-surface);padding:10px 14px;min-height:44px;font:600 13px var(--ak-sans);cursor:pointer}
.authoring-modes button[aria-current=true]{background:var(--ak-primary);color:var(--ak-on-primary)}
.authoring-actions button:last-child{background:var(--ak-primary);color:var(--ak-on-primary)}
.authoring-toolbar button:focus-visible{outline:3px solid var(--ak-primary);outline-offset:3px}
.authoring-toolbar button:disabled{opacity:.48;cursor:not-allowed}
.authoring-status{margin:0;padding:5px 24px;color:var(--ak-on-variant);font:13px var(--ak-sans)}
.authoring-status[data-error=true],.authoring-error{color:var(--ak-on-surface)}
.authoring-stage{min-width:0;margin:0 14px 18px;background:var(--ak-surface-low);border:1px solid var(--ak-outline-variant);border-radius:15px;overflow:hidden;min-height:65vh}
.authoring-canvas,.authoring-puck{min-height:65vh}
.authoring-article-selector{margin:18px;max-width:calc(100% - 36px);padding:10px;border:1px solid var(--ak-outline-variant);border-radius:8px}
.authoring-article{width:min(850px,calc(100% - 40px));min-height:460px;margin:0 auto}
.authoring-review{width:min(92vw,850px);max-height:85vh;padding:26px;border:1px solid var(--ak-outline-variant);border-radius:18px;background:var(--ak-surface-low);color:var(--ak-on-surface)}
.authoring-review::backdrop{background:color-mix(in srgb,var(--ak-surface-lowest) 70%,transparent)}
.authoring-review h2{font:500 32px var(--ak-serif)}
.authoring-review-list{line-height:2;max-height:55vh;overflow:auto}
.authoring-review{width:min(95vw,1200px);max-width:1200px}
.authoring-review-list{max-height:135px;overflow:auto}
.authoring-review-devices{display:flex;gap:9px;align-items:center;justify-content:flex-end;margin:14px 0}
.authoring-review-devices button[aria-pressed=true]{background:var(--ak-primary);color:var(--ak-on-primary)}
.authoring-review-preview{box-sizing:border-box;display:block;width:100%;height:min(60vh,700px);min-height:320px;margin:0 auto 18px;border:1px solid var(--ak-outline-variant);border-radius:11px;background:var(--ak-surface-low);transition:width 180ms ease}
.authoring-review-preview[data-viewport=phone]{width:390px;max-width:100%}
@media(prefers-reduced-motion:reduce){.authoring-review-preview{transition:none}}
@media(max-width:760px){.authoring-toolbar{padding:12px}.authoring-stage{margin:0 5px}.authoring-top{padding:12px}}

/* Full component material editing lives in Puck's inspector, not a JSON dump. */
.authoring-structured-inspector{display:grid;gap:14px;min-width:0;font:13px/1.5 var(--ak-sans);color:var(--ak-on-surface)}
.authoring-structured-inspector :is(fieldset,ol){margin:0;padding:0;min-width:0}
.authoring-structured-inspector fieldset{padding:12px;border:1px solid var(--ak-outline-variant);border-radius:10px;background:var(--ak-surface-low);display:grid;gap:11px}
.authoring-structured-inspector fieldset>legend{padding:0 7px;max-width:100%;overflow-wrap:anywhere}
.authoring-structured-inspector .authoring-field-label{text-transform:none;font-weight:650;letter-spacing:0}
.authoring-structured-inspector label{display:grid;gap:6px;min-width:0}
.authoring-structured-inspector textarea,.authoring-structured-inspector input,.authoring-structured-inspector select{box-sizing:border-box;width:100%;min-width:0;border:1px solid var(--ak-outline-variant);border-radius:7px;padding:9px 10px;background:var(--ak-surface-low);color:var(--ak-on-surface);font:inherit}
.authoring-structured-inspector textarea{resize:vertical;min-height:48px}
.authoring-structured-inspector [type=checkbox]{width:auto;min-width:18px;height:18px}
.authoring-structured-inspector button{background:var(--ak-surface-mid);color:var(--ak-on-surface);border:1px solid var(--ak-outline-variant);border-radius:7px;padding:7px 10px;font:650 12px var(--ak-sans);min-height:34px;cursor:pointer}
.authoring-structured-inspector button:hover:not(:disabled){background:var(--ak-surface-mid)}
.authoring-structured-inspector button:disabled{opacity:.42;cursor:not-allowed}
.authoring-structured-inspector :is(button,input,textarea,select):focus-visible{outline:3px solid var(--ak-primary);outline-offset:2px}
.authoring-structured-inspector .authoring-structured-array>ol{list-style:none;display:grid;gap:11px}
.authoring-structured-inspector .authoring-structured-item{border:1px solid var(--ak-outline-variant);border-radius:9px;padding:11px;background:var(--ak-surface-low);display:grid;gap:10px;min-width:0}
.authoring-structured-inspector .authoring-structured-item-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.authoring-structured-inspector .authoring-structured-item-actions small{margin-right:auto}
.authoring-structured-inspector .authoring-structured-property{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:6px}
.authoring-structured-inspector .authoring-field-remove{align-self:end}
.authoring-structured-inspector .authoring-structured-add{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;align-items:end}
.authoring-structured-inspector .authoring-structured-add>button{grid-column:1/-1;justify-self:start}
.authoring-structured-inspector [role=alert]{color:var(--ak-on-surface);overflow-wrap:anywhere}
.authoring-puck-material{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--ak-outline-variant)}
.authoring-puck-material small{color:var(--ak-on-variant)}
@media(max-width:560px){.authoring-structured-inspector .authoring-structured-add{grid-template-columns:1fr}}
/* The native authoring palette remains visible in all three editor modes. */
.authoring-create-bar{display:flex;align-items:end;gap:12px;flex-wrap:wrap;padding:12px 24px;background:var(--ak-surface-mid);border-bottom:1px solid var(--ak-outline-variant)}
.authoring-create-bar label{display:grid;gap:5px;color:var(--ak-on-surface);font:650 12px/1.4 var(--ak-sans);letter-spacing:.015em;min-width:165px}
.authoring-create-bar select{font:14px var(--ak-sans);min-width:min(100%,210px);max-width:350px;min-height:43px;padding:9px 34px 9px 12px;background:var(--ak-surface-low);border:1px solid var(--ak-outline-variant);border-radius:9px;color:var(--ak-on-surface)}
.authoring-create-bar .authoring-parent-picker{min-width:240px}
.authoring-create-bar .authoring-insert{border:1px solid var(--ak-outline-variant);border-radius:9px;padding:10px 18px;min-height:43px;cursor:pointer;background:var(--ak-surface-high);color:var(--ak-on-surface);font:700 13px var(--ak-sans)}
.authoring-create-bar :is(select,button):focus-visible{outline:3px solid var(--ak-primary);outline-offset:2px}
.authoring-create-bar :is(select,button):disabled{opacity:.48;cursor:not-allowed}
.authoring-create-bar .authoring-insert:hover:not(:disabled){background:var(--ak-surface-high);border:1px solid var(--ak-outline-variant)}
@media(max-width:700px){.authoring-create-bar{padding:12px}.authoring-create-bar label{flex:1 1 190px}.authoring-create-bar select{max-width:none;width:100%}.authoring-create-bar .authoring-insert{width:100%}}
/* Site-level authoring: pages, route selection, and the page's native CMS fields. */
.authoring-site-workspace{display:grid;grid-template-columns:minmax(240px,290px) minmax(0,1fr);align-items:start;min-height:90vh}
.authoring-page-navigation{position:sticky;top:0;min-width:0;max-height:100vh;overflow:auto;background:var(--ak-surface-low);border-right:1px solid var(--ak-outline-variant)}
.authoring-page-bar{display:grid;gap:14px;padding:18px;color:var(--ak-on-surface)}
.authoring-pages-panel h2{font:650 24px var(--ak-serif);letter-spacing:-.025em;margin:0}
.authoring-pages-panel p{font-size:12px;line-height:1.6;color:var(--ak-on-variant)}
.authoring-page-route-form{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.authoring-page-route-form input{font:13px var(--ak-sans);border:1px solid var(--ak-outline-variant);background:var(--ak-surface-low);color:var(--ak-on-surface);border-radius:8px;min-width:100%;min-height:40px;padding:9px}
.authoring-page-route-form button{border:1px solid var(--ak-outline-variant);border-radius:8px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:650 12px var(--ak-sans);min-height:40px;padding:8px 12px;cursor:pointer}
.authoring-page-list{list-style:none;margin:16px 0 4px;padding:0;max-height:220px;overflow:auto;display:grid;gap:4px}
.authoring-page-list li{min-width:0}
.authoring-page-list button{font:13px/1.45 var(--ak-sans);text-align:left;width:100%;border:1px solid transparent;border-radius:8px;color:var(--ak-on-surface);background:transparent;padding:8px 10px;overflow-wrap:anywhere;cursor:pointer}
.authoring-page-list button:is(:hover,[aria-current=page]){border-color:var(--ak-outline-variant);background:var(--ak-surface-mid)}
.authoring-page-list [aria-current=page]{font-weight:700}
.authoring-page-unsaved{display:block;font:650 12px var(--ak-sans);background:var(--ak-surface-mid);border-radius:8px;padding:10px;overflow-wrap:anywhere}
.authoring-pages-status{min-height:18px;font:12px/1.4 var(--ak-sans);color:var(--ak-on-variant)}
.authoring-page-settings{border:1px solid var(--ak-outline-variant);border-radius:12px;background:var(--ak-surface-low);padding:13px;display:grid;gap:12px;min-width:0}
.authoring-page-settings legend{padding:0 7px;font:650 14px var(--ak-serif)}
.authoring-page-settings label{display:grid;gap:6px;font:650 12px var(--ak-sans);color:var(--ak-on-surface)}
.authoring-page-settings input,.authoring-page-settings textarea{font:13px/1.5 var(--ak-sans);box-sizing:border-box;min-width:0;width:100%;padding:8px 10px;border:1px solid var(--ak-outline-variant);border-radius:7px;background:var(--ak-surface-low);color:var(--ak-on-surface)}
.authoring-page-settings textarea{resize:vertical;min-height:100px}
.authoring-page-bar :is(button,input,textarea):focus-visible{outline:3px solid var(--ak-primary);outline-offset:3px}
.authoring-page-editor{min-width:0}
@media(max-width:1170px){.authoring-site-workspace{grid-template-columns:1fr}.authoring-page-navigation{position:static;max-height:none;border-right:0;border-bottom:1px solid var(--ak-outline-variant)}.authoring-page-bar{grid-template-columns:minmax(240px,1fr) minmax(240px,1fr);align-items:start}.authoring-page-list{max-height:125px}}
@media(max-width:720px){.authoring-page-bar{grid-template-columns:1fr;padding:12px}.authoring-page-list{max-height:100px}}
.authoring-journal-intake{margin:14px 12px;padding:14px;border:1px solid var(--ak-outline-variant);border-radius:12px;background:var(--ak-surface-low);color:var(--ak-on-surface);font:13px/1.5 var(--ak-sans)}
.authoring-journal-intake summary{cursor:pointer;font:650 15px/1.5 var(--ak-serif)}
.authoring-journal-intake p{margin:10px 0}
.authoring-journal-intake input{display:block;max-width:100%;margin:8px 0}
.authoring-journal-intake button{min-height:44px;padding:9px 14px;color:var(--ak-on-surface);background:var(--ak-surface-high);border:1px solid var(--ak-outline-variant);border-radius:7px;cursor:pointer}
.authoring-journal-intake button:disabled{opacity:.5;cursor:default}
.authoring-import-status{min-height:1.4em;color:var(--ak-on-variant)}
.authoring-import-preview{overflow-wrap:anywhere}
.authoring-audio-entry{margin:14px 12px;padding:14px;border:1px solid var(--ak-outline-variant);border-radius:12px;background:var(--ak-surface-low);color:var(--ak-on-surface);font:13px/1.5 var(--ak-sans)}
.authoring-audio-entry h3{font:600 20px/1.3 var(--ak-serif);margin:0 0 8px}
.authoring-audio-entry p{margin:8px 0;color:var(--ak-on-variant)}
.authoring-audio-entry button,.authoring-audio-entry a{display:inline-flex;align-items:center;min-height:44px;padding:9px 14px;border:1px solid var(--ak-outline-variant);border-radius:7px;background:var(--ak-surface-high);color:var(--ak-on-surface);font:600 13px var(--ak-sans);text-decoration:none;cursor:pointer}
.authoring-audio-entry button:disabled{opacity:.5;cursor:default}
.authoring-audio-entry a[hidden]{display:none!important}
.authoring-composition{margin:0 14px;border:1px solid var(--ak-outline-variant);border-radius:12px;background:var(--ak-surface-low);padding:15px 18px;color:var(--ak-on-surface);font:13px/1.45 var(--ak-sans)}
.authoring-composition h2{font:600 22px var(--ak-serif);margin:0 0 5px}
.authoring-composition h3{font:600 16px var(--ak-serif);margin:0}
.authoring-composition>p{margin:4px 0 10px;color:var(--ak-on-variant)}
.authoring-composition-tree{padding:5px;margin:0 0 10px;list-style:none;max-height:195px;overflow:auto;display:grid;gap:4px}
.authoring-composition-row{padding-left:calc(var(--nest-level)*18px)}
.authoring-composition-row>button{width:100%;text-align:left;min-height:34px;border:1px solid transparent;background:transparent;color:var(--ak-on-surface);border-radius:7px;padding:6px 10px;cursor:pointer}
.authoring-composition-row>button[aria-current=true]{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant);font-weight:700}
.authoring-composition-inspector{display:grid;gap:10px}
.authoring-composition-actions{display:flex;flex-wrap:wrap;gap:7px}
.authoring-composition-fields,.authoring-composition-layout{display:flex;flex-wrap:wrap;align-items:end;gap:12px}
.authoring-composition label{display:grid;gap:4px;min-width:145px;flex:1}
.authoring-composition :is(input,textarea,select){box-sizing:border-box;width:100%;min-height:39px;padding:7px 9px;border:1px solid var(--ak-outline-variant);background:var(--ak-surface-low);color:var(--ak-on-surface);border-radius:7px;font:13px var(--ak-sans)}
.authoring-composition textarea{min-height:74px;resize:vertical}
.authoring-composition-inspector button{min-height:39px;background:var(--ak-surface-mid);color:var(--ak-on-surface);border:1px solid var(--ak-outline-variant);border-radius:7px;font:600 12px var(--ak-sans);padding:7px 11px;cursor:pointer}
.authoring-composition :is(button,input,textarea,select):focus-visible{outline:3px solid var(--ak-primary);outline-offset:2px}
.authoring-composition button:disabled{opacity:.46;cursor:default}
.authoring-composition-status{min-height:18px;margin:0;color:var(--ak-on-variant)}
@media(max-width:720px){.authoring-composition{margin:0 5px}.authoring-composition label{flex-basis:100%}}
.authoring-composition-row[draggable=true]{cursor:grab}
.authoring-composition-row[draggable=true]:active{cursor:grabbing}
.authoring-composition-move{display:flex;align-items:end;gap:10px;flex-wrap:wrap}
.authoring-composition-move label{flex:1 1 240px}

/* Creator Studio: one page, one canvas and a persistent composition inspector. */
body.authoring-page{background:var(--ak-surface-mid);color:var(--ak-on-surface);font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}
.authoring-page .authoring-top{position:relative;z-index:4;min-height:62px;padding:10px clamp(14px,2vw,28px);background:var(--ak-surface-high);border-bottom:1px solid var(--ak-outline-variant);box-sizing:border-box}
.authoring-site-workspace{grid-template-columns:248px minmax(0,1fr);min-height:calc(100vh - 62px);align-items:stretch}
.authoring-page-navigation{top:0;max-height:100vh;background:var(--ak-surface-low);border-right:1px solid var(--ak-outline-variant);scrollbar-color:var(--ak-outline-variant) transparent}
.authoring-page-bar{padding:24px 18px 20px;gap:21px}
.authoring-pages-panel h2{font:500 29px/1.1 var(--ak-serif);letter-spacing:-.04em}
.authoring-pages-panel>p{font:13px/1.55 var(--ak-sans);color:var(--ak-on-variant)}
.authoring-page-list{max-height:280px;gap:2px}
.authoring-page-list button{padding:11px 12px;border-radius:9px;color:var(--ak-on-surface);font:600 12px/1.5 var(--ak-sans)}
.authoring-page-list button[aria-current=page]{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant)}
.authoring-page-settings{background:var(--ak-surface-low);border:1px solid var(--ak-outline-variant);padding:17px;border-radius:15px;gap:13px}
.authoring-page-settings legend{font:500 19px var(--ak-serif)}
.authoring-page-settings label{font-size:12px;color:var(--ak-on-variant)}
.authoring-page-settings :is(input,textarea,select){min-height:38px;background:var(--ak-surface-low);box-sizing:border-box;border:1px solid var(--ak-outline-variant);border-radius:8px}
.authoring-page-editor{background:var(--ak-surface-mid)}
.aurekai-authoring{display:grid!important;gap:0!important;min-height:calc(100vh - 62px);grid-template-columns:minmax(0,1fr) 330px;grid-template-rows:auto auto minmax(550px,1fr) auto;grid-template-areas:'toolbar toolbar' 'workflow workflow' 'canvas inspector' 'status status';background:var(--ak-surface-mid)}
.authoring-toolbar{grid-area:toolbar;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'heading actions' 'modes modes';align-items:center;gap:13px 18px;padding:22px 28px 0;background:var(--ak-surface-low);border-bottom:0}
.authoring-heading{grid-area:heading;min-width:0;display:grid;gap:3px}
.authoring-eyebrow{display:block;color:var(--ak-on-variant);font:700 10px/1.4 var(--ak-sans);letter-spacing:.12em;text-transform:uppercase}
.authoring-heading h1{margin:0;font:500 clamp(24px,2.25vw,36px)/1.12 var(--ak-serif);letter-spacing:-.04em}
.authoring-page-path{margin:0;color:var(--ak-on-variant);font:12px/1.5 ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}
.authoring-actions{grid-area:actions;justify-content:end;gap:7px}
.authoring-modes{display:flex;gap:3px;align-items:center}
.authoring-mode-strip{grid-area:modes;display:flex;align-items:center;gap:22px;min-width:0;border-top:1px solid var(--ak-outline-variant);padding:11px 0}
.authoring-strip-label{font:700 10px var(--ak-sans);letter-spacing:.1em;color:var(--ak-on-variant)}
.authoring-modes button{border:1px solid transparent;border-radius:8px;background:transparent;padding:8px 15px;min-height:40px;color:var(--ak-on-variant)}
.authoring-modes button[aria-current=true]{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant);color:var(--ak-on-surface)}
.authoring-actions button{min-height:40px;padding:8px 13px;border:1px solid var(--ak-outline-variant);background:var(--ak-surface-low);border-radius:8px;color:var(--ak-on-surface)}
.authoring-actions button:hover:not(:disabled),.authoring-modes button:hover:not(:disabled){background:var(--ak-surface-low)}
.authoring-actions button:last-child{background:var(--ak-primary);color:var(--ak-on-primary);border-color:var(--ak-outline-variant)}
.authoring-actions button:last-child:hover:not(:disabled){background:var(--ak-primary)}
.authoring-workflow-bar{grid-area:workflow;display:flex;align-items:center;flex-wrap:wrap;gap:8px 22px;padding:13px 28px;border-top:1px solid var(--ak-outline-variant);border-bottom:1px solid var(--ak-outline-variant);background:var(--ak-surface-low)}
.authoring-workflow{display:flex;align-items:center;flex-wrap:wrap;gap:11px;margin:0;padding:0;list-style:none}
.authoring-workflow-step{display:flex;align-items:center;gap:8px;color:var(--ak-on-variant);font:650 12px/1.4 var(--ak-sans)}
.authoring-workflow-step:not(:last-child):after{content:'›';margin-left:6px;color:var(--ak-on-variant);font-size:18px}
.authoring-workflow-count{display:grid;place-items:center;width:23px;height:23px;border:1px solid var(--ak-outline-variant);border-radius:50%;font:700 11px var(--ak-sans)}
.authoring-workflow-step[data-state=active]{color:var(--ak-on-surface)}
.authoring-workflow-step[data-state=active] .authoring-workflow-count{border-color:var(--ak-outline-variant);background:var(--ak-primary);color:var(--ak-on-primary)}
.authoring-workflow-step[data-state=complete]{color:var(--ak-on-variant)}
.authoring-workflow-step[data-state=complete] .authoring-workflow-count{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant)}
.authoring-save-state{margin-left:auto;padding:6px 11px;border:1px solid var(--ak-outline-variant);border-radius:999px;color:var(--ak-on-variant);background:var(--ak-surface-low);font:700 11px/1.4 var(--ak-sans);white-space:nowrap}
.authoring-save-state[data-state=saved]{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant);color:var(--ak-on-variant)}
.authoring-workflow-note{margin:0;color:var(--ak-on-variant);font:11px/1.45 var(--ak-sans);flex:1 1 100%}
.authoring-canvas-shell{grid-area:canvas;min-width:0;display:flex;flex-direction:column;background:var(--ak-surface-mid)}
.authoring-canvas-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:13px;padding:17px 20px}
.authoring-canvas-title{display:grid;gap:1px}
.authoring-canvas-title strong{font:500 17px var(--ak-serif);color:var(--ak-on-surface)}
.authoring-device-controls{display:flex;gap:3px;border:1px solid var(--ak-outline-variant);border-radius:9px;padding:3px;background:var(--ak-surface-low)}
.authoring-device-controls button{border:0;border-radius:6px;padding:7px 11px;min-height:33px;background:transparent;color:var(--ak-on-variant);cursor:pointer;font:650 11px var(--ak-sans)}
.authoring-device-controls button[aria-pressed=true]{background:var(--ak-primary);color:var(--ak-on-primary);box-shadow:0 1px 3px color-mix(in srgb,var(--ak-surface-lowest) 70%,transparent)}
.authoring-device-controls button:disabled{opacity:.45;cursor:not-allowed}
.authoring-stage{flex:1;min-width:0;min-height:560px;margin:0 20px 22px;border:1px solid var(--ak-outline-variant);border-radius:11px;background:var(--ak-surface-low);box-shadow:0 14px 35px color-mix(in srgb,var(--ak-surface-lowest) 70%,transparent)}
.authoring-canvas,.authoring-puck{min-height:560px}
.authoring-empty-state{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:20px;margin:0 20px 17px;padding:22px 26px;background:var(--ak-surface-low);border:1px solid var(--ak-outline-variant);border-radius:12px}
.authoring-empty-state[hidden]{display:none!important}
.authoring-empty-copy{display:grid;gap:6px}
.authoring-empty-copy h2{font:500 clamp(21px,2vw,29px)/1.1 var(--ak-serif);letter-spacing:-.025em;margin:0;color:var(--ak-on-surface)}
.authoring-empty-copy p{font:13px/1.55 var(--ak-sans);max-width:54ch;color:var(--ak-on-variant);margin:0}
.authoring-empty-actions{display:flex;flex-direction:column;gap:8px}
.authoring-empty-actions button{background:var(--ak-surface-low);border:1px solid var(--ak-outline-variant);border-radius:8px;color:var(--ak-on-surface);min-height:41px;padding:9px 16px;font:700 12px var(--ak-sans);cursor:pointer}
.authoring-empty-actions .authoring-empty-primary{background:var(--ak-primary);border-color:var(--ak-outline-variant);color:var(--ak-on-primary)}
.authoring-inspector-rail{grid-area:inspector;position:sticky;top:0;align-self:start;max-height:100vh;overflow-y:auto;min-width:0;background:var(--ak-surface-low);border-left:1px solid var(--ak-outline-variant);scrollbar-color:var(--ak-outline-variant) transparent}
.authoring-create-bar{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:20px 18px 22px;background:transparent;border-bottom:1px solid var(--ak-outline-variant)}
.authoring-create-bar:before{content:'Add content';grid-column:1/-1;color:var(--ak-on-surface);font:500 23px/1.15 var(--ak-serif)}
.authoring-create-bar label{min-width:0;letter-spacing:0;font:650 11px/1.4 var(--ak-sans);color:var(--ak-on-variant)}
.authoring-create-bar select{min-width:0;max-width:100%;width:100%;font:12px/1.5 var(--ak-sans);min-height:41px;padding:8px 26px 8px 9px;border-color:var(--ak-outline-variant)}
.authoring-create-bar .authoring-parent-picker{min-width:0}
.authoring-create-bar .authoring-insert{grid-column:1/-1;width:100%;min-height:41px;background:var(--ak-surface-high);border-radius:8px}
.authoring-composition-presets{grid-column:1/-1;display:grid;gap:8px;border:1px solid var(--ak-outline-variant);border-radius:12px;background:var(--ak-surface-low);padding:15px 14px 16px}
.authoring-composition-presets h3{font:500 22px/1.2 var(--ak-serif);margin:0;color:var(--ak-on-surface);letter-spacing:-.02em}
.authoring-composition-presets p{font:12px/1.45 var(--ak-sans);margin:0;color:var(--ak-on-variant)}
.authoring-composition-preset-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:stretch}
.authoring-create-bar .authoring-composition-preset-row select{min-width:0;width:100%;font-size:13px;background:var(--ak-surface-low)}
.authoring-composition-preset-row button{min-height:41px;padding:7px 14px;border-radius:8px;background:var(--ak-surface-high);color:var(--ak-on-surface);border:1px solid var(--ak-outline-variant);font:700 12px var(--ak-sans)}
.authoring-composition-preset-row button:disabled{opacity:.45;cursor:not-allowed}
@media(max-width:560px){.authoring-composition-preset-row{grid-template-columns:1fr}.authoring-composition-preset-row button{width:100%}}
.authoring-composition{margin:0;border:0;border-radius:0;background:transparent;padding:20px 18px 32px}
.authoring-composition h2{font:500 23px var(--ak-serif);letter-spacing:-.025em;color:var(--ak-on-surface)}
.authoring-composition>p{font:12px/1.55 var(--ak-sans);color:var(--ak-on-variant);margin-bottom:13px}
.authoring-composition-tree{padding:0;max-height:320px;gap:3px;overflow:auto}
.authoring-composition-row{border-left:2px solid var(--ak-outline-variant)}
.authoring-composition-row:has(>button[aria-current=true]){border-left-color:var(--ak-outline-variant)}
.authoring-composition-row>button{min-height:37px;padding:7px 9px;font:12px/1.5 var(--ak-sans);overflow-wrap:anywhere}
.authoring-composition-row>button[aria-current=true]{background:var(--ak-surface-mid);border-color:var(--ak-outline-variant);color:var(--ak-on-surface)}
.authoring-composition-inspector{gap:13px;border-top:1px solid var(--ak-outline-variant);padding-top:17px}
.authoring-composition h3{font:500 17px var(--ak-serif);color:var(--ak-on-surface)}
.authoring-composition-actions{gap:5px}
.authoring-composition-inspector button{min-height:35px;padding:7px 10px;background:var(--ak-surface-low);color:var(--ak-on-variant);border-color:var(--ak-outline-variant)}
.authoring-composition-fields,.authoring-composition-layout{display:grid;grid-template-columns:1fr;gap:11px}
.authoring-composition :is(input,select,textarea){border-color:var(--ak-outline-variant);border-radius:8px;min-height:39px}
.authoring-composition-status{font-size:11px}
.authoring-status{grid-area:status;padding:10px 24px;margin:0;border-top:1px solid var(--ak-outline-variant);background:var(--ak-surface-low);color:var(--ak-on-variant);min-height:17px}
.authoring-article{width:min(760px,calc(100% - 56px));margin:30px auto;padding:24px 0;min-height:460px}
.authoring-article-selector{display:block;margin:24px auto 0;max-width:min(760px,calc(100% - 56px))}
.authoring-workflow-bar :is(button,input):focus-visible,.authoring-device-controls button:focus-visible,.authoring-empty-actions button:focus-visible{outline:3px solid var(--ak-primary);outline-offset:3px}
@media(max-width:1450px){.authoring-site-workspace{grid-template-columns:225px minmax(0,1fr)}.aurekai-authoring{grid-template-columns:minmax(0,1fr) 295px}.authoring-toolbar{padding-inline:18px}.authoring-workflow-bar{padding-inline:18px}}
@media(max-width:1120px){.authoring-site-workspace{grid-template-columns:1fr}.authoring-page-navigation{position:static;max-height:330px;overflow:auto;border-right:0;border-bottom:1px solid var(--ak-outline-variant)}.authoring-page-bar{grid-template-columns:minmax(0,1fr) minmax(0,1fr);padding:15px 22px}.authoring-page-list{max-height:135px}.aurekai-authoring{grid-template-columns:minmax(0,1fr) 305px}}
@media(max-width:780px){.aurekai-authoring{grid-template-columns:1fr;grid-template-rows:auto auto auto auto auto;grid-template-areas:'toolbar' 'workflow' 'canvas' 'inspector' 'status'}.authoring-inspector-rail{position:static;max-height:none;border-left:0;border-top:1px solid var(--ak-outline-variant)}.authoring-toolbar{grid-template-columns:1fr;grid-template-areas:'heading' 'actions' 'modes';padding:18px 16px 0}.authoring-actions{justify-content:start}.authoring-workflow-bar{padding:12px 16px}.authoring-save-state{margin-left:0}.authoring-empty-state{grid-template-columns:1fr}.authoring-empty-actions{flex-direction:row;flex-wrap:wrap}.authoring-page-bar{grid-template-columns:1fr}.authoring-canvas-head{padding:14px}.authoring-stage{margin:0 12px 15px}.authoring-create-bar{grid-template-columns:1fr 1fr}.authoring-composition-tree{max-height:230px}}
@media(max-width:480px){.authoring-create-bar{grid-template-columns:1fr}.authoring-page .authoring-top{gap:10px}.authoring-page .authoring-top form{margin-left:0}.authoring-workflow{gap:5px}.authoring-workflow-step{font-size:11px}.authoring-canvas-head{align-items:start}.authoring-device-controls button{padding:7px 8px}}
@media(prefers-reduced-motion:reduce){.authoring-canvas-shell *{scroll-behavior:auto!important}}
.authoring-page-visibility{border-left:3px solid var(--ak-outline-variant);padding:10px 12px;margin:0;background:var(--ak-surface-low);border-radius:0 8px 8px 0;color:var(--ak-on-surface)!important;font:700 12px/1.45 var(--ak-sans)!important}
.authoring-page-visibility[data-status=published]{border-left-color:var(--ak-outline-variant);background:var(--ak-surface-low);color:var(--ak-on-variant)!important}
.authoring-page-create-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.authoring-page-create-actions button{min-height:43px;padding:8px 9px;border:1px solid var(--ak-outline-variant);border-radius:9px;background:var(--ak-surface-low);color:var(--ak-on-surface);font:700 12px/1.4 var(--ak-sans);cursor:pointer}
.authoring-page-create-actions button:first-child{background:var(--ak-surface-high);border-color:var(--ak-outline-variant);color:var(--ak-on-surface)}
.authoring-page-create-actions button:hover:not(:disabled){filter:brightness(.95)}
.authoring-page-list button{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}
.authoring-page-list button>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.authoring-page-list button>small{padding:3px 6px;border:1px solid var(--ak-outline-variant);border-radius:6px;color:var(--ak-on-variant);background:var(--ak-surface-low);font:700 10px var(--ak-sans)}
.authoring-page-list button[data-status=published]>small{background:var(--ak-surface-low);border-color:var(--ak-outline-variant);color:var(--ak-on-variant)}
@media(max-width:480px){.authoring-page-create-actions{grid-template-columns:1fr 1fr}}
/* Article release belongs to this same editor and inherits its site tokens. */
.authoring-publication{--ap-ink:var(--bf-ink,var(--ak-on-surface));--ap-muted:var(--bf-muted,var(--ak-on-variant));--ap-line:var(--bf-rule,var(--ak-outline-variant));margin:14px 12px;padding:20px;background:var(--bf-panel,var(--ak-surface-mid));border:1px solid var(--ap-line);border-radius:12px;color:var(--ap-ink);display:grid;gap:11px}
.authoring-publication-head{display:grid;gap:7px}
.authoring-publication-kicker{font:750 10px/1.4 var(--ak-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--ap-muted)}
.authoring-publication h2{font:500 24px/1.13 var(--bf-face-display,var(--ak-serif));letter-spacing:-.03em;margin:0}
.authoring-publication p{font:13px/1.55 var(--bf-face-body,system-ui,sans-serif);margin:0;color:var(--ap-muted)}
.authoring-publication .authoring-publication-open{min-height:44px;padding:10px 13px;border:1px solid var(--ap-ink);border-radius:7px;background:var(--ap-ink);color:var(--bf-ground,var(--ak-on-surface));font:700 13px var(--ak-sans);cursor:pointer}
.authoring-publication .authoring-publication-open:disabled{opacity:.52;cursor:not-allowed}
.authoring-publication-status[data-error=true]{color:var(--ak-on-surface)}
.authoring-publication-review{width:min(94vw,740px);max-height:86vh;overflow:auto;margin:auto;padding:clamp(22px,4vw,40px);border:1px solid var(--bf-rule,var(--ak-outline-variant));border-radius:12px;background:var(--bf-ground,var(--ak-surface-low));color:var(--bf-ink,var(--ak-on-surface));box-shadow:0 24px 70px color-mix(in srgb,var(--ak-surface-lowest) 70%,transparent)}
.authoring-publication-review::backdrop{background:color-mix(in srgb,var(--ak-surface-lowest) 70%,transparent)}
.authoring-publication-review h2{font:500 clamp(2rem,4vw,3rem)/1.07 var(--bf-face-display,var(--ak-serif));letter-spacing:-.04em;margin:0 0 15px}
.authoring-publication-summary{font:650 14px/1.6 var(--ak-sans);color:var(--bf-ink,var(--ak-on-surface))}
.authoring-publication-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:16px 0 16px 20px;max-height:30vh;overflow:auto;border-block:1px solid var(--bf-rule,var(--ak-outline-variant));font:13px/1.45 var(--ak-sans)}
.authoring-publication-sections li{min-width:0;overflow-wrap:anywhere}
.authoring-publication-rights{font:13px/1.7 var(--ak-sans);color:var(--bf-muted,var(--ak-on-variant))}
.authoring-publication-actions{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap}
.authoring-publication-actions button{min-height:44px;padding:10px 14px;border:1px solid var(--bf-rule,var(--ak-outline-variant));border-radius:8px;background:transparent;color:var(--bf-ink,var(--ak-on-surface));font:650 13px var(--ak-sans);cursor:pointer}
.authoring-publication-actions .authoring-publication-confirm{background:var(--bf-ink,var(--ak-primary));border-color:var(--bf-ink,var(--ak-outline-variant));color:var(--bf-ground,var(--ak-on-surface))}
.authoring-publication-actions button:disabled{opacity:.5;cursor:wait}
.authoring-publication :is(button):focus-visible,.authoring-publication-review button:focus-visible{outline:3px solid var(--ak-primary);outline-offset:3px}
@media(max-width:630px){.authoring-publication-sections{grid-template-columns:1fr}.authoring-publication-actions{display:grid;grid-template-columns:1fr}.authoring-publication-actions button{width:100%}}

/* One primary per step: Save draft. Everything else is quiet. */
.authoring-actions button:last-child:disabled{background:var(--ak-surface-high);color:var(--ak-on-variant);border-color:var(--ak-outline-variant)}
