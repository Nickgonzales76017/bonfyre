/*! Generated from components/BonfyreServiceSite/pricing-desk.pcss; do not edit this output. */
.pricing-desk{--pd-ground:#0d130f;--pd-field:#121b15;--pd-ink:#dde6da;--pd-display:#f5f7ee;--pd-accent:#b5df32;--pd-muted:#9aa89b;--pd-rule:#2a3a2e;--pd-signal:#ef6547;--pd-warn:#e8b64a;--pd-sky:#8fc7d6;background:var(--pd-ground);color:var(--pd-ink);min-height:100vh;font:15px/1.55 'DM Sans',system-ui,sans-serif;padding:20px 28px 48px}
.pricing-desk *{box-sizing:border-box}.pricing-desk [hidden]{display:none!important}.pricing-desk a{color:var(--pd-accent)}
.pricing-desk a:focus-visible,.pricing-desk button:focus-visible,.pricing-desk input:focus-visible,.pricing-desk select:focus-visible,.pricing-desk [tabindex]:focus-visible{outline:3px solid var(--pd-sky);outline-offset:3px}
.pd-top{display:flex;justify-content:space-between;gap:16px;font-size:14px}.pd-top a{min-height:44px;display:flex;align-items:center;text-decoration:none}
.pd-intro{max-width:1100px;margin:28px 0 18px}.pd-eyebrow{font:500 12px/1.3 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--pd-accent);margin:0}
.pd-intro h1{font-weight:700;color:var(--pd-display);font-size:clamp(34px,5.4vw,68px);letter-spacing:-.035em;line-height:1.02;margin:12px 0 14px;overflow-wrap:anywhere}.pd-lede{font:italic 22px/1.4 'Instrument Serif',Georgia,serif;max-width:62ch;margin:0}
.pd-hint{color:var(--pd-muted);font-size:13px}.pd-message{min-height:1.5em;color:var(--pd-display)}.pd-message[data-tone=bad]{color:var(--pd-signal)}
.pricing-desk button,.pd-file{background:transparent;color:var(--pd-ink);border:1px solid var(--pd-rule);border-radius:999px;padding:7px 15px;font:inherit;font-size:14px;cursor:pointer;min-height:38px;display:inline-flex;align-items:center;gap:6px;position:relative}
.pricing-desk button:hover,.pd-file:hover{border-color:var(--pd-accent);color:var(--pd-display)}.pricing-desk .pd-primary{background:var(--pd-accent);color:#102107;border-color:var(--pd-accent);font-weight:600}.pricing-desk .pd-quiet{border-color:transparent;color:var(--pd-muted)}
.pricing-desk input,.pricing-desk select{background:var(--pd-field);color:var(--pd-display);border:0;border-bottom:1px solid var(--pd-rule);border-radius:0;padding:6px 4px;font:inherit;min-height:36px;width:100%}.pricing-desk input[type=checkbox]{width:auto;min-height:0;accent-color:var(--pd-accent)}.pricing-desk input[type=file]{position:absolute;width:1px;height:1px;opacity:0}
.pricing-desk label{display:block;font-size:12px;color:var(--pd-muted);margin:8px 0}.pricing-desk code{font:12px 'DM Mono',monospace;color:var(--pd-warn)}
.pd-work{display:grid;grid-template-columns:250px minmax(0,1fr) 300px;gap:28px;border-top:1px solid var(--pd-rule);padding-top:16px}
.pd-nav h2,.pd-main h2,.pd-side h2{color:var(--pd-display);font-size:22px;margin:0 0 6px;letter-spacing:-.02em}
.pd-list{list-style:none;margin:10px 0;padding:0}.pd-list button{display:block;width:100%;text-align:left;border:0;border-radius:0;border-bottom:1px solid #1d2b21;padding:10px 4px;min-height:0;font-weight:600}.pd-list button small{display:block;font:11px 'DM Mono',monospace;color:var(--pd-muted);font-weight:400}
.pd-list button[aria-current=true]{color:var(--pd-accent)}.pd-add{display:flex;gap:6px}
.pd-main{min-width:0}.pd-curve{width:100%;height:auto;display:block;cursor:ew-resize;touch-action:none;user-select:none}
.pd-band{fill:rgba(143,199,214,.12)}.pd-zero{stroke:#2f4334}.pd-volume{fill:none;stroke:#5d7563;stroke-width:2;stroke-dasharray:5 4}.pd-profit{fill:none;stroke:var(--pd-accent);stroke-width:3}.pd-floor{stroke:var(--pd-signal);stroke-dasharray:3 4}
.pd-best{fill:var(--pd-display)}.pd-price{stroke:var(--pd-display);stroke-width:2}.pd-knob{fill:var(--pd-display)}.pd-axis{fill:var(--pd-muted);font:11px 'DM Mono',monospace}
.pd-legend{font-size:12px;color:var(--pd-muted);display:flex;flex-wrap:wrap;gap:4px 14px;align-items:center;margin:4px 0}.pd-k{display:inline-block;width:14px;height:3px;margin-right:4px;vertical-align:middle}.pd-k-profit{background:var(--pd-accent)}.pd-k-volume{border-top:2px dashed #5d7563;height:0}.pd-k-best{width:8px;height:8px;border-radius:50%;background:var(--pd-display)}.pd-k-band{height:8px;background:rgba(143,199,214,.3)}
.pd-readout{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:14px 0;border-top:1px solid var(--pd-rule)}.pd-readout div{padding:10px 0;border-bottom:1px solid var(--pd-rule)}.pd-readout dt{font:500 10px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--pd-muted)}
.pd-readout dd{margin:2px 0 0;font:600 24px 'DM Sans',sans-serif;color:var(--pd-display);letter-spacing:-.02em;font-variant-numeric:tabular-nums}.pd-readout dd.is-loss{color:var(--pd-signal)}.pd-verdict{max-width:70ch}
.pd-table{width:100%;border-collapse:collapse;margin:8px 0;font-variant-numeric:tabular-nums}.pd-table th{font:500 11px 'DM Mono',monospace;color:var(--pd-muted);text-align:left;padding:4px;text-transform:uppercase;letter-spacing:.06em}.pd-table td{padding:3px 4px;border-bottom:1px solid #1d2b21}
.pd-share{display:block;height:8px;width:var(--w);background:var(--pd-accent);border-radius:4px;min-width:2px}
.pd-three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.pd-pills{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:12px 0}.pd-check{display:inline-flex!important;gap:6px;align-items:center;font-size:14px!important;color:var(--pd-ink)!important}
.pd-side{border-left:1px solid var(--pd-rule);padding-left:20px}.pd-side fieldset{border:0;border-top:1px solid var(--pd-rule);margin:12px 0 0;padding:8px 0 0}.pd-side legend{font:500 11px 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--pd-accent);padding-right:8px}
.pd-foot{color:var(--pd-muted);font-size:13px;margin-top:36px;max-width:80ch}
@media(max-width:1100px){.pd-work{grid-template-columns:220px minmax(0,1fr)}.pd-side{grid-column:1/-1;border-left:0;border-top:1px solid var(--pd-rule);padding-left:0}}
@media(max-width:720px){.pricing-desk{padding:16px}.pd-work{grid-template-columns:minmax(0,1fr)}.pd-readout{grid-template-columns:repeat(2,minmax(0,1fr))}.pd-three{grid-template-columns:1fr}}
.instrument-store{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:end;padding:10px 0;border-bottom:1px solid #2a3a2e;font-size:13px;color:#9aa89b}.instrument-store label{display:flex;flex-direction:column;font-size:12px;flex:1 1 200px}.instrument-store .is-where{font:500 11px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:#b5df32;align-self:center}.instrument-store select{width:auto!important}
