.creator-workspace{background:#131715;color:#ecf1eb;min-height:100vh;font:16px/1.55 system-ui,sans-serif;padding:24px}.creator-workspace *{box-sizing:border-box}.creator-top{max-width:1000px;margin:auto;display:flex;justify-content:space-between;gap:20px;font-size:14px}.creator-top a{color:#b8d8be;min-height:44px;display:flex;align-items:center}.creator-body{max-width:900px;margin:48px auto}.creator-body h1{font-size:clamp(32px,6vw,54px);letter-spacing:-.04em;line-height:1.1;margin:12px 0 20px}.creator-eyebrow{color:#a9c3ae;text-transform:uppercase;font-size:12px;letter-spacing:.14em}.creator-muted{color:#a8b3a9}.creator-panel{border:1px solid #35433a;border-radius:18px;background:#1c231f;padding:24px;margin:28px 0}.creator-panel canvas{display:block;width:100%;height:180px}.creator-track{display:grid;grid-template-columns:90px 1fr 48px;gap:12px;align-items:center;margin:18px 0}.creator-track input{width:100%;min-height:44px;accent-color:#a8d4ad}.creator-track output{font-variant-numeric:tabular-nums}.creator-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.creator-workspace button{background:#a8d4ad;color:#102416;border:0;padding:10px 18px;border-radius:8px;font:inherit;cursor:pointer;min-height:44px}.creator-workspace button:disabled{opacity:.4;cursor:default}.creator-workspace button.secondary{background:#35433a;color:#ecf1eb}.creator-workspace a:focus-visible,.creator-workspace button:focus-visible,.creator-workspace input:focus-visible{outline:3px solid #90c5d5;outline-offset:3px}.creator-footer{font-size:14px;color:#a8b3a9}.creator-message{min-height:1.6em;margin-top:16px}.creator-clock{display:flex;justify-content:space-between;color:#a8b3a9;font-size:12px}@media(max-width:500px){.creator-workspace{padding:16px}.creator-body{margin-top:28px}.creator-panel{padding:16px}.creator-track{grid-template-columns:65px 1fr 42px;gap:8px}.creator-actions button{flex:1 1 auto}}

.creator-workspace [hidden]{display:none!important}.creator-workspace button[aria-pressed=true]{outline:2px solid #b8d8be;outline-offset:3px}.creator-workspace h2{font-size:23px;margin-top:0}.creator-workspace h3{font-size:16px;margin:0;overflow-wrap:anywhere}.creator-body{max-width:1000px;margin-top:28px}.creator-body h1{font-size:clamp(30px,4vw,44px)}.creator-field{display:block;margin:22px 0;font-size:14px}.creator-field input,.creator-field select,.creator-clip-fields input[type=number]{display:block;width:100%;margin-top:7px;min-height:44px;border:1px solid #526356;border-radius:6px;background:#131715;color:#ecf1eb;padding:10px;font:inherit}.creator-field select{white-space:normal}.creator-file{display:block;font-weight:600}.creator-file input{display:block;width:100%;margin:14px 0;min-height:44px;font:inherit}.creator-source{border-top:1px solid #35433a;padding:18px 0}.creator-source strong,.creator-source span{display:block;overflow-wrap:anywhere}.creator-source span,.creator-source details{font-size:13px;color:#a8b3a9;margin-top:8px}.creator-source summary{cursor:pointer;min-height:30px}.creator-source code{display:block;overflow-wrap:anywhere;font-size:11px}.creator-session-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.creator-session-heading>span{white-space:nowrap;color:#a8b3a9;font-size:13px}.creator-session-heading h2{margin:0}.creator-clip{border:1px solid #35433a;background:#131715;border-radius:8px;padding:18px;margin-top:18px}.creator-clip canvas{height:36px;margin:16px 0;display:block;width:100%}.creator-mute{display:flex;gap:8px;align-items:center;white-space:nowrap;font-size:13px;min-height:44px}.creator-mute input{width:20px;height:20px}.creator-clip-fields{display:grid;grid-template-columns:1fr 1fr 1fr 1.5fr;gap:16px}.creator-clip-fields label{font-size:12px;min-width:0}.creator-clip-fields input{width:100%;min-width:0;min-height:44px;accent-color:#a8d4ad}.creator-clip-fields output{margin-left:8px;font-variant-numeric:tabular-nums}.creator-workspace [data-audio=saved]{align-self:center;font-size:13px}.creator-workspace [data-audio=status]{overflow-wrap:anywhere}.creator-workspace [data-audio=levels]{font-size:13px}.creator-workspace [data-audio=files]::file-selector-button{background:#a8d4ad;border:0;border-radius:6px;padding:12px;margin-right:10px;cursor:pointer}.creator-workspace select:focus-visible{outline:3px solid #90c5d5;outline-offset:3px}
@media(max-width:650px){.creator-clip-fields{grid-template-columns:1fr 1fr;gap:10px}.creator-clip{padding:12px}.creator-session-heading{align-items:start}.creator-session-heading h2{font-size:20px}.creator-workspace [data-audio=workspace]>.creator-actions button{padding:10px 12px;font-size:14px}.creator-workspace [data-audio=workspace] .creator-panel{padding:16px 12px}}

.creator-workspace button[aria-pressed=false]{background:#35433a;color:#ecf1eb}.creator-footer{margin-top:24px}

/* Arrangement and source inspector share the existing audio workspace. */
.creator-body{max-width:1320px;margin-top:12px}.creator-top{max-width:1320px}.creator-body h1{font-size:28px;margin:6px 0 12px}.creator-eyebrow{margin:0}.creator-panel{margin:16px 0;padding:20px}.creator-message{font-size:13px;margin:12px 0}.creator-transport{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:18px 0 10px}.creator-transport>output{font:20px ui-monospace,monospace;font-variant-numeric:tabular-nums;min-width:112px;color:#d7efdb}.creator-seek{display:flex;align-items:center;gap:8px;flex:1;min-width:140px;font-size:12px;color:#a8b3a9}.creator-seek input{width:100%;accent-color:#a8d4ad}.creator-timeline-tools{display:flex;gap:20px;align-items:center;justify-content:flex-end;flex-wrap:wrap;margin:4px 0 12px;font-size:12px;color:#b3c0b6}.creator-timeline-tools label{display:flex;align-items:center;gap:8px;min-height:44px}.creator-timeline-tools input{accent-color:#a8d4ad}.creator-timeline-tools input[type=range]{width:100px}.creator-timeline-tools button{font-size:12px;padding:6px 12px}.creator-arrangement{--timeline-width:100%;border:1px solid #3c4c41;border-radius:10px;overflow:hidden;background:#111713}.creator-ruler-row{display:grid;grid-template-columns:170px minmax(0,1fr);border-bottom:1px solid #3c4c41}.creator-ruler-row>span{padding:12px 16px;font-size:12px;color:#a8b3a9}.creator-ruler-scroll,.creator-lane-scroll{overflow-x:auto;min-width:0;scrollbar-width:thin;scrollbar-color:#526356 #131715}.creator-ruler{width:var(--timeline-width);height:42px;position:relative;cursor:crosshair;background:repeating-linear-gradient(90deg,#43534844 0 1px,transparent 1px 5%)}.creator-ruler span{position:absolute;top:11px;font:11px ui-monospace,monospace;color:#b0bdb3;padding-left:5px}.creator-lane{display:grid;grid-template-columns:170px minmax(0,1fr);border-bottom:1px solid #35433a}.creator-lane:last-child{border:0}.creator-lane-label{padding:10px 12px;border-right:1px solid #35433a;background:#1c231f;border-left:3px solid var(--track-color);min-width:0}.creator-workspace .creator-select-track{background:transparent;color:#ecf1eb;border:0;padding:0;text-align:left;font-size:13px;font-weight:600;min-height:32px;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;outline:0}.creator-workspace .creator-select-track:focus-visible{outline:2px solid #90c5d5}.creator-lane[data-selected=true] .creator-lane-label{background:#2b3a30}.creator-lane-label .creator-mute{min-height:32px;font-size:11px}.creator-lane-label .creator-mute input{width:15px;height:15px;accent-color:var(--track-color)}.creator-lane-track{width:var(--timeline-width);height:98px;position:relative;background:repeating-linear-gradient(90deg,#43534833 0 1px,transparent 1px 5%)}.creator-clip-block{position:absolute;top:11px;height:75px;min-width:4px;background:color-mix(in srgb,var(--track-color) 13%,#131715);border:1px solid var(--track-color);border-radius:5px;display:flex;align-items:stretch;overflow:hidden}.creator-lane[data-selected=true] .creator-clip-block{box-shadow:0 0 0 1px var(--track-color)}.creator-clip-block[data-muted=true]{opacity:.35}.creator-workspace .creator-clip-move{position:relative;flex:1;min-width:0;padding:3px 10px;color:var(--track-color);background:transparent;border-radius:0;cursor:grab;touch-action:none;overflow:hidden;text-align:left;font-size:10px;white-space:nowrap}.creator-clip-move>span:first-child{display:block;overflow:hidden;text-overflow:ellipsis;max-width:100%;padding-right:35px}.creator-clip-move>[data-clip-time]{position:absolute;right:7px;top:4px;font-size:9px}.creator-clip-move canvas{height:44px!important;margin:0!important;width:100%}.creator-workspace .creator-trim{position:absolute;top:0;bottom:0;z-index:2;width:10px;min-height:0;padding:0;background:transparent;border-radius:0;cursor:ew-resize;touch-action:none}.creator-trim.start{left:0;border-left:3px solid var(--track-color)}.creator-trim.end{right:0;border-right:3px solid var(--track-color)}.creator-playhead{position:absolute;left:0;top:0;bottom:0;border-left:1px solid #f4f0c4;pointer-events:none;z-index:3}.creator-lane .creator-clip-fields{grid-column:1/-1;padding:12px 18px;background:#202c24;border-top:1px solid #35433a;margin:0;grid-template-columns:repeat(3,minmax(0,1fr)) minmax(0,1.4fr)}.creator-source-editor{margin-top:18px;border:1px solid #35433a;border-radius:10px;padding:14px 18px;background:#141c17}.creator-source-editor h3{color:#dcebe0;font-size:13px}.creator-source-editor .creator-session-heading span{font-size:11px}.creator-source-editor [data-audio=source-wave]{margin-top:12px;min-height:96px}.creator-source-editor [data-audio=wave-state]{margin:8px 0 0;font-size:11px}.creator-source-editor ::part(region-handle){width:10px!important;border-color:#cce8cc!important}.creator-footer{font-size:12px}.creator-workspace button:focus-visible{outline:3px solid #90c5d5;outline-offset:2px}
@media(max-width:650px){.creator-ruler-row,.creator-lane{grid-template-columns:100px minmax(0,1fr)}.creator-lane-label{padding:8px}.creator-workspace .creator-select-track{font-size:11px}.creator-arranger{padding:12px!important}.creator-lane .creator-clip-fields{grid-template-columns:1fr 1fr;padding:10px;gap:8px}.creator-transport{gap:8px}.creator-transport button{padding:8px 12px;font-size:12px}.creator-seek{order:2;flex-basis:100%}.creator-timeline-tools{gap:8px;justify-content:space-between}.creator-timeline-tools label{font-size:11px}.creator-timeline-tools input[type=range]{width:60px}.creator-source-editor{padding:12px}.creator-session-heading{flex-wrap:wrap;gap:6px}.creator-workspace{padding:12px}.creator-body h1{font-size:26px}.creator-clip-move>span:first-child{visibility:hidden}}

.creator-arrangement [data-audio=tracks]{display:grid;grid-template-columns:170px minmax(0,1fr)}.creator-lane{display:contents}.creator-lane-label,.creator-lane-scroll{grid-row:var(--track-row);border-bottom:1px solid #35433a}.creator-lane-label{grid-column:1}.creator-lane-scroll{grid-column:2}.creator-lane .creator-clip-fields{grid-row:calc(var(--track-count) + 1)}.creator-workspace .creator-select-track[aria-pressed]{outline:0;background:transparent}.creator-workspace .creator-select-track:focus-visible{outline:2px solid #90c5d5}.creator-workspace nav.creator-actions{margin-top:12px;gap:4px}.creator-workspace nav.creator-actions button{font-size:13px;min-height:36px;padding:6px 14px;border-radius:6px;outline:0}.creator-workspace nav.creator-actions button[aria-pressed=true]{background:#a8d4ad;color:#102416}.creator-workspace nav.creator-actions button:focus-visible{outline:2px solid #90c5d5}.creator-body h1{font-size:26px;margin:6px 0}.creator-arranger{margin-top:10px}.creator-arranger h2{font-size:18px}.creator-source-editor [data-audio=source-wave]{min-height:72px}.creator-top{font-size:12px}.creator-body .creator-eyebrow{font-size:10px}.creator-session-heading>span[data-audio=track-count]{margin-left:auto}.creator-lane-track{height:90px}.creator-clip-block{top:7px}.creator-timeline-tools{margin-bottom:8px}.creator-transport{margin-top:10px}.creator-workspace [data-audio=levels]{margin-bottom:0}
