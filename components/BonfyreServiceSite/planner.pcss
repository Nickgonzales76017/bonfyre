/*! Generated from components/BonfyreServiceSite/planner.pcss; do not edit this output. */
.fixture-planner{--red:#b5282c;--ink:#292a28;--muted:#676a64;--line:#dddfd8;--paper:#f8f8f3;font:14px/1.5 Manrope,Arial,sans-serif;color:var(--ink);background:var(--paper);min-height:100vh}.fixture-planner *{box-sizing:border-box}.fixture-planner [hidden]{display:none!important}.fixture-planner h1,.fixture-planner h2,.fixture-planner h3,.fixture-planner p{margin:0}.fixture-planner h1{font-size:clamp(30px,3.4vw,48px);font-weight:600;letter-spacing:-1.6px;line-height:1.15;margin:9px 0 14px}.fixture-planner h2{font-size:20px;font-weight:600;letter-spacing:-.4px}.fixture-planner h3{font-size:14px;font-weight:600}.fixture-planner button{border:1px solid #cbd0c7;background:#fff;border-radius:5px;padding:11px 14px;min-height:44px;font:inherit;font-weight:600;cursor:pointer;color:var(--ink);transition:background .15s}.fixture-planner button:hover{background:#efefe7}.fixture-planner button:disabled{opacity:.5;cursor:default}.fixture-planner button:focus-visible,.fixture-planner input:focus-visible,.fixture-planner textarea:focus-visible,.fixture-planner a:focus-visible{outline:3px solid #d06a33;outline-offset:3px}.fixture-planner .fp-primary{background:var(--red);color:white;border-color:var(--red);display:flex;justify-content:space-between}.fixture-planner .fp-primary:hover{background:#952025}.fixture-planner input,.fixture-planner textarea{display:block;width:100%;border:1px solid #cbd0c7;background:white;border-radius:4px;padding:10px;font:inherit;color:var(--ink);min-width:0}.fixture-planner textarea{resize:vertical}.fixture-planner a{color:inherit;text-underline-offset:3px}.fp-header{display:flex;align-items:center;gap:28px;border-bottom:1px solid var(--line);height:86px;padding:0 4vw;background:white}.fp-header>a:last-child{margin-left:auto;font-size:12px;color:var(--muted)}.fp-brand{display:flex;align-items:center;gap:9px;text-decoration:none}.fp-brand>span{font-size:42px;font-weight:800;letter-spacing:-3px;line-height:1}.fp-red{color:var(--red)}.fp-brand small{border-left:1px solid #ccc;padding-left:10px;letter-spacing:2px;font-size:10px}.fp-header-label{font-size:12px;color:var(--muted);border-left:1px solid var(--line);padding-left:28px}.fp-intro{padding:34px 4vw 25px;display:flex;align-items:end;justify-content:space-between;gap:22px}.fp-intro p:not(.fp-eyebrow){max-width:610px;color:var(--muted);font-size:15px}.fp-eyebrow{font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:var(--muted)}.fp-save{display:flex;gap:14px;align-items:center;flex-shrink:0}.fp-save span{color:var(--muted);font-size:11px;max-width:170px}.fp-work{margin:0 4vw;display:grid;grid-template-columns:240px minmax(0,1fr) 270px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}.fp-sidebar{padding:24px 20px;border-right:1px solid var(--line);background:#fcfcf8}.fp-fields{display:grid;gap:14px}.fp-fields h2{margin-bottom:4px}.fp-fields label,.fp-position label,.fp-summary label{font-size:11px;font-weight:600;display:grid;gap:6px}.fp-fields input,.fp-fields textarea{font-size:13px}.fp-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fp-preset{margin-top:25px;padding-top:20px;border-top:1px solid var(--line)}.fp-preset .fp-pair{margin-top:10px}.fp-preset button{font-size:11px;padding:8px}.fp-preset p{font-size:11px;color:var(--muted);margin-top:8px}.fp-center{min-width:0;padding:22px}.fp-canvas-heading{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:20px}.fp-canvas-heading span{font-size:12px;color:var(--muted)}.fp-board{background:#f1f2eb;border:1px solid #e5e6dd;border-radius:5px}.fp-board svg{display:block;width:100%;max-height:450px}.fp-legend{display:flex;flex-wrap:wrap;gap:14px;font-size:10px;color:var(--muted);margin:16px 0 10px}.fp-legend span{display:flex;align-items:center;gap:5px}.fp-legend i{width:12px;height:9px;border:1px solid #758174;background:#d4ddcd}.fp-legend .fp-dashed{border:1px dashed #a78648;background:#f5ead0}.fp-caption{font-size:11px;color:var(--muted)}.fp-position{margin-top:17px;padding-top:14px;border-top:1px solid var(--line)}.fp-position strong{font-size:12px}.fp-position-inputs{display:grid;grid-template-columns:1fr 1fr auto auto;gap:8px;align-items:end;margin-top:8px}.fp-position button{font-size:11px;padding:9px}.fp-position small{font-size:10px;color:var(--muted);display:block;margin-top:8px}.fp-issues{padding-left:17px;color:#914414;font-size:12px;margin-top:15px}.fp-summary{padding:24px 20px;border-left:1px solid var(--line);background:#fcfcf8}.fp-selection{margin:18px 0}.fp-selection button{display:flex;align-items:center;text-align:left;gap:10px;width:100%;border:0;border-bottom:1px solid var(--line);border-radius:0;padding:12px 0;background:transparent;min-height:58px}.fp-selection button[aria-pressed=true]{color:var(--red)}.fp-selection img{height:42px;width:42px;object-fit:contain;mix-blend-mode:multiply}.fp-selection b{font-size:11px;font-weight:600;line-height:1.4;display:block}.fp-selection small{color:var(--muted);font-size:10px;display:block}.fp-total{padding:16px 0 20px;border-top:1px solid var(--line)}.fp-total>span{font-size:11px;color:var(--muted)}.fp-total>strong{display:block;font-size:29px;font-weight:500;letter-spacing:-1px;margin:2px 0 6px}.fp-total p{font-size:11px;margin-bottom:8px}.fp-total small,.fp-small{font-size:10px;line-height:1.6;color:var(--muted)}.fp-summary>button{width:100%;margin-bottom:8px;font-size:12px}.fp-summary>label{margin-top:12px}.fp-summary>p{margin-top:3px}.fp-collection{padding:36px 4vw}.fp-collection h2{font-size:27px;margin:6px 0}.fp-collection>div>p:last-child{color:var(--muted);font-size:12px}.fp-products{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:20px}.fp-product{background:#fff;border:1px solid var(--line);border-radius:7px;overflow:hidden;display:flex;flex-direction:column}.fp-photo{height:190px;background:#fff;padding:18px}.fp-photo img{height:100%;width:100%;object-fit:contain}.fp-product-body{padding:18px;display:flex;flex-direction:column;flex:1}.fp-product h3{font-size:15px;margin:5px 0}.fp-product .fp-use{color:var(--red);font-size:10px;letter-spacing:1.2px;text-transform:uppercase}.fp-product p{font-size:11px;color:var(--muted);margin-bottom:8px}.fp-product a{font-size:10px;margin:6px 0 14px;color:var(--muted)}.fp-product .fp-price{font-size:16px;font-weight:600;color:var(--ink)}.fp-product button{margin-top:auto;font-size:12px}.fp-footer{border-top:1px solid var(--line);padding:20px 4vw;display:flex;justify-content:space-between;gap:16px;font-size:11px;color:var(--muted)}.fp-message{margin:0 4vw 12px!important;min-height:20px;color:#356142;font-size:12px}.fp-error{margin:0 4vw 12px;padding:13px;border:1px solid #dfada0;border-radius:5px;background:#fff0e9;color:#862d21}.fp-dialog{border:1px solid var(--line);border-radius:9px;max-width:760px;width:calc(100% - 32px);padding:28px;color:var(--ink);max-height:90vh}.fp-dialog::backdrop{background:#20241be0}.fp-dialog-head{display:flex;justify-content:space-between;align-items:start;margin-bottom:20px;gap:15px}.fp-dialog-head h2{font-size:28px;margin-top:7px}.fp-dialog>p{font-size:12px;color:var(--muted)}.fp-dialog pre{font:12px/1.7 Manrope,Arial,sans-serif;white-space:pre-wrap;overflow-wrap:anywhere;background:var(--paper);border:1px solid var(--line);padding:20px;margin:18px 0;max-height:35vh;overflow:auto}.fp-dialog .fp-fields{margin-top:25px;padding-top:20px;border-top:1px solid var(--line)}.fp-dialog .fp-fields small{font-size:11px;color:var(--muted)}.fp-dialog [data-ui=receipt]{overflow-wrap:anywhere;font-size:12px}.fp-board [data-item]{cursor:pointer;outline:none}.fp-board [data-item]:focus-visible rect{stroke:var(--red);stroke-width:3px}
@media(min-width:1700px){.fp-work{grid-template-columns:280px minmax(0,1fr) 310px}.fp-board svg{max-height:550px}}
@media(max-width:1100px){.fp-work{grid-template-columns:220px minmax(0,1fr)}.fp-summary{grid-column:1/-1;border-left:0;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:12px 25px}.fp-summary>.fp-eyebrow,.fp-summary>.fp-selection{grid-column:1}.fp-summary .fp-total{grid-column:2;grid-row:1/3;border:0;padding:0}.fp-selection{margin:0}.fp-summary>button{margin:0}.fp-summary .fp-small{grid-column:1/-1}.fp-position-inputs{grid-template-columns:1fr 1fr}.fp-products{grid-template-columns:repeat(2,1fr)}}
@media(max-width:650px){.fp-header{height:68px;padding:0 18px;gap:12px}.fp-brand>span{font-size:34px}.fp-brand small{font-size:8px}.fp-header-label{display:none}.fp-header>a:last-child{font-size:10px}.fp-intro{padding:25px 18px 16px;display:block}.fp-intro p:not(.fp-eyebrow){font-size:13px}.fp-save{justify-content:space-between;margin-top:20px}.fp-work{margin:0 14px;display:flex;flex-direction:column}.fp-center{order:0;padding:18px 13px}.fp-sidebar{order:1;border-right:0;border-top:1px solid var(--line);padding:20px}.fp-summary{order:2;display:block;padding:20px}.fp-summary .fp-selection{margin:15px 0}.fp-summary .fp-total{padding:14px 0}.fp-summary>button{margin-bottom:10px}.fp-collection{padding:28px 14px}.fp-products{gap:10px}.fp-photo{height:130px;padding:12px}.fp-product-body{padding:12px}.fp-product h3{font-size:13px}.fp-product p{font-size:10px}.fp-product button{font-size:11px;padding:9px}.fp-footer{padding:18px;display:block}.fp-footer a{display:block;margin-top:8px}.fp-dialog{padding:18px}.fp-dialog pre{padding:12px}.fp-dialog .fp-pair{grid-template-columns:1fr}.fp-position-inputs{grid-template-columns:1fr 1fr}.fp-board svg{max-height:none}.fp-canvas-heading h2{font-size:17px}.fp-legend{gap:8px;font-size:9px}.fp-collection h2{font-size:23px}}
@media print{body>*{display:none}body>main{display:block}.fixture-planner,.fixture-planner dialog[open],.fixture-planner dialog[open] pre{display:block!important;position:static;max-height:none;overflow:visible;width:100%;border:0}.fixture-planner>*:not(dialog),.fp-dialog button,.fp-dialog form,.fp-dialog>.fp-pair{display:none!important}.fp-dialog::backdrop{background:white}}

/* Workspace views keep layout, selection and cross-project decisions separate. */
.fp-workspace-nav{display:flex;gap:8px;flex-wrap:wrap;margin:0 4vw 20px}.fp-workspace-nav button[aria-current=page]{background:var(--ink);color:white;border-color:var(--ink)}.fp-projects{margin:0 4vw 32px}.fp-section-heading{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-bottom:24px}.fp-section-heading p{color:var(--muted);margin-top:6px;font-size:13px}.fp-project-search{display:flex;gap:10px;align-items:end;margin:20px 0;max-width:550px}.fp-project-search label{flex:1;min-width:0;font-size:12px}.fp-project-search input{margin-top:6px}.fp-project-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px}.fp-project-card{min-width:0;border:1px solid var(--line);border-radius:8px;background:white;padding:22px;overflow-wrap:anywhere}.fp-project-card h3{font-size:19px}.fp-project-card p,.fp-project-card small{display:block;font-size:12px;color:var(--muted);margin:8px 0}.fp-project-card strong{display:block;font-size:25px;margin:12px 0}.fp-project-card .fp-pair{margin-top:18px}.fp-project-card h4{margin:22px 0 6px}.fp-project-card ul{font-size:12px;padding-left:18px}.fp-project-card details{margin-top:16px;font-size:12px}.fp-project-card summary{cursor:pointer;min-height:30px}.fp-empty{padding:30px;background:white;border:1px dashed var(--line)}.fp-compare-selectors{margin:20px 0;max-width:850px}.fp-compare-selectors label{min-width:0;font-size:12px}.fixture-planner select{display:block;width:100%;min-width:0;min-height:44px;margin-top:8px;padding:10px;font:inherit;background:white;border:1px solid var(--line);border-radius:5px}.fp-comparison-plans{display:grid;grid-template-columns:1fr 1fr;gap:18px}.fp-comparison-delta{font-size:17px;margin:20px 0!important}.fp-table-wrap{overflow:auto;border:1px solid var(--line);margin:22px 0;background:white}.fp-table-wrap table{border-collapse:collapse;width:100%;font-size:12px}.fp-table-wrap caption{text-align:left;font-weight:600;padding:16px}.fp-table-wrap td,.fp-table-wrap th{padding:14px;text-align:left;border-top:1px solid var(--line);min-width:90px;max-width:250px;overflow-wrap:anywhere}.fp-table-wrap th small{display:block;font-weight:400;color:var(--muted)}.fp-projects>p{font-size:12px;color:var(--muted)}.fixture-planner h1{font-size:clamp(26px,3vw,38px)}.fp-intro{padding-top:24px}.fp-sidebar [data-ui=duplicate-project]{font-size:11px}.fp-collection{padding-top:4px}
@media(max-width:650px){.fp-projects,.fp-workspace-nav{margin-left:14px;margin-right:14px}.fp-workspace-nav{display:grid;grid-template-columns:1fr 1fr}.fp-workspace-nav button{font-size:12px;padding:10px}.fp-section-heading{display:block}.fp-section-heading>button{margin-top:14px}.fp-comparison-plans{grid-template-columns:1fr}.fp-project-card{padding:18px}.fp-table-wrap td,.fp-table-wrap th{padding:10px}.fp-intro h1{letter-spacing:-.8px}}

.fp-spatial{width:100%;min-height:340px;touch-action:none;outline:none;overflow:hidden}.fp-spatial:focus-visible{outline:3px solid #d06a33;outline-offset:2px}.fp-spatial-toolbar,.fp-spatial-actions{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:12px}.fp-spatial-toolbar button,.fp-spatial-actions button{font-size:11px;min-height:36px;padding:6px 9px}.fp-spatial-toolbar output{font:11px ui-monospace,monospace;min-width:40px;text-align:center}.fp-spatial-toolbar [data-ui=pan][aria-pressed=true]{background:var(--ink);color:white}.fp-spatial-actions{margin:12px 0}.fp-spatial-actions>span{font-size:11px;color:var(--muted);margin-right:auto}.fp-quick-add{display:grid;gap:5px;margin-top:12px}.fp-quick-add button{text-align:left;font-size:11px;padding:7px 9px;min-height:34px}.fp-intro{padding:18px 3vw 10px}.fixture-planner h1{font-size:28px;margin:6px 0 0}.fp-header{height:68px;padding:0 3vw}.fp-header-label{font-size:11px}.fp-work{margin:0 3vw;grid-template-columns:210px minmax(0,1fr) 240px}.fp-workspace-nav{margin:0 3vw 14px}.fp-sidebar,.fp-summary{padding:18px 14px}.fp-center{padding:18px 14px}.fp-canvas-heading{margin-bottom:12px}.fp-canvas-heading h2{font-size:18px}.fp-selection{margin:12px 0}.fp-message:empty{min-height:0;margin-bottom:4px!important}.fp-legend{margin-top:12px}.fp-position{margin-top:12px}.fp-fields{gap:12px}.fp-fields textarea{min-height:70px}.fp-selection button:focus-visible{outline:3px solid #d06a33;outline-offset:2px}
@media(max-width:1100px){.fp-work{grid-template-columns:190px minmax(0,1fr)}.fp-summary{grid-template-columns:1fr 1fr}.fp-quick-add{grid-column:1}.fp-summary .fp-total{grid-row:1/4}.fp-spatial-toolbar button{padding:6px 8px}}
@media(max-width:650px){.fp-work{margin:0 12px;display:flex}.fp-intro{padding:18px 14px 12px}.fp-header{padding:0 14px}.fp-center{padding:14px 10px}.fp-spatial-toolbar{gap:4px}.fp-spatial-toolbar button,.fp-spatial-actions button{min-height:44px;padding:7px;font-size:11px}.fp-spatial-actions>span{flex-basis:100%}.fp-save{margin-top:12px}.fp-quick-add{grid-template-columns:1fr 1fr}.fp-summary{display:block}.fp-sidebar{padding:18px}.fp-workspace-nav{margin-left:12px;margin-right:12px}}

@media(max-width:650px){.fp-spatial{min-height:300px}}

/* Keep totals within reach when a room has many fixtures. */
.fp-selection{max-height:360px;overflow:auto;overscroll-behavior:contain;padding:3px;scrollbar-gutter:stable}
