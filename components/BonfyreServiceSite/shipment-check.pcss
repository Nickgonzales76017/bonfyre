/*! Generated from components/BonfyreServiceSite/shipment-check.pcss; do not edit this output. */
.shipment-check{background:#131715;color:#ecf1eb;min-height:100vh;font:15px/1.5 system-ui,sans-serif;padding:24px}
.shipment-check *{box-sizing:border-box}.shipment-check [hidden]{display:none!important}
.shipment-check a{color:#c9f26b}.shipment-check small{display:block;color:#9fb0a4;font-size:12px;margin-top:2px}
.sc-top{display:flex;justify-content:space-between;gap:16px;max-width:1320px;margin:0 auto 8px;font-size:14px}
.sc-body{max-width:1320px;margin:0 auto}.sc-eyebrow{color:#9fb0a4;text-transform:uppercase;letter-spacing:.08em;font-size:12px;margin:12px 0 4px}
.sc-body h1{font-size:30px;margin:0 0 6px;font-weight:600}.sc-lede{max-width:760px;color:#cbd6cd;margin:0 0 20px}
.sc-steps{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-bottom:20px}
.sc-card{background:#1b211e;border:1px solid #2c3630;border-radius:12px;padding:16px}.sc-card h2{font-size:17px;margin:0 0 8px}
.sc-card textarea{width:100%;min-height:118px;background:#101412;color:#ecf1eb;border:1px solid #34413a;border-radius:8px;padding:10px;font:13px/1.45 ui-monospace,monospace;resize:vertical}
.sc-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}
.shipment-check button,.sc-file span{background:#c9f26b;color:#10140f;border:0;border-radius:8px;padding:9px 14px;font:600 14px system-ui,sans-serif;cursor:pointer}
.shipment-check button.sc-secondary,.sc-file span{background:#2a342e;color:#ecf1eb}.shipment-check button:disabled{background:#2a342e;color:#6f7d73;cursor:not-allowed}
.shipment-check button:focus-visible,.shipment-check select:focus-visible,.shipment-check input:focus-visible,.shipment-check textarea:focus-visible{outline:2px solid #c9f26b;outline-offset:2px}
.sc-file{position:relative;display:inline-block}.sc-file input{position:absolute;inset:0;opacity:0;cursor:pointer}
.sc-drop{border:1.5px dashed #46564c;border-radius:10px;padding:22px;text-align:center;color:#cbd6cd}.sc-drop.sc-over{border-color:#c9f26b;background:#1f2a20}
.sc-status{color:#9fb0a4;font-size:13px;margin:8px 0 0}.sc-bad{color:#ffb4a4}
.sc-empty{color:#9fb0a4;border:1px solid #2c3630;border-radius:12px;padding:20px}
.sc-filters{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 12px}
.shipment-check .sc-filters button{background:#1b211e;color:#ecf1eb;border:1px solid #2c3630;display:flex;gap:8px;align-items:baseline;font-weight:500}
.shipment-check .sc-filters button[aria-pressed=true]{border-color:#c9f26b;background:#222c22}.sc-n{font-weight:700;font-size:16px}
.sc-table-wrap{overflow-x:auto;border:1px solid #2c3630;border-radius:12px}
.sc-table{width:100%;border-collapse:collapse;min-width:900px}.sc-table th{text-align:left;font-size:12px;color:#9fb0a4;font-weight:600;padding:10px;border-bottom:1px solid #2c3630;background:#171c19}
.sc-table td{padding:10px;border-bottom:1px solid #232b26;vertical-align:top}.sc-table tr:last-child td{border-bottom:0}
.sc-table select,.sc-table input{background:#101412;color:#ecf1eb;border:1px solid #34413a;border-radius:6px;padding:6px 8px;font:13px system-ui,sans-serif;max-width:170px}
.sc-name{font:12px/1.4 ui-monospace,monospace;color:#cbd6cd;word-break:break-all;max-width:260px}
.sc-badge{display:inline-block;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:600}
.sc-ready{background:#2f4a22;color:#d6f5a6}.sc-duplicate{background:#3a3524;color:#f1dc9c}.sc-unmatched,.sc-date-needs-review,.sc-type-needs-review{background:#4a2b26;color:#ffc4b4}
.sc-actions{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
.sc-missing{margin-top:18px}.sc-missing ul{margin:6px 0 0;padding-left:18px;color:#ffc4b4}
.sc-foot{color:#9fb0a4;font-size:13px;margin-top:24px}
@media(max-width:760px){.sc-table-wrap{border:0;overflow:visible}.sc-table{min-width:0}.sc-table thead{display:none}
.sc-table,.sc-table tbody,.sc-table tr,.sc-table td{display:block;width:100%}
.sc-table tr{background:#1b211e;border:1px solid #2c3630;border-radius:12px;padding:12px;margin-bottom:10px}
.sc-table td{border:0;padding:6px 0;display:grid;grid-template-columns:110px minmax(0,1fr);gap:8px;align-items:start}
.sc-table td:first-child{display:block;padding-top:0;font-weight:600}.sc-table td[data-label]::before{content:attr(data-label);color:#9fb0a4;font-size:12px;padding-top:6px}
.sc-table td > *{grid-column:2}.sc-table td > .sc-badge{justify-self:start}.sc-table select,.sc-table input{max-width:100%;width:100%}.sc-name{max-width:none}
.shipment-check{padding:16px}.sc-steps{grid-template-columns:1fr}.sc-body h1{font-size:24px}.sc-top{flex-direction:column;gap:4px}}
