  source_path components/BonfyreServiceSite/tests/campaign-composer.test.mjs
  source_path components/BonfyreServiceSite/tests/campaign-persistence-browser.mjs
  source_path components/BonfyreServiceSite/tests/campaign-persistence-native.mjs
