#!/usr/bin/env python3
"""Compile Aurekai's supplied external estate into a lossless candidate corpus.

This is a *source compiler*, not an external-provider runtime and not a
semantic owner.  It preserves each supplied occurrence (including raw source
lines) and adds deliberately non-authoritative, breadth-oriented composition
candidates.  Admission, capability closure, authority, evidence, settlement,
and effects remain owned by their existing Bonfyre organs.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
from collections import Counter
from pathlib import Path
from typing import Any, Iterable


