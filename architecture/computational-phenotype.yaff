atlas computational-phenotype
# The ComputationalPhenotype contract. Every substrate declares WHAT KIND of
# computation it is -- what it consumes and produces, whether it is
# deterministic / incremental / distributed / retraction-capable, its proof
# class and its effect class -- so ProviderGraph and the closure machinery can
# reason about Feldera and Tract through the same capability contract even though
# they do completely different things. A phenotype is not another architecture;
# it is how an execution phenotype presents itself to the selector.
#
# A phenotype block: `phenotype <id>` with `architecture <substrate-id>`, at
# least one `produces`, and the boolean/enum fields below. atlas.py validates
# that the architecture is registered and that produces is named; loss() flags
# any substrate lacking a phenotype.

phenotype yaff-phenotype
  architecture yaff
  produces SemanticContract
  consumes TypedCut
  deterministic yes
  incremental no
  distributed no
  supports_retraction no
  proof_class none
  effect_class none
  witness_schema ContractDigest

phenotype automerge-phenotype
  architecture automerge
  produces CandidateState
  deterministic no
  incremental yes
  distributed yes
  supports_retraction yes
  proof_class none
  effect_class possible-only
  witness_schema CRDTMergeReceipt

phenotype feldera-phenotype
  architecture feldera
  produces DerivedRelation
  produces Delta
  consumes SourceRelation
  deterministic yes
  incremental yes
  distributed yes
  supports_retraction yes
  proof_class none
  effect_class none
  witness_schema DerivedRelationDelta

