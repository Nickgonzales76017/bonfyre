  witness integrations/mcp/tests/fabric_work.test.mjs
  witness integrations/mcp/tests/fabric_transport.test.mjs
  witness integrations/mcp/tests/fabric_model.test.mjs
  witness integrations/mcp/tests/fabric_model_pipeline.test.mjs verifies account-owned execution through the actual queue native protocol adapter compiled Meter and browser decoder, including exact replay fresh revocation STOP and usage-only reconciliation
  witness integrations/mcp/tests/native_meter.test.mjs
  witness integrations/mcp/tests/fabric_output_transfer.test.mjs
  witness integrations/mcp/tests/fabric_push.test.mjs
