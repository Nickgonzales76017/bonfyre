  source_path estate/generated/bitnet-embedding-270m-i2s-pr606-cpuonly-addressplane-shadow-evidence-2026-09.jsonl
  source_path estate/generated/bitnet-embedding-270m-i2s-pr606-cpuonly-addressplane-exact-owner-evidence-2026-09.jsonl
