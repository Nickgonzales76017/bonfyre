atlas economic
# Harvested run6/run7 economic estate. Cannot be reduced to ledgers -- causal
# economic relations, resource commitments, and recursive non-cash value are
# distinct. Registered architectural until built.

architecture money-graph
  canonical_name MoneyGraph
  family economic
  domain Economic / Money
  layer economic
  semantic_question What money flows here -- funds, pays, owes, grants, subsidizes, costs, earns?
  purpose Causal economic relationships between actors and institutions. Distinct from the ledger, which records; this models the flow.
  maturity architectural
  node_types Party
  edge_types funds
  edge_types owes
  forbidden_inference projected value -> realized money
  source_lineage run6/run7 economic estate
  known_gap not built; ERPNext accounting is the intended projection target

architecture commitment-graph
  canonical_name CommitmentGraph
  family economic
  domain Economic / Commitment
  layer economic
  semantic_question Who committed what resource to whom, under what conditions, until when?
  purpose Resource commitments -- purchase orders, SLAs, equipment reservations, grants, human assignments -- each domain-distinct, with authority and expiry.
  maturity architectural
  node_types ResourceCommitment
  edge_types commits
  forbidden_inference a commitment -> the resource delivered
  source_lineage run6/run7 economic estate
  known_gap not built; AuthorityGraph + ResourceActivation are the nearest real shapes

architecture recursive-value-graph
  canonical_name RecursiveValueGraph
  family economic
  domain Economic / Value
  layer economic
  semantic_question What does this unlock, prefill, strengthen, or make reachable -- without converting to cash?
  purpose Vector-valued causal value: unlocks, prefills, increases-eligibility, strengthens-evidence, decreases-cost/time, creates capacity/distribution/relationship/learning options. No implicit conversion to money.
  maturity architectural
  node_types ValueEdge
  edge_types unlocks_value
  forbidden_inference a value edge -> a cash amount
  source_lineage run6/run7 economic estate
  known_gap not built; UnlockGraph is the causal-reachability cousin already real

architecture institutional-cost-graph
  canonical_name InstitutionalCostGraph
  family economic
  domain Economic / Cost
  layer economic
  semantic_question What does this mission actually cost across compute, model, storage, provider, human, facility?
  purpose Recursive cost allocation of a mission across every resource it consumes, ultimately projecting legitimate costs into ERPNext.
  maturity architectural
  node_types CostEnvelope
  edge_types allocates
  forbidden_inference a projected cost -> a booked accounting entry
  source_lineage run6/run7 economic estate
  known_gap not built
