#!/usr/bin/env python3
# Archived after 202 Arrow IPC bindings moved to the digest-bound native runtime.
import argparse, sys
import pyarrow as pa
import pyarrow.parquet as pq

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('parquet')
    ap.add_argument('--batch-size',type=int,default=65536)
    a=ap.parse_args()
    pf=pq.ParquetFile(a.parquet)
    sink=pa.output_stream(sys.stdout.buffer)
    with pa.ipc.new_stream(sink,pf.schema_arrow) as writer:
        for batch in pf.iter_batches(batch_size=a.batch_size):
            writer.write_batch(batch)

if __name__=='__main__': main()
