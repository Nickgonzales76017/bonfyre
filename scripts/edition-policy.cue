  listen: {window_days: 45, count: 4}
  reading: {window_days: 45, minimum_title_chars: 20, maximum_title_chars: 120, count: 14}
  chart: {window_days: 30, minimum_points: 3}
  boundary: "Everything here is material this estate read and kept, arranged by it. A piece appearing in this edition is not a claim that its source still publishes it, that what it says is true, or that anyone involved knows this estate exists."
