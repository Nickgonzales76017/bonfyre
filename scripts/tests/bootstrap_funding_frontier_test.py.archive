#!/usr/bin/env python3
"""Archived after Bun test cutover. Offline contract for the full ProgrammeFabric -> funding-frontier compiler.

The live compiler has a deliberate public observation effect.  This test pins
the owner boundary without making CI depend on Grants.gov availability.
"""
from __future__ import annotations

import json
import os
import pathlib
import sqlite3
import subprocess
import sys
import tempfile


ROOT = pathlib.Path(__file__).resolve().parents[2]
SCRIPT = ROOT / "scripts" / "bootstrap_funding_frontier.mjs"


def main() -> int:
    with tempfile.TemporaryDirectory(prefix="bonfyre-funding-frontier.") as directory:
        root = pathlib.Path(directory)
        cms = root / "cms.db"
        out = root / "public"
        db = sqlite3.connect(cms)
        db.executescript("""
            CREATE TABLE program_template(
              template_id TEXT PRIMARY KEY, name TEXT, description TEXT,
              semantic_slots TEXT, funding_candidates TEXT, status TEXT
            );
            CREATE TABLE program_instance(
              instance_id TEXT PRIMARY KEY, template_id TEXT, owner_subject TEXT,
              site_id TEXT, archetype TEXT, status TEXT
            );
            CREATE TABLE funding_work_package(
              package_id TEXT PRIMARY KEY, instance_id TEXT, funding_program TEXT, status TEXT
            );
        """)
        db.execute("INSERT INTO program_template VALUES(?,?,?,?,?,?)", (
            "p1", "Open local knowledge fabric", "A real programme.",
            '["collections","people","events"]', '["IMLS NLG-L","NSF S&CC"]', "published"))
        db.execute("INSERT INTO program_instance VALUES(?,?,?,?,?,?)", (
            "program:knowledge", "p1", "person:nick", "nick", "knowledge-culture", "published"))
        db.execute("INSERT INTO funding_work_package VALUES(?,?,?,?)", (
            "package:1", "program:knowledge", "IMLS NLG-L", "published"))
        db.execute("INSERT INTO funding_work_package VALUES(?,?,?,?)", (
            "package:2", "program:knowledge", "NSF S&CC", "published"))
        # A draft must not enter a public frontier merely because it happens to
        # name an otherwise useful funding stream.
        db.execute("INSERT INTO funding_work_package VALUES(?,?,?,?)", (
            "package:draft", "program:knowledge", "private lead", "draft"))
        db.commit()
        db.close()

        done = subprocess.run(["bun", str(SCRIPT), "--cms", str(cms), "--out", str(out), "--offline"],
                              text=True, capture_output=True, check=False)
        if done.returncode:
            print(done.stdout, done.stderr, file=sys.stderr)
            return 1
        report = json.loads((out / "funding-frontier.json").read_text())
        page = (out / "funding.html").read_text()
        assert report["schema"] == "bonfyre-funding-frontier.v1"
        assert report["programme_count"] == 1
        assert report["work_package_count"] == 2
        assert report["candidate_count"] == 2
        assert set(report["observations"]) == {"IMLS NLG-L", "NSF S&CC"}
        assert all(row["observation_state"] == "not_observed" for row in report["observations"].values())
        assert "private lead" not in page
        assert "Open local knowledge fabric" in page
        assert "Public edition" in page
        assert "Connected edition" in page
        assert "Operator edition" in page
        assert "Start a pilot conversation" in page
        assert "github.com/Nickgonzales76017/bonfyre/issues/new" in page
        assert report["programmes"][0]["edition_contract"]["public"]["title"] == "Public edition"
        assert "not treated as zero opportunities" in page
        assert any("eligibility" in value for value in report["cannot_infer"])
        if os.environ.get("BONFYRE_VERIFY_LEGACY") == "1":
            legacy_out = root / "legacy"
            legacy = subprocess.run([sys.executable, str(ROOT / "scripts/bootstrap_funding_frontier.py.archive"),
                                     "--cms", str(cms), "--out", str(legacy_out), "--offline"],
                                    text=True, capture_output=True, check=False)
            if legacy.returncode:
                print(legacy.stdout, legacy.stderr, file=sys.stderr)
                return 1
            old = json.loads((legacy_out / "funding-frontier.json").read_text())
            report.pop("generated_at")
            old.pop("generated_at")
            for row in report["observations"].values(): row.pop("observed_at")
            for row in old["observations"].values(): row.pop("observed_at")
            if report != old:
                print("bootstrap funding frontier: native report differs from legacy", file=sys.stderr)
                return 1
    print("bootstrap funding frontier: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
