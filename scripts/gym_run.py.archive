#!/usr/bin/env python3
"""Run a live gym: build the cohort, exercise every available route, compute the
ceilings, and attribute the residual.

The point is not a score. A score says a number went down; a residual says
*where* the loss happened, and that is what decides where effort should go. So a
run reports several ceilings rather than one:

    InternalizedCeiling   what this institution already holds
    DirectSourceCeiling   what the authoritative source itself still contains
    InstitutionalCeiling  what could be derived after fetch, identity, evidence
    MarketCeiling         what any external supplier could deliver
    ActionCeiling         what could lawfully and economically be executed

and the residual decomposes against them:

    RetrievalResidual        held, but the source has moved
    TemporalResidual         held and stale past its validity window
    IdentityResidual         held twice under two identities
    CanonicalizationResidual the same resource not recognised as the same

An unmeasured ceiling is reported as unmeasured, with the reason. This estate
cannot exercise an external search market today -- there are no provider
credentials on the host and the model account has no credits -- and a benchmark
that filled that gap with an estimate would be worse than one with a hole in it,
because the hole is visible and the estimate is not.

Cannot infer: a ceiling is not a promise, a residual is not a defect, and a gym
that passes says the routes agreed at this moment, not that any answer is true.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

CMS_DB = os.environ.get("BONFYRE_CMS_DB", "/var/lib/bonfyre/cms/bonfyre_cms.db")
BIN = os.environ.get("BONFYRE_BIN_DIR", "/usr/local/bin")
RECEIPTS = os.environ.get("BONFYRE_GYM_RECEIPTS", "/var/lib/bonfyre/gym/receipts")
TRIALS = os.environ.get("BONFYRE_TRIAL_RECEIPTS", "/var/lib/bonfyre/gym/trials")

# How long a held observation stays usable, per subject kind. These are not
# guesses dressed as constants: each one is the window the gym contract declares,
# and a kind with no declared window is treated as expiring immediately rather
# than as never expiring -- forgetting must fail toward stale, never toward
# fresh.
WINDOWS = {
    "minutes": 900,
    "hours": 3600 * 6,
    "days": 86400,
    "weeks": 86400 * 7,
    "months": 86400 * 30,
}


def iso_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def organ(args: list[str], timeout: int = 120) -> tuple[int, str]:
    try:
        p = subprocess.run([os.path.join(BIN, args[0])] + args[1:],
                           capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""



def declared_routes() -> list[dict]:
    """Which suppliers exist is a CMS question; whether one is usable here is an
    environment question. The two are kept apart on purpose: the registry is
    content and must never hold a credential, so a route names the variable its
    credential arrives in and nothing more."""
    import sqlite3
    try:
        db = sqlite3.connect(f"file:{CMS_DB}?mode=ro", uri=True)
        db.row_factory = sqlite3.Row
        rows = [dict(r) for r in db.execute(
            "SELECT route, capability, kind, COALESCE(credential_env,'') AS credential_env, "
            "       COALESCE(unit_cost_usd,'') AS unit_cost_usd "
            "FROM provider_route WHERE status = 'published' ORDER BY route")]
        db.close()
        return rows
    except sqlite3.Error:
        return []


def source_ceiling(gym: str, digest: str) -> dict:
    """What the authoritative sources themselves still contained.

    Measured the same way as any other ceiling: from executed trials against
    this cohort, never from the fact that a source exists. Re-fetching is an
    outbound cost against third parties, so this is populated by a deliberate
    trial run rather than on every gym run -- which is why an absent measurement
    here means "not exercised", not "not reachable"."""
    receipts = [r for r in trial_receipts(gym, digest)
                if r.get("capability", "").startswith("discovery.direct_source")]
    if not receipts:
        return {"measured": False, "rung": "executed",
                "unmeasured_because": "no direct-source trial has run against this cohort; "
                                      "re-fetching every source is an outbound cost against "
                                      "third parties and is a separate, rate-aware act"}
    got = [r for r in receipts if r.get("outcome") == "retrieved"]
    evidence = {r.get("evidence_digest") for r in got if r.get("evidence_digest")}
    return {"measured": True, "rung": "measured",
            "value": len(evidence), "of": len(receipts),
            "means": "distinct evidence digests the sources themselves returned "
                     "when actually asked"}


def trial_receipts(gym: str, digest: str) -> list[dict]:
    """Receipts for this gym that were run against this exact cohort.

    Scoping by digest is not bookkeeping. A supplier that answered an older
    cohort has not answered this one, and counting it would let a route keep
    credit for a question it was never asked."""
    out = []
    if not os.path.isdir(TRIALS):
        return out
    for name in os.listdir(TRIALS):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(TRIALS, name)) as f:
                r = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        if r.get("gym") == gym and r.get("cohort_digest") == digest:
            out.append(r)
    return out


def market_ceiling(gym: str, digest: str, capability: str = "retrieval.search") -> dict:
    """What an external supplier actually delivered against this cohort.

    Constructed from executed trials only. An earlier version returned
    `measured: True` when a route's named credential was merely present in the
    environment, which asserted that a market had been measured on the strength
    of possessing a key. It was reproduced deliberately before being removed:
    one route, one always-present variable, nothing executed, and the ceiling
    called itself measured.

    So the rungs are checked in order, and the first one that fails is the
    reason reported. `declared` is not `admissible`, `admissible` is not
    `executed`, and `executed` is not `retrieved`.
    """
    routes = declared_routes()
    external = [r for r in routes if r["kind"] not in ("internal_organ", "direct_source")]
    admissible = [r for r in external
                  if r["capability"] == capability
                  or r["capability"].startswith(capability + ".")]
    if not external:
        return {"measured": False, "rung": "declared",
                "unmeasured_because": "no external supplier is declared as a provider_route; "
                                      "a market cannot be measured before it is named"}
    if not admissible:
        return {"measured": False, "rung": "admissible",
                "declared_routes": len(external),
                "unmeasured_because": f"no declared external route closes {capability}; "
                                      "possessing a credential for a completion endpoint "
                                      "does not make a supplier a search supplier"}
    receipts = [r for r in trial_receipts(gym, digest)
                if r.get("route") in {a["route"] for a in admissible}]
    if not receipts:
        return {"measured": False, "rung": "executed",
                "admissible_routes": [a["route"] for a in admissible],
                "unmeasured_because": "admissible routes exist but none has an executed "
                                      "trial receipt against this cohort; a declared route "
                                      "is not an executed one"}
    retrieved = [r for r in receipts if r.get("outcome") == "retrieved"]
    if not retrieved:
        outcomes = sorted({r.get("outcome", "?") for r in receipts})
        return {"measured": False, "rung": "retrieved",
                "trials": len(receipts), "outcomes": outcomes,
                "unmeasured_because": "trials executed but nothing was retrieved; "
                                      f"outcomes were {', '.join(outcomes)}"}
    # Evidence, not URLs. Distinct digests, because several addresses of one
    # resource are one contribution and counting them separately is the
    # over-count this estate already found nine of.
    evidence = {r.get("evidence_digest") for r in retrieved if r.get("evidence_digest")}
    return {"measured": True, "rung": "measured",
            "value": len(evidence), "trials": len(receipts),
            "routes": sorted({r["route"] for r in retrieved}),
            "means": "distinct evidence digests recovered by external suppliers "
                     "against this cohort, from executed trials"}


def load_contract(gym: str) -> dict:
    import sqlite3
    db = sqlite3.connect(f"file:{CMS_DB}?mode=ro", uri=True)
    db.row_factory = sqlite3.Row
    row = db.execute(
        "SELECT * FROM live_gym WHERE gym = ? AND status = 'published' LIMIT 1", (gym,)
    ).fetchone()
    db.close()
    if not row:
        raise SystemExit(f"no published gym contract named {gym!r}")
    return dict(row)


def cohort_foreign_sources(limit: int) -> list[dict]:
    """The cohort is generated from live state, not from a fixture.

    Every run asks the twin owner what it currently holds, so the cohort tracks
    the estate rather than a snapshot someone took once."""
    rc, out = organ(["bonfyre-project", "foreign", "twins"])
    if rc != 0 or not out.strip():
        return []
    doc = json.loads(out)
    twins = doc["twins"] if isinstance(doc, dict) and "twins" in doc else doc
    twins = [t for t in twins if t.get("url", "").startswith("http")]
    twins.sort(key=lambda t: t.get("last_seen") or "")
    return twins[:limit]


def parse_iso(value: str) -> float | None:
    if not value:
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S.%fZ", "%Y-%m-%d %H:%M:%S"):
        try:
            return datetime.strptime(value, fmt).replace(tzinfo=timezone.utc).timestamp()
        except ValueError:
            continue
    return None


def run(gym: str, as_json: bool) -> int:
    contract = load_contract(gym)
    window = WINDOWS.get(contract["validity_window"], 0)
    size = int(contract.get("cohort_size") or 12)
    started = time.time()

    cohort = cohort_foreign_sources(size)
    if not cohort:
        print("the twin owner returned no cohort; the gym cannot run", file=sys.stderr)
        return 2

    now = time.time()
    rows = []
    for twin in cohort:
        seen = parse_iso(twin.get("last_seen", ""))
        age = None if seen is None else now - seen
        held = bool(twin.get("ever_retained"))
        rows.append({
            "subject": twin.get("subject_id", ""),
            "url": twin.get("url", ""),
            "observations": twin.get("observations", 0),
            "content_changes": twin.get("content_changes", 0),
            "held_body": held,
            "age_seconds": None if age is None else int(age),
            "within_window": bool(age is not None and window and age <= window),
        })

    # Identity is asked of the organ that owns it, not recomputed here. Two
    # identities over one resource is a real loss and it is invisible to any
    # score that counts rows.
    import hashlib
    # The same material provider_trial.cohort_digest builds: the subjects and the
    # gym, and deliberately not the capability. Who is asked is a property of the
    # trial, never of the cohort -- mixing it in gave every capability its own
    # cohort over one set of subjects, so no trial could ever be counted.
    digest = hashlib.sha256(
        ("\n".join(sorted(r["url"] for r in rows)) + "\n--\ngym=" + contract["gym"]).encode()
    ).hexdigest()[:32]

    rc, dup_out = organ(["bonfyre-project", "foreign", "duplicates"])
    duplicates = 0
    if rc == 0 and dup_out.strip():
        try:
            duplicates = len(json.loads(dup_out).get("duplicates", []))
        except json.JSONDecodeError:
            duplicates = 0

    internalized = sum(1 for r in rows if r["held_body"])
    fresh = sum(1 for r in rows if r["within_window"])
    admissible_rc, adm = organ(["bonfyre-project", "foreign", "admissible"])
    admissible = 0
    observations = 0
    boundary = 0
    if admissible_rc == 0 and adm.strip():
        try:
            doc = json.loads(adm)
            admissible = doc.get("admissible", 0)
            observations = doc.get("observations", 0)
            refused = doc.get("refused") or doc.get("refusals") or []
            if isinstance(refused, list):
                boundary = sum(1 for r in refused
                               if str(r.get("reason") or r.get("why") or "")
                               == "boundary_response_not_content")
        except json.JSONDecodeError:
            pass

    ceilings = {
        "InternalizedCeiling": {
            "measured": True, "value": internalized, "of": len(rows),
            "means": "subjects whose bytes this institution still holds",
        },
        "InstitutionalCeiling": {
            "measured": True, "value": admissible,
            "means": "observations that may lawfully support a derived claim",
        },
        "TemporalCeiling": {
            "measured": True, "value": fresh, "of": len(rows),
            "means": f"subjects still inside the declared {contract['validity_window']} window",
        },
        "DirectSourceCeiling": source_ceiling(contract["gym"], digest),
        "MarketCeiling": market_ceiling(contract["gym"], digest),
        "ActionCeiling": {
            "measured": False,
            "unmeasured_because": "reachability stops at the human line; what may "
                                  "be executed is the authority organ's answer, not "
                                  "a benchmark's",
        },
    }

    residual = {
        "TemporalResidual": {
            "value": len(rows) - fresh, "of": len(rows),
            "attribution": "held but past its declared validity window; the fix is "
                           "a refresh schedule priced against staleness, not more retrieval",
        },
        "IdentityResidual": {
            "value": duplicates,
            "attribution": "one resource carried under more than one identity; the "
                           "fix is in AddressPlane and Matrix, not in the provider",
        },
        "EvidenceQualityResidual": {
            "value": boundary, "of": observations,
            "attribution": "retained with a 200 but containing a boundary page rather than "
                           "the resource requested; permission and transport both succeeded, "
                           "so nothing before this asked whether the bytes were the answer",
        },
        "RetentionResidual": {
            "value": len(rows) - internalized, "of": len(rows),
            "attribution": "observed but not retained, so nothing can be re-derived "
                           "without going back to the source; a hydration-regime decision",
        },
        "MarketResidual": {
            "value": None,
            "attribution": "unattributable until a supplier is admitted; this is the "
                           "number that would say whether to buy, build or internalize",
        },
    }

    receipt = {
        "schema": "bonfyre-gym-run.v1",
        "gym": contract["gym"],
        "title": contract["title"],
        "subject_kind": contract["subject_kind"],
        "generator": contract["generator"],
        "validity_window": contract["validity_window"],
        "ran_at": iso_now(),
        "duration_seconds": round(time.time() - started, 3),
        "cohort": rows,
        "cohort_size": len(rows),
        "cohort_digest": digest,
        "ceilings": ceilings,
        "residual": residual,
        "cannot_infer": [c.strip() for c in contract["cannot_infer"].split(";") if c.strip()],
    }

    if as_json:
        print(json.dumps(receipt, indent=2))
    else:
        print(f"  {contract['title']}")
        print(f"  cohort {len(rows)} {contract['subject_kind']}, generated from {contract['generator']}")
        print()
        for name, c in ceilings.items():
            if c["measured"]:
                of = f"/{c['of']}" if "of" in c else ""
                print(f"    {name:<22} {c['value']}{of:<6}  {c['means']}")
            else:
                print(f"    {name:<22} {'--':<8}  unmeasured: {c['unmeasured_because'][:64]}…")
        print()
        for name, r in residual.items():
            v = "--" if r["value"] is None else str(r["value"]) + (f"/{r['of']}" if "of" in r else "")
            print(f"    {name:<22} {v:<8}  {r['attribution'][:66]}")
        print()
        print(f"  a run is a receipt: --json writes one, and {RECEIPTS} keeps the series")

    if "--receipt" in sys.argv:
        os.makedirs(RECEIPTS, exist_ok=True)
        path = os.path.join(RECEIPTS, f"{contract['gym']}-{receipt['ran_at'].replace(':','')}.json")
        with open(path, "w") as f:
            json.dump(receipt, f, indent=2)
        print(f"  receipt: {path}", file=sys.stderr)
    return 0


def main() -> int:
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if not args:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        print("usage: gym_run.py <gym> [--json] [--receipt]", file=sys.stderr)
        return 2
    return run(args[0], "--json" in sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
