def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--sql', default='SHOW TABLES')
    a=ap.parse_args()
    ctx=SessionContext()
    for name,path in TABLES:
        ctx.register_parquet(name,path)
    frames=ctx.sql(a.sql)
    for frame in frames:
        print(frame)

if __name__=='__main__':
    main()
