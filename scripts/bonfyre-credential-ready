#!/bin/sh
# Run by the credential boundary (BONFYRE_CREDENTIALS_ON_READY) the moment a
# provider has every field it needs.  It receives only the provider id, reads
# every census source that was waiting on that credential right away, and
# leaves a line in the automation log.  No credential value passes through here.
set -eu
provider=${1:?provider id required}
case "$provider" in *[!a-z0-9-]*) echo "bonfyre-credential-ready: invalid provider id" >&2; exit 2 ;; esac
log=${BONFYRE_AUTOMATION_LOG:-/var/lib/bonfyre/automation/credential-ready.log}
mkdir -p "$(dirname "$log")"
answer=$(/usr/local/bin/bonfyre-project foreign reheat --credential "$provider" 2>/dev/null || true)
printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$provider" "$(printf '%s' "$answer" | tr -d '\n' | cut -c1-600)" >> "$log"
