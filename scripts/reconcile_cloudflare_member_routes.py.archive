#!/usr/bin/env python3
"""Archived after cutover to cloudflare-reconcile.mjs. Reconcile dedicated auth-host handoffs ahead of estate-wide R2 routes.

The static estate Worker remains responsible for each territory apex.  A
dedicated ``auth.`` hostname is the native member origin for that territory,
which keeps a no-Worker route from falling through an apex's static DNS origin.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request

HOSTS = ("aurekai.life", "aurekai.live", "aurekai.shop", "aurekai.work")
MEMBER_HOSTS = {
    "aurekai.life": "auth.aurekai.life",
    "aurekai.live": "auth.aurekai.live",
    "aurekai.shop": "auth.aurekai.shop",
    # auth.aurekai.work is the separate OAuth issuer address; the ordinary
    # browser session must not steal its issuer ingress.
    "aurekai.work": "signin.aurekai.work",
}
PATHS = ("/_surface*", "/login*", "/signup*", "/logout*", "/account*", "/saved*", "/studio*", "/cms*")
API = "https://api.cloudflare.com/client/v4"


def request(method: str, path: str, token: str, body: dict | None = None) -> dict:
    data = None if body is None else json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        API + path, data=data, method=method,
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            answer = json.load(response)
    except urllib.error.HTTPError as exc:
        answer = json.loads(exc.read().decode("utf-8", "replace"))
    if not answer.get("success"):
        raise RuntimeError(json.dumps(answer.get("errors", answer), separators=(",", ":")))
    return answer


def configured_token() -> str:
    """Prefer the zone-management credential that owns Workers routes.

    Older estate files retain a separate account/tunnel token for R2 and Tunnel
    administration; that credential intentionally may not mutate zone routes.
    """
    reference = os.environ.get("CLOUDFLARE_info_zones", "")
    matched = re.search(r"Bearer\s+([A-Za-z0-9_-]+)", reference)
    if matched:
        return matched.group(1)
    return os.environ.get("CLOUDFLARE_API_TOKEN", "")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    token = configured_token()
    if not token:
        parser.error("CLOUDFLARE_API_TOKEN is required")

    zones = request("GET", "/zones?per_page=50", token).get("result", [])
    zone_ids = {row.get("name"): row.get("id") for row in zones}
    missing = [host for host in HOSTS if host not in zone_ids]
    if missing:
        raise RuntimeError("missing Cloudflare zones: " + ", ".join(missing))

    wanted = [(host, MEMBER_HOSTS[host] + "/*") for host in HOSTS]
    legacy = [(host, prefix + path) for host in HOSTS
              for prefix in (host, "*." + host) for path in PATHS]
    created = 0
    present = 0
    removed = 0
    by_host = {host: request("GET", f"/zones/{zone_ids[host]}/workers/routes", token).get("result", [])
               for host in HOSTS}
    for host, pattern in legacy:
        exact = next((row for row in by_host[host] if row.get("pattern") == pattern), None)
        if exact and exact.get("script") is None:
            if args.apply:
                request("DELETE", f"/zones/{zone_ids[host]}/workers/routes/{exact['id']}", token)
            removed += 1
            print(("removed" if args.apply else "would remove") + " " + pattern)
    for host, pattern in wanted:
        exact = next((row for row in by_host[host] if row.get("pattern") == pattern), None)
        if exact and exact.get("script") is None:
            present += 1
            continue
        if exact:
            raise RuntimeError(f"{pattern} is bound to {exact.get('script')!r}, refusing to replace it")
        if args.apply:
            request("POST", f"/zones/{zone_ids[host]}/workers/routes", token,
                    {"pattern": pattern, "script": None})
        created += 1
        print(("created" if args.apply else "would create") + " " + pattern)
    print(json.dumps({"present": present, "created": created, "removed": removed, "apply": args.apply,
                      "patterns": len(wanted)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
