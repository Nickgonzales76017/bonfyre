#!/usr/bin/env python3
"""Historical parity oracle: tell the index what the estate has kept.

A set of composed pages cannot answer a question nobody asked in advance: there
is no file for it. The estate therefore keeps an index of what it has read, and
this is what fills it. It sends only what the pages already show -- a title, who
published it, its address here -- and never the retained body in full.
"""
import json, os, sqlite3, sys, time, urllib.error, urllib.request

ref = os.environ["SUPABASE_PROJECT_REF"]
key = os.environ["SUPABASE_SERVICE_ROLE_KEY"]
import argparse
_ap = argparse.ArgumentParser()
_ap.add_argument("--archive", default=os.path.expanduser("~/.bonfyre/estate-local/items.db"))
_ap.add_argument("--url", default=os.environ.get("BONFYRE_SEARCH_INDEX_URL", ""),
                 help="PostgREST estate_item endpoint (test/alternate deployment override)")
_ap.add_argument("--attempts", type=int, default=5,
                 help="bounded attempts for transient remote failures")
_args = _ap.parse_args()
url = _args.url or "https://%s.supabase.co/rest/v1/estate_item?on_conflict=address" % ref
# `address` is the archive's stable public identity.  A publish is a projection
# pass, not a claim that this is the first time an item was observed: ordinary
# POST turns the second pass into 409-conflicting 500-row batches.  PostgREST
# performs the merge only against a declared unique address constraint, so a
# missing constraint remains an explicit backend refusal instead of silently
# duplicating or replacing a different item.
if "on_conflict=" not in url:
    url += ("&" if "?" in url else "?") + "on_conflict=address"
db = sqlite3.connect(_args.archive)
db.row_factory = sqlite3.Row

rows, sent, failed = [], 0, 0
seen_addresses = set()   # one row per address per statement, or Postgres refuses the whole batch
def submit(batch):
    """Return an error string only after the bounded remote retry budget."""
    body = json.dumps(batch).encode()
    attempts = max(1, _args.attempts)
    last = "unknown failure"
    for attempt in range(attempts):
        request = urllib.request.Request(url, data=body, method="POST")
        for header, value in (("apikey", key), ("Authorization", "Bearer " + key),
                              ("Content-Type", "application/json"),
                              ("Prefer", "resolution=merge-duplicates,return=minimal")):
            request.add_header(header, value)
        try:
            with urllib.request.urlopen(request, timeout=90) as answer:
                answer.read()
            return None
        except urllib.error.HTTPError as problem:
            # A malformed row/constraint is a durable refusal.  Rate limits
            # and server errors are not evidence against an archive item, so
            # retry them but never call the partial projection successful.
            last = "HTTP %d" % problem.code
            if problem.code not in (408, 429) and not (500 <= problem.code < 600):
                break
        except (urllib.error.URLError, TimeoutError) as problem:
            last = str(problem)[:120]
        if attempt + 1 < attempts:
            time.sleep(min(2.0, 0.25 * (2 ** attempt)))
    return last

def flush(batch):
    global sent, failed
    if not batch:
        return
    problem = submit(batch)
    if problem is None:
        sent += len(batch)
        return
    # PostgREST rejects a multi-row statement atomically.  Keep the failed
    # batch from turning an otherwise healthy corpus into a hole: recursively
    # isolate its bad row(s), while preserving the same bounded retry policy
    # for each child.  This is a transport recovery, not a content repair.
    if len(batch) > 1:
        middle = len(batch) // 2
        flush(batch[:middle])
        flush(batch[middle:])
        return
    failed += len(batch)
    sys.stderr.write("item refused after %d attempt(s): %s (%s)\n" %
                     (max(1, _args.attempts), problem[:120], batch[0].get("address", "unknown")))

started = time.time()
for row in db.execute("SELECT source,key,kind,COALESCE(family,'') family,title,COALESCE(body,'') body,"
                      "COALESCE(href,'') href,COALESCE(image,'') image,COALESCE(publisher,'') publisher,"
                      "COALESCE(at,0) at,COALESCE(first_read,'') first_read FROM item"):
    address = "o/%s/%s" % (row["source"], row["key"])
    if address in seen_addresses:
        continue
    seen_addresses.add(address)
    rows.append({
        "address": address,
        "source": row["source"], "key": row["key"], "kind": row["kind"], "family": row["family"],
        "title": (row["title"] or "")[:600], "body": (row["body"] or "")[:2000],
        "href": row["href"][:900], "image": row["image"][:900],
        "publisher": row["publisher"][:200], "at": row["at"], "first_read": row["first_read"],
    })
    if len(rows) >= 500:
        flush(rows); rows = []
        if sent % 5000 == 0:
            print("  %d loaded" % sent, file=sys.stderr)
flush(rows)
print(json.dumps({"loaded": sent, "refused": failed, "seconds": round(time.time() - started, 1)}))
sys.exit(1 if failed else 0)
