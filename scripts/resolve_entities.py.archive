#!/usr/bin/env python3
"""Give the names this estate keeps repeating an identity that outlives the feed.

The estate has sixty-nine thousand titles and no idea what any of them are
about. It can tell you that forty publishers wrote "White House" this month and
nothing at all about what the White House is, where it is, or that the phrase
"The Future" appearing in twenty-five titles is not a thing.

So the names are put to Wikidata, through the QLever endpoint this estate has
already admitted as a channel. Resolution does two jobs at once. It attaches an
identity -- a Q-number, a description, coordinates where the thing has any -- and
it *filters*: a phrase that resolves to a well-linked entity is an entity, and
one that does not is a turn of phrase. Nothing else in this estate can tell
those apart.

What this does not do: decide that a title is *about* the entity it names. A
headline containing "Fort Worth" mentions Fort Worth. Mention is not aboutness,
and the difference is not one a string match can close.

  resolve_entities.py [--out DIR] [--limit N] [--min-publishers N]
"""
import argparse, json, os, sys, time, urllib.parse, urllib.request

# The endpoint this estate already reads, not a new dependency on a new service.
QLEVER = "https://qlever.dev/api/wikidata"

# A phrase made only of ordinary English is a turn of phrase, however many
# language editions some song of that title has. "The Best" resolves to a Tina
# Turner single with twenty-three sitelinks and is still not a subject; "The
# Guardian" carries a word that is not ordinary and is. So a candidate is
# refused when every word in it is common, and kept when any word is not.
ORDINARY = set("""
a an the this that these those and or but for with from into over under about
best better good great new old first last next final full more most less least
big small long short high low real true free open close early late young
future past present today week weekend month year years day days time times
here there now then when what why how who all any each every some many much
one two three four five ten hundred thousand million billion
way ways thing things part parts kind kinds sort story stories news update
top end start begin made make making take taking get getting going know
look looking see seeing say saying come coming back front side inside outside
life live living work working home house world people person man woman
right left north south east west up down out off on in at by to of is are was
were be been being have has had do does did can could would should will
available released announced coming launch launched review reviews guide guides
tips ideas list lists watch listen read season episode series show shows video
photo photos picture pictures music song songs album feature features special
state states public private tech technology radio television media press report
reports data study studies research market markets business company companies
city cities county town area areas center centre school schools health care
police court courts government federal national international local global
south north east west central american united national general service services
group groups team teams game games play player players season event events
""".split())


# A single capitalised word is usually a sentence opening, and when it does
# resolve it often resolves to the class rather than an instance: Apple is a
# type of fruit, Camera a type of device, Supply an economic concept. A word on
# its own is admitted only when the register says the thing it names is an
# instance of something -- a state, a country, a person, a company. A phrase of
# two or more words needs no such help; almost nothing says "Fort Worth" by
# accident.
SINGLE_WORD_FLOOR = 60

INSTANCE_OF = (
    "state", "country", "city", "town", "province", "county", "municipality",
    "village", "capital", "island", "river", "mountain", "region", "territory",
    "human", "person", "company", "business", "enterprise", "corporation",
    "organization", "organisation", "agency", "university", "college", "school",
    "team", "club", "party", "republic", "kingdom", "nation", "rechtsstaat",
    "league", "federation", "institution", "newspaper", "broadcaster",
)


def instance_like(kind):
    k = (kind or "").lower()
    if k.startswith("type of") or "concept" in k or "widget" in k:
        return False
    return any(w in k for w in INSTANCE_OF)


def ordinary(name):
    """Every word common means the phrase is common, not that it is a thing."""
    words = [w for w in name.lower().replace("-", " ").split() if w]
    return bool(words) and all(w in ORDINARY for w in words)


# A name has to be used by several separate publishers before it is worth
# asking about. One publisher's house style is not the world's vocabulary.
CANDIDATES = r"""
WITH phrase AS (
  -- Multi-word capitalised phrases are usually entities. Single capitalised
  -- words usually are not -- most are sentence openings -- but the ones that
  -- are carry the subjects people actually search for: Texas, Nepal, Gaza. So
  -- both are taken, and a single word has to clear a much higher bar of
  -- separate publishers before it is worth asking the world about.
  SELECT publisher,
         unnest(regexp_extract_all(title, '\b[A-Z][a-z]{2,}(?: [A-Z][a-z]{2,}){1,3}\b')) AS name,
         2 AS words
  FROM read_parquet('%s/material.parquet') WHERE title <> ''
  UNION ALL
  SELECT publisher,
         unnest(regexp_extract_all(title, '\b[A-Z][a-z]{3,}\b')) AS name,
         1 AS words
  FROM read_parquet('%s/material.parquet') WHERE title <> ''
)
SELECT name, mentions, publishers FROM (
  SELECT name, words, COUNT(*) AS mentions, COUNT(DISTINCT publisher) AS publishers,
         row_number() OVER (PARTITION BY words
                            ORDER BY COUNT(DISTINCT publisher) DESC, COUNT(*) DESC) AS rank
  FROM phrase
  WHERE NOT regexp_matches(name,
          '^(January|February|March|April|May|June|July|August|September|October|November|December) ')
  GROUP BY name, words
  HAVING COUNT(DISTINCT publisher) >= (CASE WHEN words = 1 THEN %d ELSE %d END)
) WHERE rank <= %d ORDER BY publishers DESC, mentions DESC
"""

SPARQL = """PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?name ?item ?d ?n ?coord ?kindLabel WHERE {
  VALUES ?name { %s }
  ?item rdfs:label ?name ; wikibase:sitelinks ?n .
  OPTIONAL { ?item schema:description ?d . FILTER(LANG(?d) = "en") }
  OPTIONAL { ?item wdt:P625 ?coord }
  OPTIONAL { ?item wdt:P31 ?kind . ?kind rdfs:label ?kindLabel . FILTER(LANG(?kindLabel) = "en") }
}
ORDER BY DESC(?n)"""


def ask(names, patience=60):
    """One question for a batch of names, asked politely and once."""
    forms = []
    for n in names:
        clean = n.replace('"', '')
        for variant in (clean, clean.lower()):
            form = '"%s"@en' % variant
            if form not in forms:
                forms.append(form)
    values = " ".join(forms)
    query = SPARQL % values
    url = QLEVER + "?" + urllib.parse.urlencode({"query": query})
    req = urllib.request.Request(url, headers={
        "Accept": "application/sparql-results+json",
        # Said plainly, so the endpoint's operator can see who is asking.
        "User-Agent": "Aurekai/1.0 (estate entity resolution; contact via aurekai.live)",
    })
    with urllib.request.urlopen(req, timeout=patience) as answer:
        return json.load(answer)


def point(literal):
    """Wikidata states a coordinate as Point(lon lat). Nothing is inferred."""
    if not literal or not literal.upper().startswith("POINT("):
        return None, None
    try:
        lon, lat = literal[literal.index("(") + 1:].rstrip(")").split()
        return float(lon), float(lat)
    except ValueError:
        return None, None


def fold(name, wanted):
    """Answer under whichever casing the estate's own phrase used."""
    for w in wanted:
        if w.lower() == name.lower():
            return w
    return name


def best(rows, wanted=()):
    """One name, one entity: whichever the world links to most.

    A name that several entities carry -- Dallas the city, Dallas the series,
    Dallas the lexeme -- is resolved to the most linked, and the count is kept
    so a reader can see how weak or strong that choice was.
    """
    held = {}
    for row in rows:
        get = lambda k: (row.get(k) or {}).get("value", "")
        item = get("item")
        if "/entity/Q" not in item:
            continue                      # lexemes and properties are not things
        name, links = fold(get("name"), wanted), int(get("n") or 0)
        if name in held and held[name]["links"] >= links:
            continue
        lon, lat = point(get("coord"))
        held[name] = {"name": name, "qid": item.rsplit("/", 1)[-1],
                      "about": get("d"), "kind": get("kindLabel"),
                      "links": links, "lon": lon, "lat": lat}
    return held


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--catalog", default=os.path.expanduser("~/.bonfyre/estate-local/catalog"))
    ap.add_argument("--limit", type=int, default=400, help="how many names to ask about")
    ap.add_argument("--min-publishers", type=int, default=3)
    ap.add_argument("--batch", type=int, default=40)
    ap.add_argument("--floor", type=int, default=5,
                    help="sitelinks below which a match is not an identity")
    args = ap.parse_args()

    try:
        import duckdb
    except ImportError:
        import subprocess
        sql = CANDIDATES % (args.catalog, args.catalog, args.min_publishers * 4, args.min_publishers, args.limit // 2)
        out = subprocess.run(["duckdb", "-json", "-c", sql],
                             capture_output=True, text=True)
        if out.returncode:
            print(out.stderr[:400], file=sys.stderr)
            return 2
        names = [r["name"] for r in json.loads(out.stdout)]
        counts = {r["name"]: (r["mentions"], r["publishers"]) for r in json.loads(out.stdout)}
    else:
        db = duckdb.connect()
        rows = db.execute(CANDIDATES % (args.catalog, args.catalog, args.min_publishers * 4, args.min_publishers, args.limit // 2)).fetchall()
        names = [r[0] for r in rows]
        counts = {r[0]: (r[1], r[2]) for r in rows}

    resolved, asked, refused = {}, 0, []
    for at in range(0, len(names), args.batch):
        batch = names[at:at + args.batch]
        try:
            answer = ask(batch)
        except Exception as why:
            refused.append({"batch": at, "why": str(why)[:120]})
            continue
        asked += len(batch)
        resolved.update(best(answer.get("results", {}).get("bindings", []), batch))
        time.sleep(0.4)          # the endpoint is someone else's machine

    # Where a resolved thing is, asked by identity rather than by name. The
    # combined query silently returned no coordinate at all, which is worse than
    # asking twice.
    ids = [e["qid"] for e in resolved.values() if e["links"] >= args.floor]
    placed = {}
    for at in range(0, len(ids), args.batch):
        batch = ids[at:at + args.batch]
        where = " ".join("wd:" + q for q in batch)
        query = ("PREFIX wd: <http://www.wikidata.org/entity/> "
                 "PREFIX wdt: <http://www.wikidata.org/prop/direct/> "
                 "SELECT ?item ?coord WHERE { VALUES ?item { " + where + " } "
                 "?item wdt:P625 ?coord }")
        try:
            url = QLEVER + "?" + urllib.parse.urlencode({"query": query})
            req = urllib.request.Request(url, headers={
                "Accept": "application/sparql-results+json",
                "User-Agent": "Aurekai/1.0 (estate entity resolution; contact via aurekai.live)"})
            with urllib.request.urlopen(req, timeout=60) as answer:
                for row in json.load(answer).get("results", {}).get("bindings", []):
                    qid = (row.get("item") or {}).get("value", "").rsplit("/", 1)[-1]
                    lon, lat = point((row.get("coord") or {}).get("value", ""))
                    if lon is not None:
                        placed[qid] = (lon, lat)
        except Exception as why:
            refused.append({"coords_batch": at, "why": str(why)[:120]})
        time.sleep(0.4)
    for e in resolved.values():
        if e["qid"] in placed:
            e["lon"], e["lat"] = placed[e["qid"]]

    kept = []
    refused_ordinary = 0
    refused_class = 0
    refused_thin = 0
    for name, e in resolved.items():
        if e["links"] < args.floor:
            continue             # too weakly linked to be an identity
        if ordinary(name):
            refused_ordinary += 1
            continue             # a turn of phrase wearing a song's Q-number
        if " " not in name.strip():
            if not instance_like(e.get("kind")):
                refused_class += 1
                continue         # the class, not a thing of that class
            # A common word that happens to name a hamlet is still a common
            # word. Impact is a town in Texas with twenty-eight language
            # editions; Welcome is a city in North Carolina. Neither is what a
            # headline means. A single word must be something the world carries
            # heavily before this estate reads it as that thing.
            if e["links"] < SINGLE_WORD_FLOOR:
                refused_thin += 1
                continue
        mentions, publishers = counts.get(name, (0, 0))
        e = dict(e, mentions=mentions, publishers=publishers)
        kept.append(e)
    kept.sort(key=lambda e: (-e["publishers"], -e["links"]))

    out = os.path.join(args.catalog, "entity.jsonl")
    with open(out, "w") as f:
        for e in kept:
            f.write(json.dumps(e) + "\n")

    print(json.dumps({
        "asked": asked,
        "resolved": len(resolved),
        "kept": len(kept),
        "refused_as_ordinary_english": refused_ordinary,
        "refused_single_word_class": refused_class,
        "refused_single_word_thinly_linked": refused_thin,
        "placed": sum(1 for e in kept if e["lon"] is not None),
        "refused_batches": refused,
        "wrote": out,
        "cannot_infer":
            "A resolved name is an identity for the phrase, not a claim that any title "
            "carrying it is about that entity. Mention is not aboutness. A name that did "
            "not resolve is absent rather than assumed, and the sitelink count is kept so "
            "a reader can see how strong each identification was.",
    }, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
