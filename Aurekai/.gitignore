# Aurekai standalone repo .gitignore
# (placed at Aurekai/.gitignore — copied to repo root during split)

# Build output
dist/
node_modules/
# Reconstructable integration scaffolds; extracted repositories retain their own source.
/generated/integration-repos/

# macOS
.DS_Store

# Editor
.vscode/settings.json
.idea/

# Secrets / local config
.env
*.local

# Bun lockfile (keep bun.lockb)
yarn.lock
package-lock.json

# Generator output: bun bin/akai.mjs integrate:scaffold-repos --all
generated/
# Independently regenerable adapter scaffolds, not published repositories.
