{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.aurekai.ai/schemas/aurekai.functional_claim.v1.json",
  "title": "Aurekai Functional Claim",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "claim_type",
    "predicate",
    "target_commitment",
    "proof_ref",
    "opening_policy",
    "evaluation_result"
  ],
  "properties": {
    "schema_version": { "const": "aurekai.functional_claim.v1" },
    "claim_id": { "type": "string" },
    "claim_type": { "type": "string" },
    "predicate": { "type": "string" },
    "target_commitment": { "type": "string" },
    "proof_ref": { "type": "string" },
    "opening_policy": { "type": "string" },
    "evaluation_result": { "enum": ["pass", "fail", "unknown"] },
    "context": { "type": "object" }
  }
}
