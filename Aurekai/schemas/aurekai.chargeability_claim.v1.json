{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.aurekai.ai/schemas/aurekai.chargeability_claim.v1.json",
  "title": "Aurekai Chargeability Claim",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "invoice_id",
    "usage_commitment_ref",
    "fulfillment_ref",
    "predicate",
    "evaluation_result"
  ],
  "properties": {
    "schema_version": { "const": "aurekai.chargeability_claim.v1" },
    "claim_id": { "type": "string" },
    "invoice_id": { "type": "string" },
    "usage_commitment_ref": { "type": "string" },
    "fulfillment_ref": { "type": "string" },
    "predicate": { "type": "string" },
    "proof_ref": { "type": "string" },
    "evaluation_result": { "enum": ["pass", "fail", "unknown"] }
  }
}
