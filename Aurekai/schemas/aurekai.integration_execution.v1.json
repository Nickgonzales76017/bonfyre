{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.aurekai.ai/schemas/aurekai.integration_execution.v1.json",
  "title": "Aurekai Integration Execution Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "target",
    "surface",
    "committed_state",
    "transitions",
    "policies",
    "lineage_edges",
    "export_projections"
  ],
  "properties": {
    "schema_version": { "const": "aurekai.integration_execution.v1" },
    "run_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "target": { "type": "string" },
    "surface": { "enum": ["hard-fork", "soft-fork", "adapter", "observer", "state-machine"] },
    "category": { "type": "string" },
    "runtime_depth": { "type": "string" },
    "ingress_depth": { "type": "string" },
    "trust_level": { "type": "string" },
    "required_kernel_layers": { "type": "array", "items": { "type": "string" } },
    "chart_family": { "type": "string" },
    "residual_assessment": { "type": "object" },
    "mutation_boundary": { "type": ["object", "null"] },
    "transport_semantics": { "type": ["object", "null"] },
    "commerce_continuity": { "type": ["object", "null"] },
    "ingress_doctrine": { "type": ["object", "null"] },
    "state_machine_types": { "type": "array", "items": { "type": "string" } },
    "committed_state": { "$ref": "./aurekai.committed_state.v1.json" },
    "transitions": { "type": "array", "items": { "$ref": "./aurekai.transition.v1.json" } },
    "policies": { "type": "array", "items": { "$ref": "./aurekai.policy_decision.v1.json" } },
    "lineage_edges": { "type": "array", "items": { "$ref": "./aurekai.lineage_edge.v1.json" } },
    "trajectory": { "$ref": "./aurekai.trajectory.v1.json" },
    "functional_claims": { "type": "array", "items": { "$ref": "./aurekai.functional_claim.v1.json" } },
    "export_projections": { "type": "array", "items": { "$ref": "./aurekai.export_projection.v1.json" } },
    "deformation_monitor": { "type": "object" }
  }
}