    "usage_commitments": { "type": "array", "items": { "type": "string" } },
    "fulfillment_refs": { "type": "array", "items": { "type": "string" } },
    "meter_refs": { "type": "array", "items": { "type": "string" } },
    "continuity_summary": { "type": "object" },
    "proof_bundle_ref": { "type": "string" }
  }
