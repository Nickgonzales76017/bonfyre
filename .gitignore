# Compiled binaries
cmd/*/bonfyre-*
!cmd/*/src/
!cmd/*/bonfyre-*-selftest
cmd/*/build/
cmd/*/obj/
lib/liblambda-tensors/*.a
lib/liblambda-tensors/*.so
lib/liblambda-tensors/*.o
lib/liblambda-tensors/src/*.o
lib/liblambda-tensors/test_lambda_tensors
lib/*/obj/

# Python virtual environments
venv/
__pycache__/
*.pyc

# Build artifacts
*.o
*.a
*.so
*.dylib
*.dSYM/
/zig-out/
/.zig-cache/

# SQLite databases (runtime state)
*.db
*.db-journal
*.db-wal
*.db-shm
*.duckdb

# OS files
.DS_Store
Thumbs.db
*.swp
*~

# IDE
.vscode/
.idea/
*.code-workspace

# Runtime data
uploads/
--out/
wire_raw/
raw-captures/
*.pcap
*.pcapng

# Node
node_modules/
dist/
.npmrc

# Test outputs
outputs-*/

# Koopman mode checkpoints (large tensors — regenerate with learn_modes.py)
**/*.pt
**/*.koopman

# Secrets / env files — never commit
.env
**/.env
pipeline/.env
**/pipeline/.env

# Model files (large binaries — never commit)
*.gguf
*.fpq
*.safetensors
*.bin
*.pth
*.pt
*.onnx
*.tflite
*.pb
*.h5
*.hdf5
*.mlmodel
*.mlpackage
*.ckpt
*.engine
*.plan
*.mar
*.torchscript

# Model directories
models/
*.cache/huggingface/

# Generated Frappe bench (framework + venv, not source) — never track
integrations/frappe-bench/

# BonfyreFrappeCompiler compatibility output (old callers may still override it)
/output/

# Generated projections are reproducible; explicitly added witnesses remain tracked.
# Local operator state, hooks and run receipts are not source.
# These patterns only cover untracked files; private release scanning is
# still required, and existing Git history is not affected.
/.bonfyre/
/.run6/
/.bonfyre-runtime/agent-sessions/
/.bonfyre-runtime/patch-backups/
/.bonfyre-runtime/connection-bin/
.claude/settings.local.json

# Rebuildable output and transient delivery artifacts.
/generated/projections/**
!/generated/projections/estate/
!/generated/projections/estate/**
!/generated/projections/inventory/
!/generated/projections/inventory/**
!/generated/projections/lang.json

# Retained third-party observation bodies. The ForeignTwin receipt keeps the
# SHA-256 binding; the raw external page bulk stays local evidence, not history.
.bonfyre/**/household/*/bodies/

# Fleming harvest: client work and its evidence, the same category as the
# Upper90 pack above. Previously only the raw pages were ignored, which left
# 1,785 files and a 543 MB observation parquet one `git add` away from history.
packs/fleming-equity-group/

# Rust build output. 683 MB of regenerable objects that were untracked but not
# ignored, so every status listed them and every clean risked them.
services/bonfyre-restate-native/target/

# Personal Claude Code grants; shared config lives in .claude/settings.json

# Host-origin AgentSession observations written by the Claude Code hooks.
# Observations about a run, not repository source.
.bonfyre-runtime/agent-sessions/
cmd/BonfyreLex/tests/bf-lex-test

# Client work that is not this repository's to publish. Never committed, and
# ignored outright so that no blanket `git add` can sweep it into history. If
# it needs to live somewhere durable, it belongs in its own private repository,
# not here.
cmd/BonfyreUpper90/
packs/upper90/

# Foreign observation bodies and the bulk derived from them. The ForeignTwin
# receipt keeps the SHA-256 binding; the retained external page is local
# evidence, not repository history. The generated C headers in these same
# directories are what the native organs compile against, so they stay: this
# names the bulk, never the whole directory.
services/*/target/
deploy/fly/seed/*.tar.gz
site/matrix/duckdb-eh.wasm

# Retained external observation bodies and sampled pipeline bulk.
# Source receipts belong in Git; bulk external bodies generally do not.
cmd/*/generated/*.body
cmd/*/generated/*.jsonl
cmd/*/generated/*.tsv
cmd/*/generated/*.txt
cmd/*/generated/ingest_*/
estate/generated/**/*.jsonl

# Estate run state written beside the repository rather than under $HOME.

# The Fly seed image: a 28 MB tarball rebuilt from this tree.

# The DuckDB engine served to a reader's tab: 32.7 MB of WebAssembly, pinned by
# version and digest. `scripts/fetch_web_assets.sh` puts it back.

# Runtime working files the hooks leave beside the repository: pre-edit backups
# of source that is already tracked, and built helper binaries. Observations
# about a run, not repository source.
.bonfyre-runtime/patch-backups/
.bonfyre-runtime/connection-bin/
deploy/worker/edge-assets/

# Generated work-samples output; retain authored inputs in its parent directory.
/packs/aurekai-work-samples/site/dist/
/packs/no-simulation/catalogue-release-20261017/public/
/aurekai-continuity-core/

# Tiny synthetic compatibility vectors, not model artifacts.
!cmd/BonfyreFPQ/tests/fixtures/legacy-v[1-4].fpq

# W4 command-vector runner (built by tests/vectors/Makefile)
tests/vectors/bonfyre-vectors

# Local environment overrides and authentication settings.
**/.env.local
**/.env.development
**/.env.production
**/.env.test.local

# May 2026 integration repo stubs are generated templates, never actual Gitlinks.
# Regenerate them on demand from Aurekai/registry instead of tracking hundreds
# of JSON manifests as pretend source repositories.
Aurekai/generated/integration-repos/
