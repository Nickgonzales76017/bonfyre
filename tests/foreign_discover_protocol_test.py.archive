#!/usr/bin/env python3
"""MachineMembrane external-descriptor witness.

The fixture proves that public protocol-shaped JSON is retained only as a
declared candidate in a source passport. It must never be promoted to a live
endpoint, provider, authorized tool, payment route, identity, or effect.
"""
from __future__ import annotations

import http.server
import json
import os
import subprocess
import sys
import tempfile
import threading
from pathlib import Path


class Fixture(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802 -- HTTP handler API
        docs = {
            "/robots.txt": ("text/plain", "User-agent: *\nAllow: /\n"),
            "/.well-known/mcp.json": ("application/json", '{"name":"fixture MCP"}'),
            "/.well-known/agent.json": ("application/json", '{"name":"fixture agent"}'),
            "/.well-known/oauth-authorization-server": ("application/json", '{"issuer":"fixture"}'),
            "/.well-known/assetlinks.json": ("application/json", '[]'),
            "/auth.md": ("text/markdown", "# auth.md\n\nFixture agent registration guide.\n"),
        }
        content_type, body = docs.get(self.path, ("text/html", "<!doctype html><title>fixture</title>"))
        encoded = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def log_message(self, _format: str, *_args: object) -> None:
        pass


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Fixture)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        address = f"http://127.0.0.1:{server.server_port}/"
        result = subprocess.run(
            [sys.executable, str(root / "scripts/foreign-discover.py"), address],
            check=True, capture_output=True, text=True,
        )
        passport = json.loads(result.stdout)
        with tempfile.TemporaryDirectory() as temp:
            env = {
                **os.environ,
                "BONFYRE_MEMBRANE_DB": str(Path(temp) / "membrane.db"),
                "BONFYRE_DISCOVER_BIN": str(root / "scripts/foreign-discover.py"),
            }
            refreshed = subprocess.run(
                [sys.executable, str(root / "scripts/membrane-store.py"), "refresh", address],
                check=True, capture_output=True, text=True, env=env,
            )
            assert json.loads(refreshed.stdout)[0]["root"] == passport["root"]
            listed = subprocess.run(
                [sys.executable, str(root / "scripts/membrane-store.py"), "descriptors"],
                check=True, capture_output=True, text=True, env=env,
            )
            candidates = json.loads(listed.stdout)
            assert len(candidates["descriptors"]) >= len(required := {
                "mcp-descriptor-candidate", "a2a-agent-card-candidate",
                "oauth-server-candidate", "auth-md-candidate",
                "android-app-link-candidate"})
            assert required <= {row["family"] for row in candidates["descriptors"]}
            assert all(row["truth_level"] == "declared_descriptor"
                       for row in candidates["descriptors"])
            assert "admitted provider" in candidates["forbidden_inference"]
            summary = subprocess.run(
                [sys.executable, str(root / "scripts/membrane-store.py"), "summary"],
                check=True, capture_output=True, text=True, env=env,
            )
            assert json.loads(summary.stdout)["inbound"]["declared_descriptor_candidates"]
    finally:
        server.shutdown()
        thread.join(timeout=5)
        server.server_close()
    families = {row["family"] for row in passport["protocol_descriptors"]}
    required = {"mcp-descriptor-candidate", "a2a-agent-card-candidate",
                "oauth-server-candidate", "auth-md-candidate",
                "android-app-link-candidate"}
    assert required <= families, families
    for row in passport["protocol_descriptors"]:
        assert row["truth_level"] == "declared_descriptor"
        assert "authorized tool" in row["limit"]
        assert "effect right" in row["limit"]
    assert passport["best_carrier"] == "html-extraction"
    assert "provider" not in passport
    print("foreign discover protocol descriptors: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
