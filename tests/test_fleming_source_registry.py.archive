# ---------------------------------------------------------------- storage budget

def test_harvest_refuses_to_start_without_headroom(monkeypatch, tmp_path):
    """Regression: the harvester had no storage budget and filled the volume to
    100%, killing three workers and leaving the harness unable to open a command
    output file. Free space is a precondition of acquisition."""
    monkeypatch.setattr(fleming, "free_bytes", lambda path=None: 1024 ** 3)
    src = fleming.Source("src:x", "GIS", "T1", "", endpoint="https://h/q?f=json")
    with pytest.raises(fleming.StorageExhausted, match="below the"):
        fleming.harvest(src, "OBJECTID", 0.0, None, str(tmp_path / "s.db"))


def test_storage_check_passes_with_headroom(monkeypatch):
    monkeypatch.setattr(fleming, "free_bytes", lambda path=None: 500 * 1024 ** 3)
    fleming.check_storage("test")


def test_harvest_stops_between_pages_when_space_runs_out(monkeypatch, tmp_path):
    """A run that exhausts the disk must stop on its own terms so the queue can
    reclaim the mission, rather than taking the machine down with it."""
    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 1, "supportsPagination": True,
                                      "count": 1000, "oid_field": None})
    calls = {"n": 0}

    def shrinking(path=None):
        calls["n"] += 1
        return 500 * 1024 ** 3 if calls["n"] < 12 else 1024 ** 3

    def fake_curl(url, out_path):
        body = json.dumps({"features": [{"attributes": {"GIS_ACCT": "A"}}]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "free_bytes", shrinking)
    monkeypatch.setattr(fleming, "curl", fake_curl)
    monkeypatch.setattr(fleming, "PAGES", str(tmp_path / "pages"))
    src = fleming.Source("src:dallas-tax-parcels", "GIS", "T1", "", endpoint="https://h/q?f=json")
    r = fleming.harvest(src, "OBJECTID", 0.0, None, str(tmp_path / "s.db"))
    assert r["observation_kind"] == "harvest_partial"
    assert 0 < r["pages_this_run"] < 1000, "must stop early, not run to completion"


# ---------------------------------------------------------------- atomic forms

def test_forms_parse_out_of_capital_yaff():
    forms = fleming.load_forms()
    assert len(forms) >= 6
    for k, spec in forms.items():
        assert k.startswith("cap:")
        assert spec["field"], f"{k} declares no fields"
        assert set(spec) == {"field", "evidence", "authority", "review_gate"}


def test_submit_ready_never_returns_a_false_green():
    """The AtomicForm invariant: exact blockers, never a false green."""
    forms = fleming.load_forms()
    for k, spec in forms.items():
        r = fleming.submit_ready(k, spec, {})
        assert r["ready"] is False
        assert r["blockers"]
        # every declared requirement must appear as its own blocker
        assert len(r["blockers"]) >= (len(spec["field"]) + len(spec["evidence"])
                                      + len(spec["authority"]) + len(spec["review_gate"]))


def test_a_form_is_ready_only_when_nothing_blocks_it():
    spec = {"field": ["a"], "evidence": [], "authority": [], "review_gate": []}
    assert fleming.submit_ready("cap:x", spec, {})["ready"] is False
    assert fleming.submit_ready("cap:x", spec, {"a": 1})["ready"] is True


def test_an_actor_field_never_autofills_without_a_verified_actor():
    """A field autofills ONLY from a VERIFIED actor. Nothing in this pack has
    ever asserted one, so every actor field must block and say why."""
    forms = fleming.load_forms()
    for k, spec in forms.items():
        r = fleming.submit_ready(k, spec, {})
        for f in spec["field"]:
            if f in fleming.ACTOR_FIELDS:
                assert any(f"'{f}'" in b and "VERIFIED actor" in b for b in r["blockers"])


def test_fleming_is_not_a_verified_actor():
    assert fleming.actor_is_verified("Fleming Equity Group") is False


def test_parcel_autofill_never_fills_an_actor_field():
    """Parcel fields are bound to a parcel; actor fields are bound to an actor.
    Observed source rows may fill the first and must never fill the second."""
    conn = fleming.store_open()
    row = conn.execute("SELECT acct FROM parcel_flat WHERE acct<>'' LIMIT 1").fetchone()
    conn.close()
    if not row:
        pytest.skip("no parcel_flat")
    filled = fleming.autofill_parcel(row[0])
    assert filled.get("parcel_identity") == row[0]
    assert not (set(filled) & fleming.ACTOR_FIELDS)


def test_every_form_field_source_names_a_harvested_source():
    """A declared autofill source must be a source the registry knows."""
    reg = fleming.load_registry()
    text = open(fleming.CAPITAL_YAFF, encoding="utf-8").read()
    for line in text.splitlines():
        if line.startswith("form_field_source "):
            for tok in line.split():
                if tok.startswith("src:"):
                    assert tok in reg.sources, f"{tok} is not enumerated"


def test_forms_forbid_the_submission_inference():
    text = open(fleming.CAPITAL_YAFF, encoding="utf-8").read()
    assert "a submit-ready form -> an application, a submission, an award" in text


# ---------------------------------------------------------------- packages

def test_package_separates_observed_from_applicant_facts_from_human_actions():
    """The useful artifact is everything up to the signature line, with the
    human-only actions isolated rather than used as a reason to stop early."""
    conn = fleming.store_open()
    row = conn.execute(
        "SELECT acct FROM parcel_flat WHERE city_owned=1 AND prop_cl LIKE '%VACANT%' LIMIT 1"
    ).fetchone()
    conn.close()
    if not row:
        pytest.skip("no city-owned vacant parcel")
    parcel = fleming.autofill_parcel(row[0])
    pkg = fleming.package_land_bank(row[0], parcel, {"known_cost_subtotal_usd": 1,
                                                     "unknown_line_count": 3})
    assert set(pkg) >= {"filled", "unfilled", "human_only"}
    assert len(pkg["filled"]) >= 10, "most of the package must come from observation"
    assert pkg["human_only"], "human actions must be named, not implied"
    for k, v in pkg["filled"].items():
        assert v.get("source"), f"filled field {k} carries no source"
    for k, why in pkg["unfilled"].items():
        assert len(why) > 10, f"unfilled field {k} must say what would fill it"


def test_package_never_claims_it_is_an_application():
    conn = fleming.store_open()
    row = conn.execute("SELECT acct FROM parcel_flat WHERE city_owned=1 LIMIT 1").fetchone()
    conn.close()
    if not row:
        pytest.skip("no parcel")
    parcel = fleming.autofill_parcel(row[0])
    pkg = fleming.package_land_bank(row[0], parcel, {})
    assert not pkg.get("submitted")
    assert "cap:" in pkg["program"]


def test_land_bank_form_does_not_require_an_entity():
    """src:dallas-land-bank-faq states individuals are eligible. The form must
    reflect what the program says, not what the other programs happen to want."""
    forms = fleming.load_forms()
    lb = forms["cap:dallas-land-bank"]
    assert "developer_entity" not in lb["field"]
    assert "developer_entity_registered" not in lb["authority"]
    text = open(fleming.CAPITAL_YAFF, encoding="utf-8").read()
    assert "An individual is eligible" in text


def test_land_bank_is_the_shortest_path():
    forms = fleming.load_forms()
    counts = {k: len(fleming.submit_ready(k, v, {})["blockers"]) for k, v in forms.items()}
    assert counts["cap:dallas-land-bank"] == min(counts.values())


# ---------------------------------------------------------------- multi-market

def test_market_anchors_cover_more_than_one_city():
    """Anchoring every pro forma on Arlington was a habit, not a reason. TAD
    covers all of Tarrant and Fort Worth is 2.7x larger."""
    rows = fleming.market_anchors()
    assert len(rows) >= 20, "one roll should anchor many markets"
    cities = {r["city"] for r in rows}
    assert "026" in cities, "Fort Worth missing"
    assert "024" in cities, "Arlington missing"


def test_implausible_land_medians_are_excluded_not_averaged():
    """Several TAD cities report a median land value of $1 across hundreds of
    parcels. That is an exemption artifact, not a price."""
    rows = fleming.market_anchors()
    excluded = [r for r in rows if not r["usable_for_underwriting"]]
    assert excluded, "the credibility guard never fired; check the floor"
    for r in excluded:
        assert r["land_median"] < fleming.MIN_CREDIBLE_LAND_MEDIAN
        assert r["excluded_reason"]
    for r in rows:
        if r["usable_for_underwriting"]:
            assert r["land_median"] >= fleming.MIN_CREDIBLE_LAND_MEDIAN


def test_every_market_anchor_states_its_sample_size():
    for r in fleming.market_anchors():
        assert r["vacant_n"] >= fleming.MIN_VACANT_OBS
        assert r["improved_n"] >= fleming.MIN_IMPROVED_OBS


def test_a_market_may_have_a_negative_spread():
    """A market where observed exit does not cover observed land plus build must
    be representable. Clamping it at zero would hide the only markets worth
    avoiding."""
    rows = {r["city"]: r for r in fleming.market_anchors()}
    build = fleming.observed_benchmarks().get("build_median") or 0
    spreads = [(r["exit_median"] - r["land_median"] - build)
               for r in rows.values() if r["usable_for_underwriting"]]
    assert any(x < 0 for x in spreads), "no negative spread found; guard may be clamping"


# ---------------------------------------------------------------- digest

def test_digest_states_its_own_provenance():
    """A digest that cannot say what it was derived from is a rumour."""
    path = os.path.join(PACK, "evidence", "fleming-digest.json")
    if not os.path.exists(path):
        pytest.skip("no digest built")
    d = json.load(open(path, encoding="utf-8"))
    p = d["provenance"]
    assert p["observations"] > 1_000_000
    assert p["sources_harvested"] > 50
    assert p["observations_without_provenance"] == 0
    assert d["generated_at"]


def test_digest_carries_every_market_including_the_excluded_ones():
    path = os.path.join(PACK, "evidence", "fleming-digest.json")
    if not os.path.exists(path):
        pytest.skip("no digest built")
    d = json.load(open(path, encoding="utf-8"))
    assert len(d["markets"]) >= 20
    excluded = [m for m in d["markets"] if not m["usable"]]
    assert excluded, "excluded markets must still appear, with their reason"
    for m in excluded:
        assert m["excluded_reason"]
        assert m["spread_usd"] is None, "an unusable market must not carry a spread"


def test_digest_build_anchor_states_its_own_limit():
    path = os.path.join(PACK, "evidence", "fleming-digest.json")
    if not os.path.exists(path):
        pytest.skip("no digest built")
    d = json.load(open(path, encoding="utf-8"))
    assert "Arlington-observed and applied across all markets" in d["build_anchor"]["limit"]


def test_digest_refuses_to_pose_as_the_estate():
    path = os.path.join(PACK, "evidence", "fleming-digest.json")
    if not os.path.exists(path):
        pytest.skip("no digest built")
    d = json.load(open(path, encoding="utf-8"))
    joined = " ".join(d["forbidden_inference"])
    # The pack states forbidden inferences in arrow form ("X -> Y" meaning do not
    # infer Y from X), not as prose negations. Assert the convention it uses.
    assert "this digest -> the estate" in joined
    assert "any figure here -> current" in joined
    assert len(d["forbidden_inference"]) >= 4
