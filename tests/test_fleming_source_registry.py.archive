# ---------------------------------------------------------------- unlock semantics

def test_predicates_parse_out_of_capital_yaff():
    preds = fleming.load_predicates()
    assert len(preds) >= 6
    assert all("evaluable" in p for p in preds), "every predicate must state evaluability"


def test_a_non_evaluable_predicate_must_name_what_is_missing():
    """A predicate silently skipped is indistinguishable from one that failed."""
    for p in fleming.load_predicates():
        if p["evaluable"] != "YES":
            assert p.get("missing") or p.get("weakness"), f"{p['programs']} hides its gap"


def test_evaluable_predicates_name_their_evidence_source():
    reg = fleming.load_registry()
    for p in fleming.load_predicates():
        if p["evaluable"] == "YES":
            for src in p.get("evidence", "").replace("join", "").split():
                if src.startswith("src:"):
                    assert src in reg.sources


def test_unlock_table_carries_no_money_column():
    """RecursiveValueGraph forbids a value edge becoming a cash amount. The
    schema is where that is enforced, not the docstring."""
    lowered = fleming.UNLOCK_SQL.lower()
    for banned in ("usd", "price", "amount", "cash", "value", "cost", "dollar"):
        assert banned not in lowered, f"unlock schema exposes a money column: {banned}"


def test_capital_yaff_records_the_blocking_input_rather_than_a_modelled_price():
    text = open(fleming.CAPITAL_YAFF, encoding="utf-8").read()
    assert "blocking_input parcel_value" in text
    assert "an unknown price -> zero" in text


def test_no_capital_program_claims_an_observed_price():
    """Every capital program stays a research digest until it is fetched."""
    text = open(fleming.CAPITAL_YAFF, encoding="utf-8").read()
    assert "UNOBSERVED_RESEARCH_DIGEST" in text
    assert text.count("claimed_") > 20, "program figures must stay marked as claims"


def test_store_tolerates_concurrent_writers(tmp_path):
    """Regression: parallel harvests of different sources hit `database is
    locked` because the default busy timeout is zero and a whole run was lost."""
    db = str(tmp_path / "s.db")
    a = fleming.store_open(db)
    b = fleming.store_open(db)
    assert a.execute("PRAGMA journal_mode").fetchone()[0].lower() == "wal"
    assert b.execute("PRAGMA busy_timeout").fetchone()[0] >= 1000
    a.execute("INSERT INTO page VALUES ('s',0,'d',1,200,'t')")
    a.commit()
    b.execute("INSERT INTO page VALUES ('s',1,'d2',1,200,'t')")
    b.commit()
    assert a.execute("SELECT COUNT(*) FROM page").fetchone()[0] == 2
    a.close(); b.close()


# ---------------------------------------------------------------- native delegation

def test_analytics_delegate_to_bonfyre_query_not_local_sql():
    """cmd_clusters must run through the native organ, not a local sqlite loop."""
    import inspect
    src = inspect.getsource(fleming.cmd_clusters)
    assert "native_sql(" in src
    assert "sqlite3" not in src
    assert "store_open(" not in src


def test_owner_identity_delegates_to_bonfyre_entity():
    import inspect
    src = inspect.getsource(fleming.cmd_owners)
    assert '"bonfyre-entity"' in src
    assert "native_sql(" in src


def test_native_sql_raises_rather_than_falling_back(monkeypatch):
    """A quiet fallback is how a native organ gets reimplemented one call at a time."""
    monkeypatch.setattr(fleming, "native", lambda b, a, timeout=900: (1, "", "boom"))
    with pytest.raises(RuntimeError, match="bonfyre-query failed"):
        fleming.native_sql("SELECT 1")


def test_missing_native_binary_is_reported_not_swallowed(monkeypatch):
    monkeypatch.setattr(fleming, "NATIVE_BIN", "/nonexistent/bin")
    code, out, err = fleming.native("bonfyre-query", ["status"])
    assert code == 127
    assert out == ""


def test_no_archived_python_is_imported():
    """Archived modules are a reminder to use the native stack, not a library.

    Naming an archived owner in a comment is correct provenance and must stay
    legal; what must never happen is importing or executing one. The assertion
    is about imports, not mentions.
    """
    src = open(MODULE, encoding="utf-8").read()
    assert "import housing_" not in src
    assert "from components" not in src
    assert "import atomic_forms" not in src
    for line in src.splitlines():
        stripped = line.strip()
        if stripped.startswith(("import ", "from ")):
            assert ".archive" not in stripped, f"archived module imported: {stripped}"
        if "exec_module" in stripped or "spec_from_file_location" in stripped:
            assert ".archive" not in stripped


def test_every_archive_reference_names_a_real_archived_owner():
    """A comment citing an archived owner must cite one that exists on disk."""
    import re as _re
    src = open(MODULE, encoding="utf-8").read()
    for path in set(_re.findall(r"[\w/\.\-]+\.py\.archive", src)):
        full = os.path.join(fleming.REPO, path)
        assert os.path.exists(full), f"cites a missing archived owner: {path}"


def test_jget_builds_a_duckdb_json_accessor():
    assert fleming.jget("PROP_CL") == "json_extract_string(observed,'$.PROP_CL')"


# ---------------------------------------------------------------- sweep / queue

def test_sweep_enforces_the_robots_preflight():
    """Regression: cmd_sweep once called harvest() directly and so skipped the
    preflight cmd_harvest enforces. It acquired a source the admission law had
    already refused. The gate must live on every path, not the interactive one."""
    import inspect
    src = inspect.getsource(fleming.cmd_sweep)
    assert "observe(" in src
    assert 'policy_decision' in src
    assert src.index("observe(") < src.index("harvest(src")


def test_sweep_releases_a_lease_on_failure_instead_of_eating_it():
    import inspect
    src = inspect.getsource(fleming.cmd_sweep)
    assert 'queue(["fail"' in src.replace("'", '"') or '"fail"' in src
    assert "except Exception" in src


def test_sweep_never_acks_a_mission_it_did_not_enqueue():
    """A fixture mission, or another producer's work, is released not acked."""
    import inspect
    src = inspect.getsource(fleming.cmd_sweep)
    i = src.index("if src is None:")
    j = src.index("claimed += 1", i)
    assert '"fail"' in src[i:j], "unknown mission must be failed, never acked"
    assert '"ack"' not in src[i:j]


def test_pending_sources_excludes_finished_and_use_restricted(tmp_path, monkeypatch):
    reg = fleming.load_registry()
    pend = fleming.pending_sources(reg)
    ids = {s.src_id for s in pend}
    assert all(reg.sources[i].endpoint for i in ids), "a pending source must have an endpoint"
    assert all(reg.sources[i].tier != "T4" for i in ids), "T4 must never be swept"
    assert "src:dallas-tax-parcels" not in ids, "a fully harvested source stays done"


def test_withdrawn_receipts_are_marked_not_deleted():
    """An improper acquisition is withdrawn in place; the log stays append-only."""
    path = os.path.join(PACK, "evidence", "source-receipts.jsonl")
    withdrawn = [r for r in (json.loads(l) for l in open(path, encoding="utf-8") if l.strip())
                 if r.get("withdrawn")]
    for r in withdrawn:
        assert r.get("withdrawn_reason"), "a withdrawal must say why"
        assert r["observation_kind"] == "withdrawn_improper_acquisition"


def test_a_withdrawn_source_has_no_surviving_observations():
    store = os.path.join(PACK, "evidence", "estate.db")
    if not os.path.exists(store):
        pytest.skip("no estate store")
    path = os.path.join(PACK, "evidence", "source-receipts.jsonl")
    bad = {r["src_id"] for r in (json.loads(l) for l in open(path, encoding="utf-8") if l.strip())
           if r.get("withdrawn") and r.get("src_id")}
    if not bad:
        pytest.skip("nothing withdrawn")
    conn = sqlite3.connect(store, timeout=60)
    for src_id in bad:
        n = conn.execute("SELECT COUNT(*) FROM observation WHERE src_id=?", (src_id,)).fetchone()[0]
        assert n == 0, f"{src_id} was withdrawn but {n} observations survive"
    conn.close()


