"""Historical Python guards; native coverage lives in fleming-native.test.mjs.

The happy path is the least interesting thing here. What has to hold is that the
tool refuses: refuses to fetch before a clean robots preflight, refuses to project
a receipt that does not carry current policy facts, refuses to project a retained
body that no longer hashes to its receipt, and refuses a use-restricted source.
"""

from __future__ import annotations

import copy
import sqlite3
import importlib.util
import json
import os
import sys

import pytest

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PACK = os.path.join(REPO, "packs", "fleming-equity-group")
MODULE = os.path.join(PACK, "fleming.py")

spec = importlib.util.spec_from_file_location("fleming", MODULE)
fleming = importlib.util.module_from_spec(spec)
sys.modules["fleming"] = fleming
spec.loader.exec_module(fleming)


ADMISSIBLE = {
    "schema": "bonfyre-foreign-observation.v1",
    "twin_id": "t",
    "src_id": "src:dallas-tax-parcels",
    "source_url": "https://example.invalid/q",
    "observed_at": "2026-08-28T00:00:00Z",
    "observe_right": "public",
    "robots_url": "https://example.invalid/robots.txt",
    "robots_transport_exit": 0,
    "robots_http_status": 404,
    "policy_decision": "allow",
    "fetch_attempted": True,
    "transport_exit": 0,
    "http_status": 200,
    "body_bytes": 2,
    "content_sha256": "x",
    "body_path": "b.json",
    "availability_claim": False,
    "observation_kind": "source_observed",
}


# ---------------------------------------------------------------- registry

def test_registry_parses_every_enumerated_source():
    """Parse count must equal the row count in the file, not a number I typed.

    The registry grows as surfaces are discovered; what must never happen is a
    row in the file that the parser silently drops.
    """
    rows = [
        l for l in open(fleming.REGISTRY_YAFF, encoding="utf-8")
        if l.startswith("src:")
    ]
    reg = fleming.load_registry()
    assert len(reg.sources) == len(rows)
    assert len(reg.sources) >= 382, "registry shrank"
    assert {s.tier for s in reg.sources.values()} == {"T0", "T1", "T2", "T3", "T4"}


def test_no_duplicate_source_ids_in_the_registry():
    ids = [l.split("|")[0].strip() for l in open(fleming.REGISTRY_YAFF, encoding="utf-8")
           if l.startswith("src:")]
    dupes = {i for i in ids if ids.count(i) > 1}
    assert not dupes, f"duplicate rows: {dupes}"


def test_every_passport_endpoint_binds_to_an_enumerated_row():
    """A passport for a source nobody enumerated is a silent orphan."""
    reg = fleming.load_registry()
    orphans = set(fleming.load_passport_endpoints()) - set(reg.sources)
    assert not orphans, f"passports with no registry row: {sorted(orphans)}"


def test_resolution_map_binds_only_enumerated_sources(capsys):
    fleming.load_registry()
    assert "names unenumerated" not in capsys.readouterr().err


def test_enumeration_is_not_an_endpoint():
    """Enumerating a surface never gives it a URL; only a passport does.

    The bound is deliberately relative, not a magic number: passports are
    expected to grow as sources are acquired, but the enumerated set must stay
    far larger, because that gap IS the honest backlog.
    """
    reg = fleming.load_registry()
    passported = fleming.load_passport_endpoints()
    with_endpoint = [s for s in reg.sources.values() if s.endpoint]
    assert with_endpoint, "no passport carries an endpoint"
    assert all(s.endpoint.startswith("https://") for s in with_endpoint)
    # The invariant is not a ratio. Discovery legitimately closes the gap, so a
    # fixed fraction would fail as the walker succeeds. What must hold is that
    # an endpoint exists ONLY because a passport declares it: enumerating a
    # surface never confers one.
    for s in reg.sources.values():
        if s.src_id not in passported:
            assert s.endpoint is None, f"{s.src_id} has an endpoint with no passport"


def test_a_source_with_an_endpoint_has_a_passport_declaring_it():
    """An endpoint may only enter the registry through sources.yaff."""
    reg = fleming.load_registry()
    passported = fleming.load_passport_endpoints()
    for s in reg.sources.values():
        if s.endpoint:
            assert passported.get(s.src_id) == s.endpoint


def test_unknown_weights_cover_the_resolution_map():
    reg = fleming.load_registry()
    resolved = {u for s in reg.sources.values() for u in s.resolves}
    assert resolved <= set(reg.unknown_weight)


# ---------------------------------------------------------------- admission law

def test_admissible_receipt_admits():
    assert fleming.admission_failure(ADMISSIBLE) is None
    assert fleming.is_admissible(ADMISSIBLE)


@pytest.mark.parametrize(
    "field,value,failure",
    [
        ("observe_right", "unknown", "missing_public_observe_right"),
        ("policy_decision", "policy_excluded", "missing_allow_policy_decision"),
        ("fetch_attempted", False, "missing_fetch_attempt"),
        ("robots_transport_exit", 56, "robots_preflight_not_successful"),
        ("robots_http_status", 503, "robots_preflight_not_successful"),
    ],
)
def test_each_missing_policy_fact_refuses(field, value, failure):
    r = dict(ADMISSIBLE, **{field: value})
    assert fleming.admission_failure(r) == failure


def test_robots_404_is_a_successful_preflight_not_a_deny():
    assert fleming.admission_failure(dict(ADMISSIBLE, robots_http_status=404)) is None
    assert fleming.admission_failure(dict(ADMISSIBLE, robots_http_status=200)) is None


def test_policy_evidence_copies_only_policy_facts():
    ev = fleming.policy_evidence(ADMISSIBLE)
    assert set(ev) == set(fleming.POLICY_EVIDENCE_FIELDS)
    assert "content_sha256" not in ev


# ---------------------------------------------------------------- preflight gate

def test_failed_preflight_never_fetches_the_source_url(monkeypatch):
    """A source excluded by robots is receipted WITHOUT fetching its source URL."""
    fetched: list[str] = []

    def fake_curl(url, out_path):
        fetched.append(url)
        return (0, 503, b"") if url.endswith("robots.txt") else (0, 200, b"{}")

    monkeypatch.setattr(fleming, "curl", fake_curl)
    r = fleming.observe("src:x", "https://example.invalid/data", "twin")

    assert fetched == ["https://example.invalid/robots.txt"]
    assert r["policy_decision"] == "policy_excluded"
    assert r["fetch_attempted"] is False
    assert r["observation_kind"] == "policy_excluded"
    assert fleming.admission_failure(r) == "missing_allow_policy_decision"


def test_robots_disallow_excludes_without_fetching(monkeypatch):
    fetched: list[str] = []

    def fake_curl(url, out_path):
        fetched.append(url)
        return 0, 200, b"User-agent: *\nDisallow: /data\n"

    monkeypatch.setattr(fleming, "curl", fake_curl)
    r = fleming.observe("src:x", "https://example.invalid/data/q", "twin")

    assert fetched == ["https://example.invalid/robots.txt"]
    assert r["policy_decision"] == "policy_excluded"
    assert r["fetch_attempted"] is False


def test_robots_disallow_on_another_path_still_allows(monkeypatch):
    def fake_curl(url, out_path):
        if url.endswith("robots.txt"):
            return 0, 200, b"User-agent: *\nDisallow: /private\n"
        return 0, 200, b'{"features": []}'

    monkeypatch.setattr(fleming, "curl", fake_curl)
    r = fleming.observe("src:x", "https://example.invalid/data/q", "twin")
    assert r["policy_decision"] == "allow"
    assert r["fetch_attempted"] is True


def test_disallow_for_another_agent_does_not_bind_us(monkeypatch):
    def fake_curl(url, out_path):
        if url.endswith("robots.txt"):
            return 0, 200, b"User-agent: BadBot\nDisallow: /\n"
        return 0, 200, b'{"features": []}'

    monkeypatch.setattr(fleming, "curl", fake_curl)
    r = fleming.observe("src:x", "https://example.invalid/data", "twin")
    assert r["policy_decision"] == "allow"


def test_transport_failure_is_a_boundary_response_not_an_observation(monkeypatch):
    def fake_curl(url, out_path):
        if url.endswith("robots.txt"):
            return 0, 404, b""
        return 56, 0, b""

    monkeypatch.setattr(fleming, "curl", fake_curl)
    r = fleming.observe("src:x", "https://example.invalid/data", "twin")
    assert r["observation_kind"] == "boundary_response"
    assert r["content_sha256"] is None
    assert r["body_path"] is None
    assert r["body_bytes"] == 0


def test_no_receipt_ever_claims_availability(monkeypatch):
    def fake_curl(url, out_path):
        return (0, 404, b"") if url.endswith("robots.txt") else (0, 200, b'{"features": []}')

    monkeypatch.setattr(fleming, "curl", fake_curl)
    r = fleming.observe("src:x", "https://example.invalid/d", "twin")
    assert r["availability_claim"] is False


# ---------------------------------------------------------------- schema parity

def test_receipt_schema_matches_the_receipts_already_on_disk(monkeypatch):
    """A new receipt must carry every field the existing on-disk receipts carry."""
    on_disk = [
        json.loads(line)
        for line in open(os.path.join(PACK, "evidence", "source-receipts.jsonl"), encoding="utf-8")
        if line.strip()
    ]
    # The log is append-only and legitimately carries more than one schema
    # (single observations and harvest receipts). Parity is per schema.
    on_disk = [r for r in on_disk if r.get("schema") == fleming.RECEIPT_SCHEMA]
    assert on_disk

    def fake_curl(url, out_path):
        return (0, 404, b"") if url.endswith("robots.txt") else (0, 200, b'{"features": []}')

    monkeypatch.setattr(fleming, "curl", fake_curl)
    fresh = fleming.observe("src:x", "https://example.invalid/d", "twin")

    for existing in on_disk:
        assert set(existing) <= set(fresh), f"dropped: {set(existing) - set(fresh)}"
        assert existing["schema"] == fresh["schema"]


def test_projection_schema_matches_projections_already_on_disk():
    path = os.path.join(PACK, "evidence", "property-observations-20260827.jsonl")
    on_disk = [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]
    assert on_disk

    receipt = dict(ADMISSIBLE, content_sha256="d" * 64, twin_id="t")
    payload = {"features": [{"attributes": {"OBJECTID": 1, "GIS_ACCT": "A1", "ST_NAME": "X"}}]}
    rows = fleming.project_dallas_tax_parcel(receipt, payload)

    assert len(rows) == 1
    for existing in on_disk:
        assert set(existing) == set(rows[0]), f"schema drift: {set(existing) ^ set(rows[0])}"
        assert existing["schema"] == rows[0]["schema"]
        assert existing["dialect"] == rows[0]["dialect"]


def test_projection_carries_the_receipt_digest_it_was_read_from():
    receipt = dict(ADMISSIBLE, content_sha256="ab" * 32)
    payload = {"features": [{"attributes": {"GIS_ACCT": "A1"}}]}
    row = fleming.project_dallas_tax_parcel(receipt, payload)[0]
    assert row["source_payload_sha256"] == "ab" * 32
    assert ("ab" * 32)[:16] in row["observation_id"]


def test_projection_never_asserts_a_canonical_parcel_id():
    receipt = dict(ADMISSIBLE, content_sha256="c" * 64)
    payload = {"features": [{"attributes": {"GIS_ACCT": "A1", "ACCT": "A1"}}]}
    row = fleming.project_dallas_tax_parcel(receipt, payload)[0]
    assert row["canonical_parcel_id"] is None
    assert row["external_parcel_candidate_id"].startswith("external_parcel:")
    assert "not current title ownership" in row["forbidden_inference"]


def test_feature_without_an_account_produces_no_observation():
    receipt = dict(ADMISSIBLE, content_sha256="c" * 64)
    payload = {"features": [{"attributes": {"ST_NAME": "X"}}]}
    assert fleming.project_dallas_tax_parcel(receipt, payload) == []


# ---------------------------------------------------------------- ranking

def test_rank_ignores_sources_that_resolve_nothing_open():
    reg = fleming.load_registry()
    unknowns = {"canonical_parcel_id"}
    parcels = reg.sources["src:dallas-tax-parcels"]
    lidar = reg.sources["src:txgio-lidar"]
    assert reg.value(parcels, unknowns) > 0
    assert reg.value(lidar, unknowns) == 0


def test_gated_sources_cost_more_than_free_equivalents():
    reg = fleming.load_registry()
    free = reg.sources["src:dallas-tax-parcels"]      # T0 GIS
    gated = reg.sources["src:dcad-parcel-shapefiles"]  # T3 GIS, fee schedule
    assert free.resolves & gated.resolves
    assert reg.cost(gated) > reg.cost(free)
    assert gated.gated and not free.gated


def test_parcel_identity_outranks_every_other_unknown():
    reg = fleming.load_registry()
    assert reg.unknown_weight["canonical_parcel_id"] == max(reg.unknown_weight.values())


def test_open_unknowns_come_from_the_fixture_not_a_constant():
    unknowns = fleming.open_unknowns()
    assert unknowns["canonical_parcel_id"] == "UNKNOWN"
    assert unknowns["route_state"] == "NO_LAWFUL_ROUTE_PROVEN"
    assert unknowns["evidence_state"] == "MARKETING_CLAIMS_ONLY"


# ---------------------------------------------------------------- CLI refusals

def _run(argv):
    try:
        return fleming.main(argv)
    except SystemExit as exc:  # argparse
        return exc.code


def test_observe_refuses_an_unenumerated_source(capsys):
    assert _run(["observe", "src:not-in-registry"]) == 2
    assert "not enumerated" in capsys.readouterr().err


def test_observe_refuses_a_use_restricted_source(capsys):
    assert _run(["observe", "src:skip-trace-providers", "--url", "https://example.invalid"]) == 3
    err = capsys.readouterr().err
    assert "T4 use-restricted" in err
    assert "does not imply permitted use" in err


def test_observe_refuses_an_enumerated_source_with_no_endpoint(capsys):
    assert _run(["observe", "src:hud-lihtc-property-db"]) == 2
    assert "Enumeration is not an endpoint" in capsys.readouterr().err


def test_project_refuses_a_receipt_that_is_not_admissible(monkeypatch, capsys):
    bad = dict(ADMISSIBLE, twin_id="bad", policy_decision="policy_excluded")
    monkeypatch.setattr(fleming, "load_receipts", lambda: [bad])
    assert _run(["project", "bad"]) == 3
    assert "missing_allow_policy_decision" in capsys.readouterr().err


def test_project_refuses_a_boundary_response(monkeypatch, capsys):
    r = dict(ADMISSIBLE, twin_id="b", observation_kind="boundary_response")
    monkeypatch.setattr(fleming, "load_receipts", lambda: [r])
    assert _run(["project", "b"]) == 3
    assert "observation_kind=boundary_response" in capsys.readouterr().err


def test_project_refuses_a_body_that_no_longer_hashes_to_its_receipt(tmp_path, monkeypatch, capsys):
    body = tmp_path / "tampered.json"
    body.write_text('{"features": []}', encoding="utf-8")
    r = dict(
        ADMISSIBLE,
        twin_id="tampered",
        content_sha256="0" * 64,
        body_path=os.path.relpath(str(body), fleming.REPO),
    )
    monkeypatch.setattr(fleming, "load_receipts", lambda: [r])
    assert _run(["project", "tampered"]) == 3
    assert "no longer hashes to its receipt" in capsys.readouterr().err


def test_project_accepts_a_body_that_still_hashes(tmp_path, monkeypatch, capsys):
    import hashlib

    raw = b'{"features": [{"attributes": {"GIS_ACCT": "A1"}}]}'
    body = tmp_path / "ok.json"
    body.write_bytes(raw)
    r = dict(
        ADMISSIBLE,
        twin_id="ok",
        src_id="src:dallas-tax-parcels",
        content_sha256=hashlib.sha256(raw).hexdigest(),
        body_path=os.path.relpath(str(body), fleming.REPO),
    )
    monkeypatch.setattr(fleming, "load_receipts", lambda: [r])
    assert _run(["project", "ok"]) == 0
    assert "1 projection(s)" in capsys.readouterr().err


# ---------------------------------------------------------------- second dialect

def test_arlington_dialect_keys_on_its_own_identity_field():
    """Arlington keys on TaxParcelId; Dallas keys on GIS_ACCT. Neither is unified."""
    receipt = dict(ADMISSIBLE, content_sha256="e" * 64)
    payload = {"features": [{"attributes": {"TaxParcelId": 200004, "TaxParcelAddress": "COLLINS"}}]}
    row = fleming.project_arlington_tax_parcel(receipt, payload)[0]
    assert row["external_parcel_candidate_id"] == "external_parcel:arlington-tax-parcel:200004"
    assert row["dialect"] == "arlington-tax-parcel.v1"
    assert row["canonical_parcel_id"] is None


def test_both_dialects_emit_the_same_schema():
    receipt = dict(ADMISSIBLE, content_sha256="f" * 64)
    d = fleming.project_dallas_tax_parcel(receipt, {"features": [{"attributes": {"GIS_ACCT": "A"}}]})[0]
    a = fleming.project_arlington_tax_parcel(receipt, {"features": [{"attributes": {"TaxParcelId": 1}}]})[0]
    assert set(d) == set(a)
    assert d["schema"] == a["schema"] == fleming.PROJECTION_SCHEMA
    assert d["dialect"] != a["dialect"]


def test_arlington_feature_without_a_parcel_id_produces_no_observation():
    receipt = dict(ADMISSIBLE, content_sha256="f" * 64)
    for attrs in ({"TaxParcelAddress": "X"}, {"TaxParcelId": None}, {"TaxParcelId": ""}):
        assert fleming.project_arlington_tax_parcel(receipt, {"features": [{"attributes": attrs}]}) == []


def test_arlington_dialect_drops_editing_identity_but_keeps_retirement():
    receipt = dict(ADMISSIBLE, content_sha256="f" * 64)
    attrs = {
        "TaxParcelId": 1, "OBJECTID": 9, "GlobalID": "{x}",
        "created_user": "someone", "last_edited_user": "someone",
        "RetiredByRecord": "{r}",
    }
    row = fleming.project_arlington_tax_parcel(receipt, {"features": [{"attributes": attrs}]})[0]
    assert "created_user" not in row["observed"]
    assert "GlobalID" not in row["observed"]
    assert row["observed"]["RetiredByRecord"] == "{r}"


def test_a_specific_dialect_beats_the_generic_fallback():
    assert fleming.dialect_for("src:dallas-tax-parcels") == "dallas-tax-parcel.v1"
    assert fleming.dialect_for("src:arlington-tax-parcel") == "arlington-tax-parcel.v1"


def test_unknown_sources_fall_back_to_the_generic_dialect():
    """The fallback is what makes 383 surfaces harvestable without 383 dialects."""
    assert fleming.dialect_for("src:dallas-city-owned-property") == "arcgis-generic.v1"
    assert fleming.dialect_for("src:anything-at-all") == "arcgis-generic.v1"


def test_every_dialect_is_reachable_from_some_source_id():
    reachable = {fleming.dialect_for(s) for s in
                 ("src:dallas-tax-parcels", "src:arlington-tax-parcel", "src:other")}
    assert reachable == set(fleming.DIALECTS)


def test_generic_dialect_never_claims_a_parcel_binding():
    receipt = dict(ADMISSIBLE, content_sha256="a" * 64, src_id="src:dallas-city-owned-property")
    payload = {"features": [{"attributes": {"OBJECTID": 7, "ZONE": "PD-193"}}]}
    row = fleming.project_arcgis_generic(receipt, payload)[0]
    assert row["external_parcel_candidate_id"].startswith("external_feature:")
    assert "external_parcel:" not in row["external_parcel_candidate_id"]
    assert row["canonical_parcel_id"] is None
    assert "not a parcel binding" in row["forbidden_inference"]
    assert row["observed"] == {"ZONE": "PD-193"}


def test_generic_dialect_drops_a_feature_with_no_objectid():
    receipt = dict(ADMISSIBLE, content_sha256="a" * 64)
    assert fleming.project_arcgis_generic(receipt, {"features": [{"attributes": {"X": 1}}]}) == []


def test_dialect_routing_is_registry_backed():
    reg = fleming.load_registry()
    for src_id in ("src:dallas-tax-parcels", "src:arlington-tax-parcel"):
        assert src_id in reg.sources
        assert fleming.dialect_for(src_id) in fleming.DIALECTS


# ---------------------------------------------------------------- live evidence

def test_live_receipts_on_disk_are_admissible_and_hash_to_their_bodies():
    """Every source_observed receipt must still hash to the body it retained."""
    import hashlib

    checked = 0
    for r in fleming.load_receipts():
        if r.get("observation_kind") != "source_observed":
            continue
        assert fleming.admission_failure(r) is None, r["twin_id"]
        path = os.path.join(fleming.REPO, r["body_path"])
        if not os.path.exists(path):
            continue
        with open(path, "rb") as fh:
            assert hashlib.sha256(fh.read()).hexdigest() == r["content_sha256"], r["twin_id"]
        checked += 1
    assert checked >= 2, "expected live observations from at least two jurisdictions"


# ---------------------------------------------------------------- harvest

def test_paged_url_replaces_probe_limits_with_real_paging():
    base = ("https://h/q?where=1%3D1&outFields=*&resultRecordCount=5&f=json")
    url = fleming.paged_url(base, 4000, 2000, "OBJECTID")
    assert "resultRecordCount=2000" in url
    assert "resultRecordCount=5" not in url
    assert "resultOffset=4000" in url
    assert "orderByFields=OBJECTID" in url
    assert "where=1%3D1" in url and "outFields=*" in url


def test_paged_url_does_not_duplicate_paging_params_on_reuse():
    base = "https://h/q?where=1%3D1&resultOffset=0&orderByFields=X&f=json"
    url = fleming.paged_url(base, 100, 50, "OBJECTID")
    assert url.count("resultOffset=") == 1
    assert url.count("orderByFields=") == 1
    assert "orderByFields=OBJECTID" in url


def test_harvest_refuses_a_layer_that_does_not_declare_pagination(monkeypatch, tmp_path):
    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 2000, "supportsPagination": False, "count": 10})
    src = fleming.Source("src:x", "GIS", "T1", "", endpoint="https://h/q?f=json")
    with pytest.raises(RuntimeError, match="supportsPagination"):
        fleming.harvest(src, "OBJECTID", 0.0, None, str(tmp_path / "s.db"))


def test_harvest_uses_the_declared_page_size_not_a_chosen_one(monkeypatch, tmp_path):
    seen: list[str] = []

    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 777, "supportsPagination": True, "count": 777})

    def fake_curl(url, out_path):
        seen.append(url)
        body = json.dumps({"features": [{"attributes": {"GIS_ACCT": f"A{len(seen)}"}}]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "curl", fake_curl)
    src = fleming.Source("src:dallas-tax-parcels", "GIS", "T1", "", endpoint="https://h/q?f=json")
    r = fleming.harvest(src, "OBJECTID", 0.0, 1, str(tmp_path / "s.db"))
    assert r["page_size_used"] == 777
    assert "resultRecordCount=777" in seen[0]


def test_harvest_is_resumable_and_does_not_refetch_stored_pages(monkeypatch, tmp_path):
    calls: list[int] = []

    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 10, "supportsPagination": True, "count": 30})

    def fake_curl(url, out_path):
        off = int(url.split("resultOffset=")[1].split("&")[0])
        calls.append(off)
        body = json.dumps({"features": [{"attributes": {"GIS_ACCT": f"A{off}"}}]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "curl", fake_curl)
    src = fleming.Source("src:dallas-tax-parcels", "GIS", "T1", "", endpoint="https://h/q?f=json")
    db = str(tmp_path / "s.db")

    fleming.harvest(src, "OBJECTID", 0.0, 2, db)
    first = list(calls)
    calls.clear()
    fleming.harvest(src, "OBJECTID", 0.0, None, db)

    assert first == [0, 10]
    assert 0 not in calls and 10 not in calls, "resume refetched pages already stored"
    assert 20 in calls


def test_chain_root_is_sha256_over_page_digests_in_offset_order(monkeypatch, tmp_path):
    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 10, "supportsPagination": True, "count": 30})

    def fake_curl(url, out_path):
        off = int(url.split("resultOffset=")[1].split("&")[0])
        body = json.dumps({"features": [{"attributes": {"GIS_ACCT": f"A{off}"}}]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "curl", fake_curl)
    src = fleming.Source("src:dallas-tax-parcels", "GIS", "T1", "", endpoint="https://h/q?f=json")
    db = str(tmp_path / "s.db")
    r = fleming.harvest(src, "OBJECTID", 0.0, None, db)

    import hashlib as _h
    conn = fleming.store_open(db)
    expected = _h.sha256()
    for (d,) in conn.execute("SELECT page_sha256 FROM page WHERE src_id=? ORDER BY offset", (src.src_id,)):
        expected.update(d.encode())
    conn.close()
    assert r["page_digest_chain_root"] == expected.hexdigest()


def test_every_stored_observation_names_a_page_that_exists(monkeypatch, tmp_path):
    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 10, "supportsPagination": True, "count": 20})

    def fake_curl(url, out_path):
        off = int(url.split("resultOffset=")[1].split("&")[0])
        body = json.dumps({"features": [
            {"attributes": {"GIS_ACCT": f"A{off}"}},
            {"attributes": {"GIS_ACCT": f"B{off}"}},
        ]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "curl", fake_curl)
    src = fleming.Source("src:dallas-tax-parcels", "GIS", "T1", "", endpoint="https://h/q?f=json")
    db = str(tmp_path / "s.db")
    fleming.harvest(src, "OBJECTID", 0.0, None, db)

    conn = fleming.store_open(db)
    orphans = conn.execute(
        "SELECT COUNT(*) FROM observation o "
        "WHERE NOT EXISTS (SELECT 1 FROM page p WHERE p.page_sha256 = o.page_sha256)"
    ).fetchone()[0]
    stored = conn.execute("SELECT COUNT(*) FROM observation").fetchone()[0]
    conn.close()
    assert stored == 4
    assert orphans == 0, "an observation cannot name a page that was never received"


def test_harvest_stops_on_a_transport_failure_without_inventing_rows(monkeypatch, tmp_path):
    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 10, "supportsPagination": True, "count": 100})

    def fake_curl(url, out_path):
        off = int(url.split("resultOffset=")[1].split("&")[0])
        if off >= 20:
            return 56, 0, b""
        body = json.dumps({"features": [{"attributes": {"GIS_ACCT": f"A{off}"}}]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "curl", fake_curl)
    src = fleming.Source("src:dallas-tax-parcels", "GIS", "T1", "", endpoint="https://h/q?f=json")
    r = fleming.harvest(src, "OBJECTID", 0.0, None, str(tmp_path / "s.db"))
    assert r["pages_this_run"] == 2
    assert r["observation_kind"] == "harvest_partial"
    assert r["rows_stored"] == 2


def test_harvest_refuses_a_use_restricted_source(capsys):
    assert _run(["harvest", "src:skip-trace-providers"]) == 3
    assert "T4 use-restricted" in capsys.readouterr().err


def test_harvest_refuses_a_source_with_no_passport_endpoint(capsys):
    assert _run(["harvest", "src:hud-lihtc-property-db"]) == 2
    assert "no passport endpoint" in capsys.readouterr().err


def test_harvest_receipts_on_disk_keep_their_own_schema_shape():
    """Harvest receipts share the log with observations but not their shape."""
    path = os.path.join(PACK, "evidence", "source-receipts.jsonl")
    harvests = [
        r for r in (json.loads(l) for l in open(path, encoding="utf-8") if l.strip())
        if r.get("schema") == fleming.HARVEST_SCHEMA
    ]
    if not harvests:
        pytest.skip("no harvest has run yet")
    required = {
        "src_id", "declared_count", "declared_max_record_count",
        "declared_supports_pagination", "page_size_used", "pages_stored",
        "rows_stored", "page_digest_chain_root", "rate_limit_seconds",
        "availability_claim", "observation_kind",
    }
    for r in harvests:
        assert required <= set(r), f"missing: {required - set(r)}"
        assert r["availability_claim"] is False
        assert r["page_size_used"] <= r["declared_max_record_count"]
        # A layer is pageable two ways: by result offset, or -- when it refuses
        # offsets -- by walking its object-id space. Either is a declared
        # capability; neither is assumed.
        mode = r.get("paging_mode", "result_offset")
        if mode == "result_offset":
            assert r["declared_supports_pagination"] is True
        else:
            assert mode == "object_id_range"
            assert r.get("declared_oid_field"), "oid paging must name its id field"


def test_a_superseded_source_is_tiered_out_of_acquisition():
    """The redacted TAD mirror must not be reachable by rank or harvest."""
    reg = fleming.load_registry()
    open_mirror = reg.sources["src:tad-parcel-view-open"]
    real = reg.sources["src:tad-parcel-view"]
    assert open_mirror.tier == "T4", "a superseded redacted feed must be refused, not merely noted"
    assert real.tier == "T1"
    assert reg.cost(open_mirror) > reg.cost(real)


def test_every_receipt_in_the_log_declares_a_known_schema():
    """The log is append-only and multi-schema. Every line must still name a
    schema the tool defines, so an unrecognised writer is caught, not ignored."""
    known = {fleming.RECEIPT_SCHEMA, fleming.HARVEST_SCHEMA, fleming.ADJACENCY_SCHEMA}
    path = os.path.join(PACK, "evidence", "source-receipts.jsonl")
    seen = set()
    for r in (json.loads(l) for l in open(path, encoding="utf-8") if l.strip()):
        assert r.get("schema") in known, f"unknown schema: {r.get('schema')}"
        seen.add(r["schema"])
    assert seen, "receipt log is empty"


def test_no_receipt_of_any_schema_ever_claims_availability():
    path = os.path.join(PACK, "evidence", "source-receipts.jsonl")
    for r in (json.loads(l) for l in open(path, encoding="utf-8") if l.strip()):
        assert r.get("availability_claim") is False, r.get("twin_id")


# ---------------------------------------------------------------- reproject

def _seed_store(tmp_path, monkeypatch, src_id="src:dallas-city-owned-property", n=2):
    monkeypatch.setattr(fleming, "layer_metadata",
                        lambda base: {"maxRecordCount": 10, "supportsPagination": True, "count": 10 * n})

    def fake_curl(url, out_path):
        off = int(url.split("resultOffset=")[1].split("&")[0])
        body = json.dumps({"features": [
            {"attributes": {"OBJECTID": 1000 + off, "dcad_account_number": f"ACCT{off}"}}
        ]}).encode()
        if out_path:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
            open(out_path, "wb").write(body)
        return 0, 200, body

    monkeypatch.setattr(fleming, "curl", fake_curl)
    monkeypatch.setattr(fleming, "PAGES", str(tmp_path / "pages"))
    src = fleming.Source(src_id, "GIS", "T1", "", endpoint="https://h/q?f=json")
    db = str(tmp_path / "s.db")
    fleming.harvest(src, "OBJECTID", 0.0, n, db)
    return src, db


def test_harvest_namespaces_candidate_ids_by_source(tmp_path, monkeypatch):
    """Regression: the synthetic receipt once omitted src_id, so every generic
    source collided under a single 'unknown' namespace."""
    src, db = _seed_store(tmp_path, monkeypatch)
    conn = fleming.store_open(db)
    ids = [r[0] for r in conn.execute("SELECT candidate_id FROM observation")]
    conn.close()
    assert ids
    assert all(i.startswith("external_feature:dallas-city-owned-property:") for i in ids)
    assert not any(":unknown:" in i for i in ids)


def test_reproject_rebuilds_from_retained_pages_without_network(tmp_path, monkeypatch):
    src, db = _seed_store(tmp_path, monkeypatch)

    def explode(url, out_path):
        raise AssertionError("reproject must not touch the network")

    monkeypatch.setattr(fleming, "curl", explode)
    r = fleming.reproject(src, db)
    assert r["rows"] == 2
    assert r["pages"] == 2
    assert r["pages_missing_body"] == 0


def test_reproject_refuses_a_page_that_drifted_on_disk(tmp_path, monkeypatch):
    src, db = _seed_store(tmp_path, monkeypatch)
    page = os.path.join(str(tmp_path / "pages"), "dallas-city-owned-property-00000000.json")
    with open(page, "wb") as fh:
        fh.write(b'{"features": [{"attributes": {"OBJECTID": 666}}]}')
    with pytest.raises(RuntimeError, match="no longer hash"):
        fleming.reproject(src, db)


def test_reproject_reports_a_missing_body_rather_than_inventing_rows(tmp_path, monkeypatch):
    src, db = _seed_store(tmp_path, monkeypatch)
    os.remove(os.path.join(str(tmp_path / "pages"), "dallas-city-owned-property-00000000.json"))
    r = fleming.reproject(src, db)
    assert r["pages_missing_body"] == 1
    assert r["rows"] == 1


