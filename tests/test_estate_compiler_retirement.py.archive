import copy
import importlib.util
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "scripts/check_estate_compiler_retirement.py"
SPEC = importlib.util.spec_from_file_location("estate_compiler_retirement", SCRIPT)
assert SPEC and SPEC.loader
RETIREMENT = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(RETIREMENT)


def test_frozen_v81_prohibition_is_bound_and_no_successor_is_declared():
    policy = RETIREMENT.load_policy()
    assert policy["successor"] is None
    assert policy["frozen_authority"]["section"] == RETIREMENT.REQUIRED_FROZEN_SECTION
    assert policy["frozen_authority"]["prohibition"] == RETIREMENT.REQUIRED_FROZEN_PROHIBITION
    assert RETIREMENT.validate_successor(policy) == []


def test_successor_requires_current_architecture_owner_state_model_and_bounds():
    policy = copy.deepcopy(RETIREMENT.load_policy())
    policy["successor"] = {
        "architecture_id": "missing-estate-compiler",
        "owner": "",
        "state_model": "append_only_snapshots",
        "retention": {"max_age_seconds": 0},
        "generated_projections_are_authority": True,
    }
    errors = RETIREMENT.validate_successor(policy)
    assert "successor architecture_id is not current in the Atlas" in errors
    assert "successor requires an explicit owner" in errors
    assert "successor requires a non-append-only snapshot state model" in errors
    assert "successor retention.max_age_seconds must be a positive integer" in errors
    assert "successor retention.max_bytes must be a positive integer" in errors
    assert "successor retention.max_snapshots must be a positive integer" in errors
    assert "generated projections cannot become semantic authority" in errors


def test_an_unrelated_existing_architecture_cannot_launder_a_successor():
    policy = copy.deepcopy(RETIREMENT.load_policy())
    policy["successor"] = {
        "architecture_id": "repository-shape",
        "owner": "RepositoryShape",
        "state_model": "bounded_current_state_plus_compacted_history",
        "retention": {
            "max_age_seconds": 86400,
            "max_bytes": 1048576,
            "max_snapshots": 24,
        },
        "generated_projections_are_authority": False,
    }
    assert RETIREMENT.validate_successor(policy) == [
        "successor architecture_id does not explicitly define an estate compiler"
    ]
